#ifndef NARM_GPU_TCH
#define NARM_GPU_TCH

// Named built-ins require Native GPU interface 1.1 and firmware API 1.19.
#define NARM_GPU_GET_CAPS 0x0001
#define NARM_GPU_GET_STATUS 0x0002
#define NARM_GPU_WRITE_HEAP 0x0003
#define NARM_GPU_SUBMIT_PASS 0x0004
#define NARM_GPU_COPY_RECT 0x0005
#define NARM_GPU_FENCE 0x0006
#define NARM_GPU_PRESENT 0x0007
#define NARM_GPU_READ_MEMORY 0x0008
#define NARM_GPU_BACK_TARGET 0x0100
#define NARM_GPU_ENCODE_PASS 0x0101
#define NARM_GPU_ENCODE_TILE 0x0102
#define NARM_GPU_ENCODE_PRIMITIVE 0x0103
#define NARM_GPU_LINK_STATUS 0x0104
#define NARM_GPU_ABORT 0x0105
#define NARM_GPU_RESET 0x0106
#define NARM_GPU_FRAME_READY 0x0107
#define NARM_GPU_TRY_PRESENT 0x0108

#define NARM_GPU_USER_HEAP 0x280000
#define NARM_GPU_SDRAM_BYTES 0x800000
#define NARM_GPU_COLOR0_BASE 0x000000
#define NARM_GPU_COLOR1_BASE 0x096000
#define NARM_GPU_DEPTH_BASE 0x12C000
#define NARM_GPU_COLOR_PITCH 1280
#define NARM_GPU_DEPTH_PITCH 2560
#define NARM_GPU_QUERY_BYTES 64
#define NARM_GPU_COPY_WORDS 14
#define NARM_GPU_MAX_UPLOAD_BYTES 956
// Worst-case encoded upload fits the empty 256-byte RX FIFO after FRAME_READY.
#define NARM_GPU_FRAME_UPLOAD_BYTES 216
#define NARM_GPU_MAX_READ_BYTES 512
#define NARM_GPU_WIDTH 640
#define NARM_GPU_HEIGHT 480
#define NARM_GPU_TILE_SIDE 32
#define NARM_GPU_TILE_COLUMNS 20
#define NARM_GPU_TILE_COUNT 300
#define NARM_GPU_MAX_PASS_REFERENCES 1048576
#define NARM_GPU_PASS_BYTES 32
#define NARM_GPU_TILE_BYTES 8
#define NARM_GPU_TABLE_BYTES 2400
#define NARM_GPU_PRIMITIVE_BYTES 320

#define NARM_GPU_COLOR_LOAD 0
#define NARM_GPU_DEPTH_LOAD 0
#define NARM_GPU_COLOR_CLEAR 1
#define NARM_GPU_DEPTH_CLEAR 2
#define NARM_GPU_DEPTH_DISCARD 4
#define NARM_GPU_KIND_TRIANGLE 0
#define NARM_GPU_KIND_RECTANGLE 1
#define NARM_GPU_KIND_LINE 2
#define NARM_GPU_KIND_SPRITE 3
#define NARM_GPU_COLOR_WRITE 0x10000
#define NARM_GPU_DEPTH_TEST 0x20000
#define NARM_GPU_DEPTH_WRITE 0x40000
#define NARM_GPU_COLOR_KEY 0x80000
#define NARM_GPU_SHADE_FLAT 0
#define NARM_GPU_SHADE_GOURAUD 1
#define NARM_GPU_SHADE_TEXTURE_REPLACE 2
#define NARM_GPU_SHADE_TEXTURE_FLAT_MODULATE 3
#define NARM_GPU_SHADE_TEXTURE_GOURAUD_MODULATE 4
#define NARM_GPU_DEPTH_LESS 0
#define NARM_GPU_DEPTH_LEQUAL 1
#define NARM_GPU_DEPTH_ALWAYS 2
#define NARM_GPU_ADDRESS_CLAMP 0
#define NARM_GPU_U_REPEAT 1
#define NARM_GPU_V_REPEAT 2
#define NARM_GPU_COPY_FRAMEBUFFER 0
#define NARM_GPU_COPY_HEAP 1

// Byte offsets in the little-endian 64-byte replies.
#define NARM_GPU_CAPS_MAJOR 0
#define NARM_GPU_CAPS_MINOR 1
#define NARM_GPU_CAPS_BUS_BITS 2
#define NARM_GPU_CAPS_TILE_SIDE 3
#define NARM_GPU_CAPS_SDRAM_BYTES 4
#define NARM_GPU_CAPS_HEAP_BASE 8
#define NARM_GPU_CAPS_MAX_PAYLOAD 12
#define NARM_GPU_CAPS_PRIMITIVE_BYTES 16
#define NARM_GPU_CAPS_MAX_REFERENCES 20
#define NARM_GPU_CAPS_CORE_HZ 24
#define NARM_GPU_CAPS_HOST_DIVIDER 28
#define NARM_GPU_CAPS_PIXEL_DIVIDER 32
#define NARM_GPU_CAPS_RX_BYTES 36
#define NARM_GPU_CAPS_QUEUE_CAPACITY 40
#define NARM_GPU_CAPS_TX_BYTES 44
#define NARM_GPU_CAPS_DISPLAY_FIFO_PIXELS 48
#define NARM_GPU_CAPS_WIDTH 52
#define NARM_GPU_CAPS_HEIGHT 56
#define NARM_GPU_CAPS_FEATURE_MASK 60
#define NARM_GPU_STATUS_FLAGS 1
#define NARM_GPU_STATUS_EPOCH 2
#define NARM_GPU_STATUS_LAST_SEQUENCE 6
#define NARM_GPU_STATUS_FENCE_TOKEN 10
#define NARM_GPU_STATUS_FRONT 14
#define NARM_GPU_STATUS_VALID 15
#define NARM_GPU_STATUS_CYCLES 16
#define NARM_GPU_STATUS_UNDERFLOWS 24
#define NARM_GPU_STATUS_CORE_FAULT 32
#define NARM_GPU_STATUS_PRESENT_TOKEN 36
#define NARM_GPU_STATUS_LINK_FAULT 56
#define NARM_GPU_READY 1
#define NARM_GPU_BUSY 2
#define NARM_GPU_SEALED 4
#define NARM_GPU_CORE_FAULT 8
#define NARM_GPU_REPLY_AVAILABLE 16
#define NARM_GPU_QUEUE_FULL 32
#define NARM_GPU_RX_FULL 64
#define NARM_GPU_LINK_FAULTED 128
#define NARM_GPU_COLOR0_VALID 1
#define NARM_GPU_COLOR1_VALID 2
#define NARM_GPU_DEPTH_VALID 4

struct NarmGpuCopy {
    unsigned source_kind;
    unsigned source_target;
    unsigned target;
    int source_x;
    int source_y;
    int dest_x;
    int dest_y;
    int width;
    int height;
    unsigned base;
    unsigned image_width;
    unsigned image_height;
    unsigned pitch;
    unsigned reserved;
};

// CPU-side encoder input. Zero unused fields. RGB888 stores R in the low byte.
struct NarmGpuPrimitive {
    unsigned kind;
    unsigned flags;
    unsigned shade;
    unsigned depth_function;
    unsigned addressing;
    unsigned rgb888;
    unsigned key_rgb565;
    int scissor[4];
    int bounds[4];
    unsigned texture_base;
    unsigned texture_width;
    unsigned texture_height;
    unsigned texture_pitch;
    unsigned depth;
    int origin[2];
    int line_end[2];
    int vertices_q4[6];
    int edges[12];
    // z, r, g, b, q, U, V. Each seed, step_x and step_y is a low/high pair.
    unsigned planes[42];
};

int narm_gpu_get_caps(void *out);
int narm_gpu_get_status(void *out);
int narm_gpu_write_heap(unsigned destination, const void *source, unsigned bytes);
int narm_gpu_submit_pass(unsigned descriptor);
int narm_gpu_copy_rect(const struct NarmGpuCopy *copy);
int narm_gpu_fence(unsigned token);
int narm_gpu_present(unsigned target, unsigned token);
int narm_gpu_read_memory(unsigned address, unsigned bytes, void *out);
int narm_gpu_back_target(void);
int narm_gpu_encode_pass(void *out, unsigned target, unsigned flags,
                         unsigned clear_color, unsigned clear_depth, unsigned table);
int narm_gpu_encode_tile(void *out, unsigned list, unsigned count);
int narm_gpu_encode_primitive(void *out, const struct NarmGpuPrimitive *input);
int narm_gpu_link_status(void *out);
int narm_gpu_abort(void);
int narm_gpu_reset(void);
// 1 = ready/queued, 0 = busy, negative = error. Neither waits for vertical blank.
int narm_gpu_frame_ready(void);
int narm_gpu_try_present(unsigned target, unsigned token);

// Raw native argument words for direct command access.
int narm_gpu_submit(unsigned command, const unsigned *args, unsigned arg_words);

#endif
