int loadingSectionShouldWarm(int cx, int cz, int section)
{
    /* Loading now covers the complete configured visible window. The previous
       frustum-only warm-up left the back half missing and depended on a
       low-FPS-sensitive gameplay streamer when the player turned around. */
    return 1;
}

void setupLoadingTerrainBuild()
{
    updateViewVectors();
    updateCamera();
    buildRenderColumnCache();

    render_radius_blocks = (render_chunks * 16) - 8;
    if (render_radius_blocks < 8) render_radius_blocks = 8;
    if (render_radius_blocks > 40) render_radius_blocks = 40;

    rc_abs_player_x = (float)world_origin_x + player_x;
    rc_abs_player_z = (float)world_origin_z + player_z;
    render_visible_center_x = floorFloatToInt(((float)floorFloatToInt(rc_abs_player_x) + 8.0f) * 0.0625f) * 16;
    render_visible_center_z = floorFloatToInt(((float)floorFloatToInt(rc_abs_player_z) + 8.0f) * 0.0625f) * 16;
    render_visible_min_x = render_visible_center_x - render_radius_blocks;
    render_visible_max_x = render_visible_center_x + render_radius_blocks;
    render_visible_min_z = render_visible_center_z - render_radius_blocks;
    render_visible_max_z = render_visible_center_z + render_radius_blocks;

    gm_x0 = render_visible_min_x - render_cache_origin_x;
    gm_x1 = render_visible_max_x - 1 - render_cache_origin_x;
    gm_z0 = render_visible_min_z - render_cache_origin_z;
    gm_z1 = render_visible_max_z - 1 - render_cache_origin_z;
    if (gm_x0 < 0) gm_x0 = 0;
    if (gm_z0 < 0) gm_z0 = 0;
    if (gm_x1 >= render_cache_width) gm_x1 = render_cache_width - 1;
    if (gm_z1 >= render_cache_width) gm_z1 = render_cache_width - 1;

    gm_chunk_cx0 = gm_x0 / 8;
    gm_chunk_cx1 = gm_x1 / 8;
    gm_chunk_cz0 = gm_z0 / 8;
    gm_chunk_cz1 = gm_z1 / 8;
    if (gm_chunk_cx0 < 0) gm_chunk_cx0 = 0;
    if (gm_chunk_cz0 < 0) gm_chunk_cz0 = 0;
    if (gm_chunk_cx1 > 15) gm_chunk_cx1 = 15;
    if (gm_chunk_cz1 > 15) gm_chunk_cz1 = 15;

    gm_cam_block_x = cam_px / block_world_size;
    gm_cam_block_y = cam_py / block_world_size;
    gm_cam_block_z = cam_pz / block_world_size;
    render_cached_tex_block = (uint)999;

    gm_player_chunk_x = (floorFloatToInt(rc_abs_player_x) - render_cache_origin_x) / 8;
    gm_player_chunk_z = (floorFloatToInt(rc_abs_player_z) - render_cache_origin_z) / 8;
    if (gm_player_chunk_x < gm_chunk_cx0) gm_player_chunk_x = gm_chunk_cx0;
    if (gm_player_chunk_x > gm_chunk_cx1) gm_player_chunk_x = gm_chunk_cx1;
    if (gm_player_chunk_z < gm_chunk_cz0) gm_player_chunk_z = gm_chunk_cz0;
    if (gm_player_chunk_z > gm_chunk_cz1) gm_player_chunk_z = gm_chunk_cz1;

    /* Keep the exact 8-block mesh bounds derived above. render_chunks is a
       16-block user-facing distance and must not be used directly as an
       8-block mesh radius. */

    loading_chunk_x = gm_chunk_cx0;
    loading_chunk_z = gm_chunk_cz0;
    loading_section = 0;
    loading_progress = 0;
    loading_total = 0;

    rn_cz = gm_chunk_cz0;
    while (rn_cz <= gm_chunk_cz1)
    {
        rn_cx = gm_chunk_cx0;
        while (rn_cx <= gm_chunk_cx1)
        {
            rn_idx = (rn_cz * 16) + rn_cx;
            rn_max_s = getNaturalMaxSectionForRenderChunk(rn_cx, rn_cz);
            loading_scan_s = 0;
            while (loading_scan_s <= rn_max_s)
            {
                if (loadingSectionShouldWarm(rn_cx, rn_cz, loading_scan_s) != 0) loading_total = loading_total + 1;
                loading_scan_s = loading_scan_s + 1;
            }
            rn_cx = rn_cx + 1;
        }
        rn_cz = rn_cz + 1;
    }
    if (loading_total < 1) loading_total = 1;
}

void advanceLoadingTerrainCursor()
{
    rn_idx = (loading_chunk_z * 16) + loading_chunk_x;
    loading_section = loading_section + 1;
    if (loading_section > getNaturalMaxSectionForRenderChunk(loading_chunk_x, loading_chunk_z))
    {
        loading_section = 0;
        loading_chunk_x = loading_chunk_x + 1;
        if (loading_chunk_x > gm_chunk_cx1)
        {
            loading_chunk_x = gm_chunk_cx0;
            loading_chunk_z = loading_chunk_z + 1;
        }
    }
}

void processOneLoadingTerrainSection()
{
    /* v53: build the closest not-yet-built chunk/section first. v53 warmed
       row-major from the far corner of the visible square, so when render
       distance was above minimum the player could stand in an unloaded chunk
       while distant chunks were being built first. */
    loading_best_x = -1;
    loading_best_z = -1;
    loading_best_s = 0;
    loading_best_dist = 999999;

    loading_scan_z = gm_chunk_cz0;
    while (loading_scan_z <= gm_chunk_cz1)
    {
        loading_scan_x = gm_chunk_cx0;
        while (loading_scan_x <= gm_chunk_cx1)
        {
            loading_scan_s = 0;
            rn_idx = (loading_scan_z * 16) + loading_scan_x;
            rn_max_s = getNaturalMaxSectionForRenderChunk(loading_scan_x, loading_scan_z);
            while (loading_scan_s <= rn_max_s)
            {
                gm_chunk_id = (loading_scan_s * 256) + (loading_scan_z * 16) + loading_scan_x;
                if (render_chunk_built[gm_chunk_id] == 0)
                {
                    if (loadingSectionShouldWarm(loading_scan_x, loading_scan_z, loading_scan_s) != 0)
                    {
                        gm_dx = loading_scan_x - gm_player_chunk_x;
                        if (gm_dx < 0) gm_dx = 0 - gm_dx;
                        gm_dz = loading_scan_z - gm_player_chunk_z;
                        if (gm_dz < 0) gm_dz = 0 - gm_dz;
                        loading_scan_dist = (gm_dx * gm_dx) + (gm_dz * gm_dz) + loading_scan_s;
                        if (loading_scan_dist < loading_best_dist)
                        {
                            loading_best_dist = loading_scan_dist;
                            loading_best_x = loading_scan_x;
                            loading_best_z = loading_scan_z;
                            loading_best_s = loading_scan_s;
                        }
                    }
                }
                loading_scan_s = loading_scan_s + 1;
            }
            loading_scan_x = loading_scan_x + 1;
        }
        loading_scan_z = loading_scan_z + 1;
    }

    if (loading_best_x < 0)
    {
        loading_progress = loading_total;
        return;
    }

    loading_chunk_x = loading_best_x;
    loading_chunk_z = loading_best_z;
    loading_section = loading_best_s;
    gm_chunk_id = (loading_section * 256) + (loading_chunk_z * 16) + loading_chunk_x;
    rebuildRenderChunkAt(loading_chunk_x, loading_chunk_z, loading_section);

    loading_progress = loading_progress + 1;
}


void processLoadingWorld()
{
    if (loading_phase == 0)
    {
        loading_ok = 0;
        if (loading_mode == 1)
        {
            if (loadCurrentWorld() != 0) loading_ok = 1;
        }
        else if (loading_mode == 2)
        {
            startNewWorldFromName();
            if (current_world_loaded != 0) loading_ok = 1;
        }

        if (loading_ok == 0)
        {
            loading_mode = 0;
            loading_phase = 0;
            app_state = 1;
            refreshWorldList();
            return;
        }

        setupLoadingTerrainBuild();
        loading_phase = 1;
        return;
    }

    if (loading_phase == 1)
    {
        loading_build_i = 0;
        while (loading_build_i < 4)
        {
            if (loading_progress >= loading_total)
            {
                loading_phase = 2;
                loading_build_i = 4;
            }
            else
            {
                processOneLoadingTerrainSection();
                loading_build_i = loading_build_i + 1;
            }
        }
        return;
    }

    render_dirty_chunk_count = 0;
    loading_mode = 0;
    loading_phase = 0;
    app_state = 5;
    menu_open = 0;
    inventory_open = 0;
    crafting_table_mode = 0;
    last_ms = millis();
}

void moveFrontendCursor()
{
    up_now = millis();
    if (last_ms == (uint)0) last_ms = up_now;
    up_dt = up_now - last_ms;
    last_ms = up_now;
    if (up_dt > (uint)50) up_dt = (uint)50;
    up_dtf = (float)up_dt;
    ui_cursor_speed = up_dtf * 0.22f * cursor_sensitivity;

    key(0x43, key_data, key_pressed);  /* I */
    if (key_pressed != 0) ui_cursor_y = ui_cursor_y - ui_cursor_speed;
    key(0x42, key_data, key_pressed);  /* K */
    if (key_pressed != 0) ui_cursor_y = ui_cursor_y + ui_cursor_speed;
    key(0x3B, key_data, key_pressed);  /* J */
    if (key_pressed != 0) ui_cursor_x = ui_cursor_x - ui_cursor_speed;
    key(0x4B, key_data, key_pressed);  /* L */
    if (key_pressed != 0) ui_cursor_x = ui_cursor_x + ui_cursor_speed;

    if (ui_cursor_x < 0.0f) ui_cursor_x = 0.0f;
    if (ui_cursor_x > 319.0f) ui_cursor_x = 319.0f;
    if (ui_cursor_y < 0.0f) ui_cursor_y = 0.0f;
    if (ui_cursor_y > 239.0f) ui_cursor_y = 239.0f;
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;
}

void clearNewWorldName()
{
    world_name_editing = 0;
    new_world_name_len = 0;
    world_tmp_i = 0;
    while (world_tmp_i < 16)
    {
        new_world_name[world_tmp_i] = 0;
        world_tmp_i = world_tmp_i + 1;
    }
}

void appendNewWorldNameChar(int ch)
{
    if (new_world_name_len >= 15) return;
    new_world_name[new_world_name_len] = (char)ch;
    new_world_name_len = new_world_name_len + 1;
    new_world_name[new_world_name_len] = 0;
}

void processNameKeyPresses()
{
    world_text_any_key = 0;
    key(0x1C, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(65); }
    key(0x32, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(66); }
    key(0x21, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(67); }
    key(0x23, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(68); }
    key(0x24, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(69); }
    key(0x2B, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(70); }
    key(0x34, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(71); }
    key(0x33, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(72); }
    key(0x43, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(73); }
    key(0x3B, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(74); }
    key(0x42, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(75); }
    key(0x4B, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(76); }
    key(0x3A, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(77); }
    key(0x31, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(78); }
    key(0x44, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(79); }
    key(0x4D, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(80); }
    key(0x15, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(81); }
    key(0x2D, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(82); }
    key(0x1B, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(83); }
    key(0x2C, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(84); }
    key(0x3C, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(85); }
    key(0x2A, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(86); }
    key(0x1D, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(87); }
    key(0x22, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(88); }
    key(0x35, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(89); }
    key(0x1A, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) appendNewWorldNameChar(90); }
    key(0x66, key_data, key_pressed); if (key_pressed != 0) { world_text_any_key = 1; if (old_world_text_key == 0) { if (new_world_name_len > 0) { new_world_name_len = new_world_name_len - 1; new_world_name[new_world_name_len] = 0; } } }
    if (world_text_any_key != 0) old_world_text_key = 1;
    else old_world_text_key = 0;
}

int updateFrontendMenus()
{
    world_text_any_key = 0;

    if ((app_state == 2) && (world_name_editing != 0))
    {
        processNameKeyPresses();

        key(0x5A, key_data, key_pressed);  /* Enter: finish typing */
        if (key_pressed != 0)
        {
            if (old_world_enter_key == 0)
            {
                world_name_editing = 0;
                old_world_text_key = 0;
            }
            old_world_enter_key = 1;
        }
        else old_world_enter_key = 0;

        return 0;
    }

    moveFrontendCursor();
    old_world_text_key = 0;
    old_world_enter_key = 0;

    key(0x1C, key_data, key_pressed);  /* A click */
    if (key_pressed != 0)
    {
        if (old_cursor_left_click == 0)
        {
            if (app_state == 0)
            {
                if (cursorInRect(86, 76, 234, 98) != 0) { refreshWorldList(); app_state = 1; }
                else if (cursorInRect(86, 108, 234, 130) != 0) { syncPendingConfigFromActive(); app_state = 3; }
                else if (cursorInRect(86, 140, 234, 162) != 0) app_state = 4;
                else if (cursorInRect(86, 172, 234, 194) != 0) return 1;
            }
            else if (app_state == 1)
            {
                world_tmp_i = 0;
                while (world_tmp_i < world_list_count)
                {
                    world_tmp_j = 44 + world_tmp_i * 12;
                    if (cursorInRect(36, world_tmp_j - 2, 284, world_tmp_j + 10) != 0) world_selected = world_tmp_i;
                    world_tmp_i = world_tmp_i + 1;
                }
                if (cursorInRect(28, 184, 82, 206) != 0) app_state = 0;
                else if (cursorInRect(92, 184, 146, 206) != 0) { clearNewWorldName(); app_state = 2; }
                else if (cursorInRect(156, 184, 210, 206) != 0) startSelectedWorld();
                else if (cursorInRect(220, 184, 292, 206) != 0)
                {
                    if (world_list_count > 0)
                    {
                        copySelectedNameToCurrent();
                        buildWorldPathFromCurrentName();
                        sdFileDelete(world_path);
                        refreshWorldList();
                    }
                }
            }
            else if (app_state == 2)
            {
                if (cursorInRect(104, 94, 216, 110) != 0)
                {
                    world_name_editing = 1;
                    old_world_text_key = 1;
                }
                else if (cursorInRect(76, 148, 152, 170) != 0)
                {
                    world_name_editing = 0;
                    app_state = 1;
                }
                else if (cursorInRect(168, 148, 244, 170) != 0) beginWorldLoading(2);
            }
            else if (app_state == 3)
            {
                if ((ui_cursor_ix >= 82) && (ui_cursor_ix <= 96) && (ui_cursor_iy >= 48) && (ui_cursor_iy <= 60))
                {
                    pending_camera_sensitivity_percent = pending_camera_sensitivity_percent - 10;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 176) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 48) && (ui_cursor_iy <= 60))
                {
                    pending_camera_sensitivity_percent = pending_camera_sensitivity_percent + 10;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 82) && (ui_cursor_ix <= 96) && (ui_cursor_iy >= 72) && (ui_cursor_iy <= 84))
                {
                    pending_cursor_sensitivity_percent = pending_cursor_sensitivity_percent - 10;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 176) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 72) && (ui_cursor_iy <= 84))
                {
                    pending_cursor_sensitivity_percent = pending_cursor_sensitivity_percent + 10;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 220) && (ui_cursor_ix <= 234) && (ui_cursor_iy >= 48) && (ui_cursor_iy <= 60))
                {
                    pending_render_chunks = pending_render_chunks - 1;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 282) && (ui_cursor_ix <= 296) && (ui_cursor_iy >= 48) && (ui_cursor_iy <= 60))
                {
                    pending_render_chunks = pending_render_chunks + 1;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 82) && (ui_cursor_ix <= 96) && (ui_cursor_iy >= 96) && (ui_cursor_iy <= 108))
                {
                    pending_cloud_area_blocks = pending_cloud_area_blocks - 32;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 176) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 96) && (ui_cursor_iy <= 108))
                {
                    pending_cloud_area_blocks = pending_cloud_area_blocks + 32;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 82) && (ui_cursor_ix <= 96) && (ui_cursor_iy >= 122) && (ui_cursor_iy <= 134))
                {
                    pending_day_cycle_speed_percent = pending_day_cycle_speed_percent - 25;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 176) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 122) && (ui_cursor_iy <= 134))
                {
                    pending_day_cycle_speed_percent = pending_day_cycle_speed_percent + 25;
                    clampPendingConfigValues();
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 126) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 136) && (ui_cursor_iy <= 152))
                {
                    if (pending_clouds_enabled == 0) pending_clouds_enabled = 1; else pending_clouds_enabled = 0;
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 126) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 154) && (ui_cursor_iy <= 170))
                {
                    if (pending_stars_enabled == 0) pending_stars_enabled = 1; else pending_stars_enabled = 0;
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 126) && (ui_cursor_ix <= 190) && (ui_cursor_iy >= 172) && (ui_cursor_iy <= 188))
                {
                    if (pending_aimed_outline_enabled == 0) pending_aimed_outline_enabled = 1; else pending_aimed_outline_enabled = 0;
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 266) && (ui_cursor_ix <= 296) && (ui_cursor_iy >= 154) && (ui_cursor_iy <= 170))
                {
                    if (pending_autosave_enabled == 0) pending_autosave_enabled = 1; else pending_autosave_enabled = 0;
                    config_dirty = 1;
                }
                else if ((ui_cursor_ix >= 24) && (ui_cursor_ix <= 86) && (ui_cursor_iy >= 204) && (ui_cursor_iy <= 220))
                {
                    syncPendingConfigFromActive();
                    app_state = 0;
                }
                else if ((ui_cursor_ix >= 108) && (ui_cursor_ix <= 286) && (ui_cursor_iy >= 204) && (ui_cursor_iy <= 220))
                {
                    applyPendingConfigValues();
                    saveConfigFile();
                }
            }
            else if (app_state == 4)
            {
                if ((ui_cursor_ix >= 24) && (ui_cursor_ix <= 86) && (ui_cursor_iy >= 202) && (ui_cursor_iy <= 222)) app_state = 0;
            }
        }
        old_cursor_left_click = 1;
    }
    else old_cursor_left_click = 0;

    key(0x23, key_data, key_pressed);  /* D: right click; no longer acts as Back in menus */
    if (key_pressed != 0) old_cursor_right_click = 1;
    else old_cursor_right_click = 0;

    return 0;
}

void drawFrontendMenus()
{
    if (app_state == 0) drawStartMenu();
    else if (app_state == 1) drawWorldSelectMenu();
    else if (app_state == 2) drawCreateWorldMenu();
    else if (app_state == 3) { menu_page = 1; drawPauseMenu(); }
    else if (app_state == 4) { menu_page = 2; drawPauseMenu(); }
}

void drawPauseMenu()
{
    clearBuffer((uint)36);
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;

    drawMenuWordTinyCraft(133, 8, 1, (uint)255);

    /* Larger menu panel: the old box wasted screen space and clipped recipe diagrams. */
    fillRect2D(20, 24, 300, 224, (uint)0);
    fillRect2D(24, 28, 296, 220, (uint)73);

    if (menu_page == 0)
    {
        drawUIButton(86, 62, 234, 84, 1, 116);
        drawUIButton(86, 94, 234, 116, 2, 119);
        drawUIButton(86, 126, 234, 148, 9, 131);
    }
    else if (menu_page == 1)
    {
        drawMenuWordSettings(116, 32, 1, (uint)255);

        drawMenuWordCamera(48, 38, 1, (uint)255);
        drawMenuWordSens(94, 38, 1, (uint)255);
