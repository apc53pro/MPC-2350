    resetMining();
    initRuntimeAssetTables();
    selected_slot = 0;
    inventory_open = 0;
    held_id = (uint)0;
    held_count = 0;

    inv_add_i = 0;
    while (inv_add_i < 36)
    {
        inv_id[inv_add_i] = (uint)0;
        inv_count[inv_add_i] = 0;
        inv_add_i = inv_add_i + 1;
    }
    crafting_table_mode = 0;
    craft_slot_i = 0;
    while (craft_slot_i < 9)
    {
        craft_id[craft_slot_i] = (uint)0;
        craft_count[craft_slot_i] = 0;
        craft_slot_i = craft_slot_i + 1;
    }
    craft_output_id = (uint)0;
    craft_output_count = 0;
    drop_active_count = 0;
    drop_i = 0;
    while (drop_i < 64)
    {
        drop_active[drop_i] = 0;
        drop_block[drop_i] = (uint)0;
        drop_count[drop_i] = 0;
        drop_x[drop_i] = 0.0f;
        drop_y[drop_i] = 0.0f;
        drop_z[drop_i] = 0.0f;
        drop_vy[drop_i] = 0.0f;
        drop_vx[drop_i] = 0.0f;
        drop_vz[drop_i] = 0.0f;
        drop_resting[drop_i] = 0;
        drop_ground_base[drop_i] = 0.0f;
        drop_age_ms[drop_i] = (uint)0;
        drop_pickup_delay_ms[drop_i] = (uint)0;
        drop_spin_speed[drop_i] = 1;
        drop_spin_angle[drop_i] = 0.0f;
        drop_spin_rate[drop_i] = 0.00035f;
        drop_i = drop_i + 1;
    }
    updateSelectedBlock();
    old_slot1_key = 0;
    old_slot2_key = 0;
    old_slot3_key = 0;
    old_slot4_key = 0;
    old_slot5_key = 0;
    old_slot6_key = 0;
    old_slot7_key = 0;
    old_slot8_key = 0;
    old_slot9_key = 0;
    old_inventory_key = 0;
    old_menu_key = 0;
    old_stats_key = 0;
    render_stats_enabled = 0;
    menu_open = 0;
    menu_page = 0;
    camera_sensitivity = 1.0f;
    camera_sensitivity_percent = 100;
    cursor_sensitivity = 1.0f;
    cursor_sensitivity_percent = 100;
    day_cycle_speed_percent = 100;
    pending_day_cycle_speed_percent = 100;
    day_last_ms = (uint)0;
    day_elapsed_ms = (uint)0;
    day_tick_units = (uint)0;
    day_time_tick = (uint)0;
    game_tick_accum_ms = (uint)0;
    game_tick_count = (uint)0;
    tick_jump_request = 0;
    tick_jump_started = 0;
    stars_enabled = 1;
    aimed_outline_enabled = 0;
    pending_stars_enabled = 1;
    pending_aimed_outline_enabled = 0;
    player_health = 20;
    player_dead = 0;
    player_hurt_ms = 0.0f;
    player_invuln_ms = 0.0f;
    player_last_damage_taken = 0.0f;
    player_attack_cooldown_ms = 0.0f;
    fall_tracking = 0;
    fall_highest_foot_y = player_foot_y;
    player_y = 5.62f;
    yaw_angle = 0.0f;
    pitch_angle = 0.0f;
    updateViewVectors();
    syncPlayerToGround();
    initPigs();
    initRenderMeshTextureTables();
}

int main()
{
    initCamera();
    initHandCamera();
    initPlayer();
    loadConfigFile();
    refreshWorldList();
    app_state = 0;
    renderStats((uint)0);
    fps_last_ms = millis();
    fps_frame_count = 0;
    fps_value = 0;
    last_ms = fps_last_ms;

    while (1)
    {
        processStatsToggleKey();

        if (app_state == 6)
        {
            drawLoadingScreen();
            present();
            updateFPSCounter();
            processLoadingWorld();
        }
        else if (app_state != 5)
        {
            if (updateFrontendMenus() != 0) return 0;
            drawFrontendMenus();
            present();
            updateFPSCounter();
        }
        else
        {
            if (player_dead != 0)
            {
                updateDeathScreenControls();
                drawDeathScreen();
                present();
                updateFPSCounter();
            }
            else
            {
                processMenuToggleKey();

                if (menu_open != 0)
                {
                    updatePauseMenuControls();
                    drawPauseMenu();
                    present();
                    updateFPSCounter();
                }
                else
                {
                    updatePlayer();
                updateCamera();

                updateDayNightCycle();
                updatePigs();
                clearBuffer(sky_color_current);
                drawSun();
                drawClouds();
                renderWorld();
                drawPigs();
                drawDrops();
                drawBreakingOverlay();
                drawAimedBlockOutline();
                drawHand();
                drawMiningProgress();
                drawHotbar();
                drawHealthHud();
                drawInventoryWindow();
                if (inventory_open == 0) drawCrosshair();
                drawRenderStatsOverlay();
                drawSaveHudIndicators();
                present();
                updateFPSCounter();
                processQueuedRenderRemesh();
                processBackgroundGreedyRemesh();
                processRenderMeshCompaction();
                processBackgroundRenderPrefetch();
                processWorldAutosave();
                }
            }
        }
    }

    return 0;
}
