        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 78, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        return;
    }
    if (b == ITEM_STICK)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 83, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 84, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 73, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 67, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 75, (uint)255);
        return;
    }
    if (b == ITEM_WOODEN_PICKAXE)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 68, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 78, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 32, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 80, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 73, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 67, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 75, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 65, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 88, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        return;
    }
    if (b == ITEM_WOODEN_SWORD)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 68, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 78, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 32, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 83, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 82, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 68, (uint)255);
        return;
    }
    if (b == ITEM_WOODEN_SHOVEL)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 68, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 78, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 32, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 83, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 72, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 86, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 76, (uint)255);
        return;
    }
    if (b == ITEM_WOODEN_AXE)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 68, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 78, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 32, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 65, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 88, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 69, (uint)255);
        return;
    }
    if (b == ITEM_RAW_PORKCHOP)
    {
        text_x = x;
        text_x = text_x + drawSmallCharAt(text_x, y, 82, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 65, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 87, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 32, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 80, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 82, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 75, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 67, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 72, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 79, (uint)255);
        text_x = text_x + drawSmallCharAt(text_x, y, 80, (uint)255);
        return;
    }
}

void drawSlotFrame(int x, int y, int selected, int cursor)
{
    fillRect2D(x, y, x + 20, y + 20, (uint)73);
    drawLine(x, y, x + 20, y, (uint)36);
    drawLine(x, y + 20, x + 20, y + 20, (uint)36);
    drawLine(x, y, x, y + 20, (uint)36);
    drawLine(x + 20, y, x + 20, y + 20, (uint)36);

    if (selected != 0)
    {
        drawLine(x - 1, y - 1, x + 21, y - 1, (uint)255);
        drawLine(x - 1, y + 21, x + 21, y + 21, (uint)255);
        drawLine(x - 1, y - 1, x - 1, y + 21, (uint)255);
        drawLine(x + 21, y - 1, x + 21, y + 21, (uint)255);
    }

    if (cursor != 0)
    {
        drawLine(x - 2, y - 2, x + 22, y - 2, (uint)219);
        drawLine(x - 2, y + 22, x + 22, y + 22, (uint)219);
        drawLine(x - 2, y - 2, x - 2, y + 22, (uint)219);
        drawLine(x + 22, y - 2, x + 22, y + 22, (uint)219);
    }
}

void drawSlotContents(int x, int y, int slot)
{
    if (inv_count[slot] <= 0) return;

    drawIconTexture16(x + 2, y + 2, inv_id[slot]);

    if (inv_count[slot] > 1)
    {
        drawNumberAt(x + 8, y + 13, inv_count[slot], (uint)0);
        drawNumberAt(x + 7, y + 12, inv_count[slot], (uint)255);
    }
}

void drawCraftSlotContents(int x, int y, int slot)
{
    if (craft_count[slot] <= 0) return;
    drawIconTexture16(x + 2, y + 2, craft_id[slot]);
    if (craft_count[slot] > 1)
    {
        drawNumberAt(x + 8, y + 13, craft_count[slot], (uint)0);
        drawNumberAt(x + 7, y + 12, craft_count[slot], (uint)255);
    }
}

void drawHotbar()
{
    hotbar_y = 216;
    hotbar_i = 0;
    while (hotbar_i < 9)
    {
        hotbar_x = 61 + hotbar_i * 22;
        drawSlotFrame(hotbar_x, hotbar_y, hotbar_i == selected_slot, 0);
        drawSlotContents(hotbar_x, hotbar_y, hotbar_i);
        hotbar_i = hotbar_i + 1;
    }
}


void drawUICursor()
{
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;

    /* Half-size pointer compared with v31. */
    drawLine(ui_cursor_ix + 1, ui_cursor_iy + 1, ui_cursor_ix + 1, ui_cursor_iy + 7, (uint)0);
    drawLine(ui_cursor_ix + 1, ui_cursor_iy + 1, ui_cursor_ix + 5, ui_cursor_iy + 5, (uint)0);
    drawLine(ui_cursor_ix + 1, ui_cursor_iy + 7, ui_cursor_ix + 3, ui_cursor_iy + 6, (uint)0);

    drawLine(ui_cursor_ix, ui_cursor_iy, ui_cursor_ix, ui_cursor_iy + 6, (uint)255);
    drawLine(ui_cursor_ix, ui_cursor_iy, ui_cursor_ix + 4, ui_cursor_iy + 4, (uint)255);
    drawLine(ui_cursor_ix, ui_cursor_iy + 6, ui_cursor_ix + 2, ui_cursor_iy + 5, (uint)255);
}


void drawInventoryWindow()
{
    if (inventory_open == 0) return;

    fillRect2D(8, 16, 312, 210, (uint)73);
    fillRect2D(12, 20, 308, 206, (uint)109);

    if (crafting_table_mode != 0)
    {
        craft_size = 3;
        craft_grid_x = 228;
        craft_grid_y = 28;
        craft_out_x = 288;
        craft_out_y = 104;
    }
    else
    {
        craft_size = 2;
        craft_grid_x = 238;
        craft_grid_y = 34;
        craft_out_x = 288;
        craft_out_y = 76;
    }

    ui_inv_x0 = 16;
    ui_inv_y0 = 112;
    ui_hotbar_y = 184;
    ui_slot_step = 22;
    ui_slot_size = 20;

    updateCraftOutput();
    findInventorySlotUnderCursor();

    /* Item name tooltip at the top-left of the inventory. */
    hover_item_id = (uint)0;
    if (inv_actual_slot == 200)
    {
        if (craft_output_count > 0) hover_item_id = craft_output_id;
    }
    else if (inv_actual_slot >= 100)
    {
        craft_slot_i = inv_actual_slot - 100;
        if (craft_count[craft_slot_i] > 0) hover_item_id = craft_id[craft_slot_i];
    }
    else if (inv_actual_slot >= 0)
    {
        if (inv_count[inv_actual_slot] > 0) hover_item_id = inv_id[inv_actual_slot];
    }
    if (hover_item_id != (uint)0)
    {
        fillRect2D(18, 28, 178, 40, (uint)0);
        drawItemNameAt(22, 30, hover_item_id);
    }

    /* Crafting area. */
    craft_slot_i = 0;
    while (craft_slot_i < (craft_size * craft_size))
    {
        craft_slot_col = craft_slot_i % craft_size;
        craft_slot_row = craft_slot_i / craft_size;
        craft_slot_x = craft_grid_x + craft_slot_col * ui_slot_step;
        craft_slot_y = craft_grid_y + craft_slot_row * ui_slot_step;
        drawSlotFrame(craft_slot_x, craft_slot_y, 0, inv_actual_slot == (100 + craft_slot_i));
        drawCraftSlotContents(craft_slot_x, craft_slot_y, craft_slot_i);
        craft_slot_i = craft_slot_i + 1;
    }

    drawLine(craft_out_x - 18, craft_out_y + 10, craft_out_x - 6, craft_out_y + 10, (uint)255);
    drawLine(craft_out_x - 10, craft_out_y + 6, craft_out_x - 6, craft_out_y + 10, (uint)255);
    drawLine(craft_out_x - 10, craft_out_y + 14, craft_out_x - 6, craft_out_y + 10, (uint)255);

    drawSlotFrame(craft_out_x, craft_out_y, 0, inv_actual_slot == 200);
    if (craft_output_count > 0)
    {
        drawIconTexture16(craft_out_x + 2, craft_out_y + 2, craft_output_id);
        if (craft_output_count > 1)
        {
            drawNumberAt(craft_out_x + 8, craft_out_y + 13, craft_output_count, (uint)0);
            drawNumberAt(craft_out_x + 7, craft_out_y + 12, craft_output_count, (uint)255);
        }
    }

    inv_draw_i = 0;
    while (inv_draw_i < 36)
    {
        inv_draw_col = inv_draw_i % 9;
        inv_draw_row = inv_draw_i / 9;

        if (inv_draw_i < 27)
        {
            inv_draw_slot = inv_draw_i + 9;
            hotbar_x = ui_inv_x0 + inv_draw_col * ui_slot_step;
            hotbar_y = ui_inv_y0 + inv_draw_row * ui_slot_step;
        }
        else
        {
            inv_draw_slot = inv_draw_i - 27;
            hotbar_x = ui_inv_x0 + inv_draw_col * ui_slot_step;
            hotbar_y = ui_hotbar_y;
        }

        drawSlotFrame(hotbar_x, hotbar_y, inv_draw_slot == selected_slot, inv_actual_slot == inv_draw_slot);
        drawSlotContents(hotbar_x, hotbar_y, inv_draw_slot);
        inv_draw_i = inv_draw_i + 1;
    }

    if (held_count > 0)
    {
        ui_cursor_ix = (int)ui_cursor_x;
        ui_cursor_iy = (int)ui_cursor_y;
        drawIconTexture16(ui_cursor_ix + 8, ui_cursor_iy + 8, held_id);
        if (held_count > 1)
        {
            drawNumberAt(ui_cursor_ix + 16, ui_cursor_iy + 22, held_count, (uint)0);
            drawNumberAt(ui_cursor_ix + 15, ui_cursor_iy + 21, held_count, (uint)255);
        }
    }

    drawUICursor();
}

void drawMiningProgress()
{
    if (mining_active == 0) return;
    if (mining_required_ms == (uint)0) return;

    mine_bar_w = (int)((mining_progress_ms * (uint)36) / mining_required_ms);
    if (mine_bar_w > 36) mine_bar_w = 36;
    if (mine_bar_w < 0) mine_bar_w = 0;

    drawLine(142, 134, 178, 134, (uint)0);
    drawLine(142, 135, 178, 135, (uint)0);
    drawLine(142, 134, 142 + mine_bar_w, 134, (uint)255);
    drawLine(142, 135, 142 + mine_bar_w, 135, (uint)255);
}


/* ------------------------------------------------------------------------- */
/* Pause/settings/recipes menu                                               */
/* ------------------------------------------------------------------------- */

void drawFontH(int x, int y, int s, int px, int py, int w, uint color)
{
    fillRect2D(x + px * s, y + py * s, x + (px + w) * s - 1, y + (py + 1) * s - 1, color);
}

void drawFontV(int x, int y, int s, int px, int py, int h, uint color)
{
    fillRect2D(x + px * s, y + py * s, x + (px + 1) * s - 1, y + (py + h) * s - 1, color);
}

void drawMenuGlyph(int x, int y, int s, int ch, uint color)
{
    if (s == 1)
    {
        drawSmallGlyph(x, y, ch, color);
        return;
    }

    /* Simple 5x7 block/vector font. Only the letters used by the menu are
       implemented, keeping code size lower than a full font table. */
    if (ch == 84)       /* T */
    {
        drawFontH(x, y, s, 0, 0, 5, color);
        drawFontV(x, y, s, 2, 0, 7, color);
    }
    else if (ch == 73)  /* I */
    {
        drawFontH(x, y, s, 0, 0, 5, color);
        drawFontV(x, y, s, 2, 0, 7, color);
        drawFontH(x, y, s, 0, 6, 5, color);
    }
    else if (ch == 78)  /* N */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontV(x, y, s, 4, 0, 7, color);
        drawLine(x + 1 * s, y + 1 * s, x + 3 * s, y + 5 * s, color);
    }
    else if (ch == 89)  /* Y */
    {
        drawLine(x, y, x + 2 * s, y + 3 * s, color);
        drawLine(x + 4 * s, y, x + 2 * s, y + 3 * s, color);
        drawFontV(x, y, s, 2, 3, 4, color);
    }
    else if (ch == 67)  /* C */
    {
        drawFontH(x, y, s, 1, 0, 4, color);
        drawFontV(x, y, s, 0, 1, 5, color);
        drawFontH(x, y, s, 1, 6, 4, color);
    }
    else if (ch == 82)  /* R */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontH(x, y, s, 1, 0, 3, color);
        drawFontV(x, y, s, 4, 1, 2, color);
        drawFontH(x, y, s, 1, 3, 3, color);
        drawLine(x + 2 * s, y + 4 * s, x + 4 * s, y + 6 * s, color);
    }
    else if (ch == 65)  /* A */
    {
        drawFontH(x, y, s, 1, 0, 3, color);
        drawFontV(x, y, s, 0, 1, 6, color);
        drawFontV(x, y, s, 4, 1, 6, color);
        drawFontH(x, y, s, 1, 3, 3, color);
    }
    else if (ch == 70)  /* F */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontH(x, y, s, 1, 0, 4, color);
        drawFontH(x, y, s, 1, 3, 3, color);
    }
    else if (ch == 83)  /* S */
    {
        drawFontH(x, y, s, 1, 0, 4, color);
        drawFontV(x, y, s, 0, 1, 2, color);
        drawFontH(x, y, s, 1, 3, 3, color);
        drawFontV(x, y, s, 4, 4, 2, color);
        drawFontH(x, y, s, 0, 6, 4, color);
    }
    else if (ch == 69)  /* E */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontH(x, y, s, 1, 0, 4, color);
        drawFontH(x, y, s, 1, 3, 3, color);
        drawFontH(x, y, s, 1, 6, 4, color);
    }
    else if (ch == 71)  /* G */
    {
        drawFontH(x, y, s, 1, 0, 4, color);
        drawFontV(x, y, s, 0, 1, 5, color);
        drawFontH(x, y, s, 1, 6, 4, color);
        drawFontH(x, y, s, 2, 3, 3, color);
        drawFontV(x, y, s, 4, 3, 3, color);
    }
    else if (ch == 80)  /* P */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontH(x, y, s, 1, 0, 3, color);
        drawFontV(x, y, s, 4, 1, 2, color);
        drawFontH(x, y, s, 1, 3, 3, color);
    }
    else if (ch == 77)  /* M */
    {
        drawFontV(x, y, s, 0, 0, 7, color);
        drawFontV(x, y, s, 4, 0, 7, color);
        drawLine(x + 1 * s, y, x + 2 * s, y + 3 * s, color);
        drawLine(x + 3 * s, y, x + 2 * s, y + 3 * s, color);
    }
    else if (ch == 85)  /* U */
    {
        drawFontV(x, y, s, 0, 0, 6, color);
        drawFontV(x, y, s, 4, 0, 6, color);
        drawFontH(x, y, s, 1, 6, 3, color);
    }
    else if (ch == 79)  /* O */
    {
        drawFontH(x, y, s, 1, 0, 3, color);
        drawFontV(x, y, s, 0, 1, 5, color);
        drawFontV(x, y, s, 4, 1, 5, color);
        drawFontH(x, y, s, 1, 6, 3, color);
    }
}

void drawMenuWordTinyCraft(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 84, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 73, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 78, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 89, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 67, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 82, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 65, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 70, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 84, color);
}

void writeTinycraftLogoTexPixel(int x, int y, uint color)
{
    logo_tex_addr = y * 75 + (x >> 2);
    logo_tex_shift = (x & 3) << 3;
    logo_tex_mask = (uint)255 << logo_tex_shift;
    logo_tex_word = tinycraft_logo_tex[logo_tex_addr];
    logo_tex_word = (logo_tex_word & ~logo_tex_mask) | ((color & (uint)255) << logo_tex_shift);
    tinycraft_logo_tex[logo_tex_addr] = logo_tex_word;
}

void initTinycraftLogoTexture()
{
    logo_tex_i = 0;
    while (logo_tex_i < 3750)
    {
        tinycraft_logo_tex[logo_tex_i] = (uint)606348324; /* 0x24242424, menu background */
        logo_tex_i = logo_tex_i + 1;
    }

    logo_i = 0;
    while (logo_i < 2151)
    {
        logo_run = tinycraft_logo_rle[logo_i];
        logo_y = (int)(logo_run >> 26);
        logo_x = (int)((logo_run >> 17) & (uint)511);
        logo_len = (int)((logo_run >> 8) & (uint)511);
        logo_color = logo_run & (uint)255;

        logo_tex_x = 0;
        while (logo_tex_x < logo_len)
        {
            writeTinycraftLogoTexPixel(logo_x + logo_tex_x, logo_y, logo_color);
            logo_tex_x = logo_tex_x + 1;
        }
        logo_i = logo_i + 1;
    }

    logo_tex_ready = 1;
}

void drawTinycraftLogo()
{
    if (logo_tex_ready == 0) initTinycraftLogoTexture();
    fillRect2DTex(10, 8, 299, 50, &tinycraft_logo_tex[0]);
}

void drawMenuWordSettings(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 83, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 69, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 84, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 84, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 73, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 78, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 71, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 83, color);
}

void drawMenuWordRecipes(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 82, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 69, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 67, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 73, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 80, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 69, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 83, color);
}

void drawMenuWordCamera(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 67, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 65, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 77, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 69, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 82, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 65, color);
}


void drawMenuWordCursor(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 67, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 85, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 82, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 83, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 79, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 82, color);
}

void drawMenuWordSens(int x, int y, int s, uint color)
{
    drawMenuGlyph(x, y, s, 83, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 69, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 78, color); x = x + 6 * s;
    drawMenuGlyph(x, y, s, 83, color);
}

void drawMiniRecipeCell(int x, int y, uint b)
{
    fillRect2D(x, y, x + 8, y + 8, (uint)37);
    drawLine(x, y, x + 8, y, (uint)109);
    drawLine(x, y + 8, x + 8, y + 8, (uint)0);
    drawLine(x, y, x, y + 8, (uint)109);
    drawLine(x + 8, y, x + 8, y + 8, (uint)0);
    if (b != (uint)0)
    {
        fillRect2D(x + 2, y + 2, x + 6, y + 6, blockUIColor(b));
    }
}

void drawMiniRecipeGrid3x3(int x, int y, uint a, uint b, uint c, uint d, uint e, uint f, uint g, uint h, uint i)
{
    drawMiniRecipeCell(x, y, a);
    drawMiniRecipeCell(x + 10, y, b);
    drawMiniRecipeCell(x + 20, y, c);
    drawMiniRecipeCell(x, y + 10, d);
    drawMiniRecipeCell(x + 10, y + 10, e);
    drawMiniRecipeCell(x + 20, y + 10, f);
    drawMiniRecipeCell(x, y + 20, g);
    drawMiniRecipeCell(x + 10, y + 20, h);
    drawMiniRecipeCell(x + 20, y + 20, i);
}

void drawMiniRecipe(int x, int y, uint a, uint b, uint c, uint d, uint e, uint f, uint g, uint h, uint i, uint out_id, int out_count)
{
    drawMiniRecipeGrid3x3(x, y, a, b, c, d, e, f, g, h, i);
    drawLine(x + 34, y + 15, x + 44, y + 15, (uint)255);
    drawLine(x + 40, y + 11, x + 44, y + 15, (uint)255);
    drawLine(x + 40, y + 19, x + 44, y + 15, (uint)255);
    drawSlotFrame(x + 48, y + 5, 0, 0);
    drawIconTexture16(x + 50, y + 7, out_id);
    if (out_count > 1)
    {
        drawNumberAt(x + 62, y + 19, out_count, (uint)0);
        drawNumberAt(x + 61, y + 18, out_count, (uint)255);
    }
}

void drawStartMenu()
{
    clearBuffer((uint)36);
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;
    drawTinycraftLogo();
    drawUIButton(86, 76, 234, 98, 0, 148);
    drawUIButton(86, 108, 234, 130, 1, 116);
    drawUIButton(86, 140, 234, 162, 2, 119);
    drawUIButton(86, 172, 234, 194, 3, 148);
    drawUICursor();
}

void drawWorldSelectMenu()
{
    clearBuffer((uint)36);
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;
    drawLabelText(142, 18, 4, (uint)255);

    fillRect2D(24, 36, 296, 168, (uint)73);
    if (world_list_count <= 0)
    {
        drawLabelText(112, 88, 11, (uint)255);
        drawLabelText(136, 88, 4, (uint)255);
    }
    world_tmp_i = 0;
    while (world_tmp_i < world_list_count)
    {
        world_tmp_j = 44 + world_tmp_i * 12;
        menu_color = (uint)0;
        if (world_tmp_i == world_selected) menu_color = (uint)109;
        if (cursorInRect(36, world_tmp_j - 2, 284, world_tmp_j + 10) != 0) menu_color = (uint)146;
        fillRect2D(36, world_tmp_j - 2, 284, world_tmp_j + 10, menu_color);
        drawStoredWorldName(world_tmp_i, 44, world_tmp_j, (uint)255);
        world_tmp_i = world_tmp_i + 1;
    }

    drawUIButton(28, 184, 82, 206, 7, 43);
    drawUIButton(92, 184, 146, 206, 11, 110);
    drawUIButton(156, 184, 210, 206, 8, 171);
    drawUIButton(220, 184, 292, 206, 6, 238);
    drawUICursor();
}

void drawCreateWorldMenu()
{
    clearBuffer((uint)36);
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;
    drawTinycraftLogo();
    drawLabelText(104, 80, 10, (uint)255);
    fillRect2D(104, 94, 216, 110, (uint)0);
    if ((cursorInRect(104, 94, 216, 110) != 0) || (world_name_editing != 0))
    {
        drawLine(104, 94, 216, 94, (uint)255);
        drawLine(104, 110, 216, 110, (uint)255);
    }
    drawNameBuffer(&new_world_name[0], 16, 110, 99, (uint)255);
    if (world_name_editing != 0) drawLine(110 + new_world_name_len * 6, 98, 110 + new_world_name_len * 6, 106, (uint)219);
    drawUIButton(76, 148, 152, 170, 7, 102);
    drawUIButton(168, 148, 244, 170, 5, 188);
    if (world_name_editing == 0) drawUICursor();
}

void drawLoadingWord(int x, int y, uint color)
{
    x = x + drawSmallCharAt(x, y, 76, color);
    x = x + drawSmallCharAt(x, y, 79, color);
    x = x + drawSmallCharAt(x, y, 65, color);
    x = x + drawSmallCharAt(x, y, 68, color);
    x = x + drawSmallCharAt(x, y, 73, color);
    x = x + drawSmallCharAt(x, y, 78, color);
    drawSmallCharAt(x, y, 71, color);
}

void drawLoadingScreen()
{
    /* v53: keep the loading frame cheap. Redrawing the full RLE logo every
       loading frame wasted CPU while the VM was already building terrain. */
    clearBuffer((uint)36);
    fillRect2D(64, 110, 256, 150, (uint)0);
    fillRect2D(68, 114, 252, 146, (uint)73);
    drawLoadingWord(112, 122, (uint)255);
    drawLabelText(160, 122, 4, (uint)255);

    if (loading_total <= 0) loading_total = 1;
    loading_bar_w = (loading_progress * 180) / loading_total;
    if (loading_bar_w < 0) loading_bar_w = 0;
    if (loading_bar_w > 180) loading_bar_w = 180;
    fillRect2D(70, 136, 250, 142, (uint)0);
    if (loading_bar_w > 0) fillRect2D(70, 136, 70 + loading_bar_w, 142, (uint)219);
}

