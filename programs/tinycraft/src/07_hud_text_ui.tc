void drawDigit(int x, int y, int d, uint color)
{
    if ((d >= 0) && (d <= 9))
    {
        font_offset = (d + 48) * 2;
        putFont(x, y, 6, 8, &ui_font6x8[font_offset], color);
        return;
    }

    /* Legacy vector fallback for invalid digit values. */
    if (d == 0)
    {
        drawLine(x + 1, y, x + 3, y, color);
        drawLine(x, y + 1, x, y + 5, color);
        drawLine(x + 4, y + 1, x + 4, y + 5, color);
        drawLine(x + 1, y + 6, x + 3, y + 6, color);
    }
    else if (d == 1)
    {
        drawLine(x + 2, y, x + 2, y + 6, color);
        drawLine(x + 1, y + 1, x + 2, y, color);
        drawLine(x + 1, y + 6, x + 3, y + 6, color);
    }
    else if (d == 2)
    {
        drawLine(x + 1, y, x + 3, y, color);
        drawLine(x + 4, y + 1, x + 4, y + 2, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x, y + 4, x, y + 5, color);
        drawLine(x, y + 6, x + 4, y + 6, color);
    }
    else if (d == 3)
    {
        drawLine(x + 1, y, x + 3, y, color);
        drawLine(x + 4, y + 1, x + 4, y + 5, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x + 1, y + 6, x + 3, y + 6, color);
    }
    else if (d == 4)
    {
        drawLine(x, y, x, y + 3, color);
        drawLine(x + 4, y, x + 4, y + 6, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
    }
    else if (d == 5)
    {
        drawLine(x, y, x + 4, y, color);
        drawLine(x, y + 1, x, y + 2, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x + 4, y + 4, x + 4, y + 5, color);
        drawLine(x, y + 6, x + 3, y + 6, color);
    }
    else if (d == 6)
    {
        drawLine(x + 1, y, x + 4, y, color);
        drawLine(x, y + 1, x, y + 5, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x + 4, y + 4, x + 4, y + 5, color);
        drawLine(x + 1, y + 6, x + 3, y + 6, color);
    }
    else if (d == 7)
    {
        drawLine(x, y, x + 4, y, color);
        drawLine(x + 4, y + 1, x + 2, y + 6, color);
    }
    else if (d == 8)
    {
        drawLine(x + 1, y, x + 3, y, color);
        drawLine(x, y + 1, x, y + 5, color);
        drawLine(x + 4, y + 1, x + 4, y + 5, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x + 1, y + 6, x + 3, y + 6, color);
    }
    else if (d == 9)
    {
        drawLine(x + 1, y, x + 3, y, color);
        drawLine(x, y + 1, x, y + 2, color);
        drawLine(x + 4, y + 1, x + 4, y + 5, color);
        drawLine(x + 1, y + 3, x + 3, y + 3, color);
        drawLine(x, y + 6, x + 3, y + 6, color);
    }
}

void drawNumberAt(int x, int y, int n, uint color)
{
    if (n <= 0) return;
    if (n > 999) n = 999;

    number_x = x;
    number_value = n;
    number_digits_started = 0;

    digit_value = number_value / 100;
    if (digit_value > 0)
    {
        number_x = number_x + drawSmallCharAt(number_x, y, digit_value + 48, color);
        number_digits_started = 1;
    }

    number_value = number_value % 100;
    digit_value = number_value / 10;
    if ((digit_value > 0) || (number_digits_started != 0))
    {
        number_x = number_x + drawSmallCharAt(number_x, y, digit_value + 48, color);
    }

    digit_value = number_value % 10;
    drawSmallCharAt(number_x, y, digit_value + 48, color);
}

void drawUIntAt(int x, int y, uint n, uint color)
{
    if (n > (uint)999999) n = (uint)999999;

    number_x = x;
    number_u_value = n;
    number_u_div = (uint)100000;
    number_digits_started = 0;

    while (number_u_div > (uint)0)
    {
        number_u_digit = number_u_value / number_u_div;
        if ((number_u_digit > (uint)0) || (number_digits_started != 0) || (number_u_div == (uint)1))
        {
            number_x = number_x + drawSmallCharAt(number_x, y, (int)number_u_digit + 48, color);
            number_digits_started = 1;
        }
        number_u_value = number_u_value - (number_u_digit * number_u_div);
        number_u_div = number_u_div / (uint)10;
    }
}

void updateFPSCounter()
{
    fps_now = millis();
    if (fps_last_ms == (uint)0)
    {
        fps_last_ms = fps_now;
        fps_frame_count = 0;
        fps_value = 0;
        return;
    }

    fps_frame_count = fps_frame_count + 1;
    fps_elapsed = fps_now - fps_last_ms;
    if (fps_elapsed >= (uint)1000)
    {
        fps_value = (int)(((uint)fps_frame_count * (uint)1000) / fps_elapsed);
        fps_frame_count = 0;
        fps_last_ms = fps_now;
    }
}


int drawSmallGlyph(int x, int y, int ch, uint color)
{
    if ((ch >= 0) && (ch <= 255))
    {
        font_offset = ch * 2;
        font_left = ui_font_left[ch];
        font_advance = ui_font_advance[ch];
        if (font_advance > 0) putFont(x - font_left, y, 6, 8, &ui_font6x8[font_offset], color);
        return font_advance;
    }

    /* Legacy vector fallback for non-ASCII values. */
    if (ch == 65) { drawLine(x+1,y,x+3,y,color); drawLine(x,y+1,x,y+6,color); drawLine(x+4,y+1,x+4,y+6,color); drawLine(x+1,y+3,x+3,y+3,color); }
    else if (ch == 66) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+3,y,color); drawLine(x+1,y+3,x+3,y+3,color); drawLine(x+1,y+6,x+3,y+6,color); drawLine(x+4,y+1,x+4,y+2,color); drawLine(x+4,y+4,x+4,y+5,color); }
    else if (ch == 67) { drawLine(x+1,y,x+4,y,color); drawLine(x,y+1,x,y+5,color); drawLine(x+1,y+6,x+4,y+6,color); }
    else if (ch == 68) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+3,y,color); drawLine(x+4,y+1,x+4,y+5,color); drawLine(x+1,y+6,x+3,y+6,color); }
    else if (ch == 69) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+4,y,color); drawLine(x+1,y+3,x+3,y+3,color); drawLine(x+1,y+6,x+4,y+6,color); }
    else if (ch == 70) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+4,y,color); drawLine(x+1,y+3,x+3,y+3,color); }
    else if (ch == 71) { drawLine(x+1,y,x+4,y,color); drawLine(x,y+1,x,y+5,color); drawLine(x+1,y+6,x+4,y+6,color); drawLine(x+2,y+3,x+4,y+3,color); drawLine(x+4,y+3,x+4,y+5,color); }
    else if (ch == 72) { drawLine(x,y,x,y+6,color); drawLine(x+4,y,x+4,y+6,color); drawLine(x+1,y+3,x+3,y+3,color); }
    else if (ch == 73) { drawLine(x,y,x+4,y,color); drawLine(x+2,y,x+2,y+6,color); drawLine(x,y+6,x+4,y+6,color); }
    else if (ch == 75) { drawLine(x,y,x,y+6,color); drawLine(x+4,y,x+1,y+3,color); drawLine(x+1,y+3,x+4,y+6,color); }
    else if (ch == 76) { drawLine(x,y,x,y+6,color); drawLine(x+1,y+6,x+4,y+6,color); }
    else if (ch == 77) { drawLine(x,y,x,y+6,color); drawLine(x+4,y,x+4,y+6,color); drawLine(x+1,y+1,x+2,y+3,color); drawLine(x+3,y+1,x+2,y+3,color); }
    else if (ch == 78) { drawLine(x,y,x,y+6,color); drawLine(x+4,y,x+4,y+6,color); drawLine(x+1,y+1,x+3,y+5,color); }
    else if (ch == 79) { drawLine(x+1,y,x+3,y,color); drawLine(x,y+1,x,y+5,color); drawLine(x+4,y+1,x+4,y+5,color); drawLine(x+1,y+6,x+3,y+6,color); }
    else if (ch == 80) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+3,y,color); drawLine(x+4,y+1,x+4,y+2,color); drawLine(x+1,y+3,x+3,y+3,color); }
    else if (ch == 81) { drawLine(x+1,y,x+3,y,color); drawLine(x,y+1,x,y+5,color); drawLine(x+4,y+1,x+4,y+5,color); drawLine(x+1,y+6,x+3,y+6,color); drawLine(x+3,y+5,x+4,y+6,color); }
    else if (ch == 82) { drawLine(x,y,x,y+6,color); drawLine(x+1,y,x+3,y,color); drawLine(x+4,y+1,x+4,y+2,color); drawLine(x+1,y+3,x+3,y+3,color); drawLine(x+2,y+4,x+4,y+6,color); }
    else if (ch == 83) { drawLine(x+1,y,x+4,y,color); drawLine(x,y+1,x,y+2,color); drawLine(x+1,y+3,x+3,y+3,color); drawLine(x+4,y+4,x+4,y+5,color); drawLine(x,y+6,x+3,y+6,color); }
    else if (ch == 84) { drawLine(x,y,x+4,y,color); drawLine(x+2,y,x+2,y+6,color); }
    else if (ch == 85) { drawLine(x,y,x,y+5,color); drawLine(x+4,y,x+4,y+5,color); drawLine(x+1,y+6,x+3,y+6,color); }
    else if (ch == 86) { drawLine(x,y,x,y+4,color); drawLine(x+4,y,x+4,y+4,color); drawLine(x+1,y+5,x+2,y+6,color); drawLine(x+3,y+5,x+2,y+6,color); }
    else if (ch == 87) { drawLine(x,y,x,y+6,color); drawLine(x+4,y,x+4,y+6,color); drawLine(x+2,y+4,x+2,y+6,color); }
    else if (ch == 88) { drawLine(x,y,x+4,y+6,color); drawLine(x+4,y,x,y+6,color); }
    else if (ch == 89) { drawLine(x,y,x+2,y+3,color); drawLine(x+4,y,x+2,y+3,color); drawLine(x+2,y+3,x+2,y+6,color); }
    else if (ch == 90) { drawLine(x,y,x+4,y,color); drawLine(x+4,y,x,y+6,color); drawLine(x,y+6,x+4,y+6,color); }
    return 6;
}


void drawHeartIcon(int x, int y, int half_state)
{
    drawLine(x + 1, y, x + 2, y, (uint)0);
    drawLine(x + 5, y, x + 6, y, (uint)0);
    drawLine(x, y + 1, x + 7, y + 1, (uint)0);
    drawLine(x, y + 2, x + 7, y + 2, (uint)0);
    drawLine(x + 1, y + 3, x + 6, y + 3, (uint)0);
    drawLine(x + 2, y + 4, x + 5, y + 4, (uint)0);
    drawLine(x + 3, y + 5, x + 4, y + 5, (uint)0);

    if (half_state >= 1)
    {
        fillRect2D(x + 1, y + 1, x + 3, y + 3, (uint)224);
        drawLine(x + 3, y + 4, x + 3, y + 5, (uint)224);
    }
    if (half_state >= 2)
    {
        fillRect2D(x + 4, y + 1, x + 6, y + 3, (uint)224);
        drawLine(x + 4, y + 4, x + 4, y + 5, (uint)224);
    }
}

void drawHealthHud()
{
    heart_i = 0;
    while (heart_i < 10)
    {
        heart_half = heart_i * 2;
        heart_x = 61 + heart_i * 10;
        heart_y = 204;
        heart_state = 0;
        if (player_health > heart_half) heart_state = 1;
        if (player_health > (heart_half + 1)) heart_state = 2;
        drawHeartIcon(heart_x, heart_y, heart_state);
        heart_i = heart_i + 1;
    }
}

void drawDeathTitle(int x, int y, uint color)
{
    x = x + drawSmallGlyph(x, y, 89, color);
    x = x + drawSmallGlyph(x, y, 79, color);
    x = x + drawSmallGlyph(x, y, 85, color); x = x + drawSmallCharAt(x, y, 32, color);
    x = x + drawSmallGlyph(x, y, 68, color);
    x = x + drawSmallGlyph(x, y, 73, color);
    x = x + drawSmallGlyph(x, y, 69, color);
    drawSmallGlyph(x, y, 68, color);
}

void drawRespawnWord(int x, int y, uint color)
{
    x = x + drawSmallGlyph(x, y, 82, color);
    x = x + drawSmallGlyph(x, y, 69, color);
    x = x + drawSmallGlyph(x, y, 83, color);
    x = x + drawSmallGlyph(x, y, 80, color);
    x = x + drawSmallGlyph(x, y, 65, color);
    x = x + drawSmallGlyph(x, y, 87, color);
    drawSmallGlyph(x, y, 78, color);
}

void drawDeathButton(int x0, int y0, int x1, int y1, int kind)
{
    menu_color = (uint)73;
    if (cursorInRect(x0, y0, x1, y1) != 0) menu_color = (uint)109;
    fillRect2D(x0, y0, x1, y1, menu_color);
    drawLine(x0, y0, x1, y0, (uint)255);
    drawLine(x0, y1, x1, y1, (uint)37);
    if (kind == 0) drawRespawnWord(x0 + 36, y0 + 8, (uint)255);
    else drawLabelText(x0 + 32, y0 + 8, 9, (uint)255);
}

void drawDeathScreen()
{
    clearBuffer((uint)0);
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;
    fillRect2D(44, 42, 276, 196, (uint)36);
    fillRect2D(48, 46, 272, 192, (uint)73);
    drawDeathTitle(136, 70, (uint)224);
    drawDeathButton(92, 112, 228, 136, 0);
    drawDeathButton(92, 150, 228, 174, 1);
    drawUICursor();
}

void updateDeathScreenControls()
{
    up_now = millis();
    if (last_ms == (uint)0) last_ms = up_now;
    up_dt = up_now - last_ms;
    last_ms = up_now;
    if (up_dt > (uint)50) up_dt = (uint)50;
    up_dtf = (float)up_dt;
    ui_cursor_speed = up_dtf * 0.22f * cursor_sensitivity;

    key(0x43, key_data, key_pressed);
    if (key_pressed != 0) ui_cursor_y = ui_cursor_y - ui_cursor_speed;
    key(0x42, key_data, key_pressed);
    if (key_pressed != 0) ui_cursor_y = ui_cursor_y + ui_cursor_speed;
    key(0x3B, key_data, key_pressed);
    if (key_pressed != 0) ui_cursor_x = ui_cursor_x - ui_cursor_speed;
    key(0x4B, key_data, key_pressed);
    if (key_pressed != 0) ui_cursor_x = ui_cursor_x + ui_cursor_speed;
    if (ui_cursor_x < 0.0f) ui_cursor_x = 0.0f;
    if (ui_cursor_x > 319.0f) ui_cursor_x = 319.0f;
    if (ui_cursor_y < 0.0f) ui_cursor_y = 0.0f;
    if (ui_cursor_y > 239.0f) ui_cursor_y = 239.0f;
    ui_cursor_ix = (int)ui_cursor_x;
    ui_cursor_iy = (int)ui_cursor_y;

    key(0x1C, key_data, key_pressed);
    if (key_pressed != 0)
    {
        if (old_death_click == 0)
        {
            if (cursorInRect(92, 112, 228, 136) != 0)
            {
                respawnPlayerAtWorldSpawn();
            }
            else if (cursorInRect(92, 150, 228, 174) != 0)
            {
                saveCurrentWorld();
                player_dead = 0;
                menu_open = 0;
                inventory_open = 0;
                crafting_table_mode = 0;
                app_state = 0;
                ui_cursor_x = 160.0f;
                ui_cursor_y = 87.0f;
                refreshWorldList();
                last_ms = millis();
            }
        }
        old_death_click = 1;
    }
    else old_death_click = 0;
}

void drawFPSOverlay()
{
    fillRect2D(2, 2, 58, 17, (uint)0);
    drawSmallGlyph(6, 6, 70, (uint)255);
    drawSmallGlyph(12, 6, 80, (uint)255);
    drawSmallGlyph(18, 6, 83, (uint)255);
    drawUIntAt(36, 6, (uint)fps_value, (uint)255);
}

void drawIntAt(int x, int y, int n, uint color)
{
    if (n < 0)
    {
        drawLine(x, y + 3, x + 4, y + 3, color);
        drawUIntAt(x + 6, y, (uint)(0 - n), color);
        return;
    }
    drawUIntAt(x, y, (uint)n, color);
}

void drawCoordinateOverlay()
{
    debug_coord_x = world_origin_x + floorFloatToInt(player_x);
    debug_coord_y = floorFloatToInt(player_foot_y);
    debug_coord_z = world_origin_z + floorFloatToInt(player_z);

    clouds_now = millis();
    if ((debug_light_cache_valid == 0) || (debug_coord_x != debug_light_cache_x) || (debug_coord_y != debug_light_cache_y) || (debug_coord_z != debug_light_cache_z) || ((clouds_now - debug_light_last_ms) > (uint)250))
    {
        debug_light_raw_sky = rawSkyLightAtAbs(debug_coord_x, debug_coord_y, debug_coord_z);
        debug_light_block = blockLightAtAbs(debug_coord_x, debug_coord_y, debug_coord_z);
        debug_light_cache_x = debug_coord_x;
        debug_light_cache_y = debug_coord_y;
        debug_light_cache_z = debug_coord_z;
        debug_light_last_ms = clouds_now;
        debug_light_cache_valid = 1;
    }

    debug_light_darkening = skyDarkeningValueForTime();
    debug_light_sky = debug_light_raw_sky - debug_light_darkening;
    if (debug_light_sky < 0) debug_light_sky = 0;
    debug_light_total = debug_light_sky;
    if (debug_light_block > debug_light_total) debug_light_total = debug_light_block;

    fillRect2D(2, 2, 126, 78, (uint)0);

    drawSmallGlyph(6, 6, 70, (uint)255);
    drawSmallGlyph(12, 6, 80, (uint)255);
    drawSmallGlyph(18, 6, 83, (uint)255);
    drawUIntAt(36, 6, (uint)fps_value, (uint)255);

    drawSmallGlyph(6, 17, 88, (uint)255);
    drawIntAt(18, 17, debug_coord_x, (uint)255);

    drawSmallGlyph(6, 27, 89, (uint)255);
    drawIntAt(18, 27, debug_coord_y, (uint)255);

    drawSmallGlyph(6, 37, 90, (uint)255);
    drawIntAt(18, 37, debug_coord_z, (uint)255);

    drawSmallGlyph(6, 48, 76, (uint)255);     /* L = max(effective sky, block) */
    drawIntAt(18, 48, debug_light_total, (uint)255);

    drawSmallGlyph(6, 58, 83, (uint)255);     /* S = effective sky */
    drawIntAt(18, 58, debug_light_sky, (uint)255);
    drawSmallGlyph(54, 58, 66, (uint)255);    /* B = block light */
    drawIntAt(66, 58, debug_light_block, (uint)255);

    drawSmallGlyph(6, 68, 68, (uint)255);     /* D = night darkening filter */
    drawIntAt(18, 68, debug_light_darkening, (uint)255);
    drawSmallGlyph(54, 68, 82, (uint)255);    /* R = raw/technical sky */
    drawIntAt(66, 68, debug_light_raw_sky, (uint)255);
}

void drawStreamingStatsOverlay()
{
    fillRect2D(2, 2, 112, 86, (uint)0);

    drawSmallGlyph(6, 6, 77, (uint)255);       /* M: visible missing */
    drawUIntAt(24, 6, (uint)render_visible_missing_count, (uint)255);
    drawSmallGlyph(58, 6, 86, (uint)255);      /* V: visible required */
    drawUIntAt(76, 6, (uint)render_visible_required_count, (uint)255);

    drawSmallGlyph(6, 15, 81, (uint)255);      /* Q: dirty queue */
    drawUIntAt(24, 15, (uint)render_dirty_chunk_count, (uint)255);
    drawSmallGlyph(58, 15, 66, (uint)255);     /* B: completed builds */
    drawUIntAt(76, 15, (uint)render_stream_build_count, (uint)255);

    drawSmallGlyph(6, 24, 85, (uint)255);      /* U: mesh slots used */
    drawUIntAt(24, 24, (uint)render_mesh_count, (uint)255);
    drawSmallGlyph(58, 24, 68, (uint)255);     /* D: dead slots */
    drawUIntAt(76, 24, (uint)render_dead_mesh_count, (uint)255);

    drawSmallGlyph(6, 33, 65, (uint)255);      /* A: allocation failures */
    drawUIntAt(24, 33, (uint)render_mesh_allocation_failures, (uint)255);
    drawSmallGlyph(58, 33, 73, (uint)255);     /* I: incomplete builds */
    drawUIntAt(76, 33, (uint)render_mesh_incomplete_builds, (uint)255);

    drawSmallGlyph(6, 42, 84, (uint)255);      /* T: last build milliseconds */
    drawUIntAt(24, 42, (uint)render_stream_last_build_duration_ms, (uint)255);
    drawSmallGlyph(58, 42, 70, (uint)255);     /* F: forced low-FPS builds */
    drawUIntAt(76, 42, (uint)render_stream_forced_build_count, (uint)255);

    drawSmallGlyph(6, 51, 82, (uint)255);      /* R: full resets */
    drawUIntAt(24, 51, (uint)render_cache_reset_count, (uint)255);
    drawSmallGlyph(58, 51, 83, (uint)255);     /* S: rolling shifts */
    drawUIntAt(76, 51, (uint)render_cache_shift_count, (uint)255);

    drawSmallGlyph(6, 60, 80, (uint)255);      /* P: preserved sections */
    drawUIntAt(24, 60, (uint)render_shift_preserved_sections, (uint)255);
    drawSmallGlyph(58, 60, 72, (uint)255);     /* H: column-cache hits */
    drawUIntAt(76, 60, (uint)render_column_cache_hits, (uint)255);

    drawSmallGlyph(6, 69, 67, (uint)255);      /* C: column-cache misses */
    drawUIntAt(24, 69, (uint)render_column_cache_misses, (uint)255);
    drawSmallGlyph(58, 69, 70, (uint)255);     /* F: FPS */
    drawUIntAt(76, 69, (uint)fps_value, (uint)255);
}

void drawRenderStatsOverlay()
{
    if (render_stats_enabled == 0)
    {
        drawFPSOverlay();
        return;
    }
    if (render_stats_enabled == 1)
    {
        drawCoordinateOverlay();
        return;
    }
    if (render_stats_enabled == 3)
    {
        drawStreamingStatsOverlay();
        return;
    }

    rs_quads = renderStat((uint)8);
    rs_tris = renderStat((uint)2);
    rs_tested = renderStat((uint)3);
    rs_written = renderStat((uint)4);
    rs_rejected = renderStat((uint)5);
    rs_fast_empty = renderStat((uint)6);
    rs_fast_current = renderStat((uint)7);

    fillRect2D(2, 2, 76, 76, (uint)0);

    drawSmallGlyph(6, 6, 81, (uint)255);
    drawUIntAt(24, 6, rs_quads, (uint)255);

    drawSmallGlyph(6, 15, 84, (uint)255);
    drawSmallGlyph(12, 15, 82, (uint)255);
    drawUIntAt(24, 15, rs_tris, (uint)255);

    drawSmallGlyph(6, 24, 80, (uint)255);
    drawSmallGlyph(12, 24, 84, (uint)255);
    drawUIntAt(24, 24, rs_tested, (uint)255);

    drawSmallGlyph(6, 33, 80, (uint)255);
    drawSmallGlyph(12, 33, 87, (uint)255);
    drawUIntAt(24, 33, rs_written, (uint)255);

    drawSmallGlyph(6, 42, 90, (uint)255);
    drawSmallGlyph(12, 42, 82, (uint)255);
    drawUIntAt(24, 42, rs_rejected, (uint)255);

    drawSmallGlyph(6, 51, 85, (uint)255);
    drawDigit(12, 51, 0, (uint)255);
    drawUIntAt(24, 51, rs_fast_empty, (uint)255);

    drawSmallGlyph(6, 60, 67, (uint)255);
    drawSmallGlyph(12, 60, 70, (uint)255);
    drawUIntAt(24, 60, rs_fast_current, (uint)255);

    drawSmallGlyph(6, 69, 70, (uint)255);
    drawSmallGlyph(12, 69, 80, (uint)255);
    drawSmallGlyph(18, 69, 83, (uint)255);
    drawUIntAt(36, 69, (uint)fps_value, (uint)255);

}

void processStatsToggleKey()
{
    key(0x2C, key_data, key_pressed);  /* T: debug overlay/menu toggle */
    if (key_pressed != 0)
    {
        if (old_stats_key == 0)
        {
            render_stats_enabled = render_stats_enabled + 1;
            if (render_stats_enabled > 3) render_stats_enabled = 0;

            if (render_stats_enabled == 2) renderStats((uint)1);
            else renderStats((uint)0);
        }
        old_stats_key = 1;
    }
    else
    {
        old_stats_key = 0;
    }
}

int drawSmallCharAt(int x, int y, int ch, uint color)
{
    return drawSmallGlyph(x, y, ch, color);
}

void drawNameBuffer(char *buf, int len, int x, int y, uint color)
{
    int i;
    text_x = x;
    i = 0;
    while ((i < len) && (buf[i] != 0))
    {
        text_x = text_x + drawSmallCharAt(text_x, y, (int)buf[i], color);
        i = i + 1;
    }
}

void drawStoredWorldName(int slot, int x, int y, uint color)
{
    int base;
    int i;
    base = slot * 16;
    text_x = x;
    i = 0;
    while ((i < 15) && (world_names[base + i] != 0))
    {
        text_x = text_x + drawSmallCharAt(text_x, y, (int)world_names[base + i], color);
        i = i + 1;
    }
}

void drawLabelText(int x, int y, int label, uint color)
{
