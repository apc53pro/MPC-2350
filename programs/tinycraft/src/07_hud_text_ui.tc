int cursorInRect(int x0, int y0, int x1, int y1)
{
    if (ui_cursor_ix < x0) return 0;
    if (ui_cursor_ix > x1) return 0;
    if (ui_cursor_iy < y0) return 0;
    if (ui_cursor_iy > y1) return 0;
    return 1;
}

void drawUIButton(int x0, int y0, int x1, int y1, int label, int text_x)
{
    menu_color = (uint)109;
    if (cursorInRect(x0, y0, x1, y1) != 0) menu_color = (uint)146;
    fillRect2D(x0, y0, x1, y1, menu_color);
    drawLine(x0, y0, x1, y0, (uint)255);
    drawLine(x0, y1, x1, y1, (uint)37);
    drawLabelText(text_x, y0 + 7, label, (uint)255);
}

void drawToggleValue(int x0, int y0, int x1, int y1, int value)
{
    menu_color = (uint)109;
    if (cursorInRect(x0, y0, x1, y1) != 0) menu_color = (uint)146;
    fillRect2D(x0, y0, x1, y1, menu_color);
    drawLine(x0, y0, x1, y0, (uint)255);
    drawLine(x0, y1, x1, y1, (uint)37);
    if (value != 0) drawLabelText(x0 + 21, y0 + 7, 13, (uint)255);
    else drawLabelText(x0 + 18, y0 + 7, 14, (uint)255);
}

