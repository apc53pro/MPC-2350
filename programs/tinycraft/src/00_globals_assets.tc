struct TextureDef {
    int used;
    int id;
    int source_kind;
    int format;
    int width;
    int height;
    int word_count;
    int alpha_kind;
    int cache_slot;
    int name_label;
};

struct BlockDef {
    int used;
    uint id;
    int render_class;
    int placeable;
    int stops_sky_light;
    int light_emission;
    uint ui_color;
    uint default_break_ms;
    int preferred_tool;
    uint preferred_break_ms;
    int drop_required_tool;
    uint dropped_item_id;
    int dropped_count;
    int tex_top;
    int tex_bottom;
    int tex_side;
    int icon_tex;
    int name_label;
    int opens_crafting;
    uint linked_item_id;
    int behavior_flags;
};

struct ItemDef {
    int used;
    uint id;
    int kind;
    int render_kind;
    int max_stack;
    int linked_block_id;
    int tool_kind;
    int tool_level;
    uint ui_color;
    int icon_tex;
    int name_label;
    int use_action;
    int behavior_flags;
    int mesh_id;
    int attack_damage;
    int attack_cooldown_ms;
};

struct ItemMeshDef {
    int used;
    int item_id;
    int first_face;
    int face_count;
    int icon_tex;
    int flags;
};

struct ItemMeshFace {
    int x0;
    int y0;
    int z0;
    int x1;
    int y1;
    int z1;
    int x2;
    int y2;
    int z2;
    int x3;
    int y3;
    int z3;
    int u0;
    int v0;
    int u1;
    int v1;
    int texture_id;
    int flags;
};

struct BlockModelDef {
    int used;
    int block_id;
    int first_face;
    int face_count;
    int flags;
};

struct BlockModelFace {
    int x0;
    int y0;
    int z0;
    int x1;
    int y1;
    int z1;
    int x2;
    int y2;
    int z2;
    int x3;
    int y3;
    int z3;
    int u0;
    int v0;
    int u1;
    int v1;
    int texture_id;
    int flags;
};

struct EntityDef {
    int used;
    int id;
    int render_kind;
    int behavior_kind;
    int texture_id;
    int model_kind;
    int max_active;
    int spawn_group;
    int spawn_floor_block;
    int spawn_light_min;
    float hitbox_x;
    float hitbox_z;
    float height;
    float eye_height;
    float render_radius;
    float lod_dist_sq;
    float ai_tick_ms;
    float move_speed;
    float turn_speed;
    float head_turn_speed;
    float head_yaw_limit;
    float head_pitch_limit;
};

struct EntityModelDef {
    int used;
    int model_id;
    int first_part;
    int part_count;
    int texture_id;
    int flags;
};

struct EntityModelPart {
    int part_kind;
    int anim_kind;
    int lod_group;
    int texture_id;
    int uvx;
    int uvy;
    int sx;
    int sy;
    int sz;
    int flags;
    float lx0;
    float ly0;
    float lz0;
    float lx1;
    float ly1;
    float lz1;
    float pivot_x;
    float pivot_y;
    float pivot_z;
};

