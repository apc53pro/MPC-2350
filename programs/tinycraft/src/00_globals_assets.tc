// v36 greedy mesh cache.
// Each merged rectangle uses two packed words:
//   p0: x0[0..6], z0[7..13], y0[14..19], faceBits[20..25], blockId[26..29]
//   p1: x1[0..6], z1[7..13], y1[14..19], chunkId[20..31]
// This keeps greedy meshing cheap in VM RAM and prepares the renderer for
// larger tiled quads via fillQuad3DTexZTiled().
uint render_mesh_p0[24576];
uint render_mesh_p1[24576];
int render_mesh_next[24576];
int render_chunk_face_head[12288];
int render_chunk_built[2048];
int render_chunk_max_y[2048];
int render_chunk_has_edit[2048];
int render_chunk_has_custom_model[2048];
/* v66 fast-terrain render optimization: per-section fast face masks let
   renderWorld skip empty direction buckets before calling the native packed
   terrain renderer. */
int render_chunk_has_fast_faces[2048];
int render_chunk_face_mask[2048];
/* Legacy compaction counters remain for image/cache maintenance. Direct edit
   splits now unlink and recycle their mesh node immediately. */
int render_dead_mesh_count = 0;
int render_mesh_compact_needed = 0;
/* v66 delayed greedy recovery: edits are patched instantly, then after the
   player stops editing the touched sections are rebuilt with full greedy
   meshing so long-term terrain performance recovers. */
int render_bg_greedy_dirty[2048];
int render_bg_greedy_x[512];
int render_bg_greedy_z[512];
int render_bg_greedy_s[512];
int render_bg_greedy_count = 0;
int render_bg_greedy_scan = 0;
int render_bg_greedy_pick = -1;
int render_bg_greedy_delay_ms = 2000;
/* NARM branch: recover direct-edit fragmentation only while the normal stream
   queue is empty and FPS has headroom. The worker is interval-limited to one
   section, so cleanup cannot monopolize a frame sequence. */
int render_bg_greedy_enabled = 1;
uint render_bg_greedy_next_ms = 0;
int render_bg_greedy_interval_ms = 1000;
int render_mesh_compact_enabled = 1;
/* v65 render optimization: custom block models are kept in a per-section
   linked list built during remesh. The old renderer scanned all 512 blocks
   in every visible section every frame just to find the few custom blocks. */
int render_custom_block_head[2048];
