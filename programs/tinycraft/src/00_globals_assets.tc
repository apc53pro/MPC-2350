/* Performance knobs. Rendering fewer textured 3D quads matters far more than
   small arithmetic changes because every submitted face goes through transform,
   clip, perspective-correct texture sampling, z testing, and rasterization. */
int render_radius = 8;
int render_chunks = 1;
int render_chunks_min = 1;
int render_chunks_max = 3;
int render_radius_blocks = 8;
float render_distance_sq = 96.0f;
float render_side_margin = 4.0f;
/* Projection-space culling limits. The camera uses focal 260 with a 320x240
   screen, so visible half-width/height are roughly 0.62 and 0.46. These are
   slightly padded so large quads do not pop, but much tighter than the old
   1.05 cone that kept drawing off-screen objects. */
float render_fov_scale = 0.68f;
float render_fov_y_scale = 0.52f;

/* Vertical physics in blocks per millisecond.
   These values are much smaller than older versions so the player eases
   through jump/fall motion instead of snapping by whole blocks per frame. */
float jump_start_speed = 0.0064f;
float gravity_accel = 0.000016f;
float max_fall_speed = -0.0180f;
float ground_snap_epsilon = 0.16f;

/* 20 TPS movement model, Minecraft-like. Horizontal velocities are stored in
   blocks/tick, not blocks/millisecond. The old per-frame speed values are
   kept only for non-player drop physics. */
float tick_ground_walk_accel = 0.098f;
float tick_ground_run_accel = 0.130f;
float tick_ground_drag = 0.546f;
float tick_air_accel_mult = 0.20f;
float tick_air_drag = 0.910f;
float tick_air_speed_cap = 0.420f;
float tick_jump_velocity = 0.420f;
float tick_gravity = 0.080f;
float tick_vertical_drag = 0.980f;
float tick_terminal_fall = -3.200f;

/* PS/2 set-2 scancodes used directly in updatePlayer():
   W=0x1D A=0x1C S=0x1B D=0x23 I=0x43 J=0x3B K=0x42 L=0x4B Space=0x29 Z=0x1A X=0x22 Y=0x35 M=0x3A R=0x2D F=0x2B LeftShift=0x12 RightShift=0x59.
   Number keys: 1=0x16 2=0x1E 3=0x26 4=0x25 5=0x2E 6=0x36 7=0x3D 8=0x3E 9=0x46. */

/* 16*64*16 = 16384 block IDs. This is only the active world window,
   not the whole world. Absolute block coordinates are:
       abs_x = world_origin_x + local_x
       abs_z = world_origin_z + local_z
   When the player approaches the edge, the window is regenerated around them. */
uint world[16384];

int world_seed = 12345;
int world_origin_x = -8;
int world_origin_z = -8;
int recenter_low = 1;
int recenter_high = 15;

/* Edit overlay. edit_block=0 means the player intentionally broke the block.
   Entries not present in this table come from procedural terrain. */
int edit_x[512];
int edit_y[512];
int edit_z[512];
uint edit_block[512];
int edit_count = 0;

