uint ITEM_WOODEN_PICKAXE = 21;
uint ITEM_WOODEN_SWORD = 22;
uint ITEM_WOODEN_SHOVEL = 23;
uint ITEM_WOODEN_AXE = 24;
uint ITEM_RAW_PORKCHOP = 25;

