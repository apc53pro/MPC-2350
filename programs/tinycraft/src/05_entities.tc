void drawViewCuboid()
{
    /* Front, right, top, left, bottom faces. Used by first-person/debug cuboids. */
    fillQuad3DZ(vm_x0, vm_y0, vm_z0,
                vm_x1, vm_y0, vm_z0,
                vm_x1, vm_y1, vm_z0,
                vm_x0, vm_y1, vm_z0,
                hand_col_a, &hand_cam[0]);

    fillQuad3DZ(vm_x1, vm_y0, vm_z0,
                vm_x1, vm_y0, vm_z1,
                vm_x1, vm_y1, vm_z1,
                vm_x1, vm_y1, vm_z0,
                hand_col_b, &hand_cam[0]);

    fillQuad3DZ(vm_x0, vm_y1, vm_z0,
                vm_x1, vm_y1, vm_z0,
                vm_x1, vm_y1, vm_z1,
                vm_x0, vm_y1, vm_z1,
                hand_col_c, &hand_cam[0]);

    fillQuad3DZ(vm_x0, vm_y0, vm_z1,
                vm_x0, vm_y0, vm_z0,
                vm_x0, vm_y1, vm_z0,
                vm_x0, vm_y1, vm_z1,
                hand_col_b, &hand_cam[0]);

    fillQuad3DZ(vm_x0, vm_y0, vm_z1,
                vm_x1, vm_y0, vm_z1,
                vm_x1, vm_y0, vm_z0,
                vm_x0, vm_y0, vm_z0,
                hand_col_b, &hand_cam[0]);
}

void drawViewCuboidTextured()
{
    fillQuad3DTexZ(
        vm_x0, vm_y0, vm_z0, 0.0f, texel_max,
        vm_x1, vm_y0, vm_z0, texel_max, texel_max,
        vm_x1, vm_y1, vm_z0, texel_max, 0.0f,
        vm_x0, vm_y1, vm_z0, 0.0f, 0.0f,
        item_side_tex, 16, 16, 0, &hand_cam[0]
    );

    fillQuad3DTexZ(
        vm_x1, vm_y0, vm_z0, 0.0f, texel_max,
        vm_x1, vm_y0, vm_z1, texel_max, texel_max,
        vm_x1, vm_y1, vm_z1, texel_max, 0.0f,
        vm_x1, vm_y1, vm_z0, 0.0f, 0.0f,
        item_side_tex, 16, 16, 0, &hand_cam[0]
    );

    fillQuad3DTexZ(
        vm_x0, vm_y1, vm_z0, 0.0f, 0.0f,
        vm_x1, vm_y1, vm_z0, texel_max, 0.0f,
        vm_x1, vm_y1, vm_z1, texel_max, texel_max,
        vm_x0, vm_y1, vm_z1, 0.0f, texel_max,
        item_top_tex, 16, 16, 0, &hand_cam[0]
    );

    fillQuad3DTexZ(
        vm_x0, vm_y0, vm_z1, 0.0f, texel_max,
        vm_x0, vm_y0, vm_z0, texel_max, texel_max,
        vm_x0, vm_y1, vm_z0, texel_max, 0.0f,
        vm_x0, vm_y1, vm_z1, 0.0f, 0.0f,
        item_side_tex, 16, 16, 0, &hand_cam[0]
    );

    fillQuad3DTexZ(
        vm_x0, vm_y0, vm_z1, 0.0f, 0.0f,
        vm_x1, vm_y0, vm_z1, texel_max, 0.0f,
        vm_x1, vm_y0, vm_z0, texel_max, texel_max,
        vm_x0, vm_y0, vm_z0, 0.0f, texel_max,
        item_bottom_tex, 16, 16, 0, &hand_cam[0]
    );

    fillQuad3DTexZ(
        vm_x1, vm_y0, vm_z1, 0.0f, texel_max,
        vm_x0, vm_y0, vm_z1, texel_max, texel_max,
        vm_x0, vm_y1, vm_z1, texel_max, 0.0f,
        vm_x1, vm_y1, vm_z1, 0.0f, 0.0f,
        item_side_tex, 16, 16, 0, &hand_cam[0]
    );
}


float pigTX(float lx, float lz)
{
    return pig_draw_x + lx * pig_draw_c - lz * pig_draw_s;
}

float pigTZ(float lx, float lz)
{
    return pig_draw_z + lx * pig_draw_s + lz * pig_draw_c;
}

float pigRollX(float lx, float ly)
{
    return lx * pig_death_roll_c - ly * pig_death_roll_s;
}

float pigRollY(float lx, float ly)
{
    return lx * pig_death_roll_s + ly * pig_death_roll_c;
}

float pigTX3(float lx, float ly, float lz)
{
    pig_roll_x = pigRollX(lx, ly);
    return pig_draw_x + pig_roll_x * pig_draw_c - lz * pig_draw_s;
}

float pigTY3(float lx, float ly, float lz)
{
    return (pig_draw_y + pigRollY(lx, ly)) * block_world_size;
}

float pigTZ3(float lx, float ly, float lz)
{
    pig_roll_x = pigRollX(lx, ly);
    return pig_draw_z + pig_roll_x * pig_draw_s + lz * pig_draw_c;
}

float pigLegRY(float ly, float lz)
{
    pig_leg_rel_y = ly - pig_leg_piv_y;
    pig_leg_rel_z = lz - pig_leg_piv_z;
    return pig_leg_piv_y + pig_leg_rel_y * pig_leg_rot_c - pig_leg_rel_z * pig_leg_rot_s;
}

float pigLegRZ(float ly, float lz)
{
    pig_leg_rel_y = ly - pig_leg_piv_y;
    pig_leg_rel_z = lz - pig_leg_piv_z;
    return pig_leg_piv_z + pig_leg_rel_y * pig_leg_rot_s + pig_leg_rel_z * pig_leg_rot_c;
}

float pigLegTX(float lx, float ly, float lz)
{
    return pigTX3(lx, pigLegRY(ly, lz), pigLegRZ(ly, lz));
}

float pigLegTY(float lx, float ly, float lz)
{
    return pigTY3(lx, pigLegRY(ly, lz), pigLegRZ(ly, lz));
}

float pigLegTZ(float lx, float ly, float lz)
{
    return pigTZ3(lx, pigLegRY(ly, lz), pigLegRZ(ly, lz));
}

float pigHeadLocalX(float lx, float ly, float lz)
{
    pig_head_rel_x = lx - pig_head_piv_x;
    pig_head_rel_y = ly - pig_head_piv_y;
    pig_head_rel_z = lz - pig_head_piv_z;
    pig_head_pitch_y = pig_head_rel_y * pig_head_pitch_c - pig_head_rel_z * pig_head_pitch_s;
    pig_head_pitch_z = pig_head_rel_y * pig_head_pitch_s + pig_head_rel_z * pig_head_pitch_c;
    pig_head_yaw_x = pig_head_rel_x * pig_head_rot_c - pig_head_pitch_z * pig_head_rot_s;
    return pig_head_piv_x + pig_head_yaw_x;
}

float pigHeadLocalY(float lx, float ly, float lz)
{
    pig_head_rel_y = ly - pig_head_piv_y;
    pig_head_rel_z = lz - pig_head_piv_z;
    pig_head_pitch_y = pig_head_rel_y * pig_head_pitch_c - pig_head_rel_z * pig_head_pitch_s;
    return pig_head_piv_y + pig_head_pitch_y;
}

float pigHeadLocalZ(float lx, float ly, float lz)
{
    pig_head_rel_x = lx - pig_head_piv_x;
    pig_head_rel_y = ly - pig_head_piv_y;
    pig_head_rel_z = lz - pig_head_piv_z;
    pig_head_pitch_y = pig_head_rel_y * pig_head_pitch_c - pig_head_rel_z * pig_head_pitch_s;
    pig_head_pitch_z = pig_head_rel_y * pig_head_pitch_s + pig_head_rel_z * pig_head_pitch_c;
    pig_head_yaw_z = pig_head_rel_x * pig_head_rot_s + pig_head_pitch_z * pig_head_rot_c;
    return pig_head_piv_z + pig_head_yaw_z;
}

float pigHeadTX(float lx, float ly, float lz)
{
    return pigTX3(pigHeadLocalX(lx, ly, lz), pigHeadLocalY(lx, ly, lz), pigHeadLocalZ(lx, ly, lz));
}

float pigHeadTY(float lx, float ly, float lz)
{
    return pigTY3(pigHeadLocalX(lx, ly, lz), pigHeadLocalY(lx, ly, lz), pigHeadLocalZ(lx, ly, lz));
}

float pigHeadTZ(float lx, float ly, float lz)
{
    return pigTZ3(pigHeadLocalX(lx, ly, lz), pigHeadLocalY(lx, ly, lz), pigHeadLocalZ(lx, ly, lz));
}

void drawPigBox(float lx0, float ly0, float lz0, float lx1, float ly1, float lz1, int uvx, int uvy, int sx, int sy, int sz)
{
    pig_box_lx0 = lx0;
    pig_box_lx1 = lx1;
    pig_box_ly0 = ly0;
    pig_box_ly1 = ly1;
    pig_box_lz0 = lz0;
    pig_box_lz1 = lz1;
    pig_uvx = uvx;
    pig_uvy = uvy;
    pig_sx = sx;
    pig_sy = sy;
    pig_sz = sz;

    pig_y0 = (pig_draw_y + pig_box_ly0) * block_world_size;
    pig_y1 = (pig_draw_y + pig_box_ly1) * block_world_size;


    /* Entity face culling: convert camera into this cuboid's local space.
       A closed cuboid only needs the faces whose outward side can see the camera. */
    pig_cam_dx = player_x - pig_draw_x;
    pig_cam_dz = player_z - pig_draw_z;
    pig_cam_base_lx = pig_cam_dx * pig_draw_c + pig_cam_dz * pig_draw_s;
    pig_cam_base_lz = (0.0f - pig_cam_dx) * pig_draw_s + pig_cam_dz * pig_draw_c;
    pig_cam_base_ly = player_y - pig_draw_y;
    pig_cam_local_x = pig_cam_base_lx;
    pig_cam_local_y = pig_cam_base_ly;
    pig_cam_local_z = pig_cam_base_lz;

    pig_draw_face_front = 0;
    pig_draw_face_right = 0;
    pig_draw_face_back = 0;
    pig_draw_face_left = 0;
    pig_draw_face_top = 0;
    pig_draw_face_bottom = 0;
    if (pig_cam_local_z < pig_box_lz0) pig_draw_face_front = 1;
    if (pig_cam_local_x > pig_box_lx1) pig_draw_face_right = 1;
    if (pig_cam_local_z > pig_box_lz1) pig_draw_face_back = 1;
    if (pig_cam_local_x < pig_box_lx0) pig_draw_face_left = 1;
    if (pig_cam_local_y > pig_box_ly1) pig_draw_face_top = 1;
    if (pig_cam_local_y < pig_box_ly0) pig_draw_face_bottom = 1;
    if (pig_cam_local_x > pig_box_lx0 && pig_cam_local_x < pig_box_lx1 &&
        pig_cam_local_y > pig_box_ly0 && pig_cam_local_y < pig_box_ly1 &&
        pig_cam_local_z > pig_box_lz0 && pig_cam_local_z < pig_box_lz1) {
        pig_draw_face_front = 1;
        pig_draw_face_right = 1;
        pig_draw_face_back = 1;
        pig_draw_face_left = 1;
        pig_draw_face_top = 1;
        pig_draw_face_bottom = 1;
    }
    if (pig_death_roll_angle > 0.001f) {
        pig_draw_face_front = 1;
        pig_draw_face_right = 1;
        pig_draw_face_back = 1;
        pig_draw_face_left = 1;
        pig_draw_face_top = 1;
        pig_draw_face_bottom = 1;
    }

    /* front/north face: atlas [u+depth, v+depth, width, height] */
    pig_fu0 = (float)(pig_uvx + pig_sz);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_front != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu0, pig_fv1,
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    /* right/east face: [u+depth+width, v+depth, depth, height] */
    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sz) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_right != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu0, pig_fv1,
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    /* back/south face: [u+depth+width+depth, v+depth, width, height] */
    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx + pig_sz);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_back != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    /* left/west face: [u, v+depth, depth, height] */
    pig_fu0 = (float)pig_uvx;
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_left != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    /* top face: [u+depth, v, width, depth] */
    pig_fu0 = (float)(pig_uvx + pig_sz);
    pig_fv0 = (float)pig_uvy;
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz) - 0.001f);
    if (pig_draw_face_top != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    /* bottom face: [u+depth+width, v, width, depth] */
    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx);
    pig_fv0 = (float)pig_uvy;
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz) - 0.001f);
    if (pig_draw_face_bottom != 0)
    {
    fillQuad3DTexZ(
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
        pigTX3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx1, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu1, pig_fv1,
        pigTX3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pigTY3(pig_box_lx0, pig_box_ly0, pig_box_lz0), pigTZ3(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu0, pig_fv1,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }
}

void drawPigHeadBox(float lx0, float ly0, float lz0, float lx1, float ly1, float lz1, int uvx, int uvy, int sx, int sy, int sz)
{
    pig_box_lx0 = lx0;
    pig_box_lx1 = lx1;
    pig_box_ly0 = ly0;
    pig_box_ly1 = ly1;
    pig_box_lz0 = lz0;
    pig_box_lz1 = lz1;
    pig_uvx = uvx;
    pig_uvy = uvy;
    pig_sx = sx;
    pig_sy = sy;
    pig_sz = sz;


    /* Entity face culling for the independently yaw/pitch rotated head. */
    pig_cam_dx = player_x - pig_draw_x;
    pig_cam_dz = player_z - pig_draw_z;
    pig_cam_base_lx = pig_cam_dx * pig_draw_c + pig_cam_dz * pig_draw_s;
    pig_cam_base_lz = (0.0f - pig_cam_dx) * pig_draw_s + pig_cam_dz * pig_draw_c;
    pig_cam_base_ly = player_y - pig_draw_y;

    pig_cam_rel_x = pig_cam_base_lx - pig_head_piv_x;
    pig_cam_rel_y = pig_cam_base_ly - pig_head_piv_y;
    pig_cam_rel_z = pig_cam_base_lz - pig_head_piv_z;

    pig_cam_local_x = pig_head_piv_x + pig_cam_rel_x * pig_head_rot_c + pig_cam_rel_z * pig_head_rot_s;
    pig_cam_pitch_z = (0.0f - pig_cam_rel_x) * pig_head_rot_s + pig_cam_rel_z * pig_head_rot_c;
    pig_cam_local_y = pig_head_piv_y + pig_cam_rel_y * pig_head_pitch_c + pig_cam_pitch_z * pig_head_pitch_s;
    pig_cam_local_z = pig_head_piv_z + (0.0f - pig_cam_rel_y) * pig_head_pitch_s + pig_cam_pitch_z * pig_head_pitch_c;

    pig_draw_face_front = 0;
    pig_draw_face_right = 0;
    pig_draw_face_back = 0;
    pig_draw_face_left = 0;
    pig_draw_face_top = 0;
    pig_draw_face_bottom = 0;
    if (pig_cam_local_z < pig_box_lz0) pig_draw_face_front = 1;
    if (pig_cam_local_x > pig_box_lx1) pig_draw_face_right = 1;
    if (pig_cam_local_z > pig_box_lz1) pig_draw_face_back = 1;
    if (pig_cam_local_x < pig_box_lx0) pig_draw_face_left = 1;
    if (pig_cam_local_y > pig_box_ly1) pig_draw_face_top = 1;
    if (pig_cam_local_y < pig_box_ly0) pig_draw_face_bottom = 1;
    if (pig_cam_local_x > pig_box_lx0 && pig_cam_local_x < pig_box_lx1 &&
        pig_cam_local_y > pig_box_ly0 && pig_cam_local_y < pig_box_ly1 &&
        pig_cam_local_z > pig_box_lz0 && pig_cam_local_z < pig_box_lz1) {
        pig_draw_face_front = 1;
        pig_draw_face_right = 1;
        pig_draw_face_back = 1;
        pig_draw_face_left = 1;
        pig_draw_face_top = 1;
        pig_draw_face_bottom = 1;
    }
    if (pig_death_roll_angle > 0.001f) {
        pig_draw_face_front = 1;
        pig_draw_face_right = 1;
        pig_draw_face_back = 1;
        pig_draw_face_left = 1;
        pig_draw_face_top = 1;
        pig_draw_face_bottom = 1;
    }

    pig_fu0 = (float)(pig_uvx + pig_sz);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_front != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly0, pig_box_lz0), pigHeadTZ(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu0, pig_fv1,
        pigHeadTX(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly0, pig_box_lz0), pigHeadTZ(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu1, pig_fv1,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sz) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_right != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly0, pig_box_lz0), pigHeadTZ(pig_box_lx1, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu0, pig_fv1,
        pigHeadTX(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx + pig_sz);
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_back != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pigHeadTX(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    pig_fu0 = (float)pig_uvx;
    pig_fv0 = (float)(pig_uvy + pig_sz);
    pig_fu1 = ((float)(pig_uvx + pig_sz) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz + pig_sy) - 0.001f);
    if (pig_draw_face_left != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pigHeadTX(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly0, pig_box_lz0), pigHeadTZ(pig_box_lx0, pig_box_ly0, pig_box_lz0) * block_world_size, pig_fu1, pig_fv1,
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    pig_fu0 = (float)(pig_uvx + pig_sz);
    pig_fv0 = (float)pig_uvy;
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz) - 0.001f);
    if (pig_draw_face_top != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu0, pig_fv0,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz0), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz0) * block_world_size, pig_fu1, pig_fv0,
        pigHeadTX(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu1, pig_fv1,
        pigHeadTX(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly1, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly1, pig_box_lz1) * block_world_size, pig_fu0, pig_fv1,
        pig_texture_ptr, pig_texture_w, pig_texture_h, 0, &cam[0]
    );
    }

    pig_fu0 = (float)(pig_uvx + pig_sz + pig_sx);
    pig_fv0 = (float)pig_uvy;
    pig_fu1 = ((float)(pig_uvx + pig_sz + pig_sx + pig_sx) - 0.001f);
    pig_fv1 = ((float)(pig_uvy + pig_sz) - 0.001f);
    if (pig_draw_face_bottom != 0)
    {
    fillQuad3DTexZ(
        pigHeadTX(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx0, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx0, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu0, pig_fv0,
        pigHeadTX(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pigHeadTY(pig_box_lx1, pig_box_ly0, pig_box_lz1), pigHeadTZ(pig_box_lx1, pig_box_ly0, pig_box_lz1) * block_world_size, pig_fu1, pig_fv0,
