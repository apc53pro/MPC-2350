/* Original Z80 interpreter for the NARM ZX80 application.
   Included from zx80_narm.tc. Pure C with no host dependencies. */
#define F_S 0x80
#define F_Z 0x40
#define F_5 0x20
#define F_H 0x10
#define F_3 0x08
#define F_P 0x04
#define F_N 0x02
#define F_C 0x01

unsigned char zx_rom[4096];
unsigned char zx_ram[16384];
int zx_ram_bytes = 1024;
int za,zf,zb,zc,zd,ze,zh,zl;
int za2,zf2,zb2,zc2,zd2,ze2,zh2,zl2;
unsigned zpc,zsp,zix,ziy,zi,zr;
int ziff1,ziff2,zim,zhalt,zei_block;
int zcycles,ztotal_frame,zirq_counter,zbad_opcode;
unsigned zx_djnz_seen, zx_djnz_taken, zx_djnz_wrong, zx_djnz_first_b;
int zx_video_activity,zx_video_sync,zx_video_rows;
/* VIDEO/SYNC MODEL: Measure real (emulated) Z80 instruction timing, not keys.
 * ZX80 video requires a continuous series of line-ending maskable interrupts,
 * nominally one per 207 T-states. The ROM suspends that sequence for BASIC.
 * A 20 ms window with too few scanlines or a long break has lost video sync.
 */
unsigned zx_video_irq_frame,zx_video_m1_frame,zx_video_gap_ticks,zx_video_max_gap;
void zx_video_begin_frame(void){
 zx_video_irq_frame=0;
 zx_video_m1_frame=0;
 zx_video_max_gap=zx_video_gap_ticks;
}
int zx_video_frame_locked(void){
 /* On the stock 50 Hz ROM ~310 horizontal IRQs per 20 ms, including borders.
    Normal top/bottom border behavior gives gaps of about 1652 T-states.
    A keypress skips ~35-40 interrupts, with a ~9000 T-state gap. */
 return zx_video_irq_frame>=290 && zx_video_max_gap<=2500u && zx_video_m1_frame>=150;
}

/* ZX80 M1/refresh scanline video. Each 8-pixel group is one M1 read,
 * sampled using the Z80's I register and the 3-bit external line counter.
 * 256x192 RGB332 frames are stored as two packed 32-bit-pixel buffers;
 * the NARM firmware can blit a complete frame with one command.
 * No BASIC display-file parsing is involved in the raster mode. */
#define ZX_VWORDS 12288
unsigned zx_vpixels[2][ZX_VWORDS];
unsigned zx_vwords[16]; /* 4 bits -> four RGB332 pixels */
unsigned zx_clock_ticks=0,zx_last_irq_clock=0,zx_last_frame_clock=0;
int zx_vwrite=0,zx_vready=0,zx_vvalid=0;
int zx_vline=0,zx_vline_3=0,zx_vsync=0;
int zx_virq_count=0,zx_vlast_irqs=0,zx_vchars=0,zx_vlast_chars=0;
int zx_vframes=0,zx_vout_count=0,zx_vfetches=0,zx_vlast_fetches=0;
int zx_tape_high = 1;
unsigned zx_keys[8]; /* 5-bit active-low keyboard rows. */

int rb(unsigned addr) {
    addr &= 65535;
    if (addr & 0x4000) return zx_ram[(addr & 0x3fff) & (zx_ram_bytes-1)];
    return zx_rom[addr & 0xfff];
}
void wb(unsigned addr,int value) {
    addr &= 65535;
    if (addr & 0x4000) zx_ram[(addr & 0x3fff) & (zx_ram_bytes-1)] = value & 255;
}
unsigned rw(unsigned adr) { return rb(adr) | (rb((adr+1)&65535)<<8); }
void ww(unsigned adr,unsigned v) { wb(adr,v);wb(adr+1,v>>8); }
/* The clock is measured in emulated T-states, not host microseconds. */
void zx_video_clear_buffer(int bank){
 int i; for(i=0;i<ZX_VWORDS;i++)zx_vpixels[bank][i]=0xffffffffu;
}
void zx_video_raster_init(void){
 int n,j;unsigned w;
 for(n=0;n<16;n++){
  w=0;
  for(j=0;j<4;j++){
   unsigned c=(n&(8>>j))?0u:255u;
   w|=c<<(j*8);
  }
  zx_vwords[n]=w;
 }
 zx_video_clear_buffer(0);zx_video_clear_buffer(1);
 zx_clock_ticks=zx_last_irq_clock=zx_last_frame_clock=0;
 zx_vwrite=zx_vready=zx_vvalid=0;
 zx_vline=zx_vline_3=zx_vsync=zx_virq_count=0;
 zx_vlast_irqs=zx_vchars=zx_vlast_chars=zx_vframes=zx_vout_count=0;
 zx_vfetches=zx_vlast_fetches=0;
}
void zx_video_in(void){
 /* Read from any even port starts programmatic vertical sync. */
 zx_vsync=1;
}
void zx_video_out(void){
 /* Any port write ends VSYNC and resets external character-row counter. */
 zx_vline_3=0;
 if(zx_vsync){
  if(zx_virq_count>=240){
   zx_vlast_irqs=zx_virq_count;
   zx_vlast_chars=zx_vchars;
   zx_vlast_fetches=zx_vfetches;
   zx_vready=zx_vwrite;zx_vvalid=1;
   zx_last_frame_clock=zx_clock_ticks;
   zx_vframes++;
   zx_vwrite ^=1;
  }
  zx_video_clear_buffer(zx_vwrite);
  zx_vline=0;zx_virq_count=0;zx_vchars=zx_vfetches=0;
  zx_vsync=0;zx_vout_count++;
 }
}
void zx_video_irq(void){
 /* An interrupt acknowledge advances the external 3-bit character line. */
 if(zx_vsync)return;
 zx_vline_3=(zx_vline_3+1)&7;
 zx_vline++;zx_virq_count++;
 zx_last_irq_clock=zx_clock_ticks;
}
void zx_video_m1(unsigned pc,unsigned raw){
 unsigned glyphaddr,cycdelta,pat,idx;
 int row,col;
 if(!(pc&0x8000u) || (raw&0x40u))return;
 zx_vfetches++;
 /* PAL 50 Hz stock ROM: 56 top border lines, then 192 picture lines.
    The first video M1 on a line starts ~75 T-states after IRQ recognition;
    every further NOP-injected M1 emits eight consecutive pixels in 4 T. */
 row=zx_vline-56;
 if(zx_vsync || row<0 || row>=192)return;
 cycdelta=zx_clock_ticks-zx_last_irq_clock;
 if(cycdelta<75u)return;
 col=(int)((cycdelta-75u)>>2);
 if(col<0 || col>=32)return;
 /* I register high byte + latched 6-bit glyph number + 3-bit scanline. */
 glyphaddr=((zi&255u)<<8)|((raw&63u)<<3)|((unsigned)zx_vline_3);
 /* If the refresh address selects RAM, actual ZX80 data-bus contention
    substitutes the byte at the refresh-counter address, enabling some
    non-character high-resolution experiments on suitable RAM expansions. */
 if(glyphaddr&0x4000u)glyphaddr=((zi&255u)<<8)|(zr&127u);
 pat=(unsigned)rb(glyphaddr);
 if(raw&0x80u)pat^=255u;
 idx=((unsigned)row)*64u + ((unsigned)col)*2u;
 zx_vpixels[zx_vwrite][idx]=zx_vwords[(pat>>4)&15];
 zx_vpixels[zx_vwrite][idx+1]=zx_vwords[pat&15];
 zx_vchars++;
}
int zx_video_raster_locked(void){
 /* A custom routine is accepted if it continues producing completed fields,
    regardless of whether its code is the stock ROM's display routine. */
 return zx_vvalid && (zx_clock_ticks-zx_last_frame_clock)<140000u;
}

int fetch8(void) { int r=rb(zpc);zpc=(zpc+1)&65535;return r; }
unsigned fetch16(void) { unsigned v=fetch8();return v | (fetch8()<<8); }
/* Do not depend on signed/unsigned integer promotion for Z80 JR/DJNZ.
   The PC wraps at 16 bits; using an explicit unsigned delta also gives a
   more straightforward lowering for NARMCC's native Thumb backend. */
int s8(int v) { v &=255; if(v>=128)return v-256;return v; }
unsigned z80_relative(unsigned base,int encoded){
  int byte=encoded&255;
  if(byte>=128)return (base-(256-byte))&65535u;
  return (base+byte)&65535u;
}
void push16(unsigned v) {zsp=(zsp-1)&65535;wb(zsp,v>>8);zsp=(zsp-1)&65535;wb(zsp,v);}
unsigned pop16(void){unsigned a=rb(zsp);zsp=(zsp+1)&65535;a|=rb(zsp)<<8;zsp=(zsp+1)&65535;return a;}
int par(int v){v&=255;v^=v>>4;v^=v>>2;v^=v>>1;return !(v&1);}
int szp(int v){v &=255;return (v & (F_S|F_5|F_3)) | ((v==0)?F_Z:0) | (par(v)?F_P:0);}
unsigned bc(void){return (zb<<8)|zc;}
unsigned de(void){return (zd<<8)|ze;}
unsigned hl(void){return (zh<<8)|zl;}
void setbc(unsigned v){zb=(v>>8)&255;zc=v&255;}
void setde(unsigned v){zd=(v>>8)&255;ze=v&255;}
void sethl(unsigned v){zh=(v>>8)&255;zl=v&255;}
unsigned getpair(int code,int idx) { if(code==0)return bc();if(code==1)return de();if(code==2)return idx==1?zix:(idx==2?ziy:hl());return zsp;}
void setpair(int code,int idx,unsigned v){v &=65535;if(code==0)setbc(v);else if(code==1)setde(v);else if(code==2){if(idx==1)zix=v;else if(idx==2)ziy=v;else sethl(v);}else zsp=v;}
unsigned getqq(int code,int idx){if(code==3)return (za<<8)|zf;return getpair(code,idx);}
void setqq(int code,int idx,unsigned v){if(code==3){za=(v>>8)&255;zf=v&255;}else setpair(code,idx,v);}
int rr8(int n,int idx,int disp){
  if(n==0)return zb;if(n==1)return zc;if(n==2)return zd;if(n==3)return ze;
  if(n==4)return idx?((getpair(2,idx)>>8)&255):zh;
  if(n==5)return idx?(getpair(2,idx)&255):zl;
  if(n==6)return rb((getpair(2,idx)+disp)&65535);
  return za;
}
void wr8(int n,int idx,int disp,int v){ v &=255;
  if(n==0)zb=v;else if(n==1)zc=v;else if(n==2)zd=v;else if(n==3)ze=v;
  else if(n==4){if(idx)setpair(2,idx,(getpair(2,idx)&255)|(v<<8));else zh=v;}
  else if(n==5){if(idx)setpair(2,idx,(getpair(2,idx)&0xff00)|v);else zl=v;}
  else if(n==6)wb(getpair(2,idx)+disp,v);else za=v;
}
int add8(int x,int y,int carry){int r=x+y+carry;int v=r&255;
 zf=(v&(F_S|F_5|F_3)) | ((v==0)?F_Z:0) | (((x^y^v)&0x10)?F_H:0) | ((~(x^y)&(x^v)&0x80)?F_P:0) | ((r>255)?F_C:0);
 return v;
}
int sub8(int x,int y,int carry){int r=x-y-carry;int v=r&255;
 zf=F_N | (v&(F_S|F_5|F_3)) | ((v==0)?F_Z:0) | (((x^y^v)&0x10)?F_H:0) | (((x^y)&(x^v)&0x80)?F_P:0) | ((r<0)?F_C:0);
 return v;
}
int inc8(int x){int v=(x+1)&255;zf=(zf&F_C)|(v&(F_S|F_5|F_3))|((v==0)?F_Z:0)|((x&15)==15?F_H:0)|((x==127)?F_P:0);return v;}
int dec8(int x){int v=(x-1)&255;zf=(zf&F_C)|F_N|(v&(F_S|F_5|F_3))|((v==0)?F_Z:0)|((x&15)==0?F_H:0)|((x==128)?F_P:0);return v;}
void alu(int op,int value){value &=255;
 if(op==0)za=add8(za,value,0);
 else if(op==1)za=add8(za,value,zf&F_C);
 else if(op==2)za=sub8(za,value,0);
 else if(op==3)za=sub8(za,value,zf&F_C);
 else if(op==4){za &=value;zf=szp(za)|F_H;}
 else if(op==5){za ^=value;zf=szp(za);}
 else if(op==6){za |=value;zf=szp(za);}
 else {int old=za;sub8(za,value,0);zf=(zf & ~(F_3|F_5))|(value&(F_3|F_5));za=old;}
}
int condition(int cc){if(cc==0)return !(zf&F_Z);if(cc==1)return !!(zf&F_Z);if(cc==2)return !(zf&F_C);if(cc==3)return !!(zf&F_C);if(cc==4)return !(zf&F_P);if(cc==5)return !!(zf&F_P);if(cc==6)return !(zf&F_S);return !!(zf&F_S);}
void addhl(int idx,unsigned x){unsigned o=getpair(2,idx);unsigned r=o+x;unsigned v=r&65535;
 zf=(zf&(F_S|F_Z|F_P)) | ((v>>8)&(F_3|F_5)) | (((o^x^v)&4096)?F_H:0) | ((r>65535)?F_C:0);setpair(2,idx,v);
}
void adchl(unsigned x,int subtraction){unsigned o=hl();int c=!!(zf&F_C);int r=subtraction?((int)o-(int)x-c):((int)o+(int)x+c);unsigned v=r&65535;
 int ff=((v>>8)&(F_S|F_5|F_3)) | ((v==0)?F_Z:0) | (((o^x^v)&4096)?F_H:0);
 if(subtraction){ff|=F_N;if((o^x)&(o^v)&32768)ff|=F_P;if(r<0)ff|=F_C;}
 else {if((~(o^x))&(o^v)&32768)ff|=F_P;if(r>65535)ff|=F_C;}
 zf=ff;sethl(v);
}
void daa(void){int old=za, oldf=zf, fix=0, c=(zf&F_C);
 if((zf&F_H)||( (!(zf&F_N)) && (za&15)>9))fix |=6;
 if(c || (!(zf&F_N) && za>0x99)){fix|=0x60;c=F_C;}
 if(zf&F_N)za=(za-fix)&255;else za=(za+fix)&255;
 zf=(oldf&F_N)|szp(za)|c|(((old^za)&0x10)?F_H:0);
}
int shiftcb(int op,int v){int carry=0;v &=255;int out=v;
 if(op==0){carry=(v>>7)&1;out=((v<<1)|carry)&255;}
 if(op==1){carry=v&1;out=(v>>1)|(carry<<7);}
 if(op==2){carry=(v>>7)&1;out=((v<<1)|(zf&F_C))&255;}
 if(op==3){carry=v&1;out=(v>>1)|((zf&F_C)<<7);}
 if(op==4){carry=v>>7;out=(v<<1)&255;}
 if(op==5){carry=v&1;out=(v>>1)|(v&0x80);}
 if(op==6){carry=v>>7;out=((v<<1)|1)&255;} /* undocumented SLL */
 if(op==7){carry=v&1;out=v>>1;}
 zf=szp(out)|(carry?F_C:0);return out;
}
void cbop(int op,int idx,int disp){int x=op>>6,y=(op>>3)&7,z=op&7;int v=rr8(idx?6:z,idx,disp);int out=v;
 if(x==0)out=shiftcb(y,v);
 else if(x==1){zf=(zf&F_C)|F_H|((v&(1<<y))?0:(F_Z|F_P))|((y==7&&(v&128))?F_S:0)|(v&(F_3|F_5));return;}
 else if(x==2)out=v&~(1<<y);
 else out=v|(1<<y);
 if(idx){wr8(6,idx,disp,out);if(z!=6)wr8(z,0,0,out);}
 else wr8(z,0,0,out);
}
int in_port(unsigned port){
 int v=255,i;
 if((port&1)==0){
  for(i=0;i<8;i++)if(!(port&(1<<(i+8))))v &= zx_keys[i];
  /* On the original ZX80, D6 is the TV-standard configuration bit:
     D6=1 for 50 Hz and D6=0 for 60 Hz (NTSC diode fitted).
     The NARM emulator defaults to 50 Hz / 65,000 Z80 T-states. */
  v=(v&0x1f) | 0x60 | (zx_tape_high?0x80:0);
  zx_video_sync=1;zx_video_in();
 }
 return v;
}
void out_port(unsigned port,int val){(void)port;(void)val;zx_video_sync=0;zx_video_out();}
void blockio(int op){int backwards=(op&8)?-1:1;int isout=(op&1);int repeat=(op&16);int oldb=zb;
 int value=isout?rb(hl()):in_port(bc());
 if(isout)out_port(bc(),value);else wb(hl(),value);
 sethl(hl()+backwards);zb=(zb-1)&255;
 /* approximate undocumented H/PV flags on block IO */
 zf=(zb&(F_S|F_5|F_3)) | ((zb==0)?F_Z:0) | ((value&128)?F_N:0);
 if(repeat && zb){zpc=(zpc-2)&65535;zcycles +=5;}
 (void)oldb;
}
void edop(int op){int y=(op>>3)&7,z=op&7,p=y>>1,q=y&1;int val;
 zcycles +=8;
 if((op&0xc7)==0x40){val=in_port(bc());if(y!=6)wr8(y,0,0,val);zf=(zf&F_C)|szp(val);zcycles=12;return;}
 if((op&0xc7)==0x41){val=(y==6)?0:rr8(y,0,0);out_port(bc(),val);zcycles=12;return;}
 /* ED 42/52/62/72 are SBC, ED 4A/5A/6A/7A are ADC. */
 if((op&0xcf)==0x42){adchl(getpair(p,0),1);zcycles=15;return;}
 if((op&0xcf)==0x4a){adchl(getpair(p,0),0);zcycles=15;return;}
 if((op&0xcf)==0x43){unsigned adr=fetch16();ww(adr,getpair(p,0));zcycles=20;return;}
 if((op&0xcf)==0x4b){unsigned adr=fetch16();setpair(p,0,rw(adr));zcycles=20;return;}
 if((op&0xc7)==0x44){za=sub8(0,za,0);zcycles=8;return;}
 if((op&0xc7)==0x45){zpc=pop16();ziff1=ziff2;zcycles=14;return;}
 if((op&0xc7)==0x46){zim=(y==2||y==6)?1:((y==3||y==7)?2:0);return;}
 if(op==0x47){zi=za;zcycles=9;return;}
 if(op==0x4f){zr=za;zcycles=9;return;}
 if(op==0x57||op==0x5f){za=(op==0x57)?zi:zr;zf=(zf&F_C)|(za&(F_S|F_5|F_3))|((za==0)?F_Z:0)|(ziff2?F_P:0);zcycles=9;return;}
 if(op==0x67||op==0x6f){int old=rb(hl());if(op==0x67){val=((za&15)<<4)|(old>>4);za=(za&0xf0)|(old&15);}else{val=((old<<4)&255)|(za&15);za=(za&0xf0)|(old>>4);}wb(hl(),val);zf=(zf&F_C)|szp(za);zcycles=18;return;}
 if((op&0xe4)==0xa0){int back=(op&8)?-1:1;int typ=op&3;int repeat=op&16;
  if(typ==0){val=rb(hl());wb(de(),val);sethl(hl()+back);setde(de()+back);setbc(bc()-1);zf=(zf&(F_S|F_Z|F_C))|(bc()?F_P:0)|((za+val)&(F_3|F_5));}
  else if(typ==1){int carry=zf&F_C;val=rb(hl());sub8(za,val,0);int keep=zf;sethl(hl()+back);setbc(bc()-1);zf=(keep&~(F_P|F_C))|carry|(bc()?F_P:0);}
  else {zcycles=16;blockio(op);return;}
  zcycles=16;
  if(repeat && bc() && (typ==0 || (zf&F_Z)==0)){zpc=(zpc-2)&65535;zcycles=21;}
  return;
 }
}
void z80_reset(void){
 za=zf=zb=zc=zd=ze=zh=zl=0;za2=zf2=zb2=zc2=zd2=ze2=zh2=zl2=0;
 zpc=0;zsp=0xffff;zix=ziy=0;zi=zr=0;ziff1=ziff2=zim=zhalt=zei_block=0;
 zcycles=ztotal_frame=zirq_counter=zbad_opcode=0;
 zx_video_activity=zx_video_sync=zx_video_rows=0;
 zx_video_irq_frame=zx_video_m1_frame=zx_video_gap_ticks=zx_video_max_gap=0;
 zx_djnz_seen=zx_djnz_taken=zx_djnz_wrong=zx_djnz_first_b=0;
 zx_video_raster_init();
}
/* Hardware refresh increments on each opcode M1 fetch, and during HALT. */
void increment_r(void){zr=(zr&0x80)|((zr+1)&127);}
int z80_step(void){
 int op,x,y,z,p,q,idx=0,disp=0,idx_mem=0,v,oldf;unsigned addr,tmp;
 int oldr=zr&127;
 zcycles=4;
 if(zhalt){increment_r();zcycles=4;}
 else {
  int opcode_addr=zpc;
  op=fetch8();increment_r();
  zx_video_m1((unsigned)opcode_addr,(unsigned)op);
  if((opcode_addr&0xc000)==0xc000)zx_video_m1_frame++;
  if((opcode_addr&0x8000) && !(op&0x40)) {op=0;zx_video_activity=1;} /* ZX80 video NOP injection */
  while(op==0xdd||op==0xfd){idx=(op==0xdd)?1:2;unsigned prefix_addr=zpc;op=fetch8();increment_r();zx_video_m1(prefix_addr,(unsigned)op);if((prefix_addr&0x8000)&&!(op&0x40))op=0;zcycles+=4;}
  if(op==0xcb){
    if(idx){disp=s8(fetch8());op=fetch8();cbop(op,idx,disp);zcycles=((op>>6)==1)?20:23;}
    else {unsigned cbaddr=zpc;op=fetch8();increment_r();zx_video_m1(cbaddr,(unsigned)op);if((cbaddr&0x8000)&&!(op&0x40))op=0;cbop(op,0,0);zcycles+=((op&7)==6?(((op>>6)==1)?8:11):4);}
  }
  else if(op==0xed){unsigned edaddr=zpc;op=fetch8();increment_r();zx_video_m1(edaddr,(unsigned)op);if((edaddr&0x8000)&&!(op&0x40))op=0;edop(op);zcycles+=idx?4:0;}
  else {
   x=op>>6;y=(op>>3)&7;z=op&7;p=y>>1;q=y&1;
   if(idx && ((x==1&& (y==6||z==6)) || (x==2 && z==6) || (x==0 && (z==4||z==5||z==6) && y==6))){idx_mem=1;disp=s8(fetch8());}
   if(x==0){
    if(z==0){
     if(y==0){}
     else if(y==1){v=za;za=za2;za2=v;v=zf;zf=zf2;zf2=v;}
     else if(y==2){
       v=fetch8();
       if(opcode_addr==0x05ce && zx_djnz_seen==0)zx_djnz_first_b=(unsigned)zb;
       zb=(zb-1)&255;
       if(opcode_addr==0x05ce)zx_djnz_seen++;
       if(zb){
         zpc=z80_relative(zpc,v);
         if(opcode_addr==0x05ce){if(zpc==0x05cc)zx_djnz_taken++;else zx_djnz_wrong++;}
         zcycles+=9;
       }else zcycles+=4;
      }
     else if(y==3){v=fetch8();zpc=z80_relative(zpc,v);zcycles+=8;}
     else {v=fetch8();if(condition(y-4)){zpc=z80_relative(zpc,v);zcycles+=8;}else zcycles+=3;}
    }
    else if(z==1){if(!q){setpair(p,idx,fetch16());zcycles+=6;}else{addhl(idx,getpair(p,idx));zcycles+=7;}}
    else if(z==2){
      if(p==0){if(q)za=rb(bc());else wb(bc(),za);zcycles+=3;}
      if(p==1){if(q)za=rb(de());else wb(de(),za);zcycles+=3;}
      if(p==2){addr=fetch16();if(q)setpair(2,idx,rw(addr));else ww(addr,getpair(2,idx));zcycles+=12;}
      if(p==3){addr=fetch16();if(q)za=rb(addr);else wb(addr,za);zcycles+=9;}
    }
    else if(z==3){setpair(p,idx,getpair(p,idx)+(q?-1:1));zcycles+=2;}
    else if(z==4){v=rr8(y,idx,disp);v=inc8(v);wr8(y,idx,disp,v);zcycles+=(y==6?7:0);}
    else if(z==5){v=rr8(y,idx,disp);v=dec8(v);wr8(y,idx,disp,v);zcycles+=(y==6?7:0);}
    else if(z==6){v=fetch8();wr8(y,idx,disp,v);zcycles+=(y==6?6:3);}
    else if(z==7){
      if(y==0){v=za>>7;za=((za<<1)|v)&255;zf=(zf&(F_S|F_Z|F_P))|(za&(F_3|F_5))|v;}
      else if(y==1){v=za&1;za=(za>>1)|(v<<7);zf=(zf&(F_S|F_Z|F_P))|(za&(F_3|F_5))|v;}
      else if(y==2){v=za>>7;za=((za<<1)|(zf&F_C))&255;zf=(zf&(F_S|F_Z|F_P))|(za&(F_3|F_5))|v;}
      else if(y==3){v=za&1;za=(za>>1)|((zf&F_C)<<7);zf=(zf&(F_S|F_Z|F_P))|(za&(F_3|F_5))|v;}
      else if(y==4)daa();
      else if(y==5){za ^=255;zf=(zf&(F_S|F_Z|F_P|F_C))|F_N|F_H|(za&(F_3|F_5));}
      else if(y==6){zf=(zf&(F_S|F_Z|F_P))|F_C|(za&(F_3|F_5));}
      else {v=zf&F_C;zf=(zf&(F_S|F_Z|F_P))|(za&(F_3|F_5))|(v?F_H:0)|(v?0:F_C);}
    }
   }
   else if(x==1){
    if(op==0x76){zhalt=1;zcycles=4;}
    else {
      v=rr8(z,idx,disp);
      /* For LD H/L,(IX+d) and LD (IX+d),H/L, H/L are not IXH/IXL. */
      if(idx_mem && y==6 && z==4)v=zh;
      if(idx_mem && y==6 && z==5)v=zl;
      if(idx_mem && z==6 && y==4){zh=v;zcycles+=3;}
      else if(idx_mem && z==6 && y==5){zl=v;zcycles+=3;}
      else {wr8(y,idx,disp,v);zcycles+=(y==6||z==6)?3:0;}
     }
   }
   else if(x==2){v=rr8(z,idx,disp);alu(y,v);zcycles+=(z==6?3:0);}
   else {
    if(z==0){if(condition(y)){zpc=pop16();zcycles+=7;}else zcycles+=1;}
    else if(z==1){
      if(q==0){setqq(p,idx,pop16());zcycles+=6;}
      else if(p==0){zpc=pop16();zcycles+=6;}
      else if(p==1){v=zb;zb=zb2;zb2=v;v=zc;zc=zc2;zc2=v;v=zd;zd=zd2;zd2=v;v=ze;ze=ze2;ze2=v;v=zh;zh=zh2;zh2=v;v=zl;zl=zl2;zl2=v;}
      else if(p==2){zpc=getpair(2,idx);}
      else {zsp=getpair(2,idx);zcycles+=2;}
    }
    else if(z==2){addr=fetch16();if(condition(y))zpc=addr;zcycles+=6;}
    else if(z==3){
      if(y==0){zpc=fetch16();zcycles+=6;}
      else if(y==1){/* CB handled above */}
      else if(y==2){v=fetch8();out_port((za<<8)|v,za);zcycles+=7;}
      else if(y==3){v=fetch8();za=in_port((za<<8)|v);zcycles+=7;}
      else if(y==4){v=rw(zsp);ww(zsp,getpair(2,idx));setpair(2,idx,v);zcycles+=15;}
      else if(y==5){v=de();setde(hl());sethl(v);}
      else if(y==6){ziff1=ziff2=0;zei_block=0;}
      else {ziff1=ziff2=1;zei_block=2;}
    }
    else if(z==4){addr=fetch16();if(condition(y)){push16(zpc);zpc=addr;zcycles+=13;}else zcycles+=6;}
    else if(z==5){
     if(q==0){push16(getqq(p,idx));zcycles+=7;}
     else if(p==0){addr=fetch16();push16(zpc);zpc=addr;zcycles+=13;}
     /* DD, ED, FD prefixes are handled before decode */
    }
    else if(z==6){alu(y,fetch8());zcycles+=3;}
    else {push16(zpc);zpc=y*8;zcycles+=7;}
   }
   if(idx){zcycles+=4;if(idx_mem)zcycles+=(x==0 && z==6)?5:8;}
  }
 }
 ztotal_frame+=zcycles;
 /* Absence of scanline IRQs is the real ZX80 loss-of-video event. Count
    executed T-states, including HALT refresh and ROM computation. */
 if(zx_video_gap_ticks<65535u){
  zx_video_gap_ticks+=((unsigned)zcycles);
  if(zx_video_gap_ticks>65535u)zx_video_gap_ticks=65535u;
 }
 if(zx_video_gap_ticks>zx_video_max_gap)zx_video_max_gap=zx_video_gap_ticks;
 if(zei_block>0)zei_block--;
 /* The ZX80 interrupt line is derived from R6 going low at 0x7f->0. */
 if((oldr&0x40) && !(zr&0x40) && ziff1 && !zei_block){
   if(zhalt)zhalt=0;
   ziff1=ziff2=0;
   push16(zpc);
   zpc=(zim==2)?rw((zi<<8)|0xff):0x38;
   zcycles+=13;ztotal_frame+=13;
   zirq_counter++;
   zx_video_irq();
   zx_video_irq_frame++;
   zx_video_gap_ticks=0;
   zx_video_rows++;
 }
 zx_clock_ticks+=(unsigned)zcycles;return zcycles;
}
