/*
 * Existing-world ChunkProvider adapter. Minecraft 1.0 keys loaded chunks by
 * their exact signed coordinates and loads complete Chunk/NibbleArray data
 * before publishing the chunk. This fixed nine-slot provider preserves those
 * invariants without pretending missing/corrupt chunks are generated air.
 *
 * A transition is NOT whole-window atomic: each replacement is staged and
 * validated before its old slot is touched, but five diagonal replacements
 * cannot all be staged in one buffer. Render/physics remain blocked until all
 * nine target chunks AND their neighbor-dependent cache are complete. On
 * failure each published slot is valid; retry/retarget reloads any missing
 * coordinates. No pointers to NBT/parser/staging memory escape a commit.
 */
#if defined(MC10_PLAYER_FOUNDATION) && !defined(MC10_AUTOPROFILE)
#define MC_STREAM_IDLE 0
#define MC_STREAM_LOADING 1
#define MC_STREAM_REBUILDING 2
#define MC_STREAM_COLORS 3
#define MC_STREAM_ERR_CANCELLED -44
#define MC_STREAM_ERR_RANGE -45
#define MC_STREAM_ERR_STATE -46
#define MC_STREAM_ERR_ACCESS -47
#define MC_STREAM_ERR_BLOCK -48
#define MC_STREAM_ERR_ASSET -49
#define MC_STREAM_STAGE_BYTES 82176

void mc_render_rebuild_begin(void);
void mc_render_rebuild_cancel(void);
int mc_render_rebuild_step(void);
int mc_render_rebuild_block_error(void);

char mc_stream_staging[MC_STREAM_STAGE_BYTES];
struct MCResidentChunk mc_stream_staged;
int mc_stream_status;
int mc_stream_dirty;
int mc_stream_target_x,mc_stream_target_z;
int mc_stream_failed_x,mc_stream_failed_z;
int mc_stream_commits;
uint mc_stream_generation;

int mc_stream_target_contains(int x,int z)
{
    return x>=mc_stream_target_x-1&&x<=mc_stream_target_x+1&&
           z>=mc_stream_target_z-1&&z<=mc_stream_target_z+1;
}

int mc_stream_target_complete(void)
{
    int dx,dz;
    for(dz=-1;dz<=1;dz=dz+1)for(dx=-1;dx<=1;dx=dx+1)
        if(!mc_runtime_chunk_exists(mc_stream_target_x+dx,mc_stream_target_z+dz))return 0;
    return 1;
}

int mc_stream_ready(void)
{
    return mc_stream_status==MC_STREAM_IDLE&&!mc_stream_dirty&&mc_runtime_access_ok;
}

/* New-world reset invalidates compilation, not resident coordinate tags. */
void mc_stream_reset(void)
{
    mc_render_rebuild_cancel();
    mc_stream_status=MC_STREAM_IDLE;mc_stream_dirty=1;mc_runtime_access_ok=0;
    mc_stream_target_x=mc_runtime_center_x;mc_stream_target_z=mc_runtime_center_z;
    mc_stream_failed_x=0;mc_stream_failed_z=0;mc_stream_commits=0;mc_stream_generation=0;
}

/* 1 ready, 0 pending, negative explicit error. Repeated same failed requests
 * never busy-loop SD retries; the UI must call retry or select another target. */
int mc_stream_request(int x,int z)
{
    if(x==mc_stream_target_x&&z==mc_stream_target_z)
    {
        if(mc_stream_status<0)return mc_stream_status;
        if(mc_stream_status>0)return 0;
        if(mc_stream_ready()&&mc_runtime_center_x==x&&mc_runtime_center_z==z)return 1;
    }
    mc_render_rebuild_cancel();mc_runtime_access_ok=0;mc_stream_dirty=1;
    mc_stream_target_x=x;mc_stream_target_z=z;
    /* All nine chunks must stay inside World's exact +/-30,000,000 bounds. */
    if(x < -1874999 || x > 1874998 || z < -1874999 || z > 1874998)
    {mc_stream_status=MC_STREAM_ERR_RANGE;mc_stream_failed_x=x;mc_stream_failed_z=z;return mc_stream_status;}
    mc_stream_status=MC_STREAM_LOADING;return 0;
}

int mc_stream_retry(void)
{
    if(mc_stream_status>=0)return mc_stream_ready()?1:0;
    mc_stream_status=MC_STREAM_IDLE;
    return mc_stream_request(mc_stream_target_x,mc_stream_target_z);
}

void mc_stream_cancel(void)
{
    mc_render_rebuild_cancel();mc_runtime_access_ok=0;mc_stream_dirty=1;
    mc_stream_status=MC_STREAM_ERR_CANCELLED;
}

void mc_stream_recount(void)
{
    int i;struct MCResidentChunk *r;
    mc_runtime_loaded=0;mc_runtime_missing=0;mc_runtime_invalid=0;
    mc_runtime_entities=0;mc_runtime_tiles=0;mc_runtime_ticks=0;
    for(i=0;i<MC_RUNTIME_CHUNKS;i=i+1)
    {
        r=&mc_runtime_chunks[i];
        if(r->state==1)
        {
            mc_runtime_loaded=mc_runtime_loaded+1;
            mc_runtime_entities=mc_runtime_entities+r->chunk.entity_count;
            mc_runtime_tiles=mc_runtime_tiles+r->chunk.tile_entity_count;
            mc_runtime_ticks=mc_runtime_ticks+r->chunk.tile_tick_count;
        }
        else if(r->state==2)mc_runtime_missing=mc_runtime_missing+1;
        else if(r->state==3)mc_runtime_invalid=mc_runtime_invalid+1;
    }
}

/* Publish state last, after all arrays and their fixed-slot bindings agree.
 * No yield between invalidation and publication; caller has already flushed
 * frame submissions and suspended collision/render access. */
void mc_stream_commit(int slot)
{
    int i;struct MCResidentChunk *r=&mc_runtime_chunks[slot];
    struct MCChunk *s=&mc_stream_staged.chunk;
    r->state=0;
    for(i=0;i<MC_CHUNK_BLOCK_COUNT;i=i+1)
        mc_runtime_blocks[slot*MC_CHUNK_BLOCK_COUNT+i]=mc_stream_staging[i];
    for(i=0;i<MC_CHUNK_NIBBLE_BYTES;i=i+1)
    {
        mc_runtime_metadata[slot*MC_CHUNK_NIBBLE_BYTES+i]=mc_stream_staging[32768+i];
        mc_runtime_skylight[slot*MC_CHUNK_NIBBLE_BYTES+i]=mc_stream_staging[49152+i];
        mc_runtime_blocklight[slot*MC_CHUNK_NIBBLE_BYTES+i]=mc_stream_staging[65536+i];
    }
    for(i=0;i<256;i=i+1)mc_runtime_heightmap[slot*256+i]=mc_stream_staging[81920+i];
    mc_nibble_array_bind(&r->data,&mc_runtime_metadata[slot*MC_CHUNK_NIBBLE_BYTES],7);
    mc_nibble_array_bind(&r->skylight,&mc_runtime_skylight[slot*MC_CHUNK_NIBBLE_BYTES],7);
    mc_nibble_array_bind(&r->blocklight,&mc_runtime_blocklight[slot*MC_CHUNK_NIBBLE_BYTES],7);
    mc_chunk_bind(&r->chunk,&mc_runtime_blocks[slot*MC_CHUNK_BLOCK_COUNT],
                   &mc_runtime_heightmap[slot*256],&r->data,&r->skylight,&r->blocklight,
                   s->x_position,s->z_position);
    r->chunk.last_update_lo=s->last_update_lo;r->chunk.last_update_hi=s->last_update_hi;
    r->chunk.is_terrain_populated=s->is_terrain_populated;r->chunk.has_entities=s->has_entities;
    r->chunk.entity_count=s->entity_count;r->chunk.tile_entity_count=s->tile_entity_count;
    r->chunk.tile_tick_count=s->tile_tick_count;
    r->status=MC_REGION_OK;r->compression=mc_region_compression;
    r->relocated=mc_region_relocated;r->timestamp=mc_region_timestamp;r->raw_bytes=mc_region_raw_bytes;
    r->state=1;mc_stream_commits=mc_stream_commits+1;
    mc_stream_recount();
}

/* At most ONE complete region read/decode per pump. Center, cardinal, corner
 * priority is deterministic, but does not reorder rendering's slot traversal.
 * Loading itself is synchronous SD/zlib work; it is not claimed to be an
 * asynchronous or fixed-millisecond operation. Cache pumps are separately
 * bounded and never draw/clear/present over the last completed game image. */
int mc_stream_step(void)
{
    int dx,dz,distance,slot,i,x=0,z=0,found=0,result;
    struct MCResidentChunk *r;
    if(mc_stream_status<0)return mc_stream_status;
    if(mc_stream_status==MC_STREAM_IDLE)return mc_stream_ready()?1:0;
    if(mc_stream_status==MC_STREAM_LOADING)
    {
        for(distance=0;distance<=2&&!found;distance=distance+1)
            for(dz=-1;dz<=1&&!found;dz=dz+1)
                for(dx=-1;dx<=1&&!found;dx=dx+1)
                    if((dx<0?-dx:dx)+(dz<0?-dz:dz)==distance&&
                       !mc_runtime_chunk_exists(mc_stream_target_x+dx,mc_stream_target_z+dz))
                    {x=mc_stream_target_x+dx;z=mc_stream_target_z+dz;found=1;}
        if(found)
        {
            slot=-1;
            for(i=0;i<MC_RUNTIME_CHUNKS;i=i+1)
            {
                r=&mc_runtime_chunks[i];
                if(r->state!=1||!mc_stream_target_contains(r->chunk.x_position,r->chunk.z_position))
                {slot=i;break;}
            }
            mc_stream_failed_x=x;mc_stream_failed_z=z;
            if(slot<0){mc_stream_status=MC_STREAM_ERR_STATE;return mc_stream_status;}
            mc_stream_staged.state=0;
            result=mc_region_load_chunk(mc_runtime_world.info,x,z,
                &mc_stream_staged.chunk,&mc_stream_staged.data,&mc_stream_staged.skylight,
                &mc_stream_staged.blocklight,&mc_stream_staging[0],&mc_stream_staging[32768],
                &mc_stream_staging[49152],&mc_stream_staging[65536],&mc_stream_staging[81920]);
            if(result!=MC_REGION_OK){mc_stream_status=result;return mc_stream_status;}
            /* Existing loader binds requested coords even when original NBT
             * needed relocation; never publish a mismatched coordinate tag. */
            if(!mc_chunk_is_at_location(&mc_stream_staged.chunk,x,z))
            {mc_stream_status=MC_STREAM_ERR_STATE;return mc_stream_status;}
            mc_stream_commit(slot);return 0;
        }
        mc_runtime_center_x=mc_stream_target_x;mc_runtime_center_z=mc_stream_target_z;
#ifdef MC10_WORLD_SYSTEMS
        mc_block_colors_begin(mc_stream_target_x,mc_stream_target_z);
        mc_stream_status=MC_STREAM_COLORS;return 0;
#else
        mc_render_rebuild_begin();mc_stream_status=MC_STREAM_REBUILDING;return 0;
#endif
    }
#ifdef MC10_WORLD_SYSTEMS
    if(mc_stream_status==MC_STREAM_COLORS)
    {
        result=mc_block_colors_pump();
        if(result<0){mc_stream_status=MC_STREAM_ERR_ASSET;return mc_stream_status;}
        if(!result)return 0;
        mc_render_rebuild_begin();mc_stream_status=MC_STREAM_REBUILDING;return 0;
    }
#endif
    if(!mc_render_rebuild_step())return 0;
#ifdef MC10_WORLD_SYSTEMS
    if(mc_block_mesh_error||mc_tint_error){mc_stream_status=MC_STREAM_ERR_ASSET;return mc_stream_status;}
#endif
    if(mc_render_rebuild_block_error())
    {mc_stream_status=MC_STREAM_ERR_BLOCK;return mc_stream_status;}
    if(!mc_stream_target_complete()||!mc_runtime_verify_access())
    {mc_stream_status=MC_STREAM_ERR_ACCESS;return mc_stream_status;}
    mc_stream_recount();mc_runtime_access_ok=1;mc_stream_dirty=0;
    mc_stream_status=MC_STREAM_IDLE;mc_stream_generation=mc_stream_generation+1;
    return 1;
}
#endif
