void mc_blocks_set_graphics_level(int fancy)
{mc_blocks[18].opaque_cube=!fancy;mc_blocks[18].texture=fancy?52:53;}

int mc_block_ray_collidable(uint id,uint metadata,int liquids)
{
    if(id==0||id>122||id==51)return 0;
    if(id>=8&&id<=11)return liquids&&metadata==0;
    return 1;
}
int mc_block_neighbor(uint id,int x,int y,int z)
{
    uint n=0;mc_runtime_try_get_block(x,y,z,&n);
    if(id==85||id==113)return n==id||n==107||(n!=0&&n<256&&mc_blocks[n].present&&mc_material_is_opaque(mc_blocks[n].material)&&mc_blocks[n].normal_block&&mc_blocks[n].material!=MC_MATERIAL_PUMPKIN);
    if(id==101||id==102)return n==id||n==20||n==18||mc_block_is_opaque(n);
    return n==id;
}
