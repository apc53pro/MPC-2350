    if(id==106){*x0=1;*y0=1;*z0=1;*x1=0;*y1=0;*z1=0;if(metadata&2){*x0=0;*x1=.0625f;*y0=0;*y1=1;*z0=0;*z1=1;}if(metadata&8){if(*x0>.9375f)*x0=.9375f;*x1=1;*y0=0;*y1=1;*z0=0;*z1=1;}if(metadata&4){*x0=0;*x1=1;*y0=0;*y1=1;*z0=0;if(*z1<.0625f)*z1=.0625f;}if(metadata&1){*x0=0;*x1=1;*y0=0;*y1=1;if(*z0>.9375f)*z0=.9375f;*z1=1;}if(metadata==0&&mc_runtime_try_get_block(x,y+1,z,&above)&&above<256&&mc_blocks[above].normal_block&&mc_materials[mc_blocks[above].material].blocks_movement){*x0=0;*x1=1;*y0=.9375f;*y1=1;*z0=0;*z1=1;}}
}

/* 0 invalid ID; 1 complete static block; 2 static model with active tile
 * portion pending; 3 special visual renderer pending; 4 unsafe dynamic shape.
 * Status is deliberately distinct from material/ID registration. */
int mc_block_static_status(uint id)
{
    if(id==0)return 1;
    if(id>122||!mc_blocks[id].present)return 0;
    if(id==36)return 4;
    if(id==119)return 3;
    if(id==52||id==54||id==63||id==68||id==116)return 2;
    return 1;
}
float mc_block_slipperiness(uint id)
{return id==79?.98f:.6f;}
#endif

