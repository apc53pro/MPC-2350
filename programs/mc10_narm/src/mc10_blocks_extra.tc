    mc_runtime_try_get_block(x-1,y,z,&w);mc_runtime_try_get_block(x+1,y,z,&e);
    if(id==95||n!=id&&s!=id&&w!=id&&e!=id)
    {if(mc_block_is_opaque(n)&&!mc_block_is_opaque(s))front=3;if(mc_block_is_opaque(s)&&!mc_block_is_opaque(n))front=2;if(mc_block_is_opaque(w)&&!mc_block_is_opaque(e))front=5;if(mc_block_is_opaque(e)&&!mc_block_is_opaque(w))front=4;return side==front?27:26;}
    if(n!=id&&s!=id){if(side==4||side==5)return 26;offset=w==id?-1:0;mc_runtime_try_get_block(w==id?x-1:x+1,y,z-1,&a);mc_runtime_try_get_block(w==id?x-1:x+1,y,z+1,&b);if(side==3)offset=-1-offset;if((mc_block_is_opaque(n)||mc_block_is_opaque(a))&&!mc_block_is_opaque(s)&&!mc_block_is_opaque(b))front=3;if((mc_block_is_opaque(s)||mc_block_is_opaque(b))&&!mc_block_is_opaque(n)&&!mc_block_is_opaque(a))front=2;return (side==front?42:58)+offset;}
    if(side==2||side==3)return 26;offset=n==id?-1:0;mc_runtime_try_get_block(x-1,y,n==id?z-1:z+1,&a);mc_runtime_try_get_block(x+1,y,n==id?z-1:z+1,&b);if(side==4)offset=-1-offset;front=5;if((mc_block_is_opaque(w)||mc_block_is_opaque(a))&&!mc_block_is_opaque(e)&&!mc_block_is_opaque(b))front=5;if((mc_block_is_opaque(e)||mc_block_is_opaque(b))&&!mc_block_is_opaque(w)&&!mc_block_is_opaque(a))front=4;return(side==front?42:58)+offset;
}
