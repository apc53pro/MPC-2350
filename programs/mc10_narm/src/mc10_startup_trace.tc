#ifdef MC10_STARTUP_DIAGNOSTIC
/* Platform-only startup isolation. No save/options writes, no performance
 * measurements. A completed readback is a checkpoint, not proof of causation
 * or a guarantee against SD-controller/power-loss caching.
 */
char mc_startup_path[MC_GAME_PATH_CAP];
char mc_startup_line[192];
char mc_startup_verify[192];
uint mc_startup_offset,mc_startup_sequence;
int mc_startup_error,mc_startup_ready,mc_startup_screen_ready;
int mc_startup_chunk,mc_startup_x,mc_startup_z;
/* Runtime gate retains the benchmark/renderer code and their fixed pools.
 * This diagnostic does not intentionally shrink the Build 15 working set. */
int mc_startup_isolation_only=1;

int mc_startup_write_line(void)
{
    uint length,offset,amount,size;int count,i;
    if(!mc_startup_ready||mc_startup_error)return 0;
    length=(uint)mc_world_strlen(mc_startup_line);offset=0;
    while(offset<length)
    {
        count=narm_file_write(mc_startup_path,&mc_startup_line[offset],
                             mc_startup_offset+offset,length-offset,mc_game_storage);
        if(count<=0||(uint)count>length-offset){mc_startup_error=1;return 0;}
        offset=offset+(uint)count;
    }
    if(narm_file_size(mc_startup_path,mc_game_storage,&size)<0||
       size!=mc_startup_offset+length){mc_startup_error=2;return 0;}
    amount=length;
    count=narm_file_read(mc_startup_path,mc_startup_verify,mc_startup_offset,amount,mc_game_storage);
    if(count!=(int)amount){mc_startup_error=3;return 0;}
    for(i=0;i<count;i=i+1)
        if(mc_startup_verify[i]!=mc_startup_line[i]){mc_startup_error=4;return 0;}
    mc_startup_offset=mc_startup_offset+length;
    return 1;
}
int mc_startup_checkpoint(char *stage,int status)
{
    if(!mc_startup_ready||mc_startup_error)return 0;
    mc_startup_line[0]=0;
    mc_world_append_uint(mc_startup_line,192,mc_startup_sequence+1);
    mc_world_append_char(mc_startup_line,192,',');
    mc_world_append_int(mc_startup_line,192,mc_startup_chunk);
    mc_world_append_char(mc_startup_line,192,',');
    mc_world_append_int(mc_startup_line,192,mc_startup_x);
    mc_world_append_char(mc_startup_line,192,',');
    mc_world_append_int(mc_startup_line,192,mc_startup_z);
    mc_world_append_char(mc_startup_line,192,',');
    mc_world_append_int(mc_startup_line,192,status);
    mc_world_append_char(mc_startup_line,192,',');
    mc_world_append(mc_startup_line,192,stage);
    mc_world_append_char(mc_startup_line,192,'\n');
    if(!mc_startup_write_line())return 0;
    mc_startup_sequence=mc_startup_sequence+1;
    if(mc_startup_screen_ready)
    {
        narm_half_fill_rect(0,177,320,240,MC_COLOR_BLACK);
        mc_menu_draw_centered_string("BUILD 16 - LEGACY FONT / STARTUP ONLY",160,181,0xffff55);
        mc_menu_draw_centered_string(mc_startup_path,160,195,0xffffff);
        mc_menu_draw_centered_string(stage,160,209,0x55ff55);
        mc_menu_draw_centered_string("Checkpoint verified on SD",160,223,0xa0a0a0);
        narm_half_present();
    }
    return 1;
}
int mc_startup_trace_begin(void)
{
    char name[16];
    int run,result;uint size;
    mc_startup_ready=0;mc_startup_error=0;mc_startup_screen_ready=0;
    mc_startup_offset=0;mc_startup_sequence=0;
    mc_startup_chunk=0;mc_startup_x=0;mc_startup_z=0;
    if(narm_storage_mount(mc_game_storage)<=0)return 0;
    if(narm_dir_make(mc_game_profiles_path,mc_game_storage)<=0&&
       narm_file_exists(mc_game_profiles_path,mc_game_storage)<=0)return 0;
    for(run=1;run<=9999;run=run+1)
    {
        mc_world_copy(name,16,"s16_");
        mc_world_append_char(name,16,(char)('0'+run/1000));
        mc_world_append_char(name,16,(char)('0'+(run/100)%10));
        mc_world_append_char(name,16,(char)('0'+(run/10)%10));
        mc_world_append_char(name,16,(char)('0'+run%10));
        mc_world_append(name,16,".log");
        if(!mc_game_join_path(mc_startup_path,mc_game_profiles_path,name))return 0;
        result=narm_file_size(mc_startup_path,mc_game_storage,&size);
        if(result==0||narm_file_exists(mc_startup_path,mc_game_storage)>0)continue;
        if(result!=-3)return 0;
        break;
    }
    if(run>9999||narm_file_create(mc_startup_path,mc_game_storage)<=0)return 0;
    mc_startup_ready=1;
    mc_world_copy(mc_startup_line,192,"MC10 Build 16 startup isolation; legacy pixel font; no 3D benchmark\n");
    if(!mc_startup_write_line())return 0;
    mc_world_copy(mc_startup_line,192,"Checkpoints alter timing and SD I/O; last verified line is not a diagnosis.\n");
    if(!mc_startup_write_line())return 0;
    mc_world_copy(mc_startup_line,192,"sequence,chunk_1based,x,z,status_or_bytes,stage\n");
    return mc_startup_write_line();
}
#endif
