/*
 * Minecraft 1.0 NBT and CompressedStreamTools compatibility layer.
 *
 * The tag rules below follow NBTBase/NBTTag* from the audited 1.0 client.
 * Java allocation is adapted to bounded NARM-owned pools; exhaustion and
 * Java exception cases are reported as negative return values.
 */

#define MC_NBT_END 0
#define MC_NBT_BYTE 1
#define MC_NBT_SHORT 2
#define MC_NBT_INT 3
#define MC_NBT_LONG 4
#define MC_NBT_FLOAT 5
#define MC_NBT_DOUBLE 6
#define MC_NBT_BYTE_ARRAY 7
#define MC_NBT_STRING 8
#define MC_NBT_LIST 9
#define MC_NBT_COMPOUND 10

#define MC_NBT_MAX_TAGS 2048
#define MC_NBT_MAX_LINKS 4096
#define MC_NBT_MAX_CHARS 32768
#define MC_NBT_MAX_BYTES 262144
#define MC_NBT_IO_BYTES 393216
#define MC_NBT_MAX_DEPTH 64

#define MC_NBT_OK 0
#define MC_NBT_ERR_FORMAT -1
#define MC_NBT_ERR_CAPACITY -2
#define MC_NBT_ERR_TYPE -3
#define MC_NBT_ERR_IO -4
#define MC_NBT_ERR_CRC -5

struct MCNBTTag {
    int type;
    int key_off;
    int key_len;
    uint lo;
    uint hi;
    int data_off;
    int data_len;
    int first;
    int last;
    int count;
    int list_type;
};

struct MCNBTReader {
    unsigned char *data;
    uint size;
    uint pos;
    int error;
};

struct MCNBTWriter {
    unsigned char *data;
    uint capacity;
    uint pos;
    int error;
};

struct MCNBTBits {
    unsigned char *data;
    uint size;
    uint pos;
    uint hold;
    int bits;
    int error;
};

struct MCNBTHuffman {
    uint count[16];
    uint symbol[320];
};

struct MCNBTTag mc_nbt_tags[MC_NBT_MAX_TAGS];
int mc_nbt_link_tag[MC_NBT_MAX_LINKS];
int mc_nbt_link_next[MC_NBT_MAX_LINKS];
uint mc_nbt_chars[MC_NBT_MAX_CHARS];
#ifdef MC10_WORLD_SYSTEMS
#include "mc10_workspace.tc"
#define mc_nbt_io ((unsigned char *)&mc_world_workspace[0])
#define mc_nbt_file_data ((unsigned char *)&mc_world_workspace[98304])
#define mc_nbt_bytes ((unsigned char *)&mc_world_workspace[196608])
#else
unsigned char mc_nbt_bytes[MC_NBT_MAX_BYTES];
unsigned char mc_nbt_io[MC_NBT_IO_BYTES];
unsigned char mc_nbt_file_data[MC_NBT_IO_BYTES];
#endif
uint mc_nbt_lengths[320];
struct MCNBTHuffman mc_nbt_lit_huffman;
struct MCNBTHuffman mc_nbt_dist_huffman;
struct MCNBTHuffman mc_nbt_code_huffman;
unsigned char mc_nbt_fixed_vector[25] = {
    0x4b,0xcb,0xac,0x48,0x4d,0xd1,0xcd,0x28,0x4d,0x4b,
    0xcb,0x4d,0xcc,0xd3,0x4d,0xca,0xc9,0x4f,0xce,0xd6,
    0x4d,0xc3,0x14,0x03,0x00
};
unsigned char mc_nbt_fixed_expected[39] = {
    0x66,0x69,0x78,0x65,0x64,0x2d,0x68,0x75,0x66,0x66,
    0x6d,0x61,0x6e,0x2d,0x62,0x6c,0x6f,0x63,0x6b,0x2d,
    0x66,0x69,0x78,0x65,0x64,0x2d,0x68,0x75,0x66,0x66,
    0x6d,0x61,0x6e,0x2d,0x62,0x6c,0x6f,0x63,0x6b
};
int mc_nbt_tag_used;
int mc_nbt_link_used;
int mc_nbt_char_used;
int mc_nbt_byte_used;

void mc_nbt_reset(void)
{
    mc_nbt_tag_used = 0;
    mc_nbt_link_used = 0;
    mc_nbt_char_used = 0;
    mc_nbt_byte_used = 0;
}

int mc_nbt_valid_type(int type)
{
    return type >= MC_NBT_END && type <= MC_NBT_COMPOUND;
}

int mc_nbt_new_tag(int type)
{
    int id;
    struct MCNBTTag *tag;
    if (!mc_nbt_valid_type(type) || mc_nbt_tag_used >= MC_NBT_MAX_TAGS) return -1;
    id = mc_nbt_tag_used++;
    tag = &mc_nbt_tags[id];
    tag->type = type;
    tag->key_off = 0;
    tag->key_len = 0;
    tag->lo = 0;
    tag->hi = 0;
    tag->data_off = 0;
    tag->data_len = 0;
    tag->first = -1;
    tag->last = -1;
    tag->count = 0;
    tag->list_type = 0;
    return id;
}

int mc_nbt_store_chars(uint *chars, int length)
{
    int off;
    int i;
    if (length < 0 || mc_nbt_char_used + length > MC_NBT_MAX_CHARS) return -1;
    off = mc_nbt_char_used;
    for (i = 0; i < length; i = i + 1) mc_nbt_chars[mc_nbt_char_used++] = chars[i] & 0xffff;
    return off;
}

int mc_nbt_store_ascii(char *text, int *length_out)
{
    int length = 0;
    int off;
    while (text[length] != 0) length = length + 1;
    if (mc_nbt_char_used + length > MC_NBT_MAX_CHARS) return -1;
    off = mc_nbt_char_used;
    while (mc_nbt_char_used < off + length)
    {
        mc_nbt_chars[mc_nbt_char_used] = (uint)(text[mc_nbt_char_used - off] & 255);
        mc_nbt_char_used = mc_nbt_char_used + 1;
    }
    *length_out = length;
    return off;
}

int mc_nbt_set_key_ascii(int tag_id, char *key)
{
    int length;
    int off;
    if (tag_id < 0 || tag_id >= mc_nbt_tag_used) return MC_NBT_ERR_FORMAT;
    off = mc_nbt_store_ascii(key, &length);
    if (off < 0) return MC_NBT_ERR_CAPACITY;
    mc_nbt_tags[tag_id].key_off = off;
    mc_nbt_tags[tag_id].key_len = length;
    return MC_NBT_OK;
}

int mc_nbt_chars_equal(int a_off, int a_len, int b_off, int b_len)
{
    int i;
    if (a_len != b_len) return 0;
    for (i = 0; i < a_len; i = i + 1)
        if (mc_nbt_chars[a_off + i] != mc_nbt_chars[b_off + i]) return 0;
    return 1;
}

int mc_nbt_key_equals_ascii(int tag_id, char *key)
{
    int i = 0;
    struct MCNBTTag *tag;
    if (tag_id < 0 || tag_id >= mc_nbt_tag_used) return 0;
    tag = &mc_nbt_tags[tag_id];
    while (key[i] != 0)
    {
        if (i >= tag->key_len || mc_nbt_chars[tag->key_off + i] != (uint)(key[i] & 255)) return 0;
        i = i + 1;
    }
    return i == tag->key_len;
}

int mc_nbt_add_child(int parent_id, int child_id)
{
    int link;
    struct MCNBTTag *parent;
    if (parent_id < 0 || parent_id >= mc_nbt_tag_used || child_id < 0 || child_id >= mc_nbt_tag_used)
        return MC_NBT_ERR_FORMAT;
    if (mc_nbt_link_used >= MC_NBT_MAX_LINKS) return MC_NBT_ERR_CAPACITY;
    parent = &mc_nbt_tags[parent_id];
    link = mc_nbt_link_used++;
    mc_nbt_link_tag[link] = child_id;
    mc_nbt_link_next[link] = -1;
    if (parent->last >= 0) mc_nbt_link_next[parent->last] = link;
    else parent->first = link;
    parent->last = link;
    parent->count = parent->count + 1;
    if (parent->type == MC_NBT_LIST) parent->list_type = mc_nbt_tags[child_id].type;
    return MC_NBT_OK;
}

int mc_nbt_compound_find(int compound_id, char *key)
{
    int link;
    int child;
    if (compound_id < 0 || compound_id >= mc_nbt_tag_used ||
        mc_nbt_tags[compound_id].type != MC_NBT_COMPOUND) return -1;
    link = mc_nbt_tags[compound_id].first;
    while (link >= 0)
    {
        child = mc_nbt_link_tag[link];
        if (mc_nbt_key_equals_ascii(child, key)) return child;
        link = mc_nbt_link_next[link];
    }
    return -1;
}

int mc_nbt_compound_put(int compound_id, int child_id)
{
    int link;
    int old;
    struct MCNBTTag *child;
    if (compound_id < 0 || compound_id >= mc_nbt_tag_used ||
        mc_nbt_tags[compound_id].type != MC_NBT_COMPOUND ||
        child_id < 0 || child_id >= mc_nbt_tag_used) return MC_NBT_ERR_TYPE;
    child = &mc_nbt_tags[child_id];
    link = mc_nbt_tags[compound_id].first;
    while (link >= 0)
    {
        old = mc_nbt_link_tag[link];
        if (mc_nbt_chars_equal(mc_nbt_tags[old].key_off, mc_nbt_tags[old].key_len,
                               child->key_off, child->key_len))
        {
            mc_nbt_link_tag[link] = child_id;
            return MC_NBT_OK;
        }
        link = mc_nbt_link_next[link];
    }
    return mc_nbt_add_child(compound_id, child_id);
}

int mc_nbt_list_set_tag(int list_id, int child_id)
{
    if (list_id < 0 || list_id >= mc_nbt_tag_used || mc_nbt_tags[list_id].type != MC_NBT_LIST)
        return MC_NBT_ERR_TYPE;
    return mc_nbt_add_child(list_id, child_id);
}

int mc_nbt_list_tag_at(int list_id, int index)
{
    int link;
    if (list_id < 0 || list_id >= mc_nbt_tag_used || mc_nbt_tags[list_id].type != MC_NBT_LIST || index < 0)
        return -1;
    link = mc_nbt_tags[list_id].first;
    while (link >= 0 && index > 0) { link = mc_nbt_link_next[link]; index = index - 1; }
    return link < 0 ? -1 : mc_nbt_link_tag[link];
}

int mc_nbt_list_tag_count(int list_id)
{
    if (list_id < 0 || list_id >= mc_nbt_tag_used || mc_nbt_tags[list_id].type != MC_NBT_LIST) return 0;
    return mc_nbt_tags[list_id].count;
}

int mc_nbt_new_named_scalar(int type, char *key, uint hi, uint lo)
{
    int id = mc_nbt_new_tag(type);
    if (id < 0) return -1;
    if (mc_nbt_set_key_ascii(id, key) < 0) return -1;
    mc_nbt_tags[id].hi = hi;
    mc_nbt_tags[id].lo = lo;
    return id;
}

int mc_nbt_compound_set_scalar(int compound_id, int type, char *key, uint hi, uint lo)
{
    int id = mc_nbt_new_named_scalar(type, key, hi, lo);
    if (id < 0) return MC_NBT_ERR_CAPACITY;
    return mc_nbt_compound_put(compound_id, id);
}

int mc_nbt_compound_set_byte(int id, char *key, int value)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_BYTE, key, 0, (uint)value & 255); }
int mc_nbt_compound_set_short(int id, char *key, int value)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_SHORT, key, 0, (uint)value & 0xffff); }
int mc_nbt_compound_set_int(int id, char *key, int value)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_INT, key, 0, (uint)value); }
int mc_nbt_compound_set_long_bits(int id, char *key, uint hi, uint lo)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_LONG, key, hi, lo); }
int mc_nbt_compound_set_float_bits(int id, char *key, uint bits)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_FLOAT, key, 0, bits); }
int mc_nbt_compound_set_double_bits(int id, char *key, uint hi, uint lo)
{ return mc_nbt_compound_set_scalar(id, MC_NBT_DOUBLE, key, hi, lo); }
int mc_nbt_compound_set_boolean(int id, char *key, int value)
{ return mc_nbt_compound_set_byte(id, key, value ? 1 : 0); }

int mc_nbt_new_named_string(int type, char *key, char *value)
{
    int id;
    int length;
    int off;
    id = mc_nbt_new_tag(type);
    if (id < 0 || mc_nbt_set_key_ascii(id, key) < 0) return -1;
    off = mc_nbt_store_ascii(value, &length);
    if (off < 0) return -1;
    mc_nbt_tags[id].data_off = off;
    mc_nbt_tags[id].data_len = length;
    return id;
}

int mc_nbt_compound_set_string(int compound_id, char *key, char *value)
{
    int id = mc_nbt_new_named_string(MC_NBT_STRING, key, value);
    if (id < 0) return MC_NBT_ERR_CAPACITY;
    return mc_nbt_compound_put(compound_id, id);
}

int mc_nbt_compound_set_byte_array(int compound_id, char *key,
                                   unsigned char *value, int length)
{
    int id;
    int i;
    int span = length > 0 ? length : 1;
    if (length < 0 || mc_nbt_byte_used + span > MC_NBT_MAX_BYTES) return MC_NBT_ERR_CAPACITY;
    id = mc_nbt_new_tag(MC_NBT_BYTE_ARRAY);
    if (id < 0 || mc_nbt_set_key_ascii(id, key) < 0) return MC_NBT_ERR_CAPACITY;
    mc_nbt_tags[id].data_off = mc_nbt_byte_used;
    mc_nbt_tags[id].data_len = length;
    for (i = 0; i < length; i = i + 1) mc_nbt_bytes[mc_nbt_byte_used++] = value[i];
    if (length == 0) mc_nbt_byte_used = mc_nbt_byte_used + 1;
    return mc_nbt_compound_put(compound_id, id);
}

int mc_nbt_compound_has_key(int compound_id, char *key)
{ return mc_nbt_compound_find(compound_id, key) >= 0; }

int mc_nbt_compound_get_tag(int compound_id, char *key)
{ return mc_nbt_compound_find(compound_id, key); }

int mc_nbt_compound_set_tag(int compound_id, char *key, int child_id)
{
    int result = mc_nbt_set_key_ascii(child_id, key);
    if (result < 0) return result;
    return mc_nbt_compound_put(compound_id, child_id);
}

int mc_nbt_get_scalar_bits(int compound_id, char *key, int type, uint *hi, uint *lo)
{
    int id = mc_nbt_compound_find(compound_id, key);
    if (id < 0)
    {
        *hi = 0;
        *lo = 0;
        return 0;
    }
    if (mc_nbt_tags[id].type != type) return MC_NBT_ERR_TYPE;
    *hi = mc_nbt_tags[id].hi;
    *lo = mc_nbt_tags[id].lo;
    return 1;
}

int mc_nbt_get_int(int compound_id, char *key, int *value)
{
    uint hi;
    uint lo;
    int result = mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_INT, &hi, &lo);
    *value = (int)lo;
    return result;
}

int mc_nbt_get_byte(int compound_id, char *key, int *value)
{
    uint hi, lo;
    int result = mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_BYTE, &hi, &lo);
    *value = (int)(lo & 255); if (*value >= 128) *value = *value - 256;
    return result;
}

int mc_nbt_get_short(int compound_id, char *key, int *value)
{
    uint hi, lo;
    int result = mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_SHORT, &hi, &lo);
    *value = (int)(lo & 0xffff); if (*value >= 32768) *value = *value - 65536;
    return result;
}

int mc_nbt_get_float_bits(int compound_id, char *key, uint *bits)
{
    uint hi;
    return mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_FLOAT, &hi, bits);
}

int mc_nbt_get_double_bits(int compound_id, char *key, uint *hi, uint *lo)
{ return mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_DOUBLE, hi, lo); }

int mc_nbt_get_boolean(int compound_id, char *key, int *value)
{
    int byte_value;
    int result = mc_nbt_get_byte(compound_id, key, &byte_value);
    *value = byte_value != 0;
    return result;
}

int mc_nbt_get_byte_array(int compound_id, char *key, int *off, int *length)
{
    int id = mc_nbt_compound_find(compound_id, key);
    *off = 0; *length = 0;
    if (id < 0) return 0;
    if (mc_nbt_tags[id].type != MC_NBT_BYTE_ARRAY) return MC_NBT_ERR_TYPE;
    *off = mc_nbt_tags[id].data_off; *length = mc_nbt_tags[id].data_len;
    return 1;
}

int mc_nbt_get_container(int compound_id, char *key, int type)
{
    int id = mc_nbt_compound_find(compound_id, key);
    if (id >= 0) return mc_nbt_tags[id].type == type ? id : MC_NBT_ERR_TYPE;
    id = mc_nbt_new_tag(type);
    if (id < 0 || mc_nbt_set_key_ascii(id, key) < 0) return MC_NBT_ERR_CAPACITY;
    return id;
}

int mc_nbt_get_compound(int compound_id, char *key)
{ return mc_nbt_get_container(compound_id, key, MC_NBT_COMPOUND); }

int mc_nbt_get_list(int compound_id, char *key)
{ return mc_nbt_get_container(compound_id, key, MC_NBT_LIST); }

char *mc_nbt_type_name(int type)
{
    if (type == 0) return "TAG_End"; if (type == 1) return "TAG_Byte";
    if (type == 2) return "TAG_Short"; if (type == 3) return "TAG_Int";
    if (type == 4) return "TAG_Long"; if (type == 5) return "TAG_Float";
    if (type == 6) return "TAG_Double"; if (type == 7) return "TAG_Byte_Array";
    if (type == 8) return "TAG_String"; if (type == 9) return "TAG_List";
    if (type == 10) return "TAG_Compound"; return "UNKNOWN";
}

int mc_nbt_get_long_bits(int compound_id, char *key, uint *hi, uint *lo)
{ return mc_nbt_get_scalar_bits(compound_id, key, MC_NBT_LONG, hi, lo); }

int mc_nbt_get_string_ascii(int compound_id, char *key, char *out, int capacity)
{
    int id = mc_nbt_compound_find(compound_id, key);
    int i;
    uint c;
    if (capacity <= 0) return MC_NBT_ERR_CAPACITY;
    out[0] = 0;
    if (id < 0) return 0;
    if (mc_nbt_tags[id].type != MC_NBT_STRING) return MC_NBT_ERR_TYPE;
    for (i = 0; i < mc_nbt_tags[id].data_len && i + 1 < capacity; i = i + 1)
    {
        c = mc_nbt_chars[mc_nbt_tags[id].data_off + i];
        out[i] = c <= 127 ? (char)c : '?';
    }
    out[i] = 0;
    return 1;
}

int mc_nbt_find_same_key(int compound_id, int wanted_id)
{
    int link;
    int child;
    struct MCNBTTag *wanted = &mc_nbt_tags[wanted_id];
    link = mc_nbt_tags[compound_id].first;
    while (link >= 0)
    {
        child = mc_nbt_link_tag[link];
        if (mc_nbt_chars_equal(mc_nbt_tags[child].key_off, mc_nbt_tags[child].key_len,
                               wanted->key_off, wanted->key_len)) return child;
        link = mc_nbt_link_next[link];
    }
    return -1;
}

int mc_nbt_equals(int a, int b)
{
    struct MCNBTTag *ta;
    struct MCNBTTag *tb;
    int la;
    int lb;
    int other;
    if (a < 0 || b < 0 || a >= mc_nbt_tag_used || b >= mc_nbt_tag_used) return 0;
    ta = &mc_nbt_tags[a]; tb = &mc_nbt_tags[b];
    if (ta->type != tb->type || !mc_nbt_chars_equal(ta->key_off, ta->key_len, tb->key_off, tb->key_len)) return 0;
    if (ta->type >= MC_NBT_BYTE && ta->type <= MC_NBT_DOUBLE)
        return ta->lo == tb->lo && ta->hi == tb->hi;
    if (ta->type == MC_NBT_BYTE_ARRAY)
        return ta->data_off == tb->data_off && ta->data_len == tb->data_len;
    if (ta->type == MC_NBT_STRING)
        return mc_nbt_chars_equal(ta->data_off, ta->data_len, tb->data_off, tb->data_len);
    if (ta->type == MC_NBT_LIST)
    {
        if (ta->list_type != tb->list_type || ta->count != tb->count) return 0;
        la = ta->first; lb = tb->first;
        while (la >= 0 && lb >= 0)
        {
            if (!mc_nbt_equals(mc_nbt_link_tag[la], mc_nbt_link_tag[lb])) return 0;
            la = mc_nbt_link_next[la]; lb = mc_nbt_link_next[lb];
        }
        return la < 0 && lb < 0;
    }
    if (ta->type == MC_NBT_COMPOUND)
    {
        if (ta->count != tb->count) return 0;
        la = ta->first;
        while (la >= 0)
        {
            other = mc_nbt_find_same_key(b, mc_nbt_link_tag[la]);
            if (other < 0 || !mc_nbt_equals(mc_nbt_link_tag[la], other)) return 0;
            la = mc_nbt_link_next[la];
        }
    }
    return 1;
}

int mc_nbt_copy_tag(int source)
{
    int copy;
    int link;
    int child;
    int i;
    struct MCNBTTag *from;
    struct MCNBTTag *to;
    if (source < 0 || source >= mc_nbt_tag_used) return -1;
    from = &mc_nbt_tags[source];
    copy = mc_nbt_new_tag(from->type);
    if (copy < 0) return -1;
    to = &mc_nbt_tags[copy];
    if (from->type != MC_NBT_END)
    {
        to->key_off = mc_nbt_char_used;
        to->key_len = from->key_len;
        if (mc_nbt_char_used + from->key_len > MC_NBT_MAX_CHARS) return -1;
        for (i = 0; i < from->key_len; i = i + 1) mc_nbt_chars[mc_nbt_char_used++] = mc_nbt_chars[from->key_off + i];
    }
    to->hi = from->hi; to->lo = from->lo; to->list_type = from->list_type;
    if (from->type == MC_NBT_STRING)
    {
        to->data_off = mc_nbt_char_used; to->data_len = from->data_len;
        if (mc_nbt_char_used + from->data_len > MC_NBT_MAX_CHARS) return -1;
        for (i = 0; i < from->data_len; i = i + 1) mc_nbt_chars[mc_nbt_char_used++] = mc_nbt_chars[from->data_off + i];
    }
    else if (from->type == MC_NBT_BYTE_ARRAY)
    {
        to->data_off = mc_nbt_byte_used; to->data_len = from->data_len;
        if (mc_nbt_byte_used + (from->data_len > 0 ? from->data_len : 1) > MC_NBT_MAX_BYTES) return -1;
        for (i = 0; i < from->data_len; i = i + 1) mc_nbt_bytes[mc_nbt_byte_used++] = mc_nbt_bytes[from->data_off + i];
        if (from->data_len == 0) mc_nbt_byte_used = mc_nbt_byte_used + 1;
    }
    if (from->type == MC_NBT_LIST || from->type == MC_NBT_COMPOUND)
    {
        link = from->first;
        while (link >= 0)
        {
            child = mc_nbt_copy_tag(mc_nbt_link_tag[link]);
            if (child < 0 || mc_nbt_add_child(copy, child) < 0) return -1;
            link = mc_nbt_link_next[link];
        }
        to->list_type = from->list_type;
    }
    return copy;
}

uint mc_nbt_read_u8(struct MCNBTReader *r)
{
    if (r->pos >= r->size) { r->error = MC_NBT_ERR_FORMAT; return 0; }
    return r->data[r->pos++];
}

uint mc_nbt_read_u16(struct MCNBTReader *r)
{
    uint a = mc_nbt_read_u8(r);
    uint b = mc_nbt_read_u8(r);
    return (a << 8) | b;
}

uint mc_nbt_read_u32(struct MCNBTReader *r)
{
    uint a = mc_nbt_read_u16(r);
    uint b = mc_nbt_read_u16(r);
    return (a << 16) | b;
}

int mc_nbt_read_utf(struct MCNBTReader *r, int *off_out, int *len_out)
{
    uint byte_length = mc_nbt_read_u16(r);
    uint end;
    uint c;
    uint c2;
    uint c3;
    int off = mc_nbt_char_used;
    if (r->error < 0 || byte_length > r->size - r->pos) return MC_NBT_ERR_FORMAT;
    end = r->pos + byte_length;
    while (r->pos < end)
    {
        if (mc_nbt_char_used >= MC_NBT_MAX_CHARS) return MC_NBT_ERR_CAPACITY;
        c = mc_nbt_read_u8(r);
        if ((c & 0x80) == 0) mc_nbt_chars[mc_nbt_char_used++] = c;
        else if ((c & 0xe0) == 0xc0)
        {
            if (r->pos >= end) return MC_NBT_ERR_FORMAT;
            c2 = mc_nbt_read_u8(r);
            if ((c2 & 0xc0) != 0x80) return MC_NBT_ERR_FORMAT;
            mc_nbt_chars[mc_nbt_char_used++] = ((c & 0x1f) << 6) | (c2 & 0x3f);
        }
        else if ((c & 0xf0) == 0xe0)
        {
            if (r->pos + 1 >= end) return MC_NBT_ERR_FORMAT;
            c2 = mc_nbt_read_u8(r);
            c3 = mc_nbt_read_u8(r);
            if ((c2 & 0xc0) != 0x80 || (c3 & 0xc0) != 0x80) return MC_NBT_ERR_FORMAT;
            mc_nbt_chars[mc_nbt_char_used++] = ((c & 15) << 12) | ((c2 & 0x3f) << 6) | (c3 & 0x3f);
        }
        else return MC_NBT_ERR_FORMAT;
    }
    *off_out = off;
    *len_out = mc_nbt_char_used - off;
    return MC_NBT_OK;
}

int mc_nbt_parse_payload(struct MCNBTReader *r, int id, int depth);

/* Callers validate source and destination lengths before copying. */
void mc_nbt_copy_bytes(unsigned char *out, unsigned char *data, uint count)
{
#ifdef __NARM__
    memcpy(out, data, count);
#else
    uint i=0;
    for(;i+4<=count;i=i+4)
    {
        out[i]=data[i];
        out[i+1]=data[i+1];
        out[i+2]=data[i+2];
        out[i+3]=data[i+3];
    }
    for(;i<count;i=i+1)out[i]=data[i];
#endif
}

int mc_nbt_parse_named(struct MCNBTReader *r, int depth)
{
    int type;
    int id;
    int result;
    if (depth > MC_NBT_MAX_DEPTH) { r->error = MC_NBT_ERR_FORMAT; return -1; }
    type = (int)mc_nbt_read_u8(r);
    if (r->error < 0 || !mc_nbt_valid_type(type)) { r->error = MC_NBT_ERR_FORMAT; return -1; }
    id = mc_nbt_new_tag(type);
    if (id < 0) { r->error = MC_NBT_ERR_CAPACITY; return -1; }
    if (type == MC_NBT_END) return id;
    result = mc_nbt_read_utf(r, &mc_nbt_tags[id].key_off, &mc_nbt_tags[id].key_len);
    if (result < 0) { r->error = result; return -1; }
    result = mc_nbt_parse_payload(r, id, depth + 1);
    if (result < 0) { r->error = result; return -1; }
    return id;
}

int mc_nbt_parse_payload(struct MCNBTReader *r, int id, int depth)
{
    struct MCNBTTag *tag = &mc_nbt_tags[id];
    int count;
    int i;
    int child;
    int type;
    int result;
    if (depth > MC_NBT_MAX_DEPTH) return MC_NBT_ERR_FORMAT;
    if (tag->type == MC_NBT_END) return MC_NBT_OK;
    if (tag->type == MC_NBT_BYTE) tag->lo = mc_nbt_read_u8(r);
    else if (tag->type == MC_NBT_SHORT) tag->lo = mc_nbt_read_u16(r);
    else if (tag->type == MC_NBT_INT || tag->type == MC_NBT_FLOAT) tag->lo = mc_nbt_read_u32(r);
    else if (tag->type == MC_NBT_LONG || tag->type == MC_NBT_DOUBLE)
    {
        tag->hi = mc_nbt_read_u32(r);
        tag->lo = mc_nbt_read_u32(r);
    }
    else if (tag->type == MC_NBT_BYTE_ARRAY)
    {
        count = (int)mc_nbt_read_u32(r);
        if (r->error < 0 || count < 0 || (uint)count > r->size - r->pos) return MC_NBT_ERR_FORMAT;
        if (mc_nbt_byte_used + (count > 0 ? count : 1) > MC_NBT_MAX_BYTES) return MC_NBT_ERR_CAPACITY;
        tag->data_off = mc_nbt_byte_used;
        tag->data_len = count;
        mc_nbt_copy_bytes(&mc_nbt_bytes[mc_nbt_byte_used], &r->data[r->pos], (uint)count);
        r->pos = r->pos + (uint)count;
        mc_nbt_byte_used = mc_nbt_byte_used + (count > 0 ? count : 1);
    }
    else if (tag->type == MC_NBT_STRING)
    {
        result = mc_nbt_read_utf(r, &tag->data_off, &tag->data_len);
        if (result < 0) return result;
    }
    else if (tag->type == MC_NBT_LIST)
    {
        type = (int)mc_nbt_read_u8(r);
        count = (int)mc_nbt_read_u32(r);
        if (!mc_nbt_valid_type(type) || count < 0) return MC_NBT_ERR_FORMAT;
        if (count > MC_NBT_MAX_LINKS) return MC_NBT_ERR_CAPACITY;
        tag->list_type = type;
        for (i = 0; i < count; i = i + 1)
        {
            child = mc_nbt_new_tag(type);
            if (child < 0) return MC_NBT_ERR_CAPACITY;
            result = mc_nbt_parse_payload(r, child, depth + 1);
            if (result < 0 || mc_nbt_add_child(id, child) < 0) return result < 0 ? result : MC_NBT_ERR_CAPACITY;
        }
    }
    else if (tag->type == MC_NBT_COMPOUND)
    {
        for (;;)
        {
            child = mc_nbt_parse_named(r, depth + 1);
            if (child < 0) return r->error;
            if (mc_nbt_tags[child].type == MC_NBT_END) break;
            result = mc_nbt_compound_put(id, child);
            if (result < 0) return result;
        }
    }
    return r->error;
}

int mc_nbt_parse(unsigned char *data, uint size, int *root_out)
{
    struct MCNBTReader r;
    int root;
    mc_nbt_reset();
    r.data = data;
    r.size = size;
    r.pos = 0;
    r.error = 0;
    root = mc_nbt_parse_named(&r, 0);
    if (root < 0) return r.error;
    if (mc_nbt_tags[root].type != MC_NBT_COMPOUND) return MC_NBT_ERR_TYPE;
    *root_out = root;
    return MC_NBT_OK;
}

void mc_nbt_write_u8(struct MCNBTWriter *w, uint value)
{
    if (w->pos >= w->capacity) { w->error = MC_NBT_ERR_CAPACITY; return; }
    w->data[w->pos++] = (unsigned char)value;
}

void mc_nbt_write_u16(struct MCNBTWriter *w, uint value)
{
    mc_nbt_write_u8(w, value >> 8);
    mc_nbt_write_u8(w, value);
}

void mc_nbt_write_u32(struct MCNBTWriter *w, uint value)
{
    mc_nbt_write_u16(w, value >> 16);
    mc_nbt_write_u16(w, value);
}

int mc_nbt_utf_bytes(int off, int length)
{
    int i;
    int total = 0;
    uint c;
    for (i = 0; i < length; i = i + 1)
    {
        c = mc_nbt_chars[off + i];
        if (c >= 1 && c <= 0x7f) total = total + 1;
        else if (c <= 0x7ff) total = total + 2;
        else total = total + 3;
    }
    return total;
}

void mc_nbt_write_utf(struct MCNBTWriter *w, int off, int length)
{
    int bytes = mc_nbt_utf_bytes(off, length);
    int i;
    uint c;
    if (bytes > 65535) { w->error = MC_NBT_ERR_CAPACITY; return; }
    mc_nbt_write_u16(w, (uint)bytes);
    for (i = 0; i < length; i = i + 1)
    {
        c = mc_nbt_chars[off + i];
        if (c >= 1 && c <= 0x7f) mc_nbt_write_u8(w, c);
        else if (c <= 0x7ff)
        {
            mc_nbt_write_u8(w, 0xc0 | (c >> 6));
            mc_nbt_write_u8(w, 0x80 | (c & 0x3f));
        }
        else
        {
            mc_nbt_write_u8(w, 0xe0 | (c >> 12));
            mc_nbt_write_u8(w, 0x80 | ((c >> 6) & 0x3f));
            mc_nbt_write_u8(w, 0x80 | (c & 0x3f));
        }
    }
}

void mc_nbt_write_payload(struct MCNBTWriter *w, int id, int depth);

void mc_nbt_write_named(struct MCNBTWriter *w, int id, int depth)
{
    struct MCNBTTag *tag = &mc_nbt_tags[id];
    if (depth > MC_NBT_MAX_DEPTH) { w->error = MC_NBT_ERR_FORMAT; return; }
    mc_nbt_write_u8(w, (uint)tag->type);
    if (tag->type == MC_NBT_END) return;
    mc_nbt_write_utf(w, tag->key_off, tag->key_len);
    mc_nbt_write_payload(w, id, depth + 1);
}

void mc_nbt_write_payload(struct MCNBTWriter *w, int id, int depth)
{
    struct MCNBTTag *tag = &mc_nbt_tags[id];
    int link;
    int child;
    int list_type;
    int i;
    if (depth > MC_NBT_MAX_DEPTH) { w->error = MC_NBT_ERR_FORMAT; return; }
    if (tag->type == MC_NBT_BYTE) mc_nbt_write_u8(w, tag->lo);
    else if (tag->type == MC_NBT_SHORT) mc_nbt_write_u16(w, tag->lo);
    else if (tag->type == MC_NBT_INT || tag->type == MC_NBT_FLOAT) mc_nbt_write_u32(w, tag->lo);
    else if (tag->type == MC_NBT_LONG || tag->type == MC_NBT_DOUBLE)
    {
        mc_nbt_write_u32(w, tag->hi);
        mc_nbt_write_u32(w, tag->lo);
    }
    else if (tag->type == MC_NBT_BYTE_ARRAY)
    {
        mc_nbt_write_u32(w, (uint)tag->data_len);
        for (i = 0; i < tag->data_len; i = i + 1) mc_nbt_write_u8(w, mc_nbt_bytes[tag->data_off + i]);
    }
    else if (tag->type == MC_NBT_STRING) mc_nbt_write_utf(w, tag->data_off, tag->data_len);
    else if (tag->type == MC_NBT_LIST)
    {
        list_type = tag->count > 0 ? mc_nbt_tags[mc_nbt_link_tag[tag->first]].type : MC_NBT_BYTE;
        mc_nbt_write_u8(w, (uint)list_type);
        mc_nbt_write_u32(w, (uint)tag->count);
        link = tag->first;
        while (link >= 0)
        {
            child = mc_nbt_link_tag[link];
            mc_nbt_write_payload(w, child, depth + 1);
            link = mc_nbt_link_next[link];
        }
    }
    else if (tag->type == MC_NBT_COMPOUND)
    {
        link = tag->first;
        while (link >= 0)
        {
            mc_nbt_write_named(w, mc_nbt_link_tag[link], depth + 1);
            link = mc_nbt_link_next[link];
        }
        mc_nbt_write_u8(w, 0);
    }
}

int mc_nbt_write(int root, unsigned char *data, uint capacity, uint *size_out)
{
    struct MCNBTWriter w;
    if (root < 0 || root >= mc_nbt_tag_used || mc_nbt_tags[root].type != MC_NBT_COMPOUND)
        return MC_NBT_ERR_TYPE;
    w.data = data;
    w.capacity = capacity;
    w.pos = 0;
    w.error = 0;
    mc_nbt_write_named(&w, root, 0);
    if (w.error < 0) return w.error;
    *size_out = w.pos;
    return MC_NBT_OK;
}

uint mc_nbt_crc32(unsigned char *data, uint length)
{
    uint crc = 0xffffffff;
    uint i;
    int bit;
    for (i = 0; i < length; i = i + 1)
    {
        crc = crc ^ data[i];
        for (bit = 0; bit < 8; bit = bit + 1)
            crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
    }
    return crc ^ 0xffffffff;
}

uint mc_nbt_bits_get(struct MCNBTBits *b, int count)
{
    uint value;
    while (b->bits < count)
    {
        if (b->pos >= b->size) { b->error = MC_NBT_ERR_FORMAT; return 0; }
        b->hold = b->hold | ((uint)b->data[b->pos++] << b->bits);
        b->bits = b->bits + 8;
    }
    value = b->hold & ((1 << count) - 1);
    b->hold = b->hold >> count;
    b->bits = b->bits - count;
    return value;
}

void mc_nbt_bits_align(struct MCNBTBits *b)
{
    b->hold = 0;
    b->bits = 0;
}

int mc_nbt_huffman_build(struct MCNBTHuffman *h, uint *lengths, int count)
{
    uint offsets[16];
    uint left = 1;
    int i;
    int len;
    for (i = 0; i < 16; i = i + 1) h->count[i] = 0;
    for (i = 0; i < count; i = i + 1)
    {
        if (lengths[i] > 15) return MC_NBT_ERR_FORMAT;
        h->count[lengths[i]] = h->count[lengths[i]] + 1;
    }
    if (h->count[0] == (uint)count) return MC_NBT_ERR_FORMAT;
    for (len = 1; len <= 15; len = len + 1)
    {
        left = left << 1;
        if (left < h->count[len]) return MC_NBT_ERR_FORMAT;
        left = left - h->count[len];
    }
    offsets[1] = 0;
    for (len = 1; len < 15; len = len + 1) offsets[len + 1] = offsets[len] + h->count[len];
    for (i = 0; i < count; i = i + 1)
        if (lengths[i] != 0) h->symbol[offsets[lengths[i]]++] = (uint)i;
    return MC_NBT_OK;
}

int mc_nbt_huffman_decode(struct MCNBTBits *b, struct MCNBTHuffman *h)
{
    uint code = 0;
    uint first = 0;
    uint index = 0;
    uint count;
    int len;
    for (len = 1; len <= 15; len = len + 1)
    {
        code = code | mc_nbt_bits_get(b, 1);
        if (b->error < 0) return -1;
        count = h->count[len];
        if (code < first + count) return (int)h->symbol[index + code - first];
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
    }
    b->error = MC_NBT_ERR_FORMAT;
    return -1;
}

int mc_nbt_fixed_tables(void)
{
    int i;
    for (i = 0; i <= 143; i = i + 1) mc_nbt_lengths[i] = 8;
    for (; i <= 255; i = i + 1) mc_nbt_lengths[i] = 9;
    for (; i <= 279; i = i + 1) mc_nbt_lengths[i] = 7;
    for (; i <= 287; i = i + 1) mc_nbt_lengths[i] = 8;
    if (mc_nbt_huffman_build(&mc_nbt_lit_huffman, mc_nbt_lengths, 288) < 0) return MC_NBT_ERR_FORMAT;
    for (i = 0; i < 32; i = i + 1) mc_nbt_lengths[i] = 5;
    return mc_nbt_huffman_build(&mc_nbt_dist_huffman, mc_nbt_lengths, 32);
}

int mc_nbt_dynamic_tables(struct MCNBTBits *b)
{
    int order[19];
    int hlit = (int)mc_nbt_bits_get(b, 5) + 257;
    int hdist = (int)mc_nbt_bits_get(b, 5) + 1;
    int hclen = (int)mc_nbt_bits_get(b, 4) + 4;
    int i;
    int symbol;
    int repeat;
    uint previous = 0;
    order[0]=16; order[1]=17; order[2]=18; order[3]=0; order[4]=8; order[5]=7; order[6]=9;
    order[7]=6; order[8]=10; order[9]=5; order[10]=11; order[11]=4; order[12]=12;
    order[13]=3; order[14]=13; order[15]=2; order[16]=14; order[17]=1; order[18]=15;
    for (i = 0; i < 19; i = i + 1) mc_nbt_lengths[i] = 0;
    for (i = 0; i < hclen; i = i + 1) mc_nbt_lengths[order[i]] = mc_nbt_bits_get(b, 3);
    if (b->error < 0 || mc_nbt_huffman_build(&mc_nbt_code_huffman, mc_nbt_lengths, 19) < 0)
        return MC_NBT_ERR_FORMAT;
    i = 0;
    while (i < hlit + hdist)
    {
        symbol = mc_nbt_huffman_decode(b, &mc_nbt_code_huffman);
        if (symbol >= 0 && symbol <= 15)
        {
            previous = (uint)symbol;
            mc_nbt_lengths[i++] = previous;
        }
        else if (symbol == 16)
        {
            if (i == 0) return MC_NBT_ERR_FORMAT;
            repeat = (int)mc_nbt_bits_get(b, 2) + 3;
            if (i + repeat > hlit + hdist) return MC_NBT_ERR_FORMAT;
            while (repeat-- > 0) mc_nbt_lengths[i++] = previous;
        }
        else if (symbol == 17)
        {
            repeat = (int)mc_nbt_bits_get(b, 3) + 3;
            if (i + repeat > hlit + hdist) return MC_NBT_ERR_FORMAT;
            previous = 0;
            while (repeat-- > 0) mc_nbt_lengths[i++] = 0;
        }
        else if (symbol == 18)
        {
            repeat = (int)mc_nbt_bits_get(b, 7) + 11;
            if (i + repeat > hlit + hdist) return MC_NBT_ERR_FORMAT;
            previous = 0;
            while (repeat-- > 0) mc_nbt_lengths[i++] = 0;
        }
        else return MC_NBT_ERR_FORMAT;
    }
    if (mc_nbt_huffman_build(&mc_nbt_lit_huffman, mc_nbt_lengths, hlit) < 0) return MC_NBT_ERR_FORMAT;
    if (mc_nbt_huffman_build(&mc_nbt_dist_huffman, &mc_nbt_lengths[hlit], hdist) < 0) return MC_NBT_ERR_FORMAT;
    return MC_NBT_OK;
}

int mc_nbt_inflate_codes(struct MCNBTBits *b, unsigned char *out, uint capacity, uint *out_pos)
{
    uint length_base[29];
    uint length_extra[29];
    uint dist_base[30];
    uint dist_extra[30];
    int symbol;
    int dsymbol;
    uint length;
    uint distance;
    uint i;
    length_base[0]=3; length_base[1]=4; length_base[2]=5; length_base[3]=6; length_base[4]=7; length_base[5]=8;
    length_base[6]=9; length_base[7]=10; length_base[8]=11; length_base[9]=13; length_base[10]=15;
    length_base[11]=17; length_base[12]=19; length_base[13]=23; length_base[14]=27; length_base[15]=31;
    length_base[16]=35; length_base[17]=43; length_base[18]=51; length_base[19]=59; length_base[20]=67;
    length_base[21]=83; length_base[22]=99; length_base[23]=115; length_base[24]=131; length_base[25]=163;
    length_base[26]=195; length_base[27]=227; length_base[28]=258;
    length_extra[0]=0; length_extra[1]=0; length_extra[2]=0; length_extra[3]=0; length_extra[4]=0; length_extra[5]=0;
    length_extra[6]=0; length_extra[7]=0; length_extra[8]=1; length_extra[9]=1; length_extra[10]=1;
    length_extra[11]=1; length_extra[12]=2; length_extra[13]=2; length_extra[14]=2; length_extra[15]=2;
    length_extra[16]=3; length_extra[17]=3; length_extra[18]=3; length_extra[19]=3; length_extra[20]=4;
    length_extra[21]=4; length_extra[22]=4; length_extra[23]=4; length_extra[24]=5; length_extra[25]=5;
    length_extra[26]=5; length_extra[27]=5; length_extra[28]=0;
    dist_base[0]=1; dist_base[1]=2; dist_base[2]=3; dist_base[3]=4; dist_base[4]=5; dist_base[5]=7;
    dist_base[6]=9; dist_base[7]=13; dist_base[8]=17; dist_base[9]=25; dist_base[10]=33; dist_base[11]=49;
    dist_base[12]=65; dist_base[13]=97; dist_base[14]=129; dist_base[15]=193; dist_base[16]=257;
    dist_base[17]=385; dist_base[18]=513; dist_base[19]=769; dist_base[20]=1025; dist_base[21]=1537;
    dist_base[22]=2049; dist_base[23]=3073; dist_base[24]=4097; dist_base[25]=6145;
    dist_base[26]=8193; dist_base[27]=12289; dist_base[28]=16385; dist_base[29]=24577;
    dist_extra[0]=0; dist_extra[1]=0; dist_extra[2]=0; dist_extra[3]=0; dist_extra[4]=1; dist_extra[5]=1;
    dist_extra[6]=2; dist_extra[7]=2; dist_extra[8]=3; dist_extra[9]=3; dist_extra[10]=4; dist_extra[11]=4;
    dist_extra[12]=5; dist_extra[13]=5; dist_extra[14]=6; dist_extra[15]=6; dist_extra[16]=7;
    dist_extra[17]=7; dist_extra[18]=8; dist_extra[19]=8; dist_extra[20]=9; dist_extra[21]=9;
    dist_extra[22]=10; dist_extra[23]=10; dist_extra[24]=11; dist_extra[25]=11;
    dist_extra[26]=12; dist_extra[27]=12; dist_extra[28]=13; dist_extra[29]=13;
    for (;;)
    {
        symbol = mc_nbt_huffman_decode(b, &mc_nbt_lit_huffman);
        if (symbol < 0) return MC_NBT_ERR_FORMAT;
        if (symbol < 256)
        {
            if (*out_pos >= capacity) return MC_NBT_ERR_CAPACITY;
            out[(*out_pos)++] = (unsigned char)symbol;
        }
        else if (symbol == 256) return MC_NBT_OK;
        else
        {
            symbol = symbol - 257;
            if (symbol < 0 || symbol >= 29) return MC_NBT_ERR_FORMAT;
            length = length_base[symbol] + mc_nbt_bits_get(b, (int)length_extra[symbol]);
            dsymbol = mc_nbt_huffman_decode(b, &mc_nbt_dist_huffman);
            if (dsymbol < 0 || dsymbol >= 30) return MC_NBT_ERR_FORMAT;
            distance = dist_base[dsymbol] + mc_nbt_bits_get(b, (int)dist_extra[dsymbol]);
            if (b->error < 0 || distance == 0 || distance > *out_pos || length > capacity - *out_pos)
                return MC_NBT_ERR_FORMAT;
            for (i = 0; i < length; i = i + 1)
            {
                out[*out_pos] = out[*out_pos - distance];
                *out_pos = *out_pos + 1;
            }
        }
    }
}

int mc_nbt_inflate_raw(unsigned char *data, uint size, unsigned char *out,
                       uint capacity, uint *size_out)
{
    struct MCNBTBits b;
    uint out_pos = 0;
    uint final = 0;
    uint type;
    uint length;
    uint inverse;
    uint i;
    int result;
    b.data = data; b.size = size; b.pos = 0; b.hold = 0; b.bits = 0; b.error = 0;
    while (!final)
    {
        final = mc_nbt_bits_get(&b, 1);
        type = mc_nbt_bits_get(&b, 2);
        if (b.error < 0) return b.error;
        if (type == 0)
        {
            mc_nbt_bits_align(&b);
            if (b.pos + 4 > b.size) return MC_NBT_ERR_FORMAT;
            length = (uint)b.data[b.pos] | ((uint)b.data[b.pos + 1] << 8);
            inverse = (uint)b.data[b.pos + 2] | ((uint)b.data[b.pos + 3] << 8);
            b.pos = b.pos + 4;
            if (((length ^ inverse) & 0xffff) != 0xffff || length > b.size - b.pos || length > capacity - out_pos)
                return MC_NBT_ERR_FORMAT;
            for (i = 0; i < length; i = i + 1) out[out_pos++] = b.data[b.pos++];
        }
        else
        {
            if (type == 1) result = mc_nbt_fixed_tables();
            else if (type == 2) result = mc_nbt_dynamic_tables(&b);
            else return MC_NBT_ERR_FORMAT;
            if (result < 0) return result;
            result = mc_nbt_inflate_codes(&b, out, capacity, &out_pos);
            if (result < 0) return result;
        }
    }
    *size_out = out_pos;
    return MC_NBT_OK;
}

uint mc_nbt_le32(unsigned char *data)
{
    return (uint)data[0] | ((uint)data[1] << 8) | ((uint)data[2] << 16) | ((uint)data[3] << 24);
}

uint mc_nbt_be32(unsigned char *data)
{
    return ((uint)data[0] << 24) | ((uint)data[1] << 16) |
           ((uint)data[2] << 8) | (uint)data[3];
}

uint mc_nbt_adler32(unsigned char *data, uint size)
{
    uint a = 1;
    uint b = 0;
    uint i = 0;
    uint end;
    while (i < size)
    {
        /* With reduced a and b, 4096 maximal bytes keep b below 2^32. */
        end = size - i > 4096 ? i + 4096 : size;
        for (; i < end; i = i + 1)
        {
            a = a + data[i];
            b = b + a;
        }
        a = a % 65521;
        b = b % 65521;
    }
    return (b << 16) | a;
}

int mc_nbt_zlib_inflate(unsigned char *data, uint size, unsigned char *out,
                        uint capacity, uint *size_out)
{
    uint header;
    uint cmf;
    uint flg;
    uint expected_adler;
    int result;
    if (size < 6) return MC_NBT_ERR_FORMAT;
    cmf = data[0];
    flg = data[1];
    header = (cmf << 8) | flg;
    if ((cmf & 15) != 8 || (cmf >> 4) > 7 || header % 31 != 0)
        return MC_NBT_ERR_FORMAT;
    if (flg & 32) return MC_NBT_ERR_FORMAT;
    result = mc_nbt_inflate_raw(&data[2], size - 6, out, capacity, size_out);
    if (result < 0) return result;
    expected_adler = mc_nbt_be32(&data[size - 4]);
    if (expected_adler != mc_nbt_adler32(out, *size_out)) return MC_NBT_ERR_CRC;
    return MC_NBT_OK;
}

int mc_nbt_gzip_inflate(unsigned char *data, uint size, unsigned char *out,
                        uint capacity, uint *size_out)
{
    uint pos = 10;
    uint flags;
    uint extra;
    uint expected_crc;
    uint expected_size;
    int result;
    if (size < 18 || data[0] != 0x1f || data[1] != 0x8b || data[2] != 8) return MC_NBT_ERR_FORMAT;
    flags = data[3];
    if ((flags & 0xe0) != 0) return MC_NBT_ERR_FORMAT;
    if (flags & 4)
    {
        if (pos + 2 > size - 8) return MC_NBT_ERR_FORMAT;
        extra = (uint)data[pos] | ((uint)data[pos + 1] << 8);
        pos = pos + 2 + extra;
    }
    if (flags & 8) { while (pos < size - 8 && data[pos++] != 0) {} }
    if (flags & 16) { while (pos < size - 8 && data[pos++] != 0) {} }
    if (flags & 2)
    {
        if (pos + 2 > size - 8) return MC_NBT_ERR_FORMAT;
        extra = (uint)data[pos] | ((uint)data[pos + 1] << 8);
        if ((mc_nbt_crc32(data, pos) & 0xffff) != extra) return MC_NBT_ERR_CRC;
        pos = pos + 2;
    }
    if (pos > size - 8) return MC_NBT_ERR_FORMAT;
    result = mc_nbt_inflate_raw(&data[pos], size - pos - 8, out, capacity, size_out);
    if (result < 0) return result;
    expected_crc = mc_nbt_le32(&data[size - 8]);
    expected_size = mc_nbt_le32(&data[size - 4]);
    if (expected_size != *size_out || expected_crc != mc_nbt_crc32(out, *size_out)) return MC_NBT_ERR_CRC;
    return MC_NBT_OK;
}

void mc_nbt_put_le32(unsigned char *data, uint *pos, uint value)
{
    data[(*pos)++] = (unsigned char)value;
    data[(*pos)++] = (unsigned char)(value >> 8);
    data[(*pos)++] = (unsigned char)(value >> 16);
    data[(*pos)++] = (unsigned char)(value >> 24);
}

int mc_nbt_gzip_store(unsigned char *input, uint length, unsigned char *out,
                      uint capacity, uint *size_out)
{
    uint pos = 0;
    uint source = 0;
    uint block;
    uint inverse;
    uint i;
    uint crc;
    if (capacity < 18) return MC_NBT_ERR_CAPACITY;
    out[pos++]=0x1f; out[pos++]=0x8b; out[pos++]=8; out[pos++]=0;
    out[pos++]=0; out[pos++]=0; out[pos++]=0; out[pos++]=0; out[pos++]=0; out[pos++]=255;
    do
    {
        block = length - source;
        if (block > 65535) block = 65535;
        if (pos + 5 + block + 8 > capacity) return MC_NBT_ERR_CAPACITY;
        out[pos++] = (source + block == length) ? 1 : 0;
        out[pos++] = (unsigned char)block;
        out[pos++] = (unsigned char)(block >> 8);
        inverse = (~block) & 0xffff;
        out[pos++] = (unsigned char)inverse;
        out[pos++] = (unsigned char)(inverse >> 8);
        for (i = 0; i < block; i = i + 1) out[pos++] = input[source++];
    } while (source < length);
    crc = mc_nbt_crc32(input, length);
    mc_nbt_put_le32(out, &pos, crc);
    mc_nbt_put_le32(out, &pos, length);
    *size_out = pos;
    return MC_NBT_OK;
}

int mc_nbt_parse_gzip(unsigned char *data, uint size, int *root_out)
{
    uint raw_size;
    int result = mc_nbt_gzip_inflate(data, size, mc_nbt_io, MC_NBT_IO_BYTES, &raw_size);
    if (result < 0) return result;
    return mc_nbt_parse(mc_nbt_io, raw_size, root_out);
}

int mc_nbt_write_gzip(int root, unsigned char *data, uint capacity, uint *size_out)
{
    uint raw_size;
    int result = mc_nbt_write(root, mc_nbt_file_data, MC_NBT_IO_BYTES, &raw_size);
    if (result < 0) return result;
    return mc_nbt_gzip_store(mc_nbt_file_data, raw_size, data, capacity, size_out);
}

int mc_nbt_load_gzip_file(char *path, uint storage, int *root_out)
{
    uint size;
    uint done = 0;
    uint take;
    int got;
    if (!narm_file_exists(path, storage)) return MC_NBT_ERR_IO;
    if (narm_file_size(path, storage, &size) < 0 || size > MC_NBT_IO_BYTES) return MC_NBT_ERR_CAPACITY;
    while (done < size)
    {
        take = size - done; if (take > 4096) take = 4096;
        got = narm_file_read(path, &mc_nbt_file_data[done], done, take, storage);
        if (got <= 0 || (uint)got > take) return MC_NBT_ERR_IO;
        done = done + (uint)got;
        narm_yield();
    }
    return mc_nbt_parse_gzip(mc_nbt_file_data, size, root_out);
}

int mc_nbt_load_file(char *path, uint storage, int *root_out)
{
    uint size;
    uint done = 0;
    uint take;
    int got;
    if (!narm_file_exists(path, storage)) return MC_NBT_ERR_IO;
    if (narm_file_size(path, storage, &size) < 0 || size > MC_NBT_IO_BYTES) return MC_NBT_ERR_CAPACITY;
    while (done < size)
    {
        take = size - done; if (take > 4096) take = 4096;
        got = narm_file_read(path, &mc_nbt_file_data[done], done, take, storage);
        if (got <= 0 || (uint)got > take) return MC_NBT_ERR_IO;
        done = done + (uint)got;
        narm_yield();
    }
    return mc_nbt_parse(mc_nbt_file_data, size, root_out);
}

int mc_nbt_write_file_bytes(char *path, uint storage, unsigned char *data, uint size)
{
    uint done = 0;
    uint take;
    int wrote;
    if (narm_file_exists(path, storage)) narm_file_delete(path, storage);
    if (narm_file_create(path, storage) <= 0) return MC_NBT_ERR_IO;
    while (done < size)
    {
        take = size - done; if (take > 4096) take = 4096;
        wrote = narm_file_write(path, &data[done], done, take, storage);
        if (wrote <= 0 || (uint)wrote > take) return MC_NBT_ERR_IO;
        done = done + (uint)wrote;
        narm_yield();
    }
    return MC_NBT_OK;
}

int mc_nbt_save_file(int root, char *path, uint storage)
{
    uint raw_size;
    int result = mc_nbt_write(root, mc_nbt_file_data, MC_NBT_IO_BYTES, &raw_size);
    if (result < 0) return result;
    return mc_nbt_write_file_bytes(path, storage, mc_nbt_file_data, raw_size);
}

int mc_nbt_save_gzip_file(int root, char *path, uint storage)
{
    uint gzip_size;
    int result = mc_nbt_write_gzip(root, mc_nbt_io, MC_NBT_IO_BYTES, &gzip_size);
    if (result < 0) return result;
    return mc_nbt_write_file_bytes(path, storage, mc_nbt_io, gzip_size);
}

int mc_nbt_make_tmp_path(char *path, char *out, int capacity)
{
    int i = 0;
    while (path[i] != 0 && i + 5 < capacity) { out[i] = path[i]; i = i + 1; }
    if (path[i] != 0 || i + 5 > capacity) return MC_NBT_ERR_CAPACITY;
    out[i++]='_'; out[i++]='t'; out[i++]='m'; out[i++]='p'; out[i]=0;
    return MC_NBT_OK;
}

int mc_nbt_save_gzip_file_atomic(int root, char *path, uint storage)
{
    uint raw_size;
    uint gzip_size;
    char temporary[256];
    int result;
    result = mc_nbt_write(root, mc_nbt_file_data, MC_NBT_IO_BYTES, &raw_size);
    if (result < 0) return result;
    result = mc_nbt_gzip_store(mc_nbt_file_data, raw_size, mc_nbt_io, MC_NBT_IO_BYTES, &gzip_size);
    if (result < 0) return result;
    result = mc_nbt_make_tmp_path(path, temporary, 256);
    if (result < 0) return result;
    if (narm_file_exists(temporary, storage)) narm_file_delete(temporary, storage);
    if (mc_nbt_write_file_bytes(temporary, storage, mc_nbt_io, gzip_size) < 0) return MC_NBT_ERR_IO;
    if (narm_file_exists(path, storage) && narm_file_delete(path, storage) < 0) return MC_NBT_ERR_IO;
    if (narm_file_exists(path, storage)) return MC_NBT_ERR_IO;
    if (narm_file_rename(temporary, path, storage) < 0) return MC_NBT_ERR_IO;
    return MC_NBT_OK;
}

int mc_nbt_save_file_atomic(int root, char *path, uint storage)
{
    uint raw_size;
    char temporary[256];
    int result = mc_nbt_write(root, mc_nbt_file_data, MC_NBT_IO_BYTES, &raw_size);
    if (result < 0) return result;
    result = mc_nbt_make_tmp_path(path, temporary, 256);
    if (result < 0) return result;
    if (narm_file_exists(temporary, storage)) narm_file_delete(temporary, storage);
    if (mc_nbt_write_file_bytes(temporary, storage, mc_nbt_file_data, raw_size) < 0) return MC_NBT_ERR_IO;
    if (narm_file_exists(path, storage) && narm_file_delete(path, storage) < 0) return MC_NBT_ERR_IO;
    if (narm_file_exists(path, storage)) return MC_NBT_ERR_IO;
    if (narm_file_rename(temporary, path, storage) < 0) return MC_NBT_ERR_IO;
    return MC_NBT_OK;
}

int mc_nbt_fixed_huffman_self_test(void)
{
    uint inflated_size;
    int i;
    if (mc_nbt_inflate_raw(mc_nbt_fixed_vector, 25, mc_nbt_io,
                           MC_NBT_IO_BYTES, &inflated_size) < 0 ||
        inflated_size != 39) return 0;
    for (i = 0; i < 39; i = i + 1)
        if (mc_nbt_io[i] != mc_nbt_fixed_expected[i]) return 0;
    return 1;
}

int mc_nbt_self_test(void)
{
    int root;
    int data;
    int parsed;
    int value;
    uint raw_size;
    uint gzip_size;
    uint inflated_size;
    uint hi;
    uint lo;
    char text[32];
    unsigned char bytes[4];
    mc_nbt_reset();
    root = mc_nbt_new_tag(MC_NBT_COMPOUND);
    if (root < 0 || mc_nbt_set_key_ascii(root, "") < 0) return 0;
    if (mc_nbt_compound_set_int(root, "SpawnX", -12345) < 0) return 0;
    if (mc_nbt_compound_set_long_bits(root, "RandomSeed", 0xfedcba98, 0x76543210) < 0) return 0;
    if (mc_nbt_compound_set_string(root, "LevelName", "NBT Foundation") < 0) return 0;
    bytes[0]=0; bytes[1]=1; bytes[2]=0xfe; bytes[3]=0xff;
    if (mc_nbt_compound_set_byte_array(root, "Bytes", bytes, 4) < 0) return 0;
    data = mc_nbt_new_tag(MC_NBT_COMPOUND);
    if (data < 0 || mc_nbt_set_key_ascii(data, "Data") < 0) return 0;
    if (mc_nbt_compound_set_boolean(data, "raining", 1) < 0) return 0;
    if (mc_nbt_compound_put(root, data) < 0) return 0;
    if (mc_nbt_write(root, mc_nbt_file_data, MC_NBT_IO_BYTES, &raw_size) < 0) return 0;
    if (mc_nbt_gzip_store(mc_nbt_file_data, raw_size, mc_nbt_io, MC_NBT_IO_BYTES, &gzip_size) < 0) return 0;
    if (mc_nbt_gzip_inflate(mc_nbt_io, gzip_size, mc_nbt_file_data, MC_NBT_IO_BYTES, &inflated_size) < 0) return 0;
    if (inflated_size != raw_size) return 0;
    if (mc_nbt_parse(mc_nbt_file_data, inflated_size, &parsed) < 0) return 0;
    if (mc_nbt_get_int(parsed, "SpawnX", &value) != 1 || value != -12345) return 0;
    if (mc_nbt_get_long_bits(parsed, "RandomSeed", &hi, &lo) != 1 || hi != 0xfedcba98 || lo != 0x76543210) return 0;
    if (mc_nbt_get_string_ascii(parsed, "LevelName", text, 32) != 1) return 0;
    if (text[0]!='N' || text[3]!=' ' || text[13]!='n' || text[14]!=0) return 0;
    data = mc_nbt_compound_find(parsed, "Data");
    if (data < 0 || mc_nbt_compound_find(data, "raining") < 0) return 0;
    return 1;
}
