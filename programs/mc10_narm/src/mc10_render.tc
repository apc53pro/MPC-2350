uint mc_render_raw_light_pair;
unsigned char mc_render_daylight_lookup[2048];
int mc_render_daylight_previous=-1;
#endif
float mc_render_lookup_gamma=-1.0f;
int mc_render_frame_batches;
uint mc_render_cache_build_ms;
int mc_render_show_hud=1;
/* Profiler builds also run the interactive loop after measurement. */
int mc_render_benchmark_running;
uint mc_render_fps_started,mc_render_fps_frames,mc_render_fps_tenths;
void mc_render_fps_reset(void)
{mc_render_fps_started=narm_millis();mc_render_fps_frames=0;mc_render_fps_tenths=0;}
void mc_render_fps_frame(void)
{
    uint now=narm_millis(),elapsed=(uint)(now-mc_render_fps_started);
    mc_render_fps_frames=mc_render_fps_frames+1;
    if(elapsed>=1000)
    {mc_render_fps_tenths=mc_render_fps_frames*10000/elapsed;mc_render_fps_frames=0;mc_render_fps_started=now;}
}
void mc_render_draw_fps(void)
{
    mc_world_line[0]=0;mc_world_append(mc_world_line,160,"FPS: ");
    mc_world_append_uint(mc_world_line,160,mc_render_fps_tenths/10);
    mc_world_append(mc_world_line,160,".");mc_world_append_uint(mc_world_line,160,mc_render_fps_tenths%10);
    mc_menu_draw_string(mc_world_line,4,4,0xffffff);
}

/* Eight-block spatial sections, indexed without reordering the display list.
 * Run ends allow a rejected contiguous range to be skipped in one operation. */
uint mc_render_run_end[MC_RENDER_CACHE_GROUPS];
char mc_render_section_state[576];
int mc_render_sections_enabled=1;
int mc_render_groups_visited,mc_render_groups_skipped;
int mc_render_last_visited,mc_render_last_skipped;
#define MC_RENDER_GEOMETRY_QUADS 12288
struct MCCachedQuad {float vertex[20];uint style;};
#ifdef MC10_WORLD_SYSTEMS
#include "mc10_workspace.tc"
#define mc_render_geometry ((struct MCCachedQuad *)&mc_world_workspace[0])
#else
struct MCCachedQuad mc_render_geometry[MC_RENDER_GEOMETRY_QUADS];
#endif
uint mc_render_geometry_range[MC_RENDER_CACHE_GROUPS];
int mc_render_geometry_enabled=1;
int mc_render_geometry_limit=MC_RENDER_GEOMETRY_QUADS;
int mc_render_geometry_count,mc_render_geometry_blocks;
int mc_render_capture,mc_render_capture_overflow,mc_render_capture_fancy;
/* The original submission path remains available for same-build comparisons.
 * Only a complete cached group with at least one quad owns a center, at its
 * first quad index. Empty groups and all incomplete groups use the old path. */
int mc_render_submit_optimized=1;
float mc_render_geometry_center[MC_RENDER_GEOMETRY_QUADS*3];
int mc_render_geometry_origin_x,mc_render_geometry_origin_z;
/* EntityRenderer.renderWorld enables GL_CULL_FACE for terrain pass 0, while
 * pass 1 water disables it. Restrict this early proof to RenderBlocks ordinary
 * opaque full cubes; special shapes and ambiguous legacy views stay unchanged.
 * General native depth-occlusion is bit 1; early ordinary-cube backfaces bit 0.
 * Geometry capture stays viewpoint-independent. Diagnostic face counts are
 * enabled only for discarded warm-ups, never ordinary F3-disabled gameplay. */
/* Normal play always enables eligible backface rejection; optional native
 * occlusion is applied from Video Settings at game entry/resume. Benchmarks
 * can still override both bits internally for explicit comparisons. */
int mc_render_cull_mode=1;
int mc_render_cull_diagnostics;
int mc_render_cull_eligible,mc_render_cull_backfaces;
int mc_render_capture_cull;
int mc_render_cull_frame_allowed;
uint mc_render_cull_face_mask=63;

void mc_render_prepare_cull_view(void)
{
    int x,y,z;uint id;
    mc_render_cull_frame_allowed=0;
    if(!(mc_render_cull_mode&1))return;
    x=(int)mc_render_view_x;if((float)x>mc_render_view_x)x=x-1;
    y=(int)mc_render_view_y;if((float)y>mc_render_view_y)y=y-1;
    z=(int)mc_render_view_z;if((float)z>mc_render_view_z)z=z-1;
    /* The old two-sided renderer can show distant backfaces when the eye is
     * inside connected solid terrain whose adjacent faces were never emitted.
     * An unknown eye cell is equally ambiguous: preserve that entire frame. */
    if(!mc_runtime_try_get_block(x+mc_render_origin_x,y,z+mc_render_origin_z,&id))return;
    if(id&&(id>=256||!mc_blocks[id].present||mc_blocks[id].opaque_cube))return;
    mc_render_cull_frame_allowed=1;
}

uint mc_render_opaque_front_mask(float x,float y,float z)
{
    float depth,radius,dx=mc_render_view_x-x,dy=mc_render_view_y-y,dz=mc_render_view_z-z;
    uint mask=0;
    if(!mc_render_cull_frame_allowed)return 63;
    /* Coplanar ties and the near-plane/camera-inside cases remain on the old
     * path. The margin exceeds binary32 rounding at resident-world scales. */
    if(dx>=-.501f&&dx<=.501f&&dy>=-.501f&&dy<=.501f&&dz>=-.501f&&dz<=.501f)return 63;
    depth=x*mc_render_camera[8]+y*mc_render_camera[9]+z*mc_render_camera[10]+mc_render_camera[11];
    radius=.5f*((mc_render_camera[8]<0?-mc_render_camera[8]:mc_render_camera[8])+
                  (mc_render_camera[9]<0?-mc_render_camera[9]:mc_render_camera[9])+
                  (mc_render_camera[10]<0?-mc_render_camera[10]:mc_render_camera[10]));
    if(depth-radius<=mc_render_camera[16]+.001f)return 63;
    if(dy<=-.499f)mask=mask|1;if(dy>=.499f)mask=mask|2;
    if(dz<=-.499f)mask=mask|4;if(dz>=.499f)mask=mask|8;
    if(dx<=-.499f)mask=mask|16;if(dx>=.499f)mask=mask|32;
    return mask;
}

int mc_render_block_in_view(int x,int y,int z);
