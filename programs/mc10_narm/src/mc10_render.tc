int mc_render_block_in_view(int x,int y,int z);
#define MC_RENDER_TESR_CAPACITY 4096
uint mc_render_tesr_keys[MC_RENDER_TESR_CAPACITY];
int mc_render_tesr_count,mc_render_tesr_overflow,mc_render_pending_dynamic;
int mc_render_is_tesr(uint id){return id==54||id==63||id==68;}
void mc_render_tesr_add(int c,int index,uint id,uint metadata)
{
    if(mc_render_tesr_count>=MC_RENDER_TESR_CAPACITY){mc_render_tesr_overflow=1;return;}
    mc_render_tesr_keys[mc_render_tesr_count]=(uint)index|((uint)c<<15)|(id<<19)|(metadata<<27);
    mc_render_tesr_count=mc_render_tesr_count+1;
    if((mc_render_tesr_count&63)==0)narm_yield();
}
void mc_render_tesr_key(uint key,float partial)
{
    int index=(int)(key&32767),c=(int)((key>>15)&15),x,z;uint id=(key>>19)&255,metadata=(key>>27)&15;
    x=mc_runtime_chunks[c].chunk.x_position*16+(index>>11);
    z=mc_runtime_chunks[c].chunk.z_position*16+((index>>7)&15);
    if(mc_render_block_in_view(x,index&127,z))mc_tp_world_tesr((int)id,(int)metadata,x,index&127,z,partial);
}
void mc_render_draw_tesr(float partial)
{
    int i,c;uint id,metadata;
    if(!mc_render_tesr_overflow)
    {for(i=0;i<mc_render_tesr_count;i=i+1)mc_render_tesr_key(mc_render_tesr_keys[i],partial);return;}
    /* Bounded-list overflow never omits models. The exact resident scan is
     * deliberately slower, and remains synchronous before hand/HUD drawing. */
    for(c=0;c<MC_RUNTIME_CHUNKS;c=c+1)if(mc_runtime_chunks[c].state==1)
        for(i=0;i<MC_CHUNK_BLOCK_COUNT;i=i+1)
        {
            id=mc_chunk_get_block_id(&mc_runtime_chunks[c].chunk,i>>11,i&127,(i>>7)&15);
            if(mc_render_is_tesr(id))
            {
                metadata=mc_chunk_get_block_metadata(&mc_runtime_chunks[c].chunk,i>>11,i&127,(i>>7)&15);
                mc_render_tesr_key((uint)i|((uint)c<<15)|(id<<19)|(metadata<<27),partial);
            }
            if((i&1023)==1023)narm_yield();
        }
}
#endif

