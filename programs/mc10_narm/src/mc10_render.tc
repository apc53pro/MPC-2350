/* Compact read-only surface display list, still below the former 4 MiB cap.
 * Each entry stores resident/cell/id/metadata and six visibility/light values.
 * Shapes/vertices/UVs still use the exact confirmed renderer; no quantization.
 * Rebuilt per world entry; overflow uses the original scan without omissions. */
#define MC_RENDER_CACHE_GROUPS 32768
uint mc_render_cached_keys[MC_RENDER_CACHE_GROUPS];
uint mc_render_cached_style[MC_RENDER_CACHE_GROUPS];
