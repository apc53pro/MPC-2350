/* NARM-only diagnostic screen; this is not part of Minecraft's GUI port. */

#define MC_GLYPH(a,b,c,d,e) ((a) | ((b) << 3) | ((c) << 6) | ((d) << 9) | ((e) << 12))

uint mc_ui_glyph(char c)
{
    if (c == 'A') return MC_GLYPH(2, 5, 7, 5, 5);
    if (c == 'B') return MC_GLYPH(6, 5, 6, 5, 6);
    if (c == 'C') return MC_GLYPH(3, 4, 4, 4, 3);
    if (c == 'D') return MC_GLYPH(6, 5, 5, 5, 6);
    if (c == 'E') return MC_GLYPH(7, 4, 6, 4, 7);
    if (c == 'F') return MC_GLYPH(7, 4, 6, 4, 4);
    if (c == 'G') return MC_GLYPH(3, 4, 5, 5, 3);
    if (c == 'H') return MC_GLYPH(5, 5, 7, 5, 5);
    if (c == 'I') return MC_GLYPH(7, 2, 2, 2, 7);
    if (c == 'J') return MC_GLYPH(1, 1, 1, 5, 2);
    if (c == 'K') return MC_GLYPH(5, 5, 6, 5, 5);
    if (c == 'L') return MC_GLYPH(4, 4, 4, 4, 7);
    if (c == 'M') return MC_GLYPH(5, 7, 7, 5, 5);
    if (c == 'N') return MC_GLYPH(5, 7, 7, 7, 5);
    if (c == 'O') return MC_GLYPH(2, 5, 5, 5, 2);
    if (c == 'P') return MC_GLYPH(6, 5, 6, 4, 4);
    if (c == 'Q') return MC_GLYPH(2, 5, 5, 3, 1);
    if (c == 'R') return MC_GLYPH(6, 5, 6, 5, 5);
    if (c == 'S') return MC_GLYPH(3, 4, 2, 1, 6);
    if (c == 'T') return MC_GLYPH(7, 2, 2, 2, 2);
    if (c == 'U') return MC_GLYPH(5, 5, 5, 5, 7);
    if (c == 'V') return MC_GLYPH(5, 5, 5, 5, 2);
    if (c == 'W') return MC_GLYPH(5, 5, 7, 7, 5);
    if (c == 'X') return MC_GLYPH(5, 5, 2, 5, 5);
    if (c == 'Y') return MC_GLYPH(5, 5, 2, 2, 2);
    if (c == 'Z') return MC_GLYPH(7, 1, 2, 4, 7);
    if (c == '0') return MC_GLYPH(7, 5, 5, 5, 7);
    if (c == '1') return MC_GLYPH(2, 6, 2, 2, 7);
    if (c == '2') return MC_GLYPH(6, 1, 7, 4, 7);
    if (c == '3') return MC_GLYPH(6, 1, 3, 1, 6);
    if (c == '4') return MC_GLYPH(5, 5, 7, 1, 1);
    if (c == '5') return MC_GLYPH(7, 4, 6, 1, 6);
    if (c == '6') return MC_GLYPH(3, 4, 7, 5, 7);
    if (c == '7') return MC_GLYPH(7, 1, 2, 2, 2);
    if (c == '8') return MC_GLYPH(7, 5, 7, 5, 7);
    if (c == '9') return MC_GLYPH(7, 5, 7, 1, 6);
    if (c == '-') return MC_GLYPH(0, 0, 7, 0, 0);
    if (c == ':') return MC_GLYPH(0, 2, 0, 2, 0);
    return 0;
}

/* The startup error path can run even when the shared RGB332 buffers fail. */
void mc_ui_startup_error_line(int y, char *text)
{
    int length = 0;
    int x;
    int row;
    int col;
    uint glyph;
    while (text[length] != 0) length = length + 1;
    x = (640 - (length * 16 - 4)) / 2;
    while (*text != 0)
    {
        glyph = mc_ui_glyph(*text);
        for (row = 0; row < 5; row = row + 1)
            for (col = 0; col < 3; col = col + 1)
                if (glyph & (1 << (row * 3 + 2 - col)))
                    narm_fill_rect(x + col * 4, y + row * 4,
                                   x + col * 4 + 3, y + row * 4 + 3, 15);
        x = x + 16;
        text = text + 1;
    }
}

int mc_ui_draw_startup_error(char *heading, char *detail)
{
    if (narm_clear(0) < 0) return 0;
    mc_ui_startup_error_line(185, heading);
    mc_ui_startup_error_line(225, detail);
    mc_ui_startup_error_line(275, "ESC OR ENTER TO EXIT");
    return narm_present() >= 0;
}

void mc_ui_char(int x, int y, char c, int scale, uint color)
{
    uint bits = mc_ui_glyph(c);
    int row = 0;
    int col;
    while (row < 5)
    {
        col = 0;
        while (col < 3)
        {
            if (bits & (1 << (row * 3 + (2 - col))))
                narm_half_fill_rect(x + col * scale, y + row * scale,
                                    x + col * scale + scale - 1,
                                    y + row * scale + scale - 1, color);
            col = col + 1;
        }
        row = row + 1;
    }
}

void mc_ui_text(int x, int y, char *text, int scale, uint color)
{
    int i = 0;
    while (text[i] != 0)
    {
        mc_ui_char(x, y, text[i], scale, color);
        x = x + scale * 4;
        i = i + 1;
    }
}

void mc_ui_center_text(int y, char *text, int scale, uint color)
{
    int length = 0;
    int width;
    while (text[length] != 0) length = length + 1;
    width = length * scale * 4 - scale;
    mc_ui_text((MC_SCREEN_WIDTH - width) / 2, y, text, scale, color);
}

void mc_ui_status_line(int y, char *label, int okay)
{
    mc_ui_text(36, y, label, 2, MC_COLOR_WHITE);
    if (okay) mc_ui_text(244, y, "OK", 2, MC_COLOR_GREEN);
    else mc_ui_text(232, y, "FAIL", 2, MC_COLOR_RED);
}

void mc_ui_placeholder_line(int y, char *label)
{
    mc_ui_text(36, y, label, 2, MC_COLOR_WHITE);
    mc_ui_text(220, y, "PENDING", 2, MC_COLOR_YELLOW);
}

void mc_ui_draw_status(char *heading)
{
    narm_half_clear(MC_COLOR_DARK);
    mc_ui_center_text(20, heading, 3, MC_COLOR_WHITE);
    narm_half_fill_rect(20, 44, 299, 214, MC_COLOR_PANEL);
    mc_ui_status_line(50, "MINECRAFT ASSETS", mc_boot_assets_ok);
    mc_ui_status_line(70, "NBT IO", mc_boot_nbt_ok);
    mc_ui_status_line(90, "JAVA RANDOM", mc_boot_random_ok);
    mc_ui_status_line(110, "JAVA LONG", mc_boot_u64_ok);
    mc_ui_status_line(130, "NOISEGEN PERLIN", mc_boot_perlin_ok);
    mc_ui_status_line(150, "CHUNK STORAGE", mc_boot_chunk_ok);
    mc_ui_status_line(170, "MENU OPTIONS", mc_boot_menu_ok && mc_boot_options_ok);
    mc_ui_status_line(190, "BLOCK TABLE", mc_boot_blocks_ok);
#ifdef MC10_LEGACY_FONT
    mc_ui_center_text(208, "BUILD 17 LEGACY FONT", 1, MC_COLOR_YELLOW);
#elif defined(MC10_AUTOPROFILE)
    mc_ui_center_text(208, "BUILD 15 HUD A/B PROFILE", 1, MC_COLOR_YELLOW);
#else
    mc_ui_center_text(208, "BUILD 15 BUFFERED FONT", 1, MC_COLOR_YELLOW);
#endif
    mc_ui_center_text(222, "ESC RETURNS", 2, MC_COLOR_WHITE);
    narm_half_present();
}

