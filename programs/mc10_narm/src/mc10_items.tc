/* Inventory-only Minecraft 1.0 item facts. Item callbacks are not simulated.
 * Numeric registration/icon facts: Item, Block, tool/armor enums and subclasses.
 * This module is deliberately separate from the resident block renderer. */
#ifdef MC10_PLAYER_FOUNDATION
struct MCItemStack {int id;int count;int damage;int tag_offset;int tag_bytes;};
unsigned char mc_item_icons[127]={
82,98,114,5,10,21,37,7,55,23,39,66,64,80,96,112,65,81,97,113,67,83,99,115,53,71,72,68,84,100,116,8,24,40,128,129,130,131,132,9,25,41,0,16,32,48,1,17,33,49,2,18,34,50,3,19,35,51,4,20,36,52,6,87,88,26,11,42,43,74,75,76,135,104,44,56,14,136,103,77,22,57,27,58,59,30,151,167,12,54,69,70,73,89,90,78,28,13,29,45,86,92,60,93,109,61,62,105,106,121,122,91,107,108,123,124,125,141,140,139,138,157,173,172,156,155,137};
int mc_item_valid(int id)
{return (id>=1&&id<=122)||(id>=256&&id<=382)||(id>=2256&&id<=2266);}
int mc_item_subtypes(int id)
{return id==6||id==17||id==18||id==31||id==35||id==44||id==98||id==263||id==351||id==373;}
int mc_item_armor_type(int id)
{if(id>=298&&id<=317)return (id-298)%4;return -1;}
int mc_item_armor_points(int id)
{
    int kind=(id-298)/4,type=(id-298)%4;
    int values[20]={1,3,2,1,2,5,4,1,2,6,5,2,3,8,6,3,2,5,3,1};
    if(id<298||id>317)return 0;return values[kind*4+type];
}
int mc_item_max_damage(int id)
{
    int type,multiplier;
    int armor_base[4]={11,16,15,13};
    if(id>=298&&id<=317)
    {type=(id-298)%4;multiplier=5;if(id>=302)multiplier=15;if(id>=310)multiplier=33;if(id>=314)multiplier=7;return armor_base[type]*multiplier;}
    if(id==259||id==346)return 64;if(id==261)return 384;if(id==359)return 238;
    if(id>=256&&id<=258)return 250;
    if(id==267)return 250;
    if(id>=268&&id<=271)return 59;
    if(id>=272&&id<=275)return 131;
    if(id>=276&&id<=279)return 1561;
    if(id>=283&&id<=286)return 32;
    if(id==290)return 59;if(id==291)return 131;if(id==292)return 250;if(id==293)return 1561;if(id==294)return 32;
    return 0;
}
int mc_item_limit(int id)
{
    if(!mc_item_valid(id))return 0;
    if(mc_item_max_damage(id)>0||mc_item_armor_type(id)>=0)return 1;
    if(id==282||id==323||id==324||id==325||id==326||id==327||id==328||id==329||id==330||id==333||id==335||id==342||id==343||id==354||id==355||id==358||id==373||id>=2256)return 1;
    if(id==332||id==344||id==368)return 16;
    return 64;
}
#ifdef MC10_WORLD_SYSTEMS
int mc_item_world_flat_icon(int id,int damage)
{
    /* ItemBlock's constructor captures getBlockTextureFromSide(2). Only the
     * registered ItemSapling/ItemColored/LilyPad subclasses vary their icon
     * by damage. Includes internal/nonobtainable source IDs deliberately. */
    int ids[44]={6,8,9,10,11,26,27,28,30,31,32,34,36,37,38,39,40,50,51,55,59,63,64,65,66,68,69,71,75,76,83,93,94,101,102,104,105,106,111,115,117,118,119,120};
    int tiles[44]={15,206,206,238,238,134,179,195,11,55,55,107,0,13,12,29,28,80,31,164,88,4,97,83,128,4,96,98,115,99,73,5,5,85,49,111,111,143,76,226,157,154,0,159};
    int i;if(id==6){damage=damage&3;return damage==1?63:(damage==2?79:15);}
    if(id==31)return damage==0?55:(damage==2?56:39);
    for(i=0;i<44;i=i+1)if(ids[i]==id)return tiles[i];return -1;
}
#endif
int mc_item_flat_block_icon(int id,int damage)
{
#ifdef MC10_WORLD_SYSTEMS
    return mc_item_world_flat_icon(id,damage);
#endif
    /* RenderItem uses a flat terrain sprite only when renderItemIn3d(type)
     * is false. These audited ItemBlock / ItemColored variants stay flat;
     * ordinary cubes/slabs and specialized geometry are NOT substituted. */
    if(id==6){damage=damage&3;return damage==1?63:(damage==2?79:15);}
    if(id==27)return 179;if(id==28)return 195;if(id==30)return 11;
    if(id==31)return damage==1?39:(damage==2?56:(damage==0?55:39));
    if(id==32)return 55;if(id==37)return 13;if(id==38)return 12;if(id==39)return 29;if(id==40)return 28;
    if(id==50)return 80;if(id==55)return 164;if(id==59)return 88;
    if(id==64)return 97;if(id==65)return 83;if(id==66)return 128;if(id==69)return 96;if(id==71)return 98;
#ifdef MC10_WORLD_SYSTEMS
    if(id==77)return -1; /* Source RenderType0 button is a 3D inventory item. */
#endif
    if(id==75)return 115;if(id==76)return 99;if(id==77)return 1;if(id==83)return 73;
    if(id==101)return 85;if(id==102)return 49;if(id==106)return 143;if(id==111)return 76;
    return -1;
}
uint mc_item_icon_color(int id,int damage)
{
    /* ItemColored delegates to the block's inventory render color, not the
     * current biome. ItemSapling and the other audited ItemBlocks are white. */
    if((id==31&&damage!=0)||id==106)return 4764952;
    if(id==111)return 2129968;
    return 0xffffff;
}
int mc_item_icon(int id,int damage)
{
    /* Only source flat block types use terrain sprites. 3D block items require
     * their inventory geometry, never a flat top-face substitute. Potion color
     * layers and animated compass/clock remain pending. */
    if(id>=2256&&id<=2266)return 240+id-2256;
    if(id<256)return mc_item_flat_block_icon(id,damage);
    if(id>382||id==373||id==345||id==347)return -1;
    if(id==351){if(damage<0)damage=0;if(damage>15)damage=15;return 78+(damage%8)*16+damage/8;}
    return (int)mc_item_icons[id-256];
}
int mc_item_stackable(struct MCItemStack *stack)
{return stack->count>0&&mc_item_limit(stack->id)>1&&!(mc_item_max_damage(stack->id)>0&&stack->damage>0);}
#endif

