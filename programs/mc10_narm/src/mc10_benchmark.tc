    mc_bench_meta("cases","saved_hud_on_baseline;saved_hud_off_baseline;sky_hud_on_baseline;sky_hud_off_baseline;saved_hud_on_optimized;saved_hud_off_optimized;sky_hud_on_optimized;sky_hud_off_optimized");
#elif defined(MC10_STAGE_PROFILE)
    mc_bench_meta("cases","saved_hud_on_baseline;saved_hud_off_baseline;sky_hud_on_baseline;sky_hud_off_baseline;saved_hud_on_instrumented;saved_hud_off_instrumented;sky_hud_on_instrumented;sky_hud_off_instrumented");
#elif defined(MC10_TILE_PROFILE)
    mc_bench_meta("cases","saved_hud_on_immediate;saved_hud_off_immediate;sky_hud_on_immediate;sky_hud_off_immediate;saved_hud_on_tiles;saved_hud_off_tiles;sky_hud_on_tiles;sky_hud_off_tiles");
#elif defined(MC10_SAMPLER_PROFILE)
    mc_bench_meta("cases","saved_hud_on_general;saved_hud_off_general;sky_hud_on_general;sky_hud_off_general;saved_hud_on_clamped;saved_hud_off_clamped;sky_hud_on_clamped;sky_hud_off_clamped");
#else
    mc_bench_meta("cases","saved_hud_on;saved_hud_off;sky_hud_on;sky_hud_off");
#endif
    mc_bench_meta("hud_off","no diagnostic text, footer or crosshair; present and CSV profiling remain active");
#if defined(MC10_PREPARATION_PROFILE) && defined(MC10_LEGACY_FONT)
    mc_bench_meta("font_backend","cached exact 8x8 mask traversal; per-pixel native submission; zero native glyph calls; cold-cache original fallback");
#elif defined(MC10_LEGACY_FONT)
    mc_bench_meta("font_backend","original per-pixel path; no native glyph submission; startup cache preparation retained");
#else
    mc_bench_meta("font_backend","cached exact 8x8 masks via narm_half_glyph; pixel fallback on service error");
#endif
    mc_bench_meta_uint("glyph_fallback_calls",mc_menu_glyph_fallbacks);
#if defined(MC10_SAMPLER_PROFILE) || defined(MC10_TILE_PROFILE)
    mc_bench_meta("external_load","other native processes/OS activity uncontrolled;paired order alternates;SDK clocks logged per sample");
#else
    mc_bench_meta("external_load","other native processes/OS activity uncontrolled; firmware CPU clock not measured");
#endif
    mc_bench_meta_uint("run_started_uptime_ms",mc_bench_run_started_ms);
    mc_bench_meta("world_selection",mc_bench_override?"profile_world.txt":"most_recent_LastPlayed_then_folder");
    mc_bench_meta("world_folder",mc_bench_world.folder);mc_bench_meta("level_name",mc_bench_world.level_name);
    mc_bench_meta_bits("world_seed_hex",mc_bench_world.random_seed_hi,mc_bench_world.random_seed_lo);
    mc_bench_meta_bits("world_time_hex",mc_bench_world.world_time_hi,mc_bench_world.world_time_lo);
    mc_bench_meta_bits("last_played_hex",mc_bench_world.last_played_hi,mc_bench_world.last_played_lo);
    mc_bench_meta_bits("eye_x_binary64_hex",mc_runtime_player.pos_x.hi,mc_runtime_player.pos_x.lo);
    mc_bench_meta_bits("eye_y_binary64_hex",mc_runtime_player.pos_y.hi,mc_runtime_player.pos_y.lo);
    mc_bench_meta_bits("eye_z_binary64_hex",mc_runtime_player.pos_z.hi,mc_runtime_player.pos_z.lo);
    mc_bench_meta_int("player_from_NBT",mc_runtime_player.present);
    mc_bench_meta_int("resident_loaded",mc_runtime_loaded);mc_bench_meta_int("resident_missing",mc_runtime_missing);
    mc_bench_meta_int("resident_invalid",mc_runtime_invalid);
    mc_bench_meta_uint("asset_source_crc32",mc_asset_source_crc32);
    mc_bench_meta_uint("cache_build_ms",mc_render_cache_build_ms);
    mc_bench_meta("effective_resolution","320x240 RGB332");
    mc_bench_meta("effective_projection_scale","171.375 horizontal and vertical");
    mc_bench_meta("effective_far_plane_blocks","48");
    mc_bench_meta("effective_smooth_lighting","off; flat per-face saved light and directional shading");
    mc_bench_meta_int("effective_fancy_grass",mc_options.fancy_graphics);
    mc_bench_meta_uint("effective_gamma_milli",(uint)(mc_options.gamma_setting*1000.0f+0.5f));
    mc_bench_meta("inactive_options","FOV; render distance; smooth lighting; clouds; particles; bobbing; anaglyph; Advanced OpenGL; FPS limit; GUI scale");
    mc_bench_meta_int("stored_render_distance",mc_options.render_distance);
    mc_bench_meta_uint("stored_fov_milli",(uint)(mc_options.fov_setting*1000.0f+0.5f));
    mc_bench_meta_int("stored_smooth_lighting",mc_options.ambient_occlusion);
    mc_bench_meta_uint("warmup_frames_per_view",1);mc_bench_meta_uint("samples_per_view",MC_BENCH_SAMPLES);
    /* Fingerprint the frozen input AFTER measurement, not inside a frame. */
    for(i=0;i<9;i=i+1)
    {
        mc_bench_chunk_key(i,"_x");mc_bench_meta_int(mc_bench_key,mc_runtime_chunks[i].chunk.x_position);
        mc_bench_chunk_key(i,"_z");mc_bench_meta_int(mc_bench_key,mc_runtime_chunks[i].chunk.z_position);
        mc_bench_chunk_key(i,"_timestamp");mc_bench_meta_uint(mc_bench_key,mc_runtime_chunks[i].timestamp);
        mc_bench_chunk_key(i,"_blocks_fnv");mc_bench_meta_uint(mc_bench_key,mc_bench_fnv(&mc_runtime_blocks[i*MC_CHUNK_BLOCK_COUNT],MC_CHUNK_BLOCK_COUNT));
        mc_bench_chunk_key(i,"_metadata_fnv");mc_bench_meta_uint(mc_bench_key,mc_bench_fnv(&mc_runtime_metadata[i*MC_CHUNK_NIBBLE_BYTES],MC_CHUNK_NIBBLE_BYTES));
        mc_bench_chunk_key(i,"_skylight_fnv");mc_bench_meta_uint(mc_bench_key,mc_bench_fnv(&mc_runtime_skylight[i*MC_CHUNK_NIBBLE_BYTES],MC_CHUNK_NIBBLE_BYTES));
        mc_bench_chunk_key(i,"_blocklight_fnv");mc_bench_meta_uint(mc_bench_key,mc_bench_fnv(&mc_runtime_blocklight[i*MC_CHUNK_NIBBLE_BYTES],MC_CHUNK_NIBBLE_BYTES));
    }
}
void mc_bench_format_log(void)
{
    int view,i;mc_bench_format_metadata();
    for(view=0;view<MC_BENCH_CASES;view=view+1)
    {
        for(i=0;i<MC_BENCH_SAMPLES;i=i+1)mc_bench_row("sample",view,i,0);
        mc_bench_row("min",view,-1,0);mc_bench_row("median",view,-1,1);mc_bench_row("max",view,-1,2);
    }
    mc_bench_meta("complete","1");
}
int mc_bench_choose_world(void)
{
    uint size;int length,i;
    mc_bench_override=narm_file_exists(mc_game_profile_world_path,mc_game_storage)>0;
    if(!mc_bench_override)
    {
        if(!mc_world_count)return 0;
        return mc_world_read_info(mc_world_list[0].folder,&mc_bench_world);
    }
    if(narm_file_size(mc_game_profile_world_path,mc_game_storage,&size)<0||!size||size>=MC_WORLD_FOLDER_CAP)return 0;
    length=narm_file_read(mc_game_profile_world_path,mc_bench_folder,0,size,mc_game_storage);
    if(length!=(int)size)return 0;
    while(length>0&&(mc_bench_folder[length-1]=='\r'||mc_bench_folder[length-1]=='\n'))length=length-1;
    mc_bench_folder[length]=0;
    if(!length||mc_menu_text_equals(mc_bench_folder,".")||mc_menu_text_equals(mc_bench_folder,".."))return 0;
    for(i=0;i<length;i=i+1)
        if(mc_bench_folder[i]=='/'||mc_bench_folder[i]=='\\'||mc_bench_folder[i]==':'||mc_bench_folder[i]==0||mc_bench_folder[i]=='\r'||mc_bench_folder[i]=='\n')return 0;
    return mc_world_read_info(mc_bench_folder,&mc_bench_world);
}
int mc_bench_write_log(void)
{
    char name[16];
    int run,i,count;uint offset,size,amount;
    if(mc_bench_full||!mc_bench_length)return 0;
    if(narm_dir_make(mc_game_profiles_path,mc_game_storage)<=0&&!narm_file_exists(mc_game_profiles_path,mc_game_storage))return 0;
    for(run=1;run<=9999;run=run+1)
    {
#ifdef MC10_CULL_PROFILE
        mc_world_copy(name,16,"b26_");
#elif defined(MC10_PREPARATION_PROFILE)
        mc_world_copy(name,16,"b24_");
#elif defined(MC10_GEOMETRY_PROFILE)
        mc_world_copy(name,16,"b23_");
#elif defined(MC10_STAGE_PROFILE)
        mc_world_copy(name,16,"b22_");
#elif defined(MC10_TILE_PROFILE)
        mc_world_copy(name,16,"b21_");
#elif defined(MC10_SAMPLER_PROFILE)
        mc_world_copy(name,16,"b20_");
#elif defined(MC10_LEGACY_FONT)
        mc_world_copy(name,16,"b17_");
#else
        mc_world_copy(name,16,"b15_");
#endif
        mc_world_append_char(name,16,(char)('0'+run/1000));
        mc_world_append_char(name,16,(char)('0'+(run/100)%10));
        mc_world_append_char(name,16,(char)('0'+(run/10)%10));
        mc_world_append_char(name,16,(char)('0'+run%10));mc_world_append(name,16,".csv");
        if(!mc_game_join_path(mc_bench_path,mc_game_profiles_path,name))return 0;
        count=narm_file_size(mc_bench_path,mc_game_storage,&size);
        if(count==0||narm_file_exists(mc_bench_path,mc_game_storage)>0)continue;
        /* FILE_IO_ERR_NOT_FOUND is -3. Do not treat a storage/I/O failure
         * as permission to truncate an existing report. */
        if(count!=-3)return 0;
        break;
    }
    if(run>9999||narm_file_create(mc_bench_path,mc_game_storage)<=0)return 0;
    offset=0;
    while(offset<mc_bench_length)
    {
        count=narm_file_write(mc_bench_path,&mc_bench_log[offset],offset,mc_bench_length-offset,mc_game_storage);
        if(count<=0||(uint)count>mc_bench_length-offset)return 0;
        offset=offset+(uint)count;
    }
    if(narm_file_size(mc_bench_path,mc_game_storage,&size)<0||size!=mc_bench_length)return 0;
    for(offset=0;offset<mc_bench_length;offset=offset+amount)
    {
        amount=mc_bench_length-offset;if(amount>1024)amount=1024;
        count=narm_file_read(mc_bench_path,mc_bench_verify,offset,amount,mc_game_storage);
        if(count!=(int)amount)return 0;
        for(i=0;i<count;i=i+1)if(mc_bench_verify[i]!=mc_bench_log[offset+(uint)i])return 0;
    }
    return 1;
}
int mc_bench_wait_result(int success)
{
    unsigned key,action,mods,character;int event;
    mc_bench_message(success?"PROFILE SAVED AND VERIFIED":"PROFILE FAILED");
    if(mc_bench_path[0])mc_menu_draw_centered_string(mc_bench_path,160,116,success?0x55ff55:0xff5555);
    mc_menu_draw_centered_string(success?"Enter: play   Escape: exit":"Escape or Enter: exit",160,160,0xa0a0a0);
    narm_half_present();
    for(;;)
    {
        while(narm_next_key_event(&key,&action,&mods,&character)>0)
            if(action==NARM_KEY_ACTION_PRESS)
            {if(key==NARM_KEY_ESCAPE)return 0;if(key==NARM_KEY_ENTER)return success;}
        event=narm_poll_system_event();if(event==NARM_EVENT_CLOSE_REQUESTED)return 0;
        narm_sleep_ms(16);
    }
}
#ifdef MC10_SAMPLER_PROFILE
#include "mc10_sampler_profile.tc"
#endif
#ifdef MC10_GEOMETRY_PROFILE
#include "mc10_geometry_profile.tc"
#elif defined(MC10_STAGE_PROFILE)
#include "mc10_stage_profile.tc"
#elif defined(MC10_TILE_PROFILE)
#include "mc10_tile_profile.tc"
#endif
int mc_benchmark_main(void)
{
    int success;
#ifndef MC10_CULL_PROFILE
    /* Keep older automated schemas/workloads on their historical path. The
     * archived releases are untouched; normal post-profile play uses culling. */
    mc_render_cull_mode=0;mc_render_cull_diagnostics=0;
#endif
#ifdef MC10_STARTUP_DIAGNOSTIC
    if(!mc_startup_trace_begin())return 3;
    if(!mc_startup_checkpoint("startup_begin",0))return 3;
    mc_blocks_init();
    if(!mc_startup_checkpoint("blocks_initialized",0))return 3;
    success=mc_asset_open();
    if(!mc_startup_checkpoint("asset_open_return",success)||!success)return 3;
    success=mc_menu_init();
    if(!mc_startup_checkpoint("menu_init_return",success)||!success)return 3;
    mc_startup_screen_ready=1;
    success=mc_options_init();
    if(!mc_startup_checkpoint("options_init_return",success)||!success)return 3;
    success=mc_world_init();
    if(!mc_startup_checkpoint("world_scan_return",success)||!success)return 3;
#else
    mc_blocks_init();
    if(!mc_asset_open()||!mc_menu_init()||!mc_options_init()||!mc_world_init())
    {mc_bench_message("ASSET / OPTIONS INITIALIZATION FAILED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_SAMPLER_PROFILE
    if(renderStat(19)!=0x53500001)
    {mc_bench_message("SAMPLER FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_TILE_PROFILE
    if(renderStat(24)!=0x54420001)
    {mc_bench_message("TEXTURED TILE FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_STAGE_PROFILE
    if(renderStat(34)!=0x44530001)
    {mc_bench_message("DRAW STAGE FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_GEOMETRY_PROFILE
    if(renderStat(65)!=0x47500001)
    {mc_bench_message("GEOMETRY A/B FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_PREPARATION_PROFILE
    if(renderStat(66)!=0x50500001)
    {mc_bench_message("PREPARATION FIX FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
#ifdef MC10_CULL_PROFILE
    if(renderStat(70)!=0x43550001)
    {mc_bench_message("VISIBILITY CULL FIRMWARE REQUIRED");mc_wait_for_return();return 1;}
#endif
    mc_bench_message("Loading benchmark world");
#ifdef MC10_STARTUP_DIAGNOSTIC
    if(!mc_startup_checkpoint("world_choose_begin",0))return 3;
#endif
    if(!mc_bench_choose_world())
    {mc_bench_message("NO VALID BENCHMARK WORLD");mc_wait_for_return();return 1;}
#ifdef MC10_STARTUP_DIAGNOSTIC
    mc_world_copy(mc_startup_line,192,"world_folder=");
    mc_world_append(mc_startup_line,192,mc_bench_world.folder);
    mc_world_append_char(mc_startup_line,192,'\n');
    if(!mc_startup_write_line()||!mc_startup_checkpoint("world_chosen",0))return 3;
#endif
    mc_runtime_status=mc_runtime_bootstrap(&mc_bench_world);
#ifdef MC10_STARTUP_DIAGNOSTIC
    if(mc_startup_isolation_only)
    {
        success=!mc_startup_error&&mc_runtime_status==MC_RUNTIME_OK&&
                mc_runtime_access_ok&&mc_runtime_loaded==9&&
                !mc_runtime_missing&&!mc_runtime_invalid;
        if(!mc_startup_error)
            if(!mc_startup_checkpoint(success?"startup_complete_9_valid_chunks":"startup_failed",mc_runtime_status))success=0;
        mc_bench_message(success?"STARTUP COMPLETE - NO 3D RENDER":"STARTUP / TRACE FAILED");
        mc_menu_draw_centered_string(mc_startup_path,160,116,success?0x55ff55:0xff5555);
        mc_menu_draw_centered_string("Enter / Escape: exit",160,150,0xa0a0a0);
        narm_half_present();mc_wait_for_return();return success?0:3;
    }
#endif
    if(mc_runtime_status!=MC_RUNTIME_OK||!mc_runtime_access_ok||mc_runtime_loaded!=9||mc_runtime_missing||mc_runtime_invalid)
    {mc_bench_message("BENCHMARK NEEDS NINE VALID CHUNKS");mc_wait_for_return();return 1;}
    if(!mc_math_init())
    {mc_bench_message("MATH TABLE FAILED");mc_wait_for_return();return 1;}
    mc_player_init();
    if(mc_player_status||!mc_render_prepare_assets())
    {mc_bench_message("PLAYER / TERRAIN INITIALIZATION FAILED");mc_wait_for_return();return 1;}
    mc_profile_cancel();mc_render_build_cache();
#ifdef MC10_GEOMETRY_PROFILE
    if(!mc_geometry_collect())
    {mc_bench_message(mc_render_list_error?"TEXTURED LIST SERVICE FAILED":"PROFILE CANCELLED - NO LOG WRITTEN");mc_wait_for_return();return 2;}
#elif defined(MC10_STAGE_PROFILE)
    if(!mc_stage_collect())
    {mc_bench_message(mc_render_list_error?"TEXTURED LIST SERVICE FAILED":"PROFILE CANCELLED - NO LOG WRITTEN");mc_wait_for_return();return 2;}
#elif defined(MC10_TILE_PROFILE)
    if(!mc_tile_collect())
    {mc_bench_message(mc_render_list_error?"TEXTURED LIST SERVICE FAILED":"PROFILE CANCELLED - NO LOG WRITTEN");mc_wait_for_return();return 2;}
#elif defined(MC10_SAMPLER_PROFILE)
    if(!mc_sampler_collect())
#else
    if(!mc_bench_collect())
#endif
#ifndef MC10_TILE_PROFILE
    {mc_bench_message("PROFILE CANCELLED - NO LOG WRITTEN");mc_wait_for_return();return 2;}
#endif
#ifdef MC10_GEOMETRY_PROFILE
    mc_geometry_format_log();
#elif defined(MC10_STAGE_PROFILE)
    mc_stage_format_log();
#elif defined(MC10_TILE_PROFILE)
    mc_tile_format_log();
#elif defined(MC10_SAMPLER_PROFILE)
    mc_sampler_format_log();
#else
    mc_bench_format_log();
#endif
    mc_bench_message("Saving benchmark CSV");success=mc_bench_write_log();
    if(mc_bench_wait_result(success))
    {
#ifdef MC10_GEOMETRY_PROFILE
        mc_render_submit_optimized=1;mc_render_list_enabled=1;renderStats(0);
#endif
        mc_render_cull_mode=3;mc_render_cull_diagnostics=0;
        mc_game_run(&mc_bench_world);
    }
    return success?0:1;
}
#endif
