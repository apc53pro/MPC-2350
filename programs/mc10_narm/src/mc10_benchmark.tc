#ifdef MC10_AUTOPROFILE
/* Platform-only, read-only renderer benchmark. No Minecraft tick, player
 * movement, menu loop, save write or options write runs during measurement.
 * Samples are buffered; CSV creation/write/readback happens after all views.
 */
#define MC_BENCH_SAMPLES 5
#define MC_BENCH_CASES 4
#ifdef MC10_GEOMETRY_PROFILE
#ifdef MC10_CULL_PROFILE
#define MC_BENCH_LOG_CAP 98304
#else
#define MC_BENCH_LOG_CAP 65536
#endif
#define MC_BENCH_COLUMNS 77
int mc_geometry_mode;
void mc_geometry_append_fields(int view,int sample);
#elif defined(MC10_STAGE_PROFILE)
#define MC_BENCH_LOG_CAP 65536
#define MC_BENCH_COLUMNS 77
int mc_stage_mode;
void mc_stage_append_fields(int view,int sample);
#elif defined(MC10_TILE_PROFILE)
#define MC_BENCH_LOG_CAP 32768
#define MC_BENCH_COLUMNS 51
int mc_tile_mode;
void mc_tile_append_fields(int view,int sample);
#elif defined(MC10_SAMPLER_PROFILE)
#define MC_BENCH_LOG_CAP 32768
#define MC_BENCH_COLUMNS 41
int mc_sampler_mode;
void mc_sampler_append_fields(int view,int sample);
#else
#define MC_BENCH_LOG_CAP 32768
#define MC_BENCH_COLUMNS 27
#endif
struct MCBenchmarkSample {
    struct MCFrameProfile frame;
    int visited;int skipped;uint yaw_bits;uint pitch_bits;
};
struct MCBenchmarkSample mc_bench_samples[MC_BENCH_CASES*MC_BENCH_SAMPLES];
char mc_bench_log[MC_BENCH_LOG_CAP];
char mc_bench_verify[1024];
char mc_bench_path[MC_GAME_PATH_CAP];
char mc_bench_folder[MC_WORLD_FOLDER_CAP];
char mc_bench_value[192];
char mc_bench_key[64];
uint mc_bench_length;
int mc_bench_full;
int mc_bench_cancelled;
int mc_bench_completed;
int mc_bench_override;
uint mc_bench_saved_yaw,mc_bench_saved_pitch;
uint mc_bench_run_started_ms;
struct MCWorldInfo mc_bench_world;

void mc_bench_message(char *title)
{
    narm_half_clear(MC_COLOR_BLACK);
#ifdef MC10_CULL_PROFILE
    mc_menu_draw_centered_string("BUILD 26 VISIBILITY CULLING",160,48,0xffff55);
    mc_world_copy(mc_bench_value,192,"Samples: ");
    mc_world_append_uint(mc_bench_value,192,(uint)mc_bench_completed);
    mc_world_append(mc_bench_value,192,"/60  (72 frames, 3 modes)");
    mc_menu_draw_centered_string(mc_bench_value,160,70,0xa0a0a0);
#elif defined(MC10_PREPARATION_PROFILE)
    mc_menu_draw_centered_string("BUILD 24 PREPARATION FIXES",160,48,0xffff55);
#elif defined(MC10_GEOMETRY_PROFILE)
    mc_menu_draw_centered_string("BUILD 23 GEOMETRY A/B PROFILE",160,48,0xffff55);
#elif defined(MC10_STAGE_PROFILE)
    mc_menu_draw_centered_string("BUILD 22 DRAW STAGE PROFILE",160,48,0xffff55);
#elif defined(MC10_TILE_PROFILE)
    mc_menu_draw_centered_string("BUILD 21 TEXTURED TILE A/B",160,48,0xffff55);
#elif defined(MC10_SAMPLER_PROFILE)
    mc_menu_draw_centered_string("BUILD 20 SAMPLER A/B PROFILE",160,48,0xffff55);
#elif defined(MC10_STARTUP_DIAGNOSTIC)
    mc_menu_draw_centered_string("BUILD 16 STARTUP ISOLATION",160,48,0xffff55);
#elif defined(MC10_LEGACY_FONT)
    mc_menu_draw_centered_string("BUILD 17 LEGACY FONT PROFILE",160,48,0xffff55);
#else
    mc_menu_draw_centered_string("BUILD 15 HUD A/B PROFILE",160,48,0xffff55);
#endif
    mc_menu_draw_centered_string(title,160,90,0xffffff);
    narm_half_present();
}
void mc_bench_char(char value)
{
    if(mc_bench_length+1>=MC_BENCH_LOG_CAP){mc_bench_full=1;return;}
    mc_bench_log[mc_bench_length++]=value;mc_bench_log[mc_bench_length]=0;
}
void mc_bench_text(char *value)
{int i=0;while(value[i]){mc_bench_char(value[i]);i=i+1;}}
void mc_bench_uint(uint value)
{
    char digits[11];int n=0;
    if(!value){mc_bench_char('0');return;}
    while(value){digits[n++]=(char)('0'+value%10);value=value/10;}
    while(n)mc_bench_char(digits[--n]);
}
void mc_bench_hex(uint value)
{int i;char *hex="0123456789abcdef";for(i=28;i>=0;i=i-4)mc_bench_char(hex[(value>>i)&15]);}
void mc_bench_quote(char *text)
{
    int i=0;mc_bench_char('"');
    while(text[i]){if(text[i]=='"')mc_bench_char('"');mc_bench_char(text[i++]);}
    mc_bench_char('"');
}
void mc_bench_meta(char *key,char *value)
{
    int i;mc_bench_text("meta");
    for(i=1;i<MC_BENCH_COLUMNS-1;i=i+1)mc_bench_char(',');
    mc_bench_quote(key);mc_bench_char(',');mc_bench_quote(value);mc_bench_char('\n');
}
void mc_bench_meta_uint(char *key,uint value)
{mc_bench_value[0]=0;mc_world_append_uint(mc_bench_value,192,value);mc_bench_meta(key,mc_bench_value);}
void mc_bench_meta_int(char *key,int value)
{mc_bench_value[0]=0;mc_world_append_int(mc_bench_value,192,value);mc_bench_meta(key,mc_bench_value);}
void mc_bench_meta_bits(char *key,uint hi,uint lo)
{
    mc_bench_value[0]=0;mc_world_append_hex8(mc_bench_value,192,hi);
    mc_world_append_hex8(mc_bench_value,192,lo);mc_bench_meta(key,mc_bench_value);
}
int mc_bench_poll(void)
{
    unsigned key,action,mods,character;int event;
    while(narm_next_key_event(&key,&action,&mods,&character)>0)
        if(key==NARM_KEY_ESCAPE&&action==NARM_KEY_ACTION_PRESS)mc_bench_cancelled=1;
    event=narm_poll_system_event();
    if(event==NARM_EVENT_CLOSE_REQUESTED||event==NARM_EVENT_FOCUS_LOST)mc_bench_cancelled=1;
    return !mc_bench_cancelled;
}
int mc_bench_measure_frame(void)
{
    uint started;int result;
    mc_render_benchmark_running=1;
    mc_profile_cancel();mc_profile_begin();mc_render_begin_frame();
    for(;;)
    {
        started=narm_micros();
        if(!mc_bench_poll()){mc_render_benchmark_running=0;mc_profile_cancel();return 0;}
        mc_profile_pump_us=mc_profile_pump_us+(uint)(narm_micros()-started);
        result=mc_render_step_frame();
        if(result<0){mc_render_benchmark_running=0;mc_profile_cancel();return 0;}
        if(result){mc_render_benchmark_running=0;return 1;}
        mc_profile_yield();
    }
}
int mc_bench_collect(void)
{
    int view,i,j,index,saved_hud=mc_render_show_hud;uint *out,*in;
    mc_bench_cancelled=0;mc_bench_completed=0;
    mc_bench_run_started_ms=narm_millis();
    mc_bench_saved_yaw=mc_runtime_player.yaw_bits;mc_bench_saved_pitch=mc_runtime_player.pitch_bits;
    for(view=0;view<MC_BENCH_CASES;view=view+1)
    {
        mc_runtime_player.yaw_bits=mc_bench_saved_yaw;
        mc_runtime_player.pitch_bits=view>=2?0xc2b40000:mc_bench_saved_pitch; /* -90.0f */
        mc_render_show_hud=(view&1)==0;
        mc_profile_valid=0;
        if(!mc_bench_measure_frame())break; /* One discarded warm-up per view. */
        for(i=0;i<MC_BENCH_SAMPLES;i=i+1)
        {
            if(!mc_bench_measure_frame())break;
            index=view*MC_BENCH_SAMPLES+i;
            out=(uint *)&mc_bench_samples[index].frame;in=(uint *)&mc_profile_last;
            for(j=0;j<(int)sizeof(struct MCFrameProfile)/4;j=j+1)out[j]=in[j];
            mc_bench_samples[index].visited=mc_render_last_visited;
            mc_bench_samples[index].skipped=mc_render_last_skipped;
            mc_bench_samples[index].yaw_bits=mc_runtime_player.yaw_bits;
            mc_bench_samples[index].pitch_bits=mc_runtime_player.pitch_bits;
            mc_bench_completed=mc_bench_completed+1;
        }
        if(mc_bench_cancelled)break;
    }
    mc_runtime_player.yaw_bits=mc_bench_saved_yaw;mc_runtime_player.pitch_bits=mc_bench_saved_pitch;
    mc_render_show_hud=saved_hud;
    mc_profile_cancel();
    return mc_bench_completed==MC_BENCH_CASES*MC_BENCH_SAMPLES&&!mc_bench_cancelled;
}
char *mc_bench_view_name(int view)
{
#ifdef MC10_CULL_PROFILE
    if(mc_geometry_mode==0)
    {
        if(view==0)return "saved_hud_on_baseline";if(view==1)return "saved_hud_off_baseline";
        if(view==2)return "sky_hud_on_baseline";return "sky_hud_off_baseline";
    }
    if(mc_geometry_mode==1)
    {
        if(view==0)return "saved_hud_on_backface";if(view==1)return "saved_hud_off_backface";
        if(view==2)return "sky_hud_on_backface";return "sky_hud_off_backface";
    }
    if(view==0)return "saved_hud_on_combined";if(view==1)return "saved_hud_off_combined";
    if(view==2)return "sky_hud_on_combined";return "sky_hud_off_combined";
#elif defined(MC10_GEOMETRY_PROFILE)
    if(mc_geometry_mode==0)
    {
        if(view==0)return "saved_hud_on_baseline";if(view==1)return "saved_hud_off_baseline";
        if(view==2)return "sky_hud_on_baseline";return "sky_hud_off_baseline";
    }
    if(view==0)return "saved_hud_on_optimized";if(view==1)return "saved_hud_off_optimized";
    if(view==2)return "sky_hud_on_optimized";return "sky_hud_off_optimized";
#elif defined(MC10_STAGE_PROFILE)
    if(mc_stage_mode==0)
    {
        if(view==0)return "saved_hud_on_baseline";if(view==1)return "saved_hud_off_baseline";
        if(view==2)return "sky_hud_on_baseline";return "sky_hud_off_baseline";
    }
    if(view==0)return "saved_hud_on_instrumented";if(view==1)return "saved_hud_off_instrumented";
    if(view==2)return "sky_hud_on_instrumented";return "sky_hud_off_instrumented";
#elif defined(MC10_TILE_PROFILE)
    if(mc_tile_mode==0)
    {
        if(view==0)return "saved_hud_on_immediate";if(view==1)return "saved_hud_off_immediate";
        if(view==2)return "sky_hud_on_immediate";return "sky_hud_off_immediate";
    }
    if(view==0)return "saved_hud_on_tiles";if(view==1)return "saved_hud_off_tiles";
    if(view==2)return "sky_hud_on_tiles";return "sky_hud_off_tiles";
#elif defined(MC10_SAMPLER_PROFILE)
    if(mc_sampler_mode==0)
    {
        if(view==0)return "saved_hud_on_general";if(view==1)return "saved_hud_off_general";
        if(view==2)return "sky_hud_on_general";return "sky_hud_off_general";
    }
    if(view==0)return "saved_hud_on_clamped";if(view==1)return "saved_hud_off_clamped";
    if(view==2)return "sky_hud_on_clamped";return "sky_hud_off_clamped";
#else
    if(view==0)return "saved_hud_on";if(view==1)return "saved_hud_off";
    if(view==2)return "sky_hud_on";return "sky_hud_off";
#endif
}
uint mc_bench_stat(int view,int field,int statistic)
{
    uint values[MC_BENCH_SAMPLES],swap;int i,j;struct MCBenchmarkSample *s;
    for(i=0;i<MC_BENCH_SAMPLES;i=i+1)
    {
        s=&mc_bench_samples[view*MC_BENCH_SAMPLES+i];
        values[i]=field<15?((uint *)&s->frame)[field]:(uint)(field==15?s->visited:s->skipped);
    }
    for(i=0;i<MC_BENCH_SAMPLES;i=i+1)for(j=i+1;j<MC_BENCH_SAMPLES;j=j+1)
        if(values[j]<values[i]){swap=values[i];values[i]=values[j];values[j]=swap;}
    return values[statistic==0?0:(statistic==1?MC_BENCH_SAMPLES/2:MC_BENCH_SAMPLES-1)];
}
void mc_bench_row(char *kind,int view,int sample,int statistic)
{
    int field;uint value;struct MCBenchmarkSample *s=&mc_bench_samples[view*MC_BENCH_SAMPLES+(sample<0?0:sample)];
    mc_bench_text(kind);mc_bench_char(',');mc_bench_text(mc_bench_view_name(view));mc_bench_char(',');
    if(sample>=0)mc_bench_uint((uint)sample+1);
    for(field=0;field<17;field=field+1)
    {
        value=sample<0?mc_bench_stat(view,field,statistic):
            (field<15?((uint *)&s->frame)[field]:(uint)(field==15?s->visited:s->skipped));
        mc_bench_char(',');mc_bench_uint(value);
    }
    mc_bench_char(',');mc_bench_uint((uint)mc_render_cache_group_count);
    mc_bench_char(',');mc_bench_uint((uint)mc_render_geometry_count);
    mc_bench_char(',');mc_bench_uint((uint)mc_render_geometry_blocks);
    mc_bench_char(',');mc_bench_hex(s->yaw_bits);mc_bench_char(',');mc_bench_hex(s->pitch_bits);
#ifdef MC10_GEOMETRY_PROFILE
    mc_geometry_append_fields(view,sample);
#elif defined(MC10_STAGE_PROFILE)
    mc_stage_append_fields(view,sample);
#elif defined(MC10_TILE_PROFILE)
    mc_tile_append_fields(view,sample);
#elif defined(MC10_SAMPLER_PROFILE)
    mc_sampler_append_fields(view,sample);
#endif
    mc_bench_text(",,\n");
}
uint mc_bench_fnv(char *data,int length)
{
    uint hash=0x811c9dc5;int i;
    for(i=0;i<length;i=i+1)hash=(hash^((uint)data[i]&255))*0x01000193;
    return hash;
}
void mc_bench_chunk_key(int index,char *field)
{
    mc_world_copy(mc_bench_key,64,"chunk_");mc_world_append_int(mc_bench_key,64,index);
    mc_world_append(mc_bench_key,64,field);
}
