/* Minecraft 1.0 GameSettings, GuiOptions, GuiVideoSettings and GuiControls.
 * The source's LWJGL key codes remain in options.txt; the NARM keyboard
 * adapter translates USB HID events at the controls-screen boundary. */

#define MC_OPTIONS_LABEL_BYTES 2048
#define MC_OPTIONS_FILE_BYTES 4096
#define MC_OPTIONS_BUTTONS 14
#define MC_OPTIONS_KEYS 13
#define MC_OPTIONS_MAIN 0
#define MC_OPTIONS_VIDEO 1
#define MC_OPTIONS_CONTROLS 2
#define MC_OPTIONS_KIND_ACTION 0
#define MC_OPTIONS_KIND_CYCLE 1
#define MC_OPTIONS_KIND_SLIDER 2
#define MC_OPTIONS_KIND_KEY 3

#define MC_OPT_MUSIC 0
#define MC_OPT_SOUND 1
#define MC_OPT_INVERT_MOUSE 2
#define MC_OPT_SENSITIVITY 3
#define MC_OPT_FOV 4
#define MC_OPT_GAMMA 5
#define MC_OPT_RENDER_DISTANCE 6
#define MC_OPT_VIEW_BOBBING 7
#define MC_OPT_ANAGLYPH 8
#define MC_OPT_ADVANCED_OPENGL 9
#define MC_OPT_FRAMERATE_LIMIT 10
#define MC_OPT_DIFFICULTY 11
#define MC_OPT_GRAPHICS 12
#define MC_OPT_AMBIENT_OCCLUSION 13
#define MC_OPT_GUI_SCALE 14
#define MC_OPT_RENDER_CLOUDS 15
#define MC_OPT_PARTICLES 16
/* Explicit NARM presentation/performance extensions, not Minecraft enum IDs. */
#define MC_OPT_CURSOR_SPEED 17
#define MC_OPT_OCCLUSION_CULLING 18

void mc_menu_set_cursor_speed(float value);

struct MCGameSettings {
    float music_volume; float sound_volume; float mouse_sensitivity;
    float fov_setting; float gamma_setting; float cursor_speed;
    int invert_mouse; int render_distance; int gui_scale; int particles;
    int view_bobbing; int anaglyph; int advanced_opengl;
    int limit_framerate; int difficulty; int fancy_graphics;
    int ambient_occlusion; int clouds; int occlusion_culling;
    int key_codes[MC_OPTIONS_KEYS];
};

struct MCGameSettings mc_options;
struct MCMenuButton mc_options_buttons[MC_OPTIONS_BUTTONS];
int mc_options_button_kind[MC_OPTIONS_BUTTONS];
int mc_options_button_option[MC_OPTIONS_BUTTONS];
char mc_options_button_text[MC_OPTIONS_BUTTONS][64];
char mc_options_labels[MC_OPTIONS_LABEL_BYTES];
char mc_options_file[MC_OPTIONS_FILE_BYTES];
uint mc_options_background[256];
uint mc_options_slider_knob[40];
uint mc_options_label_bytes;
int mc_options_button_count;
int mc_options_screen;
int mc_options_capture_key;
int mc_options_ready;
int mc_options_dirty;
int mc_options_fallback_labels;
int mc_options_drag_slider=-1;
int mc_options_drag_changed;
int mc_options_enter_blocked;
#ifdef MC10_MOUSE
int mc_options_drag_mouse;
#endif

