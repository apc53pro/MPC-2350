void mc_wait_for_return(void)
{
    unsigned key;
    unsigned action;
    unsigned mods;
    unsigned character;
    for (;;)
    {
        while (narm_next_key_event(&key, &action, &mods, &character) > 0)
        {
            if (action == NARM_KEY_ACTION_PRESS &&
                (key == NARM_KEY_ESCAPE || key == NARM_KEY_ENTER)) return;
        }
        if (narm_poll_system_event() == NARM_EVENT_CLOSE_REQUESTED) return;
        narm_sleep_ms(16);
    }
}

void mc_show_menu_target_placeholder(int button_id)
{
    if (button_id == 2) mc_ui_draw_status("MULTIPLAYER PENDING");
    else mc_ui_draw_status("TEXTURE PACKS PENDING");
    mc_wait_for_return();
}

int mc_main_startup_error(char *heading, char *detail, int status)
{
    if (mc_ui_draw_startup_error(heading, detail))
        mc_wait_for_return();
    return status;
}

int mc_main_video_error(void)
{
    return mc_main_startup_error("MINECRAFT VIDEO FAILED",
                                 "320X240 FRAMEBUFFER UNAVAILABLE", 2);
}

int mc_main_find_paths(void)
{
    char directory[MC_GAME_PATH_CAP];
    int length = narm_get_program_path(directory, MC_GAME_PATH_CAP,
                                       &mc_game_storage);
    if (length < 2 || length >= MC_GAME_PATH_CAP || directory[0] != '/')
        return 0;
    length = length - 1;
    while (directory[length] != '/') length = length - 1;
    directory[length + 1] = 0;
    return mc_game_join_path(mc_asset_path, directory, "assets.mc10") &&
           mc_game_join_path(mc_options_path, directory, "options.txt") &&
           mc_game_join_path(mc_block_mesh_path, directory, "blocks10.dat") &&
           mc_game_join_path(mc_block_tint_path, directory, "blocktint10.dat") &&
           mc_game_join_path(mc_block_color_path, directory, "biomecolor10.dat") &&
           mc_game_join_path(mc_math_path, directory, "math10.dat") &&
           mc_game_join_path(mc_sky_path, directory, "sky10.dat") &&
           mc_game_join_path(mc_game_saves_path, directory, "saves") &&
           mc_game_join_path(mc_game_profiles_path, directory, "profiles") &&
           mc_game_join_path(mc_game_profile_world_path, directory, "profile_world.txt");
}

int mc_main_activate_button(int button_id)
{
    if (button_id == 4) return 1;
    if (button_id == 1) mc_select_world_run();
    else if (button_id == 0)
    {
        if (mc_options_ready) mc_options_run();
        else
        {
            mc_ui_draw_status("OPTIONS INIT FAILED");
            mc_wait_for_return();
        }
    }
    else if (button_id >= 0) mc_show_menu_target_placeholder(button_id);
#ifdef MC10_MOUSE
    if (button_id >= 0) mc_mouse_ui_reset();
#endif
    return 0;
}

int main(void)
{
#ifdef MC10_AUTOPROFILE
    if (!mc_main_find_paths())
        return mc_main_startup_error("MINECRAFT PATH FAILED",
                                     "CHECK PROGRAM FOLDER AND PATH LENGTH", 3);
    return mc_benchmark_main();
#else
    unsigned key;
    unsigned action;
    unsigned mods;
    unsigned character;
    unsigned now;
    unsigned last_tick;
    int button_id;
    int event;
    int dirty;
#ifdef MC10_MOUSE
    int mouse_event, mouse_count;
#endif

    if (!mc_main_find_paths())
        return mc_main_startup_error("MINECRAFT PATH FAILED",
                                     "CHECK PROGRAM FOLDER AND PATH LENGTH", 3);
    if (!mc_menu_init())
        return mc_main_startup_error("MINECRAFT MENU ASSETS FAILED",
                                     "KEEP ASSETS BESIDE THE GAME", 1);
    if (!mc_menu_draw()) return mc_main_video_error();

    mc_blocks_init();
    mc_boot_blocks_ok = mc_blocks_self_test();
    mc_boot_u64_ok = mc_u64_self_test();
    mc_boot_nbt_ok = mc_nbt_self_test();
    if (mc_boot_nbt_ok) mc_boot_nbt_ok = mc_nbt_fixed_huffman_self_test();
    mc_boot_random_ok = mc_java_random_self_test();
    mc_boot_chunk_ok = mc_chunk_self_test();
    mc_boot_assets_ok = mc_asset_self_test();
    mc_boot_perlin_ok = mc_noise_perlin_constructor_self_test();
    mc_boot_menu_ok = mc_menu_self_test();
    if (!mc_options_init()) mc_boot_options_ok = 0;
    else mc_boot_options_ok = mc_options_self_test();

#ifdef MC10_MOUSE
    mc_mouse_ui_reset();
#endif
    last_tick = narm_millis();
    dirty = 0;
    for (;;)
    {
        now = narm_millis();
        while ((uint)(now - last_tick) >= 50)
        {
            mc_menu_update_screen();
            last_tick = last_tick + 50;
            dirty = 1;
        }
        if (mc_menu_update_pointer_held(now)) dirty = 1;

#ifdef MC10_MOUSE
        for (mouse_count=0; mouse_count<32; mouse_count=mouse_count+1)
        {
            mouse_event=mc_mouse_ui_event();
            if (!mouse_event) break;
            dirty=1;
            if (mouse_event!=1) continue;
            button_id=mc_menu_mouse_pressed(0);
            if (mc_main_activate_button(button_id)) return 0;
            if (button_id>=0) last_tick=narm_millis();
        }
#endif
        while (narm_next_key_event(&key, &action, &mods, &character) > 0)
        {
            if (action != NARM_KEY_ACTION_PRESS &&
                action != NARM_KEY_ACTION_REPEAT) continue;

            if (key == NARM_KEY_ENTER && action == NARM_KEY_ACTION_PRESS)
            {
                button_id = mc_menu_mouse_pressed(0);
                if (mc_main_activate_button(button_id)) return 0;
                if (button_id >= 0)
                {
                    last_tick = narm_millis();
                    dirty = 1;
                }
            }
            else if (key == NARM_KEY_F1 && action == NARM_KEY_ACTION_PRESS)
            {
                mc_ui_draw_status("PLATFORM STATUS");
                mc_wait_for_return();
#ifdef MC10_MOUSE
                mc_mouse_ui_reset();
#endif
                last_tick = narm_millis();
                dirty = 1;
            }
        }

        event = narm_poll_system_event();
        if (event == NARM_EVENT_CLOSE_REQUESTED) return 0;
#ifdef MC10_MOUSE
        if (event == NARM_EVENT_FOCUS_LOST) mc_mouse_ui_reset();
        if (event == NARM_EVENT_FOCUS_GAINED) { mc_mouse_ui_reset(); dirty=1; }
#endif
        if (dirty)
        {
            if (!mc_menu_draw()) return mc_main_video_error();
            dirty = 0;
        }
        narm_sleep_ms(2);
    }
#endif
}
