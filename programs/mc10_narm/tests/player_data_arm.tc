struct MCResidentChunk *mc_runtime_find_chunk(int x,int z)
{int i;for(i=0;i<9;i=i+1)if(mc_runtime_chunks[i].state==1&&mc_chunk_is_at_location(&mc_runtime_chunks[i].chunk,x,z))return &mc_runtime_chunks[i];return 0;}
