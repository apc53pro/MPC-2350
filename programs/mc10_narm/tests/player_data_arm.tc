#include "mc10_stream.tc"

uint probe_pattern(int i){return ((uint)i*13+((uint)i>>8))&255;}
int probe_retained_tag(void)
{
 int i;
 if(mc_inventory_slots[0].tag_offset!=0||mc_inventory_slots[0].tag_bytes!=PROBE_TAG_BYTES)return 0;
 for(i=0;i<PROBE_TAG_BYTES;i=i+1)if(mc_inventory_tags[i]!=probe_expected_tag[i])return 0;
 return 1;
}
int probe_slot_bytes(int slot,int inverted)
{
 int i;uint expected;
 for(i=0;i<82176;i=i+1)
 {
  expected=probe_pattern(i);if(inverted)expected=expected^255;
  if(i<32768)
  {if(((uint)mc_runtime_blocks[slot*32768+i]&255)!=expected)return 1;}
  else if(i<49152)
  {if(((uint)mc_runtime_metadata[slot*16384+i-32768]&255)!=expected)return 2;}
  else if(i<65536)
  {if(((uint)mc_runtime_skylight[slot*16384+i-49152]&255)!=expected)return 3;}
  else if(i<81920)
  {if(((uint)mc_runtime_blocklight[slot*16384+i-65536]&255)!=expected)return 4;}
  else
  {if(((uint)mc_runtime_heightmap[slot*256+i-81920]&255)!=expected)return 5;}
 }
 return 0;
}

