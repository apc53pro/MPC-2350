/* Test-only GL call recorder. The two source methods are inserted at runtime
 * from the owned installation, never packaged or checked in as Mojang inputs. */
strictfp class GL11 {
 static final int GL_TEXTURE_2D=0;static float[] m=new float[16],result;
 static ArrayDeque<float[]> stack=new ArrayDeque<float[]>();
 static void identity(){Arrays.fill(m,0);for(int i=0;i<16;i+=5)m[i]=1;stack.clear();}
 static void glPushMatrix(){stack.push(m.clone());}static void glPopMatrix(){m=stack.pop();}
 static void glTranslatef(float x,float y,float z){for(int r=0;r<12;r+=4)m[r+3]=m[r+3]+m[r]*x+m[r+1]*y+m[r+2]*z;}
 static void glScalef(float x,float y,float z){for(int r=0;r<12;r+=4){m[r]*=x;m[r+1]*=y;m[r+2]*=z;}}
 static void glRotatef(float a,float x,float y,float z){int axis=x!=0?0:y!=0?1:2;float rad=a*((float)Math.PI/180f),s=(float)Math.sin(rad),c=(float)Math.cos(rad);int p=axis==0?1:0,q=axis==2?1:2;if(axis==1)s=-s;for(int r=0;r<12;r+=4){float u=m[r+p],v=m[r+q];m[r+p]=u*c+v*s;m[r+q]=v*c-u*s;}}
 static void glEnable(int x){}static void glDisable(int x){}static void glBindTexture(int x,int y){}
 static void glColor4f(float a,float b,float c,float d){}static void glNormal3f(float a,float b,float c){}
}
