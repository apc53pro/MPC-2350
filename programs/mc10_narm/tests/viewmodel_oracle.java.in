strictfp class ViewmodelOracle {
 Minecraft mc=new Minecraft();ItemStack itemToRender;MapItemRenderer mapItemRenderer=new MapItemRenderer();
 float prevEquippedProgress,equippedProgress;
 void renderItem(EntityLiving p,ItemStack s,int pass){GL11.result=GL11.m.clone();}
 __SOURCE_ITEM_METHOD__
 __SOURCE_BOB_METHOD__
 public static void main(String[] args)throws Exception{
  DataInputStream data=new DataInputStream(new FileInputStream(args[0]));data.skipBytes(16);
  for(int i=0;i<65536;++i)MathHelper.table[i]=Float.intBitsToFloat(Integer.reverseBytes(data.readInt()));data.close();
  BufferedReader in=new BufferedReader(new InputStreamReader(System.in));String line;
  while((line=in.readLine())!=null){String[] fields=line.split(" ");
   if(fields[0].equals("atan")){double x=Double.longBitsToDouble(Long.parseUnsignedLong(fields[1],16));System.out.printf("%016x %08x%n",Double.doubleToRawLongBits(StrictMath.atan(x)),Float.floatToRawIntBits((float)Math.atan(x)*15f));continue;}
   float[] v=new float[fields.length];for(int i=1;i<fields.length;++i)v[i]=Float.intBitsToFloat(Integer.parseUnsignedInt(fields[i],16));
   ViewmodelOracle o=new ViewmodelOracle();EntityPlayerSP p=o.mc.thePlayer;
   p.rotationYaw=v[1];p.rotationPitch=v[2];p.prevRotationYaw=v[1];p.prevRotationPitch=v[2];
   p.renderArmYaw=v[3];p.renderArmPitch=v[4];p.prevRenderArmYaw=v[5];p.prevRenderArmPitch=v[6];
   p.swingProgress=v[7];p.prevSwingProgress=v[8];o.equippedProgress=v[9];o.prevEquippedProgress=v[10];
   p.distanceWalkedModified=v[13];p.prevDistanceWalkedModified=v[14];p.cameraYaw=v[15];p.prevCameraYaw=v[16];p.cameraPitch=v[17];p.prevCameraPitch=v[18];
   int id=(int)v[12];o.itemToRender=id==0?null:new ItemStack(id);
   GL11.identity();if(v[19]!=0)o.setupViewBobbing(v[11]);o.renderItemInFirstPerson(v[11]);
   for(int i=0;i<16;++i)System.out.printf("%08x%s",Float.floatToRawIntBits(GL11.result[i]),i==15?"\n":" ");
  }
 }
}
