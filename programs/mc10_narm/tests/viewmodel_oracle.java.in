class MathHelper{
 static float[] table=new float[65536];static float sin(float x){return table[(int)(x*10430.378f)&65535];}
 static float cos(float x){return table[(int)(x*10430.378f+16384f)&65535];}
 static float sqrt_float(float x){return (float)Math.sqrt(x);}static float abs(float x){return x<0?-x:x;}
 static int floor_double(double x){return (int)Math.floor(x);}
}
