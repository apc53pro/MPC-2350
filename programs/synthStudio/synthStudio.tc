unsigned read_u16_le(const char *p) {
    return (unsigned)(unsigned char)p[0] | ((unsigned)(unsigned char)p[1] << 8);
}
unsigned read_u32_le(const char *p) {
    return (unsigned)(unsigned char)p[0] |
           ((unsigned)(unsigned char)p[1] << 8) |
           ((unsigned)(unsigned char)p[2] << 16) |
           ((unsigned)(unsigned char)p[3] << 24);
}
void set_u16_le(char *p, unsigned v) {
    p[0]=(char)(v&255u); p[1]=(char)((v>>8)&255u);
}
void set_u32_le(char *p, unsigned v) {
    p[0]=(char)(v&255u); p[1]=(char)((v>>8)&255u); p[2]=(char)((v>>16)&255u); p[3]=(char)((v>>24)&255u);
}
int bytes_eq4(const char *p, char a, char b, char c, char d) {
    return p[0]==a && p[1]==b && p[2]==c && p[3]==d;
}

void build_wav_header_frames(unsigned frames) {
    unsigned data_bytes=frames*FRAME_BYTES;
    unsigned v;
    int i;
    for (i=0;i<44;++i) wav_header[i]=0;
    wav_header[0]='R';wav_header[1]='I';wav_header[2]='F';wav_header[3]='F';

    /* Serialize the two size fields explicitly one byte at a time.  Older
     * Studio builds used the generic v>>24 helper here; projects whose PCM
     * crossed 0x01000000 bytes exposed a lost MSB and therefore advertised
     * only the low 24 bits of their WAV length.  Successive /256 operations
     * avoid that path entirely and make the carry into byte 3 explicit. */
    v=data_bytes+36u;
    wav_header[4]=(char)(v%256u);v/=256u;
    wav_header[5]=(char)(v%256u);v/=256u;
    wav_header[6]=(char)(v%256u);v/=256u;
    wav_header[7]=(char)(v%256u);

    wav_header[8]='W';wav_header[9]='A';wav_header[10]='V';wav_header[11]='E';
    wav_header[12]='f';wav_header[13]='m';wav_header[14]='t';wav_header[15]=' ';
    set_u32_le(&wav_header[16],16u); set_u16_le(&wav_header[20],1u); set_u16_le(&wav_header[22],2u);
    set_u32_le(&wav_header[24],SAMPLE_RATE); set_u32_le(&wav_header[28],SAMPLE_RATE*4u);
    set_u16_le(&wav_header[32],4u); set_u16_le(&wav_header[34],16u);
    wav_header[36]='d';wav_header[37]='a';wav_header[38]='t';wav_header[39]='a';

    v=data_bytes;
    wav_header[40]=(char)(v%256u);v/=256u;
    wav_header[41]=(char)(v%256u);v/=256u;
    wav_header[42]=(char)(v%256u);v/=256u;
    wav_header[43]=(char)(v%256u);
}

unsigned decode_u32_le_mul(const char *p) {
    return (unsigned)(unsigned char)p[0] +
           (unsigned)(unsigned char)p[1]*256u +
           (unsigned)(unsigned char)p[2]*65536u +
           (unsigned)(unsigned char)p[3]*16777216u;
}

int verify_preview_wav_header(unsigned frames) {
    unsigned size=0u,expected_data=frames*FRAME_BYTES,expected_riff=expected_data+36u;
    if(narm_file_size(preview_path,STORAGE_SD,&size)<0||size<44u)return 0;
    if(!file_read_exact(preview_path,io_small,0u,44u,STORAGE_SD))return 0;
    if(!bytes_eq4(io_small,'R','I','F','F')||!bytes_eq4(&io_small[8],'W','A','V','E')||
       !bytes_eq4(&io_small[36],'d','a','t','a'))return 0;
    if(decode_u32_le_mul(&io_small[4])!=expected_riff)return 0;
    if(decode_u32_le_mul(&io_small[40])!=expected_data)return 0;
    return 1;
}

void build_wav_header(void) { build_wav_header_frames(project_frames); }
unsigned fnv_byte(unsigned h, unsigned b) { h ^= (b & 255u); h *= 16777619u; return h; }
unsigned fnv_u32(unsigned h, unsigned v) {
    h=fnv_byte(h,v); h=fnv_byte(h,v>>8); h=fnv_byte(h,v>>16); h=fnv_byte(h,v>>24); return h;
}

void str_clear(char *d,unsigned cap){unsigned i;for(i=0;i<cap;++i)d[i]=0;}
void str_copy_cap(char *d,const char *src,unsigned cap){unsigned i=0u;if(!cap)return;while(src[i]&&i+1u<cap){d[i]=src[i];++i;}d[i]=0;}
unsigned str_len(const char *s){unsigned n=0u;while(s[n])++n;return n;}
int char_lower(int c){if(c>='A'&&c<='Z')return c+32;return c;}
int has_wav_ext(const char *s){unsigned n=str_len(s);if(n<4u)return 0;return s[n-4u]=='.'&&char_lower(s[n-3u])=='w'&&char_lower(s[n-2u])=='a'&&char_lower(s[n-1u])=='v';}
void make_root_path(const char *name,char *out){unsigned i=0u,j=0u;out[i++]='/';while(name[j]&&i+1u<MAX_PATH)out[i++]=name[j++];out[i]=0;}
void path_join(char *out,const char *a,const char *b){unsigned i=0u,j=0u;while(a[i]&&i+1u<MAX_PATH){out[i]=a[i];++i;}if(i>0u&&out[i-1u]!='/'&&i+1u<MAX_PATH)out[i++]='/';while(b[j]&&i+1u<MAX_PATH)out[i++]=b[j++];out[i]=0;}
void set_paths_for_dir(const char *dir){str_copy_cap(project_dir,dir,MAX_PATH);path_join(project_path,dir,"project.nprj");path_join(project_tmp_path,dir,"project.tmp");path_join(project_backup_path,dir,"project.bak");path_join(preview_path,dir,"preview.wav");path_join(playback_path,dir,"playback.wav");path_join(cache_meta_path,dir,"cache.meta");path_join(export_path,dir,"export.wav");}
void set_unsaved_identity(void){project_named=0;str_clear(project_name,PROJECT_NAME_MAX);set_paths_for_dir(temp_project_dir);}
void set_named_identity(const char *name){char d[MAX_PATH];unsigned i=0u,j=0u;str_copy_cap(project_name,name,PROJECT_NAME_MAX);while(studio_root[i]&&i+1u<MAX_PATH){d[i]=studio_root[i];++i;}if(i+1u<MAX_PATH)d[i++]='/';while(name[j]&&i+1u<MAX_PATH)d[i++]=name[j++];d[i]=0;project_named=1;set_paths_for_dir(d);}
void make_waveform_path_for_dir(const char *dir,int track,char *out){char leaf[16];leaf[0]='w';leaf[1]='a';leaf[2]='v';leaf[3]='e';leaf[4]='_';leaf[5]=(char)('0'+((track/10)%10));leaf[6]=(char)('0'+(track%10));leaf[7]='.';leaf[8]='w';leaf[9]='f';leaf[10]='c';leaf[11]=0;path_join(out,dir,leaf);}
void make_waveform_path(int track,char *out){make_waveform_path_for_dir(project_dir,track,out);}
void set_status(const char *s){str_copy_cap(status_text,s,64u);status_code=0;}
void set_error(int code,const char *s){str_copy_cap(status_text,s,64u);status_code=code;render_percent=0;rendering=0;}
void playback_service_checkpoint(void){if(playing)narm_yield();}


/* Large file transfers are adaptive. Some firmware/storage combinations reject
 * large individual reads/writes even though the ABI itself does not specify a
 * maximum. Start large for speed, then back off on an actual failed call and
 * remember the proven size for the rest of the session. Short positive
 * transfers are valid progress and are always continued. */
unsigned file_read_cap=FILE_IO_SLICE;
unsigned file_write_cap=FILE_IO_SLICE;
int last_file_read_result=0;
int last_file_write_result=0;

int file_read_exact(const char *path, void *buffer, unsigned file_offset, unsigned byte_count, unsigned storage) {
    char *dst=(char*)buffer; unsigned done=0u,zero_retries=0u;
    while(done<byte_count){
        unsigned remain=byte_count-done;
        unsigned take=remain<file_read_cap?remain:file_read_cap;
        int r=narm_file_read(path,dst+done,file_offset+done,take,storage);
        last_file_read_result=r;
        if(r>0){
            if((unsigned)r>take)return 0; /* impossible/invalid service result */
            done+=(unsigned)r;zero_retries=0u;
            if((unsigned)r<take && (unsigned)r>=FILE_IO_MIN_SLICE && (unsigned)r<file_read_cap)
                file_read_cap=(unsigned)r;
            narm_yield();
            continue;
        }
        if(r==0 && zero_retries<FILE_IO_ZERO_RETRIES){
            ++zero_retries;narm_yield();continue;
        }
        zero_retries=0u;
        if(take>FILE_IO_MIN_SLICE){
            unsigned next=take>>1;
            if(next<FILE_IO_MIN_SLICE)next=FILE_IO_MIN_SLICE;
            if(next<file_read_cap)file_read_cap=next;
            continue;
        }
        return 0;
    }
    return 1;
}
int file_write_exact(const char *path, const void *buffer, unsigned file_offset, unsigned byte_count, unsigned storage) {
    const char *src=(const char*)buffer; unsigned done=0u,zero_retries=0u;
    while(done<byte_count){
        unsigned remain=byte_count-done;
        unsigned take=remain<file_write_cap?remain:file_write_cap;
        int r=narm_file_write(path,src+done,file_offset+done,take,storage);
        last_file_write_result=r;
        if(r>0){
            if((unsigned)r>take)return 0; /* impossible/invalid service result */
            done+=(unsigned)r;zero_retries=0u;
            if((unsigned)r<take && (unsigned)r>=FILE_IO_MIN_SLICE && (unsigned)r<file_write_cap)
                file_write_cap=(unsigned)r;
            narm_yield();
            continue;
        }
        if(r==0 && zero_retries<FILE_IO_ZERO_RETRIES){
            ++zero_retries;narm_yield();continue;
        }
        zero_retries=0u;
        if(take>FILE_IO_MIN_SLICE){
            unsigned next=take>>1;
            if(next<FILE_IO_MIN_SLICE)next=FILE_IO_MIN_SLICE;
            if(next<file_write_cap)file_write_cap=next;
            continue;
        }
        return 0;
    }
    return 1;
}

/* Metadata readers often need only 8-24 bytes, but some SD implementations are
 * happier with a larger transaction. Ask for up to 'preferred' bytes and
 * accept any successful read that contains at least 'need'. Back off all the
 * way to exactly 'need' instead of assuming one magic transfer size. */
int file_read_at_least(const char *path, void *buffer, unsigned file_offset,unsigned need,unsigned preferred,unsigned storage){
    unsigned take=preferred,zero_retries=0u;if(take<need)take=need;if(take>file_read_cap)take=file_read_cap;if(take<need)take=need;
    for(;;){
        int r=narm_file_read(path,buffer,file_offset,take,storage);last_file_read_result=r;
        if(r>=(int)need){if((unsigned)r<take&&(unsigned)r>=FILE_IO_MIN_SLICE&&(unsigned)r<file_read_cap)file_read_cap=(unsigned)r;return r;}
        if(r>0)return 0; /* EOF before required metadata */
        if(r==0&&zero_retries<FILE_IO_ZERO_RETRIES){++zero_retries;narm_yield();continue;}
        zero_retries=0u;if(take>need){unsigned next=take>>1;if(next<need)next=need;take=next;continue;}return 0;
    }
}
