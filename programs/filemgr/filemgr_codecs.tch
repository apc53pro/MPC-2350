int jpegRawByte()
{
    int value;
    if (imageCodecError != 0) return 0;
    if ((uint)jpegPosition >= selectedSize) { codecFail(1); return 0; }
    value = (int)codecSourceByte(jpegPosition);
    jpegPosition = jpegPosition + 1;
    return value;
}

int jpegRawWord()
{
    int high = jpegRawByte();
    int low = jpegRawByte();
    return high * 256 + low;
}

int jpegMarker()
{
    int marker;
    if (jpegRawByte() != 255) { codecFail(1); return 0; }
    marker = jpegRawByte();
    while (marker == 255 && imageCodecError == 0) marker = jpegRawByte();
    if (marker == 0) codecFail(1);
    return marker;
}

uint jpegGetBits(int count)
{
    uint value;
    int byte;
    int next;
    value = 0;
    while (count > 0 && imageCodecError == 0)
    {
        if (jpegBitCount == 0)
        {
            byte = jpegRawByte();
            if (byte == 255)
            {
                next = jpegRawByte();
                while (next == 255 && imageCodecError == 0) next = jpegRawByte();
                if (next != 0) { codecFail(1); return 0; }
            }
            jpegBits = (uint)byte;
            jpegBitCount = 8;
        }
        jpegBitCount = jpegBitCount - 1;
        value = (value << (uint)1) | ((jpegBits >> (uint)jpegBitCount) & (uint)1);
        count = count - 1;
    }
    return value;
}

int jpegHuffman(int table)
{
    int length;
    int code;
    int first;
    int index;
    int count;
    if (jpegHuffPresent[table] == 0) { codecFail(1); return 0; }
    code = 0; first = 0; index = 0;
    for (length = 1; length <= 16; length = length + 1)
    {
        code = code * 2 + (int)jpegGetBits(1);
        count = jpegHuffCount[table * 17 + length];
        if (code >= first && code < first + count)
            return (int)(((uint)jpegHuffSymbol[table * 256 + index + code - first]) & (uint)255);
        index = index + count; first = (first + count) * 2;
    }
    codecFail(1);
    return 0;
}

int jpegReceive(int count)
{
    int value;
    if (count == 0) return 0;
    if (count > 16) { codecFail(1); return 0; }
    value = (int)jpegGetBits(count);
    if (value < (1 << (count - 1))) value = value - ((1 << count) - 1);
    return value;
}

void jpegReadQuant(int end)
{
    int table;
    int precision;
    int info;
    int i;
    int value;
    while (jpegPosition < end && imageCodecError == 0)
    {
        info = jpegRawByte(); table = info & 15; precision = info >> 4;
        if (table > 3 || precision > 1 || end - jpegPosition < 64 * (precision + 1)) { codecFail(1); return; }
        for (i = 0; i < 64; i = i + 1)
        {
            if (precision == 0) value = jpegRawByte(); else value = jpegRawWord();
            if (value == 0) { codecFail(1); return; }
            jpegQuant[table * 64 + jpegZigZag[i]] = value;
        }
        jpegQuantPresent[table] = 1;
    }
}

void jpegReadHuffman(int end)
{
    int table;
    int info;
    int i;
    int total;
    int left;
    while (jpegPosition < end && imageCodecError == 0)
    {
        info = jpegRawByte();
        if ((info & 15) > 3 || (info >> 4) > 1 || end - jpegPosition < 16) { codecFail(1); return; }
        table = (info >> 4) * 4 + (info & 15);
        total = 0; left = 1;
        for (i = 1; i <= 16; i = i + 1)
        {
            jpegHuffCount[table * 17 + i] = jpegRawByte();
            total = total + jpegHuffCount[table * 17 + i];
            left = left * 2 - jpegHuffCount[table * 17 + i];
            if (left < 0) { codecFail(1); return; }
        }
        if (total == 0 || total > 256 || total > end - jpegPosition) { codecFail(1); return; }
        for (i = 0; i < total; i = i + 1) jpegHuffSymbol[table * 256 + i] = (char)jpegRawByte();
        jpegHuffPresent[table] = 1;
    }
}

void jpegReadFrame(int marker, int end)
{
    int precision;
    int width;
    int height;
    int i;
    int j;
    int sampling;
    int blocks;
    int bytes;
    int total;
    if (jpegFrame != 0 || end - jpegPosition < 6) { codecFail(1); return; }
    precision = jpegRawByte(); height = jpegRawWord(); width = jpegRawWord();
    jpegComponents = jpegRawByte();
    if (precision != 8 || (marker != 0xc0 && marker != 0xc1 && marker != 0xc2)) { codecFail(2); return; }
    if (width != imageWidth || height != imageHeight || (jpegComponents != 1 && jpegComponents != 3 && jpegComponents != 4)) { codecFail(2); return; }
    if (end - jpegPosition != jpegComponents * 3) { codecFail(1); return; }
    jpegHMax = 1; jpegVMax = 1; blocks = 0;
    for (i = 0; i < jpegComponents; i = i + 1)
    {
        jpegId[i] = jpegRawByte(); sampling = jpegRawByte(); jpegQ[i] = jpegRawByte();
        for (j = 0; j < i; j = j + 1) if (jpegId[j] == jpegId[i]) { codecFail(1); return; }
        jpegH[i] = sampling >> 4; jpegV[i] = sampling & 15;
        if (jpegH[i] < 1 || jpegH[i] > 4 || jpegV[i] < 1 || jpegV[i] > 4 || jpegQ[i] > 3) { codecFail(2); return; }
        if (jpegH[i] > jpegHMax) jpegHMax = jpegH[i];
        if (jpegV[i] > jpegVMax) jpegVMax = jpegV[i];
        blocks = blocks + jpegH[i] * jpegV[i];
    }
    if (jpegComponents > 1 && blocks > 10) { codecFail(2); return; }
    jpegMcuColumns = (imageWidth + 8 * jpegHMax - 1) / (8 * jpegHMax);
    jpegMcuRows = (imageHeight + 8 * jpegVMax - 1) / (8 * jpegVMax);
    total = 0;
    for (i = 0; i < jpegComponents; i = i + 1)
    {
        jpegBlockWidth[i] = jpegMcuColumns * jpegH[i];
        jpegBlockHeight[i] = jpegMcuRows * jpegV[i];
        jpegDataWidth[i] = (imageWidth * jpegH[i] + 8 * jpegHMax - 1) / (8 * jpegHMax);
        jpegDataHeight[i] = (imageHeight * jpegV[i] + 8 * jpegVMax - 1) / (8 * jpegVMax);
        if (jpegBlockWidth[i] > 2147483000 / (jpegBlockHeight[i] * 128)) { codecFail(2); return; }
        bytes = jpegBlockWidth[i] * jpegBlockHeight[i] * 128;
        if (bytes > 2147483000 - total) { codecFail(2); return; }
        jpegPlane[i] = total; total = total + bytes;
    }
    codecScratchBytes = total;
    jpegProgressive = marker == 0xc2;
    jpegFrame = 1;
}

void jpegReadScan(int end)
{
    int i;
    int j;
    int id;
    int component;
    int tables;
    int approximation;
    int k;
    jpegScanComponents = jpegRawByte();
    if (jpegFrame == 0 || jpegScanComponents < 1 || jpegScanComponents > jpegComponents || end - jpegPosition != jpegScanComponents * 2 + 3) { codecFail(1); return; }
    for (i = 0; i < jpegScanComponents; i = i + 1)
    {
        id = jpegRawByte(); tables = jpegRawByte(); component = -1;
        for (j = 0; j < jpegComponents; j = j + 1) if (jpegId[j] == id) component = j;
        if (component < 0 || (tables >> 4) > 3 || (tables & 15) > 3) { codecFail(1); return; }
        for (j = 0; j < i; j = j + 1) if (jpegScanComponent[j] == component) { codecFail(1); return; }
        jpegScanComponent[i] = component;
        jpegTableDC[component] = tables >> 4;
        jpegTableAC[component] = 4 + (tables & 15);
    }
    jpegSs = jpegRawByte(); jpegSe = jpegRawByte(); approximation = jpegRawByte();
    jpegAh = approximation >> 4; jpegAl = approximation & 15;
    if (jpegSs > jpegSe || jpegSe > 63 || jpegAh > 13 || jpegAl > 13) { codecFail(1); return; }
    if (jpegProgressive == 0)
    {
        if (jpegSs != 0 || jpegSe != 63 || approximation != 0) { codecFail(1); return; }
    }
    else if ((jpegSs == 0 && jpegSe != 0) || (jpegSs > 0 && jpegScanComponents != 1) || (jpegAh != 0 && jpegAl != jpegAh - 1)) { codecFail(1); return; }
    for (i = 0; i < jpegScanComponents; i = i + 1)
    {
        component = jpegScanComponent[i];
        if (jpegQuantPresent[jpegQ[component]] == 0) { codecFail(1); return; }
        if (jpegComponentQuantSaved[component] == 0)
        {
            for (k = 0; k < 64; k = k + 1) jpegComponentQuant[component * 64 + k] = jpegQuant[jpegQ[component] * 64 + k];
            jpegComponentQuantSaved[component] = 1;
        }
        if (jpegSs == 0 && jpegAh == 0 && jpegHuffPresent[jpegTableDC[component]] == 0) { codecFail(1); return; }
        if ((jpegSs > 0 || jpegProgressive == 0) && jpegHuffPresent[jpegTableAC[component]] == 0) { codecFail(1); return; }
        for (k = jpegSs; k <= jpegSe; k = k + 1)
        {
            if ((jpegAh == 0 && jpegCoefficientState[component * 64 + k] != -1) ||
                (jpegAh != 0 && jpegCoefficientState[component * 64 + k] != jpegAh)) { codecFail(1); return; }
            jpegCoefficientState[component * 64 + k] = jpegAl;
        }
    }
    if (jpegScanComponents == 1)
    {
        component = jpegScanComponent[0];
        jpegScanColumns = jpegDataWidth[component]; jpegScanRows = jpegDataHeight[component];
    }
    else { jpegScanColumns = jpegMcuColumns; jpegScanRows = jpegMcuRows; }
    for (i = 0; i < 4; i = i + 1) jpegDC[i] = 0;
    jpegBits = 0; jpegBitCount = 0; jpegEobRun = 0; jpegRestartNext = 0;
    jpegScanIndex = 0; jpegScanNumber = jpegScanNumber + 1;
    imageCacheBuildY = 0; dirty = 1;
}

int jpegParseMarkers()
{
    int marker;
    int length;
    int end;
    int i;
    while (imageCodecError == 0)
    {
        marker = jpegMarker();
        if (marker == 0xd9)
        {
            if (jpegScanNumber == 0) { codecFail(1); return 0; }
            for (i = 0; i < jpegComponents; i = i + 1)
                if (jpegCoefficientState[i * 64] < 0) { codecFail(1); return 0; }
            return 2;
        }
        if (marker == 0xd8 || (marker >= 0xd0 && marker <= 0xd7)) { codecFail(1); return 0; }
        if (marker == 1) continue;
        length = jpegRawWord();
        if (length < 2 || (uint)(length - 2) > selectedSize - (uint)jpegPosition) { codecFail(1); return 0; }
        end = jpegPosition + length - 2;
        if (marker == 0xdb) jpegReadQuant(end);
        else if (marker == 0xc4) jpegReadHuffman(end);
        else if (jpegSofMarker(marker) != 0) jpegReadFrame(marker, end);
        else if (marker == 0xdd)
        {
            if (length != 4) { codecFail(1); return 0; }
            jpegRestartInterval = jpegRawWord();
        }
        else if (marker == 0xda)
        {
            jpegReadScan(end);
            return imageCodecError == 0;
        }
        else if (marker == 0xee && length >= 14)
        {
            if (codecSourceByte(jpegPosition) == (uint)65 && codecSourceByte(jpegPosition + 1) == (uint)100 &&
                codecSourceByte(jpegPosition + 2) == (uint)111 && codecSourceByte(jpegPosition + 3) == (uint)98 &&
                codecSourceByte(jpegPosition + 4) == (uint)101)
                jpegAdobe = (int)codecSourceByte(jpegPosition + 11);
        }
        else if (marker == 0xcc || marker == 0xdc || marker == 0xde || marker == 0xdf) { codecFail(2); return 0; }
        if (jpegPosition > end) { codecFail(1); return 0; }
        jpegPosition = end;
    }
    return 0;
}

int jpegBegin()
{
    int i;
    jpegPosition = 0; jpegFrame = 0; jpegScanNumber = 0;
    jpegRestartInterval = 0; jpegAdobe = -1;
    for (i = 0; i < 4; i = i + 1) { jpegQuantPresent[i] = 0; jpegComponentQuantSaved[i] = 0; }
    for (i = 0; i < 8; i = i + 1) jpegHuffPresent[i] = 0;
    for (i = 0; i < 256; i = i + 1) jpegCoefficientState[i] = -1;
    if (jpegRawByte() != 255 || jpegRawByte() != 216) { codecFail(1); return 0; }
    if (jpegParseMarkers() != 1) { codecFail(1); return 0; }
    fileDelete(codecScratchPath, activeStorage);
    if (fileMake(codecScratchPath, activeStorage) == 0) { codecFail(3); return 0; }
    codecScratchExists = 1;
    codecZeroOffset = 0; jpegStage = 0;
    return 1;
}

void jpegLoadCoefficient(int offset)
{
    int i;
    int value;
    uint low;
    uint high;
    for (i = 0; i < 64; i = i + 1)
    {
        low = codecBankRead(offset + i * 2); high = codecBankRead(offset + i * 2 + 1);
        value = (int)(low | (high << (uint)8));
        if (value >= 32768) value = value - 65536;
        jpegCoefficient[i] = value;
    }
}

void jpegStoreCoefficient(int offset)
{
    int i;
    int value;
    for (i = 0; i < 64; i = i + 1)
    {
        value = jpegCoefficient[i];
        if (value < -32768 || value > 32767) { codecFail(1); return; }
        codecBankWrite(offset + i * 2, (uint)value & (uint)255);
        codecBankWrite(offset + i * 2 + 1, ((uint)value >> (uint)8) & (uint)255);
    }
}

void jpegRefineExisting(int index, int bit)
{
    int value = jpegCoefficient[index];
    if (jpegGetBits(1) != 0 && (value & bit) == 0)
    {
        if (value >= 0) jpegCoefficient[index] = value + bit;
        else jpegCoefficient[index] = value - bit;
    }
}

void jpegDecodeBlock(int component)
{
    int k;
    int symbol;
    int run;
    int size;
    int value;
    int bit;
    int index;
    int zeros;
    int inserted;
    if (jpegSs == 0)
    {
        if (jpegAh == 0)
        {
            size = jpegHuffman(jpegTableDC[component]);
            if (size > 11) { codecFail(1); return; }
            jpegDC[component] = jpegDC[component] + jpegReceive(size);
            jpegCoefficient[0] = jpegDC[component] * (1 << jpegAl);
        }
        else jpegCoefficient[0] = jpegCoefficient[0] | ((int)jpegGetBits(1) << jpegAl);
        if (jpegProgressive != 0) return;
    }
    k = jpegSs;
    if (k == 0) k = 1;
    bit = 1 << jpegAl;
    if (jpegAh == 0)
    {
        if (jpegEobRun > 0) { jpegEobRun = jpegEobRun - 1; return; }
        while (k <= jpegSe && imageCodecError == 0)
        {
            symbol = jpegHuffman(jpegTableAC[component]); run = symbol >> 4; size = symbol & 15;
            if (size != 0)
            {
                if (size > 10) { codecFail(1); return; }
                k = k + run;
                if (k > jpegSe) { codecFail(1); return; }
                jpegCoefficient[jpegZigZag[k]] = jpegReceive(size) * bit;
                k = k + 1;
            }
            else if (run == 15)
            {
                k = k + 16;
                if (k > jpegSe + 1) { codecFail(1); return; }
            }
            else
            {
                if (jpegProgressive != 0) jpegEobRun = (1 << run) + (int)jpegGetBits(run) - 1;
                else if (run != 0) codecFail(1);
                return;
            }
        }
        return;
    }
    if (jpegEobRun == 0)
    {
        while (k <= jpegSe && imageCodecError == 0)
        {
            symbol = jpegHuffman(jpegTableAC[component]); run = symbol >> 4; size = symbol & 15;
            value = 0;
            if (size != 0)
            {
                if (size != 1) { codecFail(1); return; }
                if (jpegGetBits(1) != 0) value = bit; else value = -bit;
                zeros = run;
            }
            else
            {
                if (run != 15) { jpegEobRun = (1 << run) + (int)jpegGetBits(run); break; }
                zeros = 16;
            }
            inserted = 0;
            while (k <= jpegSe && imageCodecError == 0)
            {
                index = jpegZigZag[k];
                if (jpegCoefficient[index] != 0) jpegRefineExisting(index, bit);
                else
                {
                    if (zeros == 0) { jpegCoefficient[index] = value; inserted = 1; k = k + 1; break; }
                    zeros = zeros - 1;
                    if (zeros == 0 && value == 0) { k = k + 1; break; }
                }
                k = k + 1;
            }
            if (zeros != 0 || (value != 0 && inserted == 0)) { codecFail(1); return; }
        }
    }
    if (jpegEobRun > 0)
    {
        while (k <= jpegSe)
        {
            index = jpegZigZag[k];
            if (jpegCoefficient[index] != 0) jpegRefineExisting(index, bit);
            k = k + 1;
        }
        jpegEobRun = jpegEobRun - 1;
    }
}

void jpegDecodeMcu()
{
    int component;
    int i;
    int x;
    int y;
    int sx;
    int sy;
    int width;
    int height;
    int offset;
    int marker;
    if (jpegRestartInterval > 0 && jpegScanIndex > 0 && jpegScanIndex % jpegRestartInterval == 0)
    {
        jpegBitCount = 0; jpegBits = 0;
        marker = jpegMarker();
        if (marker != 0xd0 + jpegRestartNext || jpegEobRun != 0) { codecFail(1); return; }
        jpegRestartNext = (jpegRestartNext + 1) & 7;
        for (i = 0; i < 4; i = i + 1) jpegDC[i] = 0;
        jpegEobRun = 0;
    }
    sx = jpegScanIndex % jpegScanColumns; sy = jpegScanIndex / jpegScanColumns;
    for (i = 0; i < jpegScanComponents; i = i + 1)
    {
        component = jpegScanComponent[i]; width = 1; height = 1;
        if (jpegScanComponents > 1) { width = jpegH[component]; height = jpegV[component]; }
        for (y = 0; y < height; y = y + 1) for (x = 0; x < width; x = x + 1)
        {
            offset = jpegPlane[component] + ((sy * height + y) * jpegBlockWidth[component] + sx * width + x) * 128;
            jpegLoadCoefficient(offset);
            jpegDecodeBlock(component);
            if (imageCodecError != 0) return;
            jpegStoreCoefficient(offset);
        }
    }
    jpegScanIndex = jpegScanIndex + 1;
    if (jpegScanIndex % jpegScanColumns == 0)
    {
        imageCacheBuildY = (jpegScanIndex / jpegScanColumns) * imageHeight / jpegScanRows;
        dirty = 1;
    }
    if (jpegScanIndex == jpegScanColumns * jpegScanRows)
    {
        if (jpegEobRun != 0) { codecFail(1); return; }
        jpegBitCount = 0; jpegBits = 0; jpegStage = 2;
    }
}

int jpegClamp(int value)
{
    if (value < 0) return 0;
    if (value > 255) return 255;
    return value;
}

void jpegIdct(int component, int offset, int slot)
{
    int i;
    int x;
    int y;
    int u;
    int v;
    int value;
    int ac;
    uint low;
    uint high;
    float sum;
    ac = 0;
    for (i = 0; i < 64; i = i + 1)
    {
        low = imageBlockByte(offset + i * 2); high = imageBlockByte(offset + i * 2 + 1);
        value = (int)(low | (high << (uint)8));
        if (value >= 32768) value = value - 65536;
        jpegCoefficient[i] = value;
        if (i != 0 && value != 0) ac = 1;
    }
    if (ac == 0)
    {
        sum = (float)jpegCoefficient[0] * (float)jpegComponentQuant[component * 64] / 8.0f + 128.0f;
        value = 0;
        if (sum >= 255.0f) value = 255;
        else if (sum > 0.0f) value = (int)(sum + 0.5f);
        for (i = 0; i < 64; i = i + 1) jpegDecoded[slot * 64 + i] = (char)value;
        return;
    }
    for (v = 0; v < 8; v = v + 1) for (x = 0; x < 8; x = x + 1)
    {
        sum = 0.0f;
        for (u = 0; u < 8; u = u + 1)
            sum = sum + (float)jpegCoefficient[v * 8 + u] * (float)jpegComponentQuant[component * 64 + v * 8 + u] * jpegIdctMatrix[x * 8 + u];
        jpegIdctWork[v * 8 + x] = sum;
    }
    for (y = 0; y < 8; y = y + 1) for (x = 0; x < 8; x = x + 1)
    {
        sum = 128.0f;
        for (v = 0; v < 8; v = v + 1) sum = sum + jpegIdctMatrix[y * 8 + v] * jpegIdctWork[v * 8 + x];
        value = 0;
        if (sum >= 255.0f) value = 255;
        else if (sum > 0.0f) value = (int)(sum + 0.5f);
        jpegDecoded[slot * 64 + y * 8 + x] = (char)value;
    }
}

int jpegComponentSample(int component, int x, int y)
{
    int sx;
    int sy;
    int tag;
    int slot;
    int i;
    uint age;
    uint oldest;
    sx = x * jpegH[component] / jpegHMax;
    sy = y * jpegV[component] / jpegVMax;
    tag = jpegPlane[component] / 128 + (sy / 8) * jpegBlockWidth[component] + sx / 8;
    slot = jpegDecodedLast[component];
    if (slot >= 0 && jpegDecodedTag[slot] == tag)
        return (int)(((uint)jpegDecoded[slot * 64 + (sy & 7) * 8 + (sx & 7)]) & (uint)255);
    slot = -1;
    for (i = 0; i < 16; i = i + 1) if (jpegDecodedTag[i] == tag) slot = i;
    if (slot < 0)
    {
        slot = 0; oldest = 0;
        for (i = 0; i < 16; i = i + 1)
        {
            if (jpegDecodedTag[i] < 0) { slot = i; break; }
            age = jpegDecodedClock - jpegDecodedAge[i];
            if (age >= oldest) { slot = i; oldest = age; }
        }
        jpegIdct(component, tag * 128, slot);
        jpegDecodedTag[slot] = tag;
    }
    jpegDecodedClock = jpegDecodedClock + (uint)1;
    jpegDecodedAge[slot] = jpegDecodedClock;
    jpegDecodedLast[component] = slot;
    return (int)(((uint)jpegDecoded[slot * 64 + (sy & 7) * 8 + (sx & 7)]) & (uint)255);
}

void jpegOutput(int x, int y)
{
    int first;
    int second;
    int third;
    int fourth;
    int red;
    int green;
    int blue;
    first = jpegComponentSample(0, x, y);
    red = first; green = first; blue = first;
    if (jpegComponents > 1)
    {
        second = jpegComponentSample(1, x, y);
        third = jpegComponentSample(2, x, y);
        if (jpegComponents == 3 && (jpegAdobe == 0 || (jpegId[0] == 82 && jpegId[1] == 71 && jpegId[2] == 66)))
        { red = first; green = second; blue = third; }
        else if (jpegComponents == 4 && jpegAdobe != 2)
        {
            fourth = jpegComponentSample(3, x, y);
            if (jpegAdobe == 0)
            {
                red = (first * fourth + 127) / 255;
                green = (second * fourth + 127) / 255;
                blue = (third * fourth + 127) / 255;
            }
            else
            {
                red = ((255 - first) * (255 - fourth) + 127) / 255;
                green = ((255 - second) * (255 - fourth) + 127) / 255;
                blue = ((255 - third) * (255 - fourth) + 127) / 255;
            }
        }
        else
        {
            second = second - 128; third = third - 128;
            red = jpegClamp(first + ((91881 * third + 32768) >> 16));
            green = jpegClamp(first + ((-22554 * second - 46802 * third + 32768) >> 16));
            blue = jpegClamp(first + ((116130 * second + 32768) >> 16));
            if (jpegComponents == 4)
            {
                fourth = jpegComponentSample(3, x, y);
                red = ((255 - red) * fourth + 127) / 255;
                green = ((255 - green) * fourth + 127) / 255;
                blue = ((255 - blue) * fourth + 127) / 255;
            }
        }
    }
    codecOutputRgb(x, y, (uint)red, (uint)green, (uint)blue);
}

void jpegRenderMcu()
{
    int startX;
    int startY;
    int endX;
    int endY;
    int x;
    int y;
    startX = (jpegRenderIndex % jpegMcuColumns) * jpegHMax * 8;
    startY = (jpegRenderIndex / jpegMcuColumns) * jpegVMax * 8;
    endX = startX + jpegHMax * 8; if (endX > imageWidth) endX = imageWidth;
    endY = startY + jpegVMax * 8; if (endY > imageHeight) endY = imageHeight;
    for (y = startY; y < endY && imageCodecError == 0; y = y + 1)
        for (x = startX; x < endX && imageCodecError == 0; x = x + 1) jpegOutput(x, y);
    jpegRenderIndex = jpegRenderIndex + 1;
    if (jpegRenderIndex % jpegMcuColumns == 0) { imageCacheBuildY = endY; dirty = 1; }
    if (jpegRenderIndex == jpegMcuColumns * jpegMcuRows) codecComplete();
}

void jpegStep()
{
    int result;
    int i;
    if (jpegStage == 0)
    {
        if (codecZeroBlock(codecScratchPath, 0, codecScratchBytes) == 0) return;
        codecBankReset(codecScratchPath, 0, codecScratchBytes);
        jpegStage = 1;
        return;
    }
    if (jpegStage == 1)
    {
        for (i = 0; i < 8 && jpegStage == 1 && imageCodecError == 0; i = i + 1) jpegDecodeMcu();
        return;
    }
    if (jpegStage == 2)
    {
        result = jpegParseMarkers();
        if (result == 1) { jpegStage = 1; return; }
        if (result != 2 || imageCodecError != 0) return;
        if (codecBankFlush() == 0) return;
        imageReadingSource = 2;
        invalidateImageBlocks();
        codecBankReset(imageCachePath, 512, imageCachePayloadBytes);
        if (imageCacheUsesRel != 0) copyBuffer(codecBankPath, imageCacheRelPath, 128);
        jpegDecodedClock = 0;
        for (i = 0; i < 16; i = i + 1) { jpegDecodedTag[i] = -1; jpegDecodedAge[i] = 0; }
        for (i = 0; i < 4; i = i + 1) jpegDecodedLast[i] = -1;
        jpegRenderIndex = 0; imageCacheBuildY = 0; dirty = 1;
        jpegStage = 3;
        return;
    }
    for (i = 0; i < 2 && codecMode != 0 && imageCodecError == 0; i = i + 1) jpegRenderMcu();
}
