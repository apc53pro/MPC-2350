void drawImageCacheStatus()
{
    int width;
    drawBox(116, 131, 523, 303, (uint)10, (uint)1);
    uiText("PREPARING IMAGE", 148, 162, (uint)0);
    if (imageCacheError != 0)
    {
        if (imageCodecError == 2) drawText("UNSUPPORTED IMAGE VARIANT", 96, 148, 202, 1, (uint)4);
        else if (imageCodecError == 3) drawText("IMAGE READ OR WRITE FAILED", 96, 148, 202, 1, (uint)4);
        else if (imageCodecError == 4) drawText("IMAGE CHECKSUM FAILED", 96, 148, 202, 1, (uint)4);
        else if (imageCodecError != 0) drawText("INVALID OR TRUNCATED IMAGE", 96, 148, 202, 1, (uint)4);
        else uiText("IMAGE CACHE FAILED", 148, 202, (uint)4);
        return;
    }
    drawText("BUILDING A ROW CACHE ON THE SELECTED DRIVE", 96, 148, 197, 1, (uint)15);
    fmFillRect(148, 225, 491, 236, (uint)14);
    width = 0;
    if (imageHeight > 0) width = imageCacheBuildY * 344 / imageHeight;
    if (width > 344) width = 344;
    if (width > 0) fmFillRect(148, 225, 147 + width, 236, (uint)13);
    drawText("BACKSPACE CANCELS", 96, 148, 265, 1, (uint)15);
}

void drawRenderableImage()
{
    int y;
    int y1;
    int sourceY;
    int slot;
    int pendingSlot;
    int pendingY;
    int pendingEnd;
    if (imageCacheReady == 0) return;
    updateImageLookupTables();
    pendingSlot = -1;
    pendingY = IMAGE_TOP;
    pendingEnd = IMAGE_TOP - 1;
    y = IMAGE_TOP;
    while (y < IMAGE_TOP + IMAGE_HEIGHT)
    {
        sourceY = imageSrcYTable[y];
        y1 = y;
        while (y1 + 1 < IMAGE_TOP + IMAGE_HEIGHT && imageSrcYTable[y1 + 1] == sourceY) y1 = y1 + 1;
        if (sourceY >= 0 && sourceY < imageHeight)
        {
            slot = 0;
            if (pendingSlot == 0) slot = 1;
            imageScreenRowValid[slot] = 0;
            buildImageScreenRowInSlot(sourceY, slot);
            if (pendingSlot >= 0 && sameImageScreenRows(pendingSlot, slot) != 0) pendingEnd = y1;
            else
            {
                if (pendingSlot >= 0) drawCachedImageRowRuns(pendingSlot, pendingY, pendingEnd);
                pendingSlot = slot;
                pendingY = y;
                pendingEnd = y1;
            }
        }
        else
        {
            if (pendingSlot >= 0) drawCachedImageRowRuns(pendingSlot, pendingY, pendingEnd);
            pendingSlot = -1;
        }
        y = y1 + 1;
    }
    if (pendingSlot >= 0) drawCachedImageRowRuns(pendingSlot, pendingY, pendingEnd);
}

void renderImageView()
{
    narm_clear((uint)1);
    if (imageRenderable != 0)
    {
        if (imageDrawError != 0) drawImagePlaceholder();
        else if (imageCacheReady != 0)
        {
            drawRenderableImage();
            if (imageDrawError != 0) drawImagePlaceholder();
        }
        else drawImageCacheStatus();
    }
    else drawImagePlaceholder();
    drawImageOverlay();
    narm_present();
}

void fmEditField()
{
    int cursorX;
    fmFillRect(81, 199, 558, 237, (uint)1);
    uiTextN(editName, editLen, 47, 92, 213, (uint)0);
    cursorX = 92 + editLen * 8;
    if (cursorX > 545) cursorX = 545;
    fmFillRect(cursorX, 225, cursorX + 6, 226, (uint)11);
}

void renderNameEdit()
{
    narm_clear(COL_BG);
    fmHeader("NAME EDITOR");
    drawPathBar();
    drawBox(64, 116, 575, 334, (uint)10, (uint)1);
    fmFillRect(65, 117, 574, 154, (uint)2);
    if (createMode == 1) uiText("CREATE A NEW FILE", 82, 131, (uint)0);
    else if (createMode == 2) uiText("CREATE A NEW FOLDER", 82, 131, (uint)0);
    else uiText("RENAME SELECTED ITEM", 82, 131, (uint)0);
    uiText("NAME", 82, 177, (uint)15);
    drawBox(80, 198, 559, 238, (uint)11, (uint)1);
    fmEditField();
    fmChip("ENTER SAVE", 82, 261, 106, (uint)10, (uint)0);
    drawText("BACKSPACE EDITS. EMPTY NAME + BACKSPACE CANCELS", 96, 82, 301, 1, (uint)15);
    renderAudioPanel();
    fmFooter("TYPE A NAME    ENTER SAVE    BACKSPACE DELETE A CHARACTER", "ALT F2 SWITCH APP    ALT F3 RUN MODE    ALT F4 CLOSE");
    narm_present();
}

void renderNameEditQuick()
{
    fmEditField();
    renderAudioPanel();
    drawStatus();
    narm_present();
}

void renderRenameProgress()
{
    uint unit;
    int width;
    narm_clear(COL_BG);
    fmHeader("RENAMING FILE");
    drawPathBar();
    drawBox(64, 116, 575, 334, (uint)10, (uint)1);
    uiText("COPYING TO THE NEW NAME", 82, 143, (uint)0);
    uiTextN(editName, editLen, 47, 82, 177, (uint)11);
    uiText("COPIED", 82, 211, (uint)15);
    uiUInt((uint)renameOffset, 146, 211, (uint)0);
    uiText("OF", 284, 211, (uint)15);
    uiUInt(renameSize, 316, 211, (uint)0);
    uiText("BYTES", 486, 211, (uint)15);
    fmFillRect(82, 242, 557, 255, (uint)14);
    width = 0;
    if (renameSize > 0)
    {
        unit = renameSize / (uint)476;
        if (unit > 0) width = (int)((uint)renameOffset / unit);
        else width = (int)((uint)renameOffset * (uint)476 / renameSize);
    }
    if (width > 476) width = 476;
    if (width > 0) fmFillRect(82, 242, 81 + width, 255, (uint)11);
    drawText("THE ORIGINAL IS REMOVED ONLY AFTER THE COPY SUCCEEDS", 96, 82, 293, 1, (uint)15);
    renderAudioPanel();
    fmFooter("PLEASE WAIT WHILE THE FILE IS COPIED", "ALT F2 SWITCH APP    ALT F3 RUN MODE    ALT F4 CLOSE");
    narm_present();
}

void render()
{
    if (dirty == 0)
    {
        if (audioPanelDirty != 0)
        {
            renderAudioPanel();
            narm_present();
        }
        return;
    }
    if (mode == 0)
    {
        if (quickMoveDirty != 0) renderBrowserQuickMove();
        else renderBrowser();
    }
    else if (mode == 1) renderFileView();
    else if (mode == 3) renderRenameProgress();
    else if (mode == 4) renderImageView();
    else
    {
        if (nameEditQuickDirty != 0) renderNameEditQuick();
        else renderNameEdit();
    }
    quickMoveDirty = 0;
    nameEditQuickDirty = 0;
    dirty = 0;
}
