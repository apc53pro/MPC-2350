    renderAudioPanel();
    fmFooter("UP/DOWN OR W/S PREVIOUS/NEXT PAGE    BACKSPACE RETURN TO FILES", "ALT F2 SWITCH APP    ALT F3 RUN MODE    ALT F4 CLOSE");
    narm_present();
}

void drawImageFormatName(int x, int y, uint color)
{
    if (imageType == 1) uiText("PNG", x, y, color);
    else if (imageType == 2) uiText("JPEG", x, y, color);
    else if (imageType == 3) uiText("GIF", x, y, color);
    else if (imageType == 4) uiText("BMP", x, y, color);
    else if (imageType == 5) uiText("PPM", x, y, color);
    else if (imageType == 6) uiText("PGM", x, y, color);
}

