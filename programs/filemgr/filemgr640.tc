/*
    FILEMGR 640 - NARM API 1.13
    --------------------
    Tiny-C SD card / internal-flash file manager for the RP2350/Pico NARM runtime.

    Uses wrappers around the NARM storage-selecting file/directory services:
        dirEntry(), dirMake(), dirDelete()
        fileExists(), fileMake(), fileDelete(), fileSize()
        fileRead(), fileWrite()
        runProg()

    Controls use normalized firmware keyboard events:
        Up / Down    move selection (W / S are aliases)
        Enter        open directory, launch NARM/image, play WAV, or view file
        Backspace    leave file/image view or go to parent directory
        D            create directory, with editable name
        F            create file, with editable name
        E            rename selected entry; files use copy-then-delete
        X            delete selected file/directory, press twice to confirm
        R            remount SD if selected, then refresh directory
        T / Tab      toggle between SD card and flash storage
        Space        pause/resume/restart the loaded audio track
        P            stop the track, keeping it available to restart
        Left/Right   seek backward/forward ten seconds (except image/name edit)
        Home / End   jump to the start/end of the loaded audio track
        Alt+F2       switch apps; launching a program keeps FILEMGR alive

    File viewing is loaded incrementally after the frame is drawn so large or
    slow SD reads do not prevent the viewer screen from appearing. Image files
    are inspected by signature/header. Only formats with an actual pixel
    decoder are opened by the built-in image viewer; compressed formats are
    rejected clearly instead of pretending to render when no decoder exists.
    PNG and JPEG decode incrementally into the same packed cache. Decoding and
    viewing share a fixed 16 KiB block cache. A packed 4-bit cache remains on
    storage; source blocks survive pan/zoom and matching display rows merge.

    Uses the firmware's shared 640x480 4-bit framebuffer. Text is batched into
    glyph submissions; the app never allocates a private full-screen buffer.
*/

#include "narm.tch"

uint fileSize(char path[], uint storage)
{
    uint size = 0;
    if (narm_file_size(path, storage, &size) < 0) return (uint)0;
    return size;
}

uint compatDirEntry(char path[], uint index, char name[], int *nameLen,
                    int *entryKind, uint storage)
{
    uint length = 0;
    uint kind = 0;
    int result = narm_dir_entry(path, index, name, (uint)48, &length, &kind, storage);
    *nameLen = (int)length;
    *entryKind = (int)kind;
    if (result < 0) return 0;
    return (uint)result;
}

uint compatRead(char path[], void *buffer, uint offset, uint bytes, uint storage)
{
    int result = narm_file_read(path, buffer, offset, bytes, storage);
    if (result < 0) return 0;
    return (uint)result;
}

uint compatWrite(char path[], const void *buffer, uint offset, uint bytes, uint storage)
{
    int result = narm_file_write(path, buffer, offset, bytes, storage);
    if (result < 0) return 0;
    return (uint)result;
}

#define fileRead(path, buffer, offset, storage) compatRead((path), (buffer), (offset), (uint)sizeof(buffer), (storage))
#define fileWrite(path, buffer, offset, storage) compatWrite((path), (buffer), (offset), (uint)sizeof(buffer), (storage))
#define fileExists(path, storage) narm_file_exists((path), (storage))
#define fileMake(path, storage) narm_file_create((path), (storage))
#define fileDelete(path, storage) narm_file_delete((path), (storage))
#define dirMake(path, storage) narm_dir_make((path), (storage))
#define dirDelete(path, storage) narm_dir_delete((path), (storage))
#define dirEntry(path, index, name, nameLen, entryKind, storage) compatDirEntry((path), (index), (name), &(nameLen), &(entryKind), (storage))
#define runProg(path, storage) narm_spawn_program((path), (storage))
#define millis() narm_millis()

