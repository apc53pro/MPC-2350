int bcDataPc;
int bcDoPcStack[32];
int bcDoModeStack[32];
int bcWhilePcStack[32];
int bcWhileSp;

void bc_error(int code)
{
    fail(code);
    bcRunning = 0;
}

int bc_varint_skip_from_byte(int pos)
{
    int b;
    while (pos < bcByteLen) {
        b = (int)programArena[pos];
        pos = pos + 1;
        if (b < 128) return pos;
    }
    return pos;
}

void bc_seek_reset()
{
    int i;
    bcSeekSlot = 0;
    bcSeekByte = 0;
    i = 0;
    while (i < BC_TOKEN_CACHE_SIZE) {
        bcTokenTag[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 2 * BC_INT_PLAN_COUNT) {
        bcIntPlans[i].slotTag = 0;
        i = i + 1;
    }
}

int bc_byte_pos_for_slot(int slot)
{
    int checkpoint;
    checkpoint = slot - (slot % BC_SEEK_STRIDE);
    if (slot < bcSeekSlot || checkpoint > bcSeekSlot) {
        bcSeekSlot = checkpoint;
        bcSeekByte = bcSeekOffsets[checkpoint / BC_SEEK_STRIDE];
    }
    while (bcSeekSlot < slot) {
        bcSeekByte = bc_varint_skip_from_byte(bcSeekByte);
        bcSeekSlot = bcSeekSlot + 1;
    }
    return bcSeekByte;
}

int bc_read_varint_at_byte(int pos)
{
    uint value;
    int shift;
    int b;
    value = (uint)0;
    shift = 0;
    while (pos < bcByteLen) {
        b = (int)programArena[pos];
        pos = pos + 1;
        value = value | (((uint)(b & 127)) << shift);
        if (b < 128) return (int)value;
        shift = shift + 7;
        if (shift > 28) return (int)value;
    }
    return 0;
}

int bc_at(int slot)
{
    int index;
    int token;
    if (slot < 0) slot = 0;
    if (slot >= bcLen) return 0;
    index = slot % BC_TOKEN_CACHE_SIZE;
    if (bcTokenTag[index] == slot + 1) return bcTokenCache[index];

    token = bc_read_varint_at_byte(bc_byte_pos_for_slot(slot));
    bcTokenTag[index] = slot + 1;
    bcTokenCache[index] = token;
    return token;
}

void bc_emit_raw_byte(int b)
{
    if (bcByteLen >= BC_MAX) { fail(60); return; }
    programArena[bcByteLen] = b & 255;
    bcByteLen = bcByteLen + 1;
}

void bc_emit(int t)
{
    uint value;
    /* Each slot occupies at least one byte. This also bounds the seek table. */
    if (bcByteLen >= BC_MAX) { fail(60); return; }
    if (bcLen % BC_SEEK_STRIDE == 0) bcSeekOffsets[bcLen / BC_SEEK_STRIDE] = bcByteLen;
    value = (uint)t;
    while (value >= (uint)128) {
        bc_emit_raw_byte((int)((value & (uint)127) | (uint)128));
        if (running == 0) return;
        value = value >> 7;
    }
    bc_emit_raw_byte((int)value);
    if (running == 0) return;
    bcLen = bcLen + 1;
}

void bc_emit2(int a, int b)
{
    bc_emit(a);
    bc_emit(b);
}

int bc_add_string(int base, int len)
{
    int off;
    int i;
    if (bcStrLen + len + 1 >= BC_STR_MAX) { fail(61); return 0; }
    off = bcStrLen;
    i = 0;
    while (i < len) {
        bcStr[bcStrLen] = bc_source_char(base + i);
        bcStrLen = bcStrLen + 1;
        i = i + 1;
    }
    bcStr[bcStrLen] = 0;
    bcStrLen = bcStrLen + 1;
    return off;
}

int bc_add_float(float f)
{
    int idx;
    if (bcFloatLen >= BC_FLOAT_MAX) { fail(62); return 0; }
    idx = bcFloatLen;
    bcFloat[idx] = f;
    bcFloatLen = bcFloatLen + 1;
    return idx;
}

void bc_runtime_reset()
{
    int i;
    i = 0;
    while (i < varCount) {
        var_int_set(i, 0);
        var_float_set(i, 0.0f);
        var_is_float_set(i, 0);
        var_str_len_set(i, 0);
        i = i + 1;
    }
    poolVarTop = poolScalarTop;
    arrayCount = 0;
    arrayNumNext = 0;
    arrayStrNext = 0;
    arrayIdxCount = 0;
    localTop = 0;
    forSp = 0;
    gosubSp = 0;
    doSp = 0;
    whileSp = 0;
    bcForSp = 0;
    bcGosubSp = 0;
    bcRoutineExit = 0;
    bcWhileSp = 0;
    bcDataPc = 0;
    dataPtr = 0;
    strTmpLen = 0;
    close_all_files();
}

int bc_ident_is(char a, char b, char c, char d, char e, char f, char g, char h)
{
    if (a != 0) { if (identTmp[0] != a) return 0; } else { if (identTmp[0] != 0) return 0; return 1; }
    if (b != 0) { if (identTmp[1] != b) return 0; } else { if (identTmp[1] != 0) return 0; return 1; }
    if (c != 0) { if (identTmp[2] != c) return 0; } else { if (identTmp[2] != 0) return 0; return 1; }
    if (d != 0) { if (identTmp[3] != d) return 0; } else { if (identTmp[3] != 0) return 0; return 1; }
    if (e != 0) { if (identTmp[4] != e) return 0; } else { if (identTmp[4] != 0) return 0; return 1; }
    if (f != 0) { if (identTmp[5] != f) return 0; } else { if (identTmp[5] != 0) return 0; return 1; }
    if (g != 0) { if (identTmp[6] != g) return 0; } else { if (identTmp[6] != 0) return 0; return 1; }
    if (h != 0) { if (identTmp[7] != h) return 0; } else { if (identTmp[7] != 0) return 0; return 1; }
    if (identTmp[8] != 0) return 0;
    return 1;
}

int bc_keyword_token()
{
#ifdef __NARM__
    if (bc_ident_is('M','O','D','E',0,0,0,0) != 0) return B_MODE;
    if (bc_ident_is('M','M','.','H','R','E','S',0) != 0) return B_HRES;
    if (bc_ident_is('M','M','.','V','R','E','S',0) != 0) return B_VRES;
    if (bc_ident_is('M','M','.','M','O','D','E',0) != 0) return B_MM_MODE;
    if (bc_ident_is('M','M','.','B','P','P',0,0) != 0) return B_BPP;
    if (bc_ident_is('R','G','B',0,0,0,0,0) != 0) return B_RGB;
    if (bc_ident_is('T','R','I',0,0,0,0,0) != 0) return B_TRI;
    if (bc_ident_is('F','I','L','L','T','R','I',0) != 0) return B_FILLTRI;
#endif
    if (bc_ident_is('P','R','I','N','T',0,0,0) != 0) return B_PRINT;
    if (bc_ident_is('L','E','T',0,0,0,0,0) != 0) return B_LET;
    if (bc_ident_is('I','F',0,0,0,0,0,0) != 0) return B_IF;
    if (bc_ident_is('T','H','E','N',0,0,0,0) != 0) return B_THEN;
    if (bc_ident_is('E','L','S','E',0,0,0,0) != 0) return B_ELSE;
    if (bc_ident_is('E','N','D','I','F',0,0,0) != 0) return B_ENDIF;
    if (bc_ident_is('G','O','T','O',0,0,0,0) != 0) return B_GOTO;
    if (bc_ident_is('G','O','S','U','B',0,0,0) != 0) return B_GOSUB;
    if (bc_ident_is('R','E','T','U','R','N',0,0) != 0) return B_RETURN;
    if (bc_ident_is('F','O','R',0,0,0,0,0) != 0) return B_FOR;
    if (bc_ident_is('T','O',0,0,0,0,0,0) != 0) return B_TO;
    if (bc_ident_is('S','T','E','P',0,0,0,0) != 0) return B_STEP;
    if (bc_ident_is('N','E','X','T',0,0,0,0) != 0) return B_NEXT;
    if (bc_ident_is('E','N','D',0,0,0,0,0) != 0) return B_END;
    if (bc_ident_is('S','T','O','P',0,0,0,0) != 0) return B_STOP;
    if (bc_ident_is('D','I','M',0,0,0,0,0) != 0) return B_DIM;
    if (bc_ident_is('I','N','P','U','T',0,0,0) != 0) return B_INPUT;
    if (bc_ident_is('O','P','E','N',0,0,0,0) != 0) return B_OPEN;
    if (bc_ident_is('C','L','O','S','E',0,0,0) != 0) return B_CLOSE;
    if (bc_ident_is('F','I','L','E','S',0,0,0) != 0) return B_FILES;
    if (bc_ident_is('K','I','L','L',0,0,0,0) != 0) return B_KILL;
    if (bc_ident_is('M','K','D','I','R',0,0,0) != 0) return B_MKDIR;
    if (bc_ident_is('R','M','D','I','R',0,0,0) != 0) return B_RMDIR;
    if (bc_ident_is('C','H','D','I','R',0,0,0) != 0) return B_CHDIR;
    if (bc_ident_is('N','A','M','E',0,0,0,0) != 0) return B_NAME;
    if (bc_ident_is('A','S',0,0,0,0,0,0) != 0) return B_AS;
    if (bc_ident_is('O','U','T','P','U','T',0,0) != 0) return B_OUTPUT;
    if (bc_ident_is('A','P','P','E','N','D',0,0) != 0) return B_APPEND;
    if (bc_ident_is('D','A','T','A',0,0,0,0) != 0) return B_DATA;
    if (bc_ident_is('R','E','A','D',0,0,0,0) != 0) return B_READ;
    if (bc_ident_is('R','E','S','T','O','R','E',0) != 0) return B_RESTORE;
    if (bc_ident_is('D','O',0,0,0,0,0,0) != 0) return B_DO;
    if (bc_ident_is('L','O','O','P',0,0,0,0) != 0) return B_LOOP;
    if (bc_ident_is('W','H','I','L','E',0,0,0) != 0) return B_WHILE;
    if (bc_ident_is('U','N','T','I','L',0,0,0) != 0) return B_UNTIL;
    if (bc_ident_is('W','E','N','D',0,0,0,0) != 0) return B_WEND;
    if (bc_ident_is('S','E','L','E','C','T',0,0) != 0) return B_SELECT;
    if (bc_ident_is('C','A','S','E',0,0,0,0) != 0) return B_CASE;
    if (bc_ident_is('S','U','B',0,0,0,0,0) != 0) return B_SUB;
    if (bc_ident_is('F','U','N','C','T','I','O','N') != 0) return B_FUNCTION;
    if (bc_ident_is('L','O','C','A','L',0,0,0) != 0) return B_LOCAL;
    if (bc_ident_is('C','A','L','L',0,0,0,0) != 0) return B_CALL;
    if (bc_ident_is('P','O','K','E',0,0,0,0) != 0) return B_POKE;
    if (bc_ident_is('P','E','E','K',0,0,0,0) != 0) return B_PEEK;
    if (bc_ident_is('F','O','N','T','A','D','D','R') != 0) return B_FONTADDR;
    if (bc_ident_is('P','I','N','M','O','D','E',0) != 0) return B_PINMODE;
    if (bc_ident_is('G','P','I','O','M','O','D','E') != 0) return B_GPIOMODE;
    if (bc_ident_is('G','P','I','O','S','E','T',0) != 0) return B_GPIOSET;
    if (bc_ident_is('P','I','N','S','E','T',0,0) != 0) return B_PINSET;
    if (bc_ident_is('D','I','G','I','T','A','L','W') != 0) return B_DIGITALWRITE;
    if (bc_ident_is('G','C','L','S',0,0,0,0) != 0) return B_GCLS;
    if (bc_ident_is('G','T','E','X','T',0,0,0) != 0) return B_GTEXT;
    if (bc_ident_is('G','B','U','T','T','O','N',0) != 0) return B_GBUTTON;
    if (bc_ident_is('L','I','N','E',0,0,0,0) != 0) return B_LINE;
    if (bc_ident_is('F','I','L','L','R','E','C','T') != 0) return B_FILLRECT;
    if (bc_ident_is('R','E','C','T',0,0,0,0) != 0) return B_RECT;
    if (bc_ident_is('P','I','X','E','L',0,0,0) != 0) return B_PIXEL;
    if (bc_ident_is('P','S','E','T',0,0,0,0) != 0) return B_PSET;
    if (bc_ident_is('P','R','E','S','E','N','T',0) != 0) return B_PRESENT;
    if (bc_ident_is('P','A','U','S','E',0,0,0) != 0) return B_PAUSE;
    if (bc_ident_is('D','E','L','A','Y',0,0,0) != 0) return B_DELAY;
    if (bc_ident_is('R','N','D',0,0,0,0,0) != 0) return B_RND;
    if (bc_ident_is('R','A','N','D',0,0,0,0) != 0) return B_RAND;
    if (bc_ident_is('R','A','N','D','O','M',0,0) != 0) return B_RANDOM;
    if (bc_ident_is('R','A','N','D','3','2',0,0) != 0) return B_RAND32;
    if (bc_ident_is('M','I','L','L','I','S',0,0) != 0) return B_MILLIS;
    if (bc_ident_is('L','E','F','T',0,0,0,0) != 0) return B_LEFT;
    if (bc_ident_is('R','I','G','H','T',0,0,0) != 0) return B_RIGHT;
    if (bc_ident_is('M','I','D',0,0,0,0,0) != 0) return B_MID;
    if (bc_ident_is('C','H','R',0,0,0,0,0) != 0) return B_CHR;
    if (bc_ident_is('S','T','R',0,0,0,0,0) != 0) return B_STRFUNC;
    if (bc_ident_is('L','E','N',0,0,0,0,0) != 0) return B_LEN;
    if (bc_ident_is('A','S','C',0,0,0,0,0) != 0) return B_ASC;
    if (bc_ident_is('V','A','L',0,0,0,0,0) != 0) return B_VAL;
    if (bc_ident_is('S','I','N',0,0,0,0,0) != 0) return B_SIN;
    if (bc_ident_is('C','O','S',0,0,0,0,0) != 0) return B_COS;
    if (bc_ident_is('I','N','K','E','Y',0,0,0) != 0) return B_INKEY;
    if (bc_ident_is('G','E','T','K','E','Y',0,0) != 0) return B_GETKEY;
    if (bc_ident_is('K','E','Y','D','O','W','N',0) != 0) return B_KEYDOWN;
    if (bc_ident_is('E','O','F',0,0,0,0,0) != 0) return B_EOF;
    if (bc_ident_is('L','O','F',0,0,0,0,0) != 0) return B_LOF;
    if (bc_ident_is('L','O','C',0,0,0,0,0) != 0) return B_LOC;
    if (bc_ident_is('C','W','D',0,0,0,0,0) != 0) return B_CWD;
    if (bc_ident_is('R','E','M',0,0,0,0,0) != 0) return B_REM;
    return 0;
}

int bc_token_needs_call_paren(int tok)
{
    if (tok == B_RGB) return 1;
    if (tok == B_LEN) return 1;
    if (tok == B_ASC) return 1;
    if (tok == B_VAL) return 1;
    if (tok == B_SIN) return 1;
    if (tok == B_COS) return 1;
    if (tok == B_LEFT) return 1;
    if (tok == B_RIGHT) return 1;
    if (tok == B_MID) return 1;
    if (tok == B_CHR) return 1;
    if (tok == B_STRFUNC) return 1;
    if (tok == B_KEYDOWN) return 1;
    if (tok == B_EOF) return 1;
    if (tok == B_LOF) return 1;
    if (tok == B_LOC) return 1;
    if (tok == B_PEEK) return 1;
    return 0;
}

int bc_name_equals_label(int varId, int lab)
{
    int i;
    int vb;
    int lb;
    char a;
    char b;
    vb = var_name_base(varId);
    lb = label_name_base(lab);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = pool_byte_get(vb + i);
        b = labelNames[lb + i];
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

int bc_label_pc_for_var(int varId)
{
    int i;
    i = 0;
    while (i < labelCount) {
        if (bc_name_equals_label(varId, i) != 0) return bcLabelPc[i];
        i = i + 1;
    }
    return -1;
}

int bc_line_pc_for_number(int n)
{
    int i;
    i = 0;
    while (i < lineCount) {
        if (lineHasNumber[i] != 0) {
            if (lineNum[i] == n) return bcLineStart[i];
        }
        i = i + 1;
    }
    return -1;
}


void bc_copy_var_name_to_ident(int varId, int isStr)
{
    int i;
    int base;
    base = var_name_base(varId);
    i = 0;
    while (i < VAR_NAME_MAX) { identTmp[i] = pool_byte_get(base + i); i = i + 1; }
    identIsString = isStr;
}

void bc_add_label_for_var(int varId, int targetPc)
{
    int idx;
    bc_copy_var_name_to_ident(varId, 0);
    idx = find_label_from_ident();
    if (idx < 0) {
        add_label_from_ident(0, targetPc);
        if (running == 0) return;
        idx = labelCount - 1;
    }
    bcLabelPc[idx] = targetPc;
}

void bc_index_sub_function_labels()
{
    int p;
    int savePc;
    int id;
    int target;
    int subIdx;
    int k;
    int paramCount;
    int paramId;
    int isFunc;

    p = 0;
    while (p < bcLen) {
        if (bc_at(p) == B_SUB || bc_at(p) == B_FUNCTION) {
            isFunc = 0;
            if (bc_at(p) == B_FUNCTION) isFunc = 1;
            if (bc_at(p + 1) == B_VAR || bc_at(p + 1) == B_STRVAR) {
                id = bc_at(p + 2);
                bc_copy_var_name_to_ident(id, 0);
                if (bc_at(p + 1) == B_STRVAR) identIsString = 1;
                savePc = bcPc;
                bcPc = p + 3;
                bc_skip_to_next_statement();
                target = bcPc;
                bcPc = savePc;

                subIdx = add_sub_from_ident(isFunc, target, 0);
                if (running == 0) return;

                k = p + 3;
                paramCount = 0;
                if (bc_at(k) == '(') {
                    k = k + 1;
                    if (bc_at(k) != ')') {
                        while (k < bcLen) {
                            if (paramCount >= MAX_PARAMS) { fail(46); return; }
                            if (bc_at(k) == B_VAR || bc_at(k) == B_STRVAR) {
                                paramId = bc_at(k + 1);
                                bc_copy_var_name_to_ident(paramId, 0);
                                if (bc_at(k) == B_STRVAR) identIsString = 1;
                                copy_ident_to_sub_param(subIdx, paramCount);
                                paramCount = paramCount + 1;
                                subParamCount[subIdx] = paramCount;
                                k = k + 2;
                                if (bc_at(k) == ',') { k = k + 1; continue; }
                                if (bc_at(k) == ')') break;
                                fail(12); return;
                            } else { fail(5); return; }
                        }
                    }
                }

                bc_add_label_for_var(id, target);
                if (running == 0) return;
            }
        }
        if (bc_at(p) == B_INT || bc_at(p) == B_FLOAT || bc_at(p) == B_VAR || bc_at(p) == B_STRVAR) p = p + 2;
        else if (bc_at(p) == B_STR) p = p + 3;
        else p = p + 1;
    }
}

void bc_emit_label_here()
{
    int idx;
    idx = find_label_from_ident();
    if (idx < 0) {
        add_label_from_ident(0, bcLen);
        if (running == 0) return;
        idx = labelCount - 1;
    } else { fail(32); return; }
    bcLabelPc[idx] = bcLen;
}

int bc_parse_ident_from_source(int base, int *ppos, int len)
{
    int n;
    int tooLong;
    int p;
    char c;
    clear_ident_tmp();
    identIsString = 0;
    p = *ppos;
    if (p >= len) return 0;
    c = bc_source_char(base + p);
    if (is_ident_start(c) == 0) return 0;
    n = 0;
    tooLong = 0;
    while (p < len) {
        c = bc_source_char(base + p);
        if (c == '$') {
            identIsString = 1;
            if (n < 32) { identTmp[n] = '$'; n = n + 1; }
            else tooLong = 1;
            p = p + 1;
            break;
        }
        if (is_ident_char(c) == 0) break;
        if (n < 32) { identTmp[n] = to_upper(c); n = n + 1; }
        else tooLong = 1;
        p = p + 1;
    }
    if (tooLong != 0) { fail(20); return 0; }
    if (n <= 0) return 0;
    *ppos = p;
    return 1;
}

void bc_tokenize_line(int lineIdx)
{
    int base;
    int len;
    int p;
    int atStatementStart;
    int tok;
    int idx;
    int litStart;
    int litLen;
    float fv;
    float frac;
    int hasDot;
    int afterIdent;
    int startNum;
    int q;
    int n;
    char c;

    base = line_base(lineIdx);
    len = lineLen[lineIdx];
    p = 0;
    atStatementStart = 1;
    bcLineStart[lineIdx] = bcLen;

    /* v73: be defensive about numbered BASIC lines stored as raw editor text.
       LOAD strips line numbers into lineNum[]/lineHasNumber[], but the fullscreen
       editor can also contain lines like "10 PRINT ..." literally.  Without
       this guard the bytecode stream starts with B_INT 10, and the runtime tries
       to execute that integer literal as a statement, causing ERR 63 at line 10. */
    q = 0;
    while (q < len) { if (is_space(bc_source_char(base + q)) == 0) break; q = q + 1; }
    startNum = q;
    n = 0;
    while (q < len) {
        c = bc_source_char(base + q);
        if (is_digit(c) == 0) break;
        n = n * 10 + (int)(c - '0');
        q = q + 1;
    }
    if (q > startNum) {
        if (q >= len || is_space(bc_source_char(base + q)) != 0) {
            lineHasNumber[lineIdx] = 1;
            lineNum[lineIdx] = n;
            while (q < len) { if (is_space(bc_source_char(base + q)) == 0) break; q = q + 1; }
            p = q;
        }
    }

    while (p < len) {
        c = bc_source_char(base + p);
        if (is_space(c) != 0) { p = p + 1; continue; }
        if (c == 39) break;
        if (c == ':') { bc_emit((int)':'); p = p + 1; atStatementStart = 1; continue; }
        if (c == '#') { bc_emit((int)'#'); p = p + 1; atStatementStart = 0; continue; }
        if (c == 34) {
            p = p + 1;
            litStart = p;
            while (p < len) { if (bc_source_char(base + p) == 34) break; p = p + 1; }
            litLen = p - litStart;
            idx = bc_add_string(base + litStart, litLen);
            bc_emit(B_STR); bc_emit(idx); bc_emit(litLen);
            if (p < len) p = p + 1;
            atStatementStart = 0;
            continue;
        }
        if (is_digit(c) != 0 || c == '.') {
            fv = 0.0f;
            hasDot = 0;
            while (p < len) { c = bc_source_char(base + p); if (is_digit(c) == 0) break; fv = fv * 10.0f + (float)((int)(c - '0')); p = p + 1; }
            if (p < len) {
                if (bc_source_char(base + p) == '.') {
                    hasDot = 1;
                    p = p + 1;
                    frac = 0.1f;
                    while (p < len) { c = bc_source_char(base + p); if (is_digit(c) == 0) break; fv = fv + frac * (float)((int)(c - '0')); frac = frac * 0.1f; p = p + 1; }
                }
            }
            if (hasDot != 0) { idx = bc_add_float(fv); bc_emit(B_FLOAT); bc_emit(idx); }
            else { bc_emit(B_INT); bc_emit((int)fv); }
            atStatementStart = 0;
            continue;
        }
        if (is_ident_start(c) != 0) {
            if (bc_parse_ident_from_source(base, &p, len) == 0) { if (running == 0) return; fail(5); return; }
            afterIdent = p;
            while (afterIdent < len) { if (is_space(bc_source_char(base + afterIdent)) == 0) break; afterIdent = afterIdent + 1; }
            tok = bc_keyword_token();
#ifdef __NARM__
            /* Reserve only MOUSE("selector"), preserving existing MOUSE variables and arrays. */
            if (bc_ident_is('M','O','U','S','E',0,0,0) != 0 && afterIdent < len) {
                if (bc_source_char(base + afterIdent) == '(') {
                    q = afterIdent + 1;
                    while (q < len && is_space(bc_source_char(base + q)) != 0) q = q + 1;
                    if (q < len && bc_source_char(base + q) == '"') tok = B_MOUSE;
                }
            }
#endif
            if (atStatementStart != 0 && tok == 0 && afterIdent < len) {
                if (bc_source_char(base + afterIdent) == ':') { bc_emit_label_here(); if (running == 0) return; p = afterIdent + 1; continue; }
            }
            if (tok != 0) {
                if (bc_token_needs_call_paren(tok) != 0) {
                    q = p;
                    while (q < len) { if (is_space(bc_source_char(base + q)) == 0) break; q = q + 1; }
                    if (q >= len || bc_source_char(base + q) != '(') tok = 0;
                }
            }
#ifdef __NARM__
            if (tok == B_PRESENT) bcHasPresent = 1;
#endif
            if (tok != 0) { if (tok == B_REM) break; bc_emit(tok); atStatementStart = 0; if (tok == B_INKEY || tok == B_LEFT || tok == B_RIGHT || tok == B_MID || tok == B_CHR || tok == B_STRFUNC || tok == B_CWD) { if (p < len) { if (bc_source_char(base + p) == '$') p = p + 1; } } continue; }
            idx = find_or_create_var_from_ident();
            if (running == 0) return;
            if (identIsString != 0) bc_emit2(B_STRVAR, idx);
            else bc_emit2(B_VAR, idx);
            atStatementStart = 0;
            continue;
        }
        if (c == '<') {
            if (p + 1 < len) {
                if (bc_source_char(base + p + 1) == '=') { bc_emit(257); p = p + 2; continue; }
                if (bc_source_char(base + p + 1) == '>') { bc_emit(258); p = p + 2; continue; }
            }
        }
        if (c == '>') {
            if (p + 1 < len) { if (bc_source_char(base + p + 1) == '=') { bc_emit(259); p = p + 2; continue; } }
        }
        bc_emit((int)c);
        p = p + 1;
        atStatementStart = 0;
    }
    bc_emit(B_EOL);
    bcLineEnd[lineIdx] = bcLen;
}

int bc_build_program()
{
    int i;
    int oldRunning;
    oldRunning = running;
    running = 1;

    if (sourceDiscarded != 0) {
        if (bcReady != 0) { running = oldRunning; return 1; }
        fail(64);
        return 0;
    }

    /* v86: tokenize directly from packed shared-pool source slots. programArena[] is only
       the packed uint8 varint bytecode output, so writing tokens can no longer overwrite
       editable source text. */
    bcSourceTextBytes = 0;
    i = 0;
    while (i < lineCount) { bcSourceTextBytes = bcSourceTextBytes + lineLen[i]; i = i + 1; }

#ifdef __NARM__
    bcHasPresent = 0;
#endif
    bcSourceFromProg = 0;
    bcLen = 0;
    bcByteLen = 0;
    bc_seek_reset();
    bcStrLen = 0;
    bcFloatLen = 0;
    clear_labels();
    clear_subs();
    varCount = 0;
    poolVarTop = BASIC_POOL_BYTES;
    poolScalarTop = BASIC_POOL_BYTES;
    i = 0;
    while (i < lineCount) {
        bc_tokenize_line(i);
        if (running == 0) {
            bcSourceFromProg = 0;
            sourceDiscarded = 0;
            bcReady = 0;
            return 0;
        }
        i = i + 1;
    }
    bc_emit(0);
    bc_index_sub_function_labels();
    if (running == 0) {
        bcSourceFromProg = 0;
        sourceDiscarded = 0;
        bcReady = 0;
        return 0;
    }
    bcSourceFromProg = 0;
    mark_compiled_ready();
    sourceDiscarded = 0;
    bcProgramOnly = 0;
    running = oldRunning;
    return 1;
}

int bc_is_stop_expr_token(int t)
{
    if (t == B_EOL) return 1;
    if (t == ':') return 1;
    if (t == ',') return 1;
    if (t == ';') return 1;
    if (t == B_THEN) return 1;
    if (t == B_TO) return 1;
    if (t == B_STEP) return 1;
    if (t == B_UNTIL) return 1;
    if (t == B_WHILE) return 1;
    if (t == B_AS) return 1;
    if (t == 257 || t == 258 || t == 259) return 1;
    if (t == '<' || t == '>' || t == '=') return 1;
    /* v77: Do not treat ')' as an unconditional expression terminator here.
       The numeric evaluator has explicit ')' handling below.  If there is an
       open '(' on the expression operator stack, ')' must close that internal
       parenthesized group.  If there is no such '(', the ')' belongs to the
       caller, such as LEN(expr), array indices, or function arguments, and the
       evaluator leaves bcPc pointing at it.  The previous unconditional stop
       left '(' on opStack for expressions like X % (2 * I - 1), causing ERR 12. */
    return 0;
}

int bc_op_prec(int op)
{
    if (op == '*') return 2;
    if (op == '/') return 2;
    if (op == '%') return 2;
    if (op == '+') return 1;
    if (op == '-') return 1;
    return 0;
}

int bc_is_arith_op(int t)
{
    if (t == '+') return 1;
    if (t == '-') return 1;
    if (t == '*') return 1;
    if (t == '/') return 1;
    if (t == '%') return 1;
    return 0;
}

int bc_var_name_equals_array(int varId, int arr)
{
    int i;
    int vb;
    int ab;
    char a;
    char b;
    vb = var_name_base(varId);
    ab = array_name_base(arr);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = pool_byte_get(vb + i);
        b = pool_byte_get(ab + i);
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

int bc_find_array_for_var(int varId, int wantString)
{
    int i;
    i = 0;
    while (i < arrayCount) {
        if (array_used_get(i) != 0) {
            if (array_is_string_get(i) == wantString) {
                if (bc_var_name_equals_array(varId, i) != 0) return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

void bc_copy_var_name_to_array(int arr, int varId)
{
    int i;
    int vb;
    int ab;
    vb = var_name_base(varId);
    ab = array_name_base(arr);
    i = 0;
    while (i < VAR_NAME_MAX) { pool_byte_set(ab + i, pool_byte_get(vb + i)); i = i + 1; }
}

int bc_parse_file_number()
{
    int n;
    if (bc_at(bcPc) == '#') bcPc = bcPc + 1;
    n = bc_eval_expr();
    if (bcRunning == 0) return 0;
    if (n < 1) { bc_error(50); return 0; }
    if (n > MAX_FILES) { bc_error(50); return 0; }
    return n - 1;
}


int bc_parse_array_indices(int arr)
{
    int dimCount;
    int v;
    if (bc_at(bcPc) != '(') { bc_error(12); return 0; }
    bcPc = bcPc + 1;
    dimCount = 0;
    arrayIdxCount = 0;
    while (bcRunning != 0) {
        if (dimCount >= ARRAY_DIMS_MAX) { bc_error(28); return 0; }
        expr_stack_save();
        v = bc_eval_expr();
        expr_stack_restore();
        if (bcRunning == 0) return 0;
        arrayIdxTmp[dimCount] = v;
        dimCount = dimCount + 1;
        arrayIdxCount = dimCount;
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        if (bc_at(bcPc) == ')') { bcPc = bcPc + 1; return 1; }
        bc_error(12); return 0;
    }
    return 0;
}

void bc_eval_apply()
{
    apply_top_op();
}

int bc_token_starts_string(int t)
{
    if (t == B_STR) return 1;
    if (t == B_STRVAR) return 1;
    if (t == B_LEFT || t == B_RIGHT || t == B_MID || t == B_CHR || t == B_STRFUNC || t == B_CWD || t == B_INKEY) return 1;
    return 0;
}


int bc_eval_string_arg_to_func()
{
    int i;
    if (bc_eval_string_expr() == 0) return 0;
    strFuncLen = strTmpLen;
    i = 0;
    while (i < STR_MAX) { strFunc[i] = strTmp[i]; i = i + 1; }
    return 1;
}

int bc_eval_string_atom_append()
{
    int t;
    int off;
    int len;
    int id;
    int arr;
    int lin;
    int i;
    int n;
    int start;
    int count;
    int oldLen;
    int v;
    float fv;

    t = bc_at(bcPc);
    if (t == B_STR) {
        bcPc = bcPc + 1;
        off = bc_at(bcPc); len = bc_at(bcPc + 1); bcPc = bcPc + 2;
        i = 0;
        while (i < len) { append_str_tmp_char(bcStr[off + i]); if (running == 0) { bcRunning = 0; return 0; } i = i + 1; }
        return 1;
    }
    if (t == B_STRVAR) {
        bcPc = bcPc + 1;
        id = bc_at(bcPc); bcPc = bcPc + 1;
        if (bc_at(bcPc) == '(') {
            n = bc_find_sub_for_var(id);
            if (n >= 0) {
                if (subIsFunction[n] == 0) { bc_error(5); return 0; }
                if (bc_execute_routine(n, 1) == 0) return 0;
                return 1;
            }
            arr = bc_find_array_for_var(id, 1);
            if (arr < 0) { bc_error(24); return 0; }
            if (bc_parse_array_indices(arr) == 0) return 0;
            lin = compute_array_linear(arr);
            if (running == 0) { bcRunning = 0; return 0; }
            append_array_string_to_tmp(arr, lin);
            if (running == 0) { bcRunning = 0; return 0; }
            return 1;
        }
        if (var_is_string_get(id) == 0) { bc_error(22); return 0; }
        append_var_string_to_tmp(id);
        if (running == 0) { bcRunning = 0; return 0; }
        return 1;
    }
    if (t == B_CWD) {
        bcPc = bcPc + 1;
        if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } }
        if (currentDirLen <= 0) { append_str_tmp_char('/'); return 1; }
        i = 0; while (i < currentDirLen) { append_str_tmp_char(currentDir[i]); if (running == 0) { bcRunning = 0; return 0; } i = i + 1; }
        return 1;
    }
    if (t == B_INKEY) {
        bcPc = bcPc + 1;
        if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } }
        v = readAnyKeyCode();
        if (v != 0) append_str_tmp_char((char)(v & 255));
        return 1;
    }
    if (t == B_CHR) {
        bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1;
        expr_stack_save(); v = bc_eval_expr(); expr_stack_restore(); if (bcRunning == 0) return 0;
        if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1;
        append_str_tmp_char((char)(v & 255)); return 1;
    }
    if (t == B_STRFUNC) {
        bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1;
        expr_stack_save(); v = bc_eval_expr(); fv = lastExprFloat; n = lastExprIsFloat; expr_stack_restore(); if (bcRunning == 0) return 0;
        if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1;
        if (n != 0) append_float_to_str_tmp(fv); else append_int_to_str_tmp(v);
        return 1;
    }
    if (t == B_LEFT || t == B_RIGHT || t == B_MID) {
        bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1;
        save_str_tmp_to_save(); if (bc_eval_string_arg_to_func() == 0) return 0; restore_str_tmp_from_save();
        oldLen = strFuncLen;
        if (bc_at(bcPc) != ',') { bc_error(16); return 0; } bcPc = bcPc + 1;
        expr_stack_save(); n = bc_eval_expr(); expr_stack_restore(); if (bcRunning == 0) return 0;
        start = 0; count = n;
        if (t == B_RIGHT) { if (count < 0) count = 0; if (count > oldLen) count = oldLen; start = oldLen - count; }
        else if (t == B_MID) {
            start = n - 1; if (start < 0) start = 0; if (start > oldLen) start = oldLen; count = oldLen - start;
            if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; expr_stack_save(); count = bc_eval_expr(); expr_stack_restore(); if (bcRunning == 0) return 0; }
        } else { if (count < 0) count = 0; if (count > oldLen) count = oldLen; }
        if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1;
        if (count < 0) count = 0; if (start + count > oldLen) count = oldLen - start;
        append_func_to_tmp_range(start, count);
        return 1;
    }
    bc_error(23);
    return 0;
}

int bc_eval_string_expr()
{
    clear_str_tmp();
    if (bc_eval_string_atom_append() == 0) return 0;
    while (bcRunning != 0) {
        if (bc_at(bcPc) != '+') return 1;
        bcPc = bcPc + 1;
        if (bc_eval_string_atom_append() == 0) return 0;
    }
    return 0;
}


int bc_find_sub_for_var(int varId)
{
    bc_copy_var_name_to_ident(varId, 0);
    return find_sub_from_ident();
}

void bc_copy_sub_name_to_ident(int subIdx)
{
    int i;
    int base;
    char c;
    base = sub_name_base(subIdx);
    identIsString = 0;
    i = 0;
    while (i < VAR_NAME_MAX) {
        c = subNames[base + i];
        identTmp[i] = c;
        if (c == '$') identIsString = 1;
        if (c == 0) return;
        i = i + 1;
    }
}

int bc_push_frame(int returnPc, int frameType)
{
    if (bcGosubSp >= MAX_GOSUB) { bc_error(30); return 0; }
    localMarkStack[bcGosubSp] = localTop;
    bcGosubPc[bcGosubSp] = returnPc;
    bcGosubType[bcGosubSp] = frameType;
    bcGosubSp = bcGosubSp + 1;
    return 1;
}

void bc_pop_frame_to_return()
{
    if (bcGosubSp <= 0) { bc_error(31); return; }
    bcGosubSp = bcGosubSp - 1;
    restore_locals_to(localMarkStack[bcGosubSp]);
    bcNextPc = bcGosubPc[bcGosubSp];
    bcFlow = 1;
}

int bc_bind_call_args(int subIdx)
{
    int argn;
    int paren;
    int idx;
    int v;
    float fv;
    int isF;
    int paramIsString;

    argn = 0;
    paren = 0;
    if (bc_at(bcPc) == '(') { paren = 1; bcPc = bcPc + 1; }

    if (paren != 0) {
        if (bc_at(bcPc) == ')') {
            bcPc = bcPc + 1;
            if (subParamCount[subIdx] != 0) { bc_error(46); return 0; }
            return 1;
        }
    } else {
        if (subParamCount[subIdx] == 0) return 1;
    }

    while (bcRunning != 0) {
        if (argn >= subParamCount[subIdx]) { bc_error(46); return 0; }
        copy_sub_param_to_ident(subIdx, argn);
        paramIsString = identIsString;
        idx = find_or_create_var_from_ident();
        if (running == 0) { bcRunning = 0; return 0; }
        save_local_var_if_needed(idx);
        if (running == 0) { bcRunning = 0; return 0; }

        if (paramIsString != 0) {
            if (bc_eval_string_expr() == 0) return 0;
            copy_tmp_to_string_var(idx);
        } else {
            expr_stack_save();
            v = bc_eval_expr();
            fv = lastExprFloat;
            isF = lastExprIsFloat;
            expr_stack_restore();
            if (bcRunning == 0) return 0;
            var_int_set(idx, v);
            var_float_set(idx, fv);
            var_is_float_set(idx, isF);
        }

        argn = argn + 1;
        if (paren != 0) {
            if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
            if (bc_at(bcPc) == ')') { bcPc = bcPc + 1; break; }
            bc_error(12); return 0;
        }
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        break;
    }

    if (argn != subParamCount[subIdx]) { bc_error(46); return 0; }
    return 1;
}

void bc_capture_function_return(int subIdx)
{
    int returnVar;
    int i;
    bc_copy_sub_name_to_ident(subIdx);
    returnVar = find_or_create_var_from_ident();
    if (running == 0) { bcRunning = 0; return; }
    bcFuncInt = var_int_get(returnVar);
    bcFuncFloat = var_float_get(returnVar);
    bcFuncIsFloat = var_is_float_get(returnVar);
    clear_str_tmp();
    if (var_is_string_get(returnVar) != 0) {
        i = 0;
        while (i < var_str_len_get(returnVar)) {
            append_str_tmp_char(pool_byte_get(str_base(returnVar) + i));
            if (running == 0) { bcRunning = 0; return; }
            i = i + 1;
        }
    }
}

int bc_execute_routine(int subIdx, int wantReturn)
{
    int savePc;
    int saveNext;
    int saveFlow;
    int startSp;
    int returnVar;
    int done;
    int isFunc;
    int token;

    isFunc = subIsFunction[subIdx];
    savePc = bcPc;
    saveNext = bcNextPc;
    saveFlow = bcFlow;

    if (bc_push_frame(savePc, 1) == 0) return 0;
    startSp = bcGosubSp;

    if (isFunc != 0) {
        bc_copy_sub_name_to_ident(subIdx);
        returnVar = find_or_create_var_from_ident();
        if (running == 0) { bcRunning = 0; return 0; }
        save_local_var_if_needed(returnVar);
        if (running == 0) { bcRunning = 0; return 0; }
        var_int_set(returnVar, 0);
        var_float_set(returnVar, 0.0f);
        var_is_float_set(returnVar, 0);
        var_str_len_set(returnVar, 0);
    }

    if (bc_bind_call_args(subIdx) == 0) return 0;

    bcPc = subLine[subIdx];
    bcNextPc = bcPc;
    done = 0;
    while (bcRunning != 0 && done == 0) {
        if (bcPc < 0 || bcPc >= bcLen) { bc_error(47); return 0; }
        token = bc_at(bcPc);
        if (token == B_EOL || token == ':') { bcPc = bcPc + 1; bcNextPc = bcPc; continue; }
        if (token == B_END) {
            if (isFunc != 0 && bc_at(bcPc + 1) == B_FUNCTION) {
                bc_capture_function_return(subIdx);
                if (bcRunning == 0) return 0;
                if (bcGosubSp != startSp) { bc_error(31); return 0; }
                bc_pop_frame_to_return();
                done = 1;
                break;
            }
            if (isFunc == 0 && bc_at(bcPc + 1) == B_SUB) {
                if (bcGosubSp != startSp) { bc_error(31); return 0; }
                bc_pop_frame_to_return();
                done = 1;
                break;
            }
        }
        if (token == B_RETURN) {
            if (bcGosubSp > 0) {
                if (bcGosubType[bcGosubSp - 1] != 0) {
                    if (isFunc != 0) {
                        bc_capture_function_return(subIdx);
                        if (bcRunning == 0) return 0;
                    }
                    bc_pop_frame_to_return();
                    done = 1;
                    break;
                }
            }
        }
        bcFlow = 0;
        bc_exec_statement(token);
        if (bcRunning == 0) break;
        if (bcFlow != 0) bcPc = bcNextPc;
        else {
            token = bc_at(bcPc);
            if (token != ':' && token != B_EOL) { bc_error(17); return 0; }
            bcPc = bcPc + 1;
        }
        bcNextPc = bcPc;
    }

    if (done == 0 && bcRunning != 0) { bc_error(47); return 0; }
    bcPc = savePc;
    bcNextPc = saveNext;
    bcFlow = saveFlow;
    return 1;
}

int bc_eval_expr()
{
    int needValue;
    int t;
    int op;
    int id;
    int arg;
    int arr;
    int lin;
    int h;
    int red;
    int green;
    int blue;
    float ff;
    valTop = 0;
    opTop = 0;
    needValue = 1;
    lastExprFloat = 0.0f;
    lastExprIsFloat = 0;

    while (bcRunning != 0) {
        t = bc_at(bcPc);
        if (bc_is_stop_expr_token(t) != 0) break;
        if (t == B_INT) { bcPc = bcPc + 1; push_val(bc_at(bcPc)); bcPc = bcPc + 1; needValue = 0; }
        else if (t == B_FLOAT) { bcPc = bcPc + 1; push_float_val(bcFloat[bc_at(bcPc)]); bcPc = bcPc + 1; needValue = 0; }
        else if (t == B_VAR) {
            bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1;
            if (bc_at(bcPc) == '(') {
                h = bc_find_sub_for_var(id);
                if (h >= 0) {
                    if (subIsFunction[h] == 0) { bc_error(5); return 0; }
                    expr_stack_save();
                    if (bc_execute_routine(h, 1) == 0) { expr_stack_restore(); return 0; }
                    expr_stack_restore();
                    if (bcFuncIsFloat != 0) push_float_val(bcFuncFloat); else push_val(bcFuncInt);
                } else {
                    arr = bc_find_array_for_var(id, 0);
                    if (arr < 0) { bc_error(24); return 0; }
                    if (bc_parse_array_indices(arr) == 0) return 0;
                    lin = compute_array_linear(arr); if (running == 0) { bcRunning = 0; return 0; }
                    if (array_num_is_float_get(arr, lin) != 0) push_float_val(array_num_float_get(arr, lin));
                    else push_val(array_num_int_get(arr, lin));
                }
            } else { if (var_is_float_get(id) != 0) push_float_val(var_float_get(id)); else push_val(var_int_get(id)); }
            needValue = 0;
        }
#ifdef __NARM__
        else if (t == B_HRES || t == B_VRES || t == B_MM_MODE || t == B_BPP) {
            bcPc = bcPc + 1;
            if (t == B_HRES) push_val(SCREEN_W);
            else if (t == B_VRES) push_val(SCREEN_H);
            else if (t == B_MM_MODE) push_val(graphicsMode);
            else push_val(graphicsBpp);
            needValue = 0;
        }
        else if (t == B_RGB) {
            bcPc = bcPc + 1;
            if (bc_at(bcPc) != '(') { bc_error(12); return 0; }
            bcPc = bcPc + 1;
            expr_stack_save(); red = bc_eval_expr(); expr_stack_restore();
            if (bcRunning == 0) return 0;
            if (bc_at(bcPc) != ',') { bc_error(16); return 0; }
            bcPc = bcPc + 1;
            expr_stack_save(); green = bc_eval_expr(); expr_stack_restore();
            if (bcRunning == 0) return 0;
            if (bc_at(bcPc) != ',') { bc_error(16); return 0; }
            bcPc = bcPc + 1;
            expr_stack_save(); blue = bc_eval_expr(); expr_stack_restore();
            if (bcRunning == 0) return 0;
            if (bc_at(bcPc) != ')') { bc_error(12); return 0; }
            bcPc = bcPc + 1;
            arg = graphics_rgb(red, green, blue);
            if (running == 0) { bcRunning = 0; return 0; }
            push_val(arg); needValue = 0;
        }
        else if (t == B_MOUSE) {
            if (bc_at(bcPc + 1) != '(' || bc_at(bcPc + 2) != B_STR ||
                bc_at(bcPc + 5) != ')') { bc_error(12); return 0; }
            arg = basic_mouse_value(bcStr + bc_at(bcPc + 3), bc_at(bcPc + 4));
            if (running == 0) { bcRunning = 0; return 0; }
            bcPc = bcPc + 6;
            push_val(arg);
            needValue = 0;
        }
#endif
        else if (t == B_MILLIS) { bcPc = bcPc + 1; if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } } push_val((int)millis()); needValue = 0; }
        else if (t == B_RND || t == B_RAND || t == B_RANDOM) {
            bcPc = bcPc + 1; arg = 0;
            if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) != ')') { expr_stack_save(); arg = bc_eval_expr(); expr_stack_restore(); if (bcRunning == 0) return 0; } if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; }
            if (arg < 0) arg = 0 - arg; if (arg > 0) push_val((int)(random() % (uint)arg)); else push_val((int)(random() & (uint)0x7FFFFFFF)); needValue = 0;
        }
        else if (t == B_RAND32) { bcPc = bcPc + 1; if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } } push_val((int)rand32()); needValue = 0; }
        else if (t == B_PEEK) { bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1; expr_stack_save(); arg = bc_eval_expr(); expr_stack_restore(); if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; push_val(rawPeekWord(arg)); needValue = 0; }
        else if (t == B_SIN || t == B_COS) { op = t; bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1; expr_stack_save(); arg = bc_eval_expr(); ff = lastExprFloat; expr_stack_restore(); if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; if (op == B_SIN) push_float_val(sin(ff)); else push_float_val(cos(ff)); needValue = 0; }
        else if (t == B_LEN || t == B_ASC || t == B_VAL) { op = t; bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1; save_str_tmp_to_save(); if (bc_eval_string_arg_to_func() == 0) return 0; restore_str_tmp_from_save(); if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; if (op == B_LEN) push_val(strFuncLen); else if (op == B_ASC) { if (strFuncLen <= 0) push_val(0); else push_val((int)strFunc[0]); } else { clear_str_tmp(); h = 0; while (h < strFuncLen) { append_str_tmp_char(strFunc[h]); h = h + 1; } push_float_val(parse_str_tmp_number()); } needValue = 0; }
        else if (t == B_GETKEY) { bcPc = bcPc + 1; if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } } push_val(readAnyKeyCode()); needValue = 0; }
        else if (t == B_FONTADDR) { bcPc = bcPc + 1; if (bc_at(bcPc) == '(') { bcPc = bcPc + 1; if (bc_at(bcPc) == ')') bcPc = bcPc + 1; else { bc_error(12); return 0; } } push_val(fontAddr()); needValue = 0; }
        else if (t == B_KEYDOWN) { bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1; expr_stack_save(); arg = bc_eval_expr(); expr_stack_restore(); if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; key(arg, keyData, keyPressed); if (keyPressed != (uint)0) push_val(1); else push_val(0); needValue = 0; }
        else if (t == B_EOF || t == B_LOF || t == B_LOC) { op = t; bcPc = bcPc + 1; if (bc_at(bcPc) != '(') { bc_error(12); return 0; } bcPc = bcPc + 1; h = bc_parse_file_number(); if (bc_at(bcPc) != ')') { bc_error(12); return 0; } bcPc = bcPc + 1; if (fileOpen[h] == 0) { bc_error(51); return 0; } if (op == B_EOF) { if (filePos[h] >= fileSizeUsed[h]) push_val(1); else push_val(0); } else if (op == B_LOF) push_val(fileSizeUsed[h]); else push_val(filePos[h]); needValue = 0; }
        else if (t == '(') { push_op(t); bcPc = bcPc + 1; needValue = 1; }
        else if (t == ')') { while (opTop > 0) { if (opStack[opTop - 1] == '(') break; bc_eval_apply(); if (running == 0) { bcRunning = 0; return 0; } } if (opTop <= 0) break; opTop = opTop - 1; bcPc = bcPc + 1; needValue = 0; }
        else if (bc_is_arith_op(t) != 0) { if (needValue != 0) { if (t == '+') { bcPc = bcPc + 1; continue; } if (t == '-') push_val(0); else { bc_error(11); return 0; } } op = t; while (opTop > 0) { if (opStack[opTop - 1] == '(') break; if (bc_op_prec(opStack[opTop - 1]) < bc_op_prec(op)) break; bc_eval_apply(); if (running == 0) { bcRunning = 0; return 0; } } push_op(op); bcPc = bcPc + 1; needValue = 1; }
        else { bc_error(5); return 0; }
    }
    while (opTop > 0) { if (opStack[opTop - 1] == '(') { bc_error(12); return 0; } bc_eval_apply(); if (running == 0) { bcRunning = 0; return 0; } }
    if (valTop <= 0) { bc_error(11); return 0; }
    lastExprFloat = valFStack[valTop - 1];
    lastExprIsFloat = valIsFloatStack[valTop - 1];
    return valStack[valTop - 1];
}

int bc_compare_numbers(int op, float left, float right)
{
    if (op == '=') return left == right;
    if (op == '<') return left < right;
    if (op == '>') return left > right;
    if (op == 257) return left <= right;
    if (op == 258) return left != right;
    return left >= right;
}

int bc_comparison_op(int token)
{
    return token == '=' || token == '<' || token == '>' ||
           token == 257 || token == 258 || token == 259;
}

int bc_int_plan_end(int token, int comparison)
{
    return token == B_EOL || token == ':' || (comparison != 0 && token == B_THEN);
}

void bc_decode_int_plan(struct BcIntPlan *plan, int start, int comparison)
{
    int token;
    int next;
    plan->slotTag = start + 1;
    plan->end = 0;
    token = bc_at(start);
    if (token != B_INT && token != B_VAR) return;
    plan->leftToken = token;
    plan->left = bc_at(start + 1);
    token = bc_at(start + 2);
    if (comparison == 0 && bc_int_plan_end(token, 0) != 0) {
        plan->operation = 0;
        plan->end = start + 2;
        return;
    }
    if (comparison != 0) {
        if (bc_comparison_op(token) == 0) return;
    } else if (token != '+' && token != '-' && token != '*') return;
    plan->operation = token;
    token = bc_at(start + 3);
    if (token != B_INT && token != B_VAR) return;
    plan->rightToken = token;
    plan->right = bc_at(start + 4);
    next = start + 5;
    if (bc_int_plan_end(bc_at(next), comparison) != 0) plan->end = next;
}

int bc_int_operand(int token, int operand, int *value)
{
    int base;
    if (token == B_INT) {
        *value = operand;
        return 1;
    }
    base = var_record_base(operand);
    if (pool_byte_get(base + 46) != 0) return 0;
    *value = pool_int_get(base + 36);
    return 1;
}

int bc_try_int_plan(int comparison, int *result)
{
    struct BcIntPlan *plan;
    int left;
    int right;
    int operation;
    plan = &bcIntPlans[2 * (bcPc % BC_INT_PLAN_COUNT) + comparison];
    if (plan->slotTag != bcPc + 1) bc_decode_int_plan(plan, bcPc, comparison);
    if (plan->end == 0) return 0;
    if (bc_int_operand(plan->leftToken, plan->left, &left) == 0) return 0;
    operation = plan->operation;
    if (operation != 0) {
        if (bc_int_operand(plan->rightToken, plan->right, &right) == 0) return 0;
        if (comparison != 0) {
            /* The general evaluator compares single-precision values,
               including when both source operands are integers. */
            left = bc_compare_numbers(operation, (float)left, (float)right);
        } else if (operation == '+') left = left + right;
        else if (operation == '-') left = left - right;
        else left = left * right;
    }
    bcPc = plan->end;
    *result = left;
    return 1;
}

int bc_eval_condition()
{
    int left;
    int right;
    float lf;
    float rf;
    int op;
    if (bc_try_int_plan(1, &left) != 0) return left;
    left = bc_eval_expr(); lf = lastExprFloat; if (bcRunning == 0) return 0;
    op = bc_at(bcPc);
    if (bc_comparison_op(op) != 0) {
        bcPc = bcPc + 1;
        right = bc_eval_expr(); rf = lastExprFloat; if (bcRunning == 0) return 0;
        return bc_compare_numbers(op, lf, rf);
    }
    if (left != 0) return 1;
    return 0;
}

void bc_skip_statement()
{
    while (bc_at(bcPc) != B_EOL) {
        if (bc_at(bcPc) == ':') return;
        if (bc_at(bcPc) == 0) return;
        if (bc_at(bcPc) == B_INT || bc_at(bcPc) == B_FLOAT || bc_at(bcPc) == B_VAR || bc_at(bcPc) == B_STRVAR) bcPc = bcPc + 2;
        else if (bc_at(bcPc) == B_STR) bcPc = bcPc + 3;
        else bcPc = bcPc + 1;
    }
}

void bc_skip_to_next_statement()
{
    bc_skip_statement();
    if (bc_at(bcPc) == ':') bcPc = bcPc + 1;
}

int bc_find_matching_forward(int startPc, int openTok, int closeTok, int altTok)
{
    int p;
    int depth;
    int t;
    p = startPc;
    depth = 0;
    while (p < bcLen) {
        t = bc_at(p);
        if (t == openTok) depth = depth + 1;
        else if (t == closeTok) { if (depth == 0) return p; depth = depth - 1; }
        else if (altTok != 0) { if (t == altTok) { if (depth == 0) return p; } }
        if (t == B_INT || t == B_FLOAT || t == B_VAR || t == B_STRVAR) p = p + 2;
        else if (t == B_STR) p = p + 3;
        else p = p + 1;
    }
    return -1;
}

int bc_read_target()
{
    int t;
    int n;
    int id;
    int pc;
    t = bc_at(bcPc);
    if (t == B_INT) { bcPc = bcPc + 1; n = bc_at(bcPc); bcPc = bcPc + 1; pc = bc_line_pc_for_number(n); if (pc < 0) { bc_error(4); return 0; } return pc; }
    if (t == B_VAR) { bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; pc = bc_label_pc_for_var(id); if (pc < 0) { bc_error(4); return 0; } return pc; }
    bc_error(4); return 0;
}

void bc_print_string_lit(int off, int len)
{
    int i; i = 0; while (i < len) { con_char(bcStr[off + i]); i = i + 1; }
}

void bc_exec_file_print()
{
    int h;
    int suppress;
    int v;
    int t;
    if (bc_at(bcPc) == '#') bcPc = bcPc + 1;
    h = bc_parse_file_number();
    if (bcRunning == 0) return;
    if (fileOpen[h] == 0) { bc_error(51); return; }
    if (fileMode[h] == 1) { bc_error(54); return; }
    if (bc_at(bcPc) == ',' || bc_at(bcPc) == ';') bcPc = bcPc + 1;
    suppress = 0;
    while (bcRunning != 0) {
        t = bc_at(bcPc);
        if (t == B_EOL || t == ':') break;
        if (bc_token_starts_string(t) != 0) { if (bc_eval_string_expr() == 0) return; file_append_tmp(h); }
        else { v = bc_eval_expr(); if (bcRunning == 0) return; if (lastExprIsFloat != 0) file_append_float_value(h, lastExprFloat); else file_append_int_value(h, v); }
        suppress = 0;
        t = bc_at(bcPc);
        if (t == ';') { suppress = 1; bcPc = bcPc + 1; }
        else if (t == ',') { file_append_char(h, ' '); bcPc = bcPc + 1; }
        else break;
    }
    if (suppress == 0) { file_append_char(h, 13); file_append_char(h, 10); }
}

void bc_exec_print()
{
    int suppress;
    int t;
    int v;
    if (bc_at(bcPc) == '#') { bc_exec_file_print(); return; }
    suppress = 0;
    while (bcRunning != 0) {
        t = bc_at(bcPc);
        if (t == B_EOL || t == ':') break;
        if (bc_token_starts_string(t) != 0) { if (bc_eval_string_expr() == 0) return; con_str_tmp(); }
        else { v = bc_eval_expr(); if (bcRunning == 0) return; if (lastExprIsFloat != 0) con_float(lastExprFloat); else con_int(v); }
        suppress = 0;
        t = bc_at(bcPc);
        if (t == ';') { suppress = 1; bcPc = bcPc + 1; }
        else if (t == ',') { con_char(' '); bcPc = bcPc + 1; }
        else break;
    }
    if (suppress == 0) con_nl();
}

void bc_assign_number_to_var_or_array(int varId)
{
    int v;
    int arr;
    int lin;
    if (bc_at(bcPc) == '(') {
        arr = bc_find_array_for_var(varId, 0);
        if (arr < 0) { bc_error(24); return; }
        if (bc_parse_array_indices(arr) == 0) return;
        lin = compute_array_linear(arr); if (running == 0) { bcRunning = 0; return; }
        if (bc_at(bcPc) != '=') { bc_error(5); return; }
        bcPc = bcPc + 1;
        v = bc_eval_expr(); if (bcRunning == 0) return;
        array_num_int_set(arr, lin, v);
        array_num_float_set(arr, lin, lastExprFloat);
        array_num_is_float_set(arr, lin, lastExprIsFloat);
        return;
    }
    if (bc_at(bcPc) != '=') { bc_error(5); return; }
    bcPc = bcPc + 1;
    if (bc_try_int_plan(0, &v) != 0) {
        lastExprIsFloat = 0;
        lastExprFloat = (float)v;
    } else {
        v = bc_eval_expr();
        if (bcRunning == 0) return;
    }
    if (lastExprIsFloat != 0) { var_float_set(varId, lastExprFloat); var_int_set(varId, (int)lastExprFloat); var_is_float_set(varId, 1); }
    else { var_int_set(varId, v); var_float_set(varId, (float)v); var_is_float_set(varId, 0); }
}

void bc_assign_string_to_var_or_array(int varId)
{
    int arr;
    int lin;
    if (bc_at(bcPc) == '(') {
        arr = bc_find_array_for_var(varId, 1);
        if (arr < 0) { bc_error(24); return; }
        if (bc_parse_array_indices(arr) == 0) return;
        lin = compute_array_linear(arr); if (running == 0) { bcRunning = 0; return; }
        if (bc_at(bcPc) != '=') { bc_error(5); return; }
        bcPc = bcPc + 1;
        if (bc_eval_string_expr() == 0) return;
        copy_tmp_to_string_array(arr, lin);
        return;
    }
    if (bc_at(bcPc) != '=') { bc_error(5); return; }
    bcPc = bcPc + 1;
    if (bc_eval_string_expr() == 0) return;
    copy_tmp_to_string_var(varId);
}

void bc_exec_dim()
{
    int id;
    int arr;
    int dimCount;
    int total;
    int limit;
    int dimBase;
    int i;
    int isStr;
    while (bcRunning != 0) {
        if (bc_at(bcPc) == B_VAR) { isStr = 0; bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; }
        else if (bc_at(bcPc) == B_STRVAR) { isStr = 1; bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; }
        else { bc_error(5); return; }
        if (bc_find_array_for_var(id, isStr) >= 0) { bc_error(25); return; }
        if (bc_at(bcPc) != '(') { bc_error(12); return; }
        bcPc = bcPc + 1;
        dimCount = 0; total = 1;
        while (bcRunning != 0) {
            if (dimCount >= ARRAY_DIMS_MAX) { bc_error(28); return; }
            expr_stack_save(); limit = bc_eval_expr(); expr_stack_restore(); if (bcRunning == 0) return;
            if (limit < 0) { bc_error(27); return; }
            arrayIdxTmp[dimCount] = limit + 1;
            total = total * (limit + 1);
            dimCount = dimCount + 1;
            if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
            if (bc_at(bcPc) == ')') { bcPc = bcPc + 1; break; }
            bc_error(12); return;
        }
        if (pool_alloc_array_record(isStr, total) == 0) { bc_error(29); return; }
        arr = arrayCount;
        array_used_set(arr, 1); array_is_string_set(arr, isStr); array_dims_set(arr, dimCount); array_total_set(arr, total);
        bc_copy_var_name_to_array(arr, id);
        i = 0; while (i < ARRAY_DIMS_MAX) { if (i < dimCount) array_dim_size_set(arr, i, arrayIdxTmp[i]); else array_dim_size_set(arr, i, 0); i = i + 1; }
        if (isStr != 0) { i = 0; while (i < total) { array_str_len_set(arr, i, 0); i = i + 1; } arrayStrNext = arrayStrNext + total; }
        else { i = 0; while (i < total) { array_num_int_set(arr, i, 0); array_num_float_set(arr, i, 0.0f); array_num_is_float_set(arr, i, 0); i = i + 1; } arrayNumNext = arrayNumNext + total; }
        arrayCount = arrayCount + 1;
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        return;
    }
}

void bc_store_input_to_target()
{
    int id;
    int arr;
    int lin;
    int value;
    if (bc_at(bcPc) == B_STRVAR) {
        bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1;
        if (bc_at(bcPc) == '(') { arr = bc_find_array_for_var(id, 1); if (arr < 0) { bc_error(24); return; } if (bc_parse_array_indices(arr) == 0) return; lin = compute_array_linear(arr); file_input_parse_string_value(); if (inputOk == 0) { bc_error(18); return; } copy_tmp_to_string_array(arr, lin); }
        else { file_input_parse_string_value(); if (inputOk == 0) { bc_error(18); return; } copy_tmp_to_string_var(id); }
        return;
    }
    if (bc_at(bcPc) == B_VAR) {
        bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1;
        value = file_input_parse_int_value(); if (inputOk == 0) { bc_error(18); return; }
        if (bc_at(bcPc) == '(') { arr = bc_find_array_for_var(id, 0); if (arr < 0) { bc_error(24); return; } if (bc_parse_array_indices(arr) == 0) return; lin = compute_array_linear(arr); array_num_int_set(arr, lin, value); array_num_float_set(arr, lin, (float)value); array_num_is_float_set(arr, lin, 0); }
        else { var_int_set(id, value); var_float_set(id, (float)value); var_is_float_set(id, 0); }
        return;
    }
    bc_error(5);
}

void bc_exec_input()
{
    int h;
    int hadPrompt;
    hadPrompt = 0;
    if (bc_at(bcPc) == '#') {
        h = bc_parse_file_number(); if (bcRunning == 0) return;
        if (file_read_line_to_input(h) == 0) { bcRunning = 0; return; }
        if (bc_at(bcPc) == ',' || bc_at(bcPc) == ';') bcPc = bcPc + 1;
    } else {
        if (bc_token_starts_string(bc_at(bcPc)) != 0) { if (bc_eval_string_expr() == 0) return; con_str_tmp(); hadPrompt = 1; if (bc_at(bcPc) == ',' || bc_at(bcPc) == ';') bcPc = bcPc + 1; }
        if (hadPrompt == 0) { con_char('?'); con_char(' '); }
        flushScreen(); read_line_editor();
    }
    g_pos = 0;
    while (bcRunning != 0) {
        if (bc_at(bcPc) == B_EOL || bc_at(bcPc) == ':') return;
        bc_store_input_to_target(); if (bcRunning == 0) return;
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        return;
    }
}

void bc_exec_line_input()
{
    int h;
    int id;
    if (bc_at(bcPc) != B_INPUT) { bc_error(5); return; }
    bcPc = bcPc + 1;
    h = -1;
    if (bc_at(bcPc) == '#') { h = bc_parse_file_number(); if (bcRunning == 0) return; if (bc_at(bcPc) == ',' || bc_at(bcPc) == ';') bcPc = bcPc + 1; }
    if (bc_at(bcPc) != B_STRVAR) { bc_error(5); return; }
    bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1;
    if (h >= 0) { if (file_read_line_to_input(h) == 0) { bcRunning = 0; return; } }
    else { flushScreen(); read_line_editor(); }
    clear_str_tmp(); g_pos = 0; while (g_pos < g_len) { append_str_tmp_char(inputLine[g_pos]); g_pos = g_pos + 1; }
    copy_tmp_to_string_var(id);
}

void bc_path_from_string_expr()
{
    if (bc_eval_string_expr() == 0) return;
    file_resolve_tmp_to_filePath();
}

void bc_exec_open()
{
    int h;
    int mode;
    bc_path_from_string_expr(); if (bcRunning == 0) return;
    mode = 1;
    if (bc_at(bcPc) == B_FOR) { bcPc = bcPc + 1; if (bc_at(bcPc) == B_INPUT) { mode = 1; bcPc = bcPc + 1; } else if (bc_at(bcPc) == B_OUTPUT) { mode = 2; bcPc = bcPc + 1; } else if (bc_at(bcPc) == B_APPEND) { mode = 3; bcPc = bcPc + 1; } else { bc_error(56); return; } }
    if (bc_at(bcPc) != B_AS) { bc_error(56); return; }
    bcPc = bcPc + 1;
    h = bc_parse_file_number(); if (bcRunning == 0) return;
    if (sd_mount_ok() == 0) { bc_error(53); return; }
    if (fileOpen[h] != 0) close_one_file(h);
    file_copy_filePath_to_handle(h); fileOpen[h] = 1; fileMode[h] = mode; fileDirty[h] = 0; filePos[h] = 0; fileSizeUsed[h] = 0; fileBufStart[h] = 0; fileBufLen[h] = 0; file_clear_buffer(h);
    if (mode == 1) { if (sdFileExists(filePath) == (uint)0) { fileOpen[h] = 0; bc_error(57); return; } fileSizeUsed[h] = (int)sdFileSize(filePath); filePos[h] = 0; }
    else if (mode == 2) { sdFileDelete(filePath); if (sdFileMake(filePath) == (uint)0) { fileOpen[h] = 0; bc_error(53); return; } }
    else { if (sdFileExists(filePath) != (uint)0) fileSizeUsed[h] = (int)sdFileSize(filePath); else { if (sdFileMake(filePath) == (uint)0) { fileOpen[h] = 0; bc_error(53); return; } fileSizeUsed[h] = 0; } filePos[h] = fileSizeUsed[h]; }
}

void bc_exec_close()
{
    int h;
    if (bc_at(bcPc) == B_EOL || bc_at(bcPc) == ':') { close_all_files(); return; }
    while (bcRunning != 0) { h = bc_parse_file_number(); if (bcRunning == 0) return; close_one_file(h); if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; } return; }
}

void bc_exec_files()
{
    int status; int idx; int nameLen; int entryType;
    if (bc_at(bcPc) == B_EOL || bc_at(bcPc) == ':') { clear_chars(filePath, PATH_MAX); if (currentDirLen > 0) { idx = 0; while (idx < currentDirLen) { filePath[idx] = currentDir[idx]; idx = idx + 1; } } }
    else { bc_path_from_string_expr(); if (bcRunning == 0) return; }
    if (sd_mount_ok() == 0) { bc_error(53); return; }
    idx = 0;
    while (idx < 256) { status = (int)sdDirEntry(filePath, idx, dirEntryName, nameLen, entryType); if (status == 0) break; con_str(dirEntryName, PATH_MAX); if (entryType != 0) con_char('/'); con_nl(); idx = idx + 1; }
}

void bc_exec_simple_path_op(int op)
{
    int i;
    bc_path_from_string_expr(); if (bcRunning == 0) return;
    if (sd_mount_ok() == 0) { bc_error(53); return; }
    if (op == B_KILL) { if (sdFileDelete(filePath) == (uint)0) bc_error(53); return; }
    if (op == B_MKDIR) { if (sdDirMake(filePath) == (uint)0) bc_error(53); return; }
    if (op == B_RMDIR) { if (sdDirDelete(filePath) == (uint)0) bc_error(53); return; }
    if (op == B_CHDIR) { i = 0; while (i < PATH_MAX) { currentDir[i] = filePath[i]; if (filePath[i] == 0) break; i = i + 1; } currentDirLen = i; return; }
}


int bc_token_size_at(int p)
{
    if (bc_at(p) == B_INT || bc_at(p) == B_FLOAT || bc_at(p) == B_VAR || bc_at(p) == B_STRVAR) return 2;
    if (bc_at(p) == B_STR) return 3;
    return 1;
}

int bc_find_next_data_item_pc(int startPc)
{
    int p;
    int inData;
    int t;
    p = startPc;
    inData = 0;
    while (p < bcLen) {
        t = bc_at(p);
        if (t == B_DATA) { inData = 1; p = p + 1; continue; }
        if (inData != 0) {
            if (t == ',') { p = p + 1; continue; }
            if (t == B_EOL || t == ':') { inData = 0; p = p + 1; continue; }
            if (t == B_INT || t == B_FLOAT || t == B_STR) return p;
            p = p + bc_token_size_at(p);
            continue;
        }
        p = p + bc_token_size_at(p);
    }
    return -1;
}

void bc_load_data_item_to_tmp_or_num(int itemPc)
{
    int t;
    int off;
    int len;
    int i;
    t = bc_at(itemPc);
    clear_str_tmp();
    if (t == B_STR) {
        off = bc_at(itemPc + 1); len = bc_at(itemPc + 2);
        i = 0; while (i < len) { append_str_tmp_char(bcStr[off + i]); i = i + 1; }
        bcDataPc = itemPc + 3;
    } else if (t == B_INT) {
        append_int_to_str_tmp(bc_at(itemPc + 1));
        bcDataPc = itemPc + 2;
    } else if (t == B_FLOAT) {
        append_float_to_str_tmp(bcFloat[bc_at(itemPc + 1)]);
        bcDataPc = itemPc + 2;
    } else {
        bc_error(43);
    }
    if (bc_at(bcDataPc) == ',') bcDataPc = bcDataPc + 1;
}

void bc_exec_read()
{
    int id;
    int itemPc;
    int arr;
    int lin;
    float fv;
    while (bcRunning != 0) {
        itemPc = bc_find_next_data_item_pc(bcDataPc);
        if (itemPc < 0) { bc_error(43); return; }
        bc_load_data_item_to_tmp_or_num(itemPc);
        if (bcRunning == 0) return;
        if (bc_at(bcPc) == B_STRVAR) {
            bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1;
            if (bc_at(bcPc) == '(') { arr = bc_find_array_for_var(id, 1); if (arr < 0) { bc_error(24); return; } if (bc_parse_array_indices(arr) == 0) return; lin = compute_array_linear(arr); copy_tmp_to_string_array(arr, lin); }
            else copy_tmp_to_string_var(id);
        } else if (bc_at(bcPc) == B_VAR) {
            bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; fv = parse_str_tmp_number();
            if (bc_at(bcPc) == '(') { arr = bc_find_array_for_var(id, 0); if (arr < 0) { bc_error(24); return; } if (bc_parse_array_indices(arr) == 0) return; lin = compute_array_linear(arr); array_num_int_set(arr, lin, (int)fv); array_num_float_set(arr, lin, fv); array_num_is_float_set(arr, lin, 1); }
            else { var_int_set(id, (int)fv); var_float_set(id, fv); var_is_float_set(id, 1); }
        } else { bc_error(5); return; }
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        return;
    }
}

void bc_exec_restore()
{
    int target;
    if (bc_at(bcPc) == B_EOL || bc_at(bcPc) == ':') { bcDataPc = 0; return; }
    target = bc_read_target(); if (bcRunning == 0) return;
    bcDataPc = target;
}

void bc_exec_poke()
{
    int addr; int value;
    if (bc_at(bcPc) == '(') bcPc = bcPc + 1;
    addr = bc_eval_expr(); if (bcRunning == 0) return;
    if (bc_at(bcPc) == ',') bcPc = bcPc + 1; else { bc_error(16); return; }
    value = bc_eval_expr(); if (bcRunning == 0) return;
    if (bc_at(bcPc) == ')') bcPc = bcPc + 1;
    rawPokeWord(addr, value);
}

void bc_exec_gpio_mode(int usePinMode)
{
    int pin; int mode;
    pin = bc_eval_expr(); if (bcRunning == 0) return;
    if (bc_at(bcPc) == ',') bcPc = bcPc + 1; else { bc_error(16); return; }
    mode = bc_eval_expr(); if (bcRunning == 0) return;
    if (usePinMode != 0) pinMode(pin, mode); else gpioMode(pin, mode);
}

void bc_exec_gpio_set(int useDigital)
{
    int pin; int value;
    pin = bc_eval_expr(); if (bcRunning == 0) return;
    if (bc_at(bcPc) == ',') bcPc = bcPc + 1; else { bc_error(16); return; }
    value = bc_eval_expr(); if (bcRunning == 0) return;
    if (useDigital != 0) digitalWrite(pin, value); else gpioSet(pin, value);
}


int bc_find_end_select_from(int startPc)
{
    int p;
    int depth;
    p = startPc;
    depth = 0;
    while (p < bcLen) {
        if (bc_at(p) == B_SELECT) depth = depth + 1;
        else if (bc_at(p) == B_END) {
            if (bc_at(p + 1) == B_SELECT) {
                if (depth == 0) return p;
                depth = depth - 1;
            }
        }
        if (bc_at(p) == B_INT || bc_at(p) == B_FLOAT || bc_at(p) == B_VAR || bc_at(p) == B_STRVAR) p = p + 2;
        else if (bc_at(p) == B_STR) p = p + 3;
        else p = p + 1;
    }
    return -1;
}

int bc_case_clause_matches(float sel)
{
    int matched;
    int haveAny;
    float a;
    float b;
    matched = 0;
    haveAny = 0;
    if (bc_at(bcPc) == B_ELSE) { bcPc = bcPc + 1; return 1; }
    while (bcRunning != 0) {
        if (bc_at(bcPc) == B_EOL || bc_at(bcPc) == ':' || bc_at(bcPc) == B_CASE) break;
        expr_stack_save(); bc_eval_expr(); a = lastExprFloat; expr_stack_restore(); if (bcRunning == 0) return 0;
        b = a;
        if (bc_at(bcPc) == B_TO) { bcPc = bcPc + 1; expr_stack_save(); bc_eval_expr(); b = lastExprFloat; expr_stack_restore(); if (bcRunning == 0) return 0; }
        if (sel >= a && sel <= b) matched = 1;
        haveAny = 1;
        if (bc_at(bcPc) == ',') { bcPc = bcPc + 1; continue; }
        break;
    }
    if (haveAny == 0) return 0;
    return matched;
}

void bc_exec_select()
{
    float sel;
    int p;
    int savePc;
    int endPc;
    int found;
    expr_stack_save(); bc_eval_expr(); sel = lastExprFloat; expr_stack_restore(); if (bcRunning == 0) return;
    found = 0;
    p = bcPc;
    while (p < bcLen) {
        if (bc_at(p) == B_CASE) {
            savePc = bcPc;
            bcPc = p + 1;
            if (bc_case_clause_matches(sel) != 0) { found = 1; if (bc_at(bcPc) == ':') bcPc = bcPc + 1; bcNextPc = bcPc; bcFlow = 1; return; }
            bcPc = savePc;
        }
        if (bc_at(p) == B_END) { if (bc_at(p + 1) == B_SELECT) { endPc = p; bcNextPc = endPc + 2; bcFlow = 1; return; } }
        if (bc_at(p) == B_INT || bc_at(p) == B_FLOAT || bc_at(p) == B_VAR || bc_at(p) == B_STRVAR) p = p + 2;
        else if (bc_at(p) == B_STR) p = p + 3;
        else p = p + 1;
    }
    bc_error(42);
}

void bc_skip_to_end_select()
{
    int endPc;
    endPc = bc_find_end_select_from(bcPc);
    if (endPc < 0) { bc_error(42); return; }
    bcNextPc = endPc + 2;
    bcFlow = 1;
}

void bc_exec_gtext()
{
    int x;
    int y;
    int color;
    int i;

    x = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    y = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    if (bc_eval_string_expr() == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    color = bc_eval_expr();
    if (bcRunning == 0) return;

    i = 0;
    while (i < strTmpLen) {
        drawGlyph(x + i * FONT_W, y, (int)strTmp[i], (uint)color);
        i = i + 1;
    }
    screenDirty = 1;
}

void bc_exec_gbutton()
{
    int x;
    int y;
    int w;
    int h;
    int fillColor;
    int borderColor;
    int textColor;

    x = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    y = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    w = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    h = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    if (bc_eval_string_expr() == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    fillColor = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    borderColor = bc_eval_expr();
    if (bcRunning == 0) return;
    if (bc_at(bcPc) != ',') { bc_error(16); return; }
    bcPc = bcPc + 1;
    textColor = bc_eval_expr();
    if (bcRunning == 0) return;

    drawButtonGfx(x, y, w, h, (uint)fillColor, (uint)borderColor, (uint)textColor);
}

void bc_exec_do_loop(int t)
{
    int target;
    int cond;
    int match;
    int token;

    if (t == B_DO) {
        target = bcPc;
        bcPc = bcPc + 1;
        cond = 1;
        match = 0;
        token = bc_at(bcPc);
        if (token == B_WHILE) {
            match = 1;
            bcPc = bcPc + 1;
            cond = bc_eval_condition();
            if (cond == 0) { target = bc_find_matching_forward(bcPc, B_DO, B_LOOP, 0); if (target < 0) { bc_error(37); return; } bcNextPc = target + 1; bcFlow = 1; return; }
        } else if (token == B_UNTIL) {
            match = 1;
            bcPc = bcPc + 1;
            cond = bc_eval_condition();
            if (cond != 0) { target = bc_find_matching_forward(bcPc, B_DO, B_LOOP, 0); if (target < 0) { bc_error(37); return; } bcNextPc = target + 1; bcFlow = 1; return; }
        }
        if (doSp >= MAX_DO) { bc_error(35); return; }
        if (match != 0) bcDoPcStack[doSp] = target;
        else bcDoPcStack[doSp] = bcPc;
        bcDoModeStack[doSp] = match;
        doSp = doSp + 1;
        return;
    }
    if (t == B_LOOP) {
        bcPc = bcPc + 1;
        if (doSp <= 0) { bc_error(34); return; }
        match = 1;
        token = bc_at(bcPc);
        if (token == B_WHILE) { bcPc = bcPc + 1; match = bc_eval_condition(); }
        else if (token == B_UNTIL) { bcPc = bcPc + 1; match = bc_eval_condition(); if (match != 0) match = 0; else match = 1; }
        if (match != 0) {
            target = bcDoPcStack[doSp - 1];
            if (bcDoModeStack[doSp - 1] != 0) doSp = doSp - 1;
            bcNextPc = target;
            bcFlow = 1;
            return;
        }
        doSp = doSp - 1;
        return;
    }
}

void bc_exec_other_statement(int t)
{
    int id; int target; int cond; int v; int x0; int y0; int x1; int y1; int x2; int y2; int col; int match;
    float fstart; float fend; float fstep;
    if (t == B_PRINT) { bcPc = bcPc + 1; bc_exec_print(); return; }
    if (t == B_LINE) { bcPc = bcPc + 1; if (bc_at(bcPc) == B_INPUT) { bc_exec_line_input(); return; } x0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; x1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; col = bc_eval_expr(); mm_line(x0,y0,x1,y1,(uint)col); screenDirty = 1; return; }
    if (t == B_LET) { bcPc = bcPc + 1; if (bc_at(bcPc) == B_VAR) { bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; bc_assign_number_to_var_or_array(id); return; } if (bc_at(bcPc) == B_STRVAR) { bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; bc_assign_string_to_var_or_array(id); return; } bc_error(5); return; }
    if (t == B_STRVAR) { bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; bc_assign_string_to_var_or_array(id); return; }
    if (t == B_DIM) { bcPc = bcPc + 1; bc_exec_dim(); return; }
    if (t == B_GOTO) { bcPc = bcPc + 1; target = bc_read_target(); bcNextPc = target; bcFlow = 1; return; }
    if (t == B_GOSUB) { bcPc = bcPc + 1; target = bc_read_target(); if (bcRunning == 0) return; bc_skip_to_next_statement(); if (bc_push_frame(bcPc, 0) == 0) return; bcNextPc = target; bcFlow = 1; return; }
    if (t == B_CALL) { bcPc = bcPc + 1; if (bc_at(bcPc) != B_VAR && bc_at(bcPc) != B_STRVAR) { bc_error(4); return; } bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; target = bc_find_sub_for_var(id); if (target < 0) { bc_error(4); return; } if (bc_execute_routine(target, 0) == 0) return; return; }
    if (t == B_RETURN) { bcPc = bcPc + 1; if (bcGosubSp <= 0) { bc_error(31); return; } bcGosubSp = bcGosubSp - 1; restore_locals_to(localMarkStack[bcGosubSp]); bcNextPc = bcGosubPc[bcGosubSp]; bcFlow = 1; if (bcGosubType[bcGosubSp] != 0) bcRoutineExit = 1; return; }
    if (t == B_IF) { bcPc = bcPc + 1; cond = bc_eval_condition(); if (bcRunning == 0) return; if (bc_at(bcPc) != B_THEN) { bc_error(15); return; } bcPc = bcPc + 1; if (cond == 0) { target = bc_find_matching_forward(bcPc, B_IF, B_ENDIF, B_ELSE); if (target < 0) { bc_skip_to_next_statement(); return; } bcNextPc = target + 1; bcFlow = 1; return; } if (bc_at(bcPc) == B_INT || bc_at(bcPc) == B_VAR) { target = bc_read_target(); bcNextPc = target; bcFlow = 1; return; } return; }
    if (t == B_ELSE) { target = bc_find_matching_forward(bcPc + 1, B_IF, B_ENDIF, 0); if (target < 0) { bc_error(36); return; } bcNextPc = target + 1; bcFlow = 1; return; }
    if (t == B_ENDIF) { bcPc = bcPc + 1; return; }
    if (t == B_FOR) { bcPc = bcPc + 1; if (bc_at(bcPc) != B_VAR) { bc_error(5); return; } bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; if (bc_at(bcPc) != '=') { bc_error(5); return; } bcPc = bcPc + 1; v = bc_eval_expr(); fstart = lastExprFloat; match = lastExprIsFloat; if (bc_at(bcPc) != B_TO) { bc_error(13); return; } bcPc = bcPc + 1; v = bc_eval_expr(); fend = lastExprFloat; if (lastExprIsFloat != 0) match = 1; fstep = 1.0f; if (bc_at(bcPc) == B_STEP) { bcPc = bcPc + 1; v = bc_eval_expr(); fstep = lastExprFloat; if (lastExprIsFloat != 0) match = 1; } if (fstep == 0.0f) { bc_error(14); return; } var_float_set(id, fstart); var_int_set(id, (int)fstart); var_is_float_set(id, match); if (bcForSp >= MAX_FOR) { bc_error(9); return; } if (match != 0) bcForVar[bcForSp] = 0 - (id + 1); else bcForVar[bcForSp] = id; bcForEnd[bcForSp] = fend; bcForStep[bcForSp] = fstep; bcForResume[bcForSp] = bcPc + 1; bcForSp = bcForSp + 1; return; }
    if (t == B_NEXT) { bcPc = bcPc + 1; if (bcForSp <= 0) { bc_error(10); return; } match = bcForVar[bcForSp - 1]; if (match < 0) { id = 0 - match - 1; col = 1; } else { id = match; col = 0; } if (bc_at(bcPc) == B_VAR) { bcPc = bcPc + 2; } var_float_set(id, var_float_get(id) + bcForStep[bcForSp - 1]); var_int_set(id, (int)var_float_get(id)); var_is_float_set(id, col); if (bcForStep[bcForSp - 1] > 0.0f) { if (var_float_get(id) <= bcForEnd[bcForSp - 1]) { bcNextPc = bcForResume[bcForSp - 1]; bcFlow = 1; return; } } else { if (var_float_get(id) >= bcForEnd[bcForSp - 1]) { bcNextPc = bcForResume[bcForSp - 1]; bcFlow = 1; return; } } bcForSp = bcForSp - 1; return; }
    if (t == B_WHILE) {
        target = bcPc;
        bcPc = bcPc + 1;
        cond = bc_eval_condition();
        if (cond == 0) { target = bc_find_matching_forward(bcPc, B_WHILE, B_WEND, 0); if (target < 0) { bc_error(38); return; } bcNextPc = target + 1; bcFlow = 1; return; }
        if (bcWhileSp >= MAX_WHILE) { bc_error(39); return; }
        bcWhilePcStack[bcWhileSp] = target;
        bcWhileSp = bcWhileSp + 1;
        return;
    }
    if (t == B_WEND) { bcPc = bcPc + 1; if (bcWhileSp <= 0) { bc_error(40); return; } bcWhileSp = bcWhileSp - 1; bcNextPc = bcWhilePcStack[bcWhileSp]; bcFlow = 1; return; }
    if (t == B_STOP) { bcPc = bcPc + 1; bcRunning = 0; return; }
    if (t == B_END) { bcPc = bcPc + 1; if (bc_at(bcPc) == B_SELECT || bc_at(bcPc) == B_SUB || bc_at(bcPc) == B_FUNCTION) { bcPc = bcPc + 1; return; } bcRunning = 0; return; }
    if (t == B_SUB || t == B_FUNCTION) { target = bc_find_matching_forward(bcPc + 1, t, B_END, 0); if (target < 0) { bc_error(47); return; } bcNextPc = target + 2; bcFlow = 1; return; }
    if (t == B_LOCAL) { bcPc = bcPc + 1; while (bc_at(bcPc) == B_VAR || bc_at(bcPc) == B_STRVAR) { match = bc_at(bcPc); bcPc = bcPc + 1; id = bc_at(bcPc); bcPc = bcPc + 1; save_local_var_if_needed(id); if (running == 0) { bcRunning = 0; return; } var_int_set(id, 0); var_float_set(id, 0.0f); var_is_float_set(id, 0); var_str_len_set(id, 0); if (match == B_STRVAR) var_is_string_set(id, 1); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; else break; } return; }
#ifdef __NARM__
    if (t == B_MODE) {
        bcPc = bcPc + 1;
        v = bc_eval_expr();
        if (bcRunning == 0) return;
        if (lastExprIsFloat != 0 && lastExprFloat != (float)v) { bc_error(5); return; }
        if (bc_at(bcPc) != B_EOL && bc_at(bcPc) != ':' && bc_at(bcPc) != 0) { bc_error(17); return; }
        graphics_set_mode(v);
        if (running == 0) bcRunning = 0;
        return;
    }
    if (t == B_TRI || t == B_FILLTRI) {
        bcPc = bcPc + 1;
        x0 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        y0 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        x1 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        y1 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        x2 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        y2 = bc_eval_expr(); if (bc_at(bcPc) != ',') { bc_error(16); return; } bcPc = bcPc + 1;
        col = bc_eval_expr();
        if (bcRunning == 0) return;
        if (t == B_FILLTRI) mm_fill_triangle(x0, y0, x1, y1, x2, y2, (uint)col);
        else { mm_line(x0, y0, x1, y1, (uint)col); mm_line(x1, y1, x2, y2, (uint)col); mm_line(x2, y2, x0, y0, (uint)col); }
        screenDirty = 1;
        return;
    }
#endif
    if (t == B_GCLS) { bcPc = bcPc + 1; col = 0; if (bc_at(bcPc) != B_EOL && bc_at(bcPc) != ':') col = bc_eval_expr(); mm_clear((uint)col); screenDirty = 1; return; }
    if (t == B_GTEXT) { bcPc = bcPc + 1; bc_exec_gtext(); return; }
    if (t == B_GBUTTON) { bcPc = bcPc + 1; bc_exec_gbutton(); return; }
    if (t == B_FILLRECT) { bcPc = bcPc + 1; x0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; x1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; col = bc_eval_expr(); fillRectClip(x0,y0,x1,y1,(uint)col); screenDirty = 1; return; }
    if (t == B_RECT) { bcPc = bcPc + 1; x0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; x1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y1 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; col = bc_eval_expr(); drawRectClip(x0,y0,x1,y1,(uint)col); screenDirty = 1; return; }
    if (t == B_PIXEL || t == B_PSET) { bcPc = bcPc + 1; x0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; y0 = bc_eval_expr(); if (bc_at(bcPc) == ',') bcPc = bcPc + 1; col = bc_eval_expr(); if (x0 >= 0 && x0 < SCREEN_W && y0 >= 0 && y0 < SCREEN_H) mm_pixel((uint)(y0 * SCREEN_W + x0), (uint)col); screenDirty = 1; return; }
    if (t == B_PAUSE || t == B_DELAY) {
        bcPc = bcPc + 1;
        v = bc_eval_expr();
        if (v > 0) {
#ifdef __NARM__
            mm_service_screen(!bcHasPresent);
#endif
            inputNow = millis();
            while ((int)(millis() - inputNow) < v) {
#ifdef __NARM__
                mm_service_screen(!bcHasPresent);
#endif
            }
        }
        return;
    }
    if (t == B_PRESENT) { bcPc = bcPc + 1; mm_present(); return; }
    if (t == B_INPUT) { bcPc = bcPc + 1; bc_exec_input(); return; }
    if (t == B_OPEN) { bcPc = bcPc + 1; bc_exec_open(); return; }
    if (t == B_CLOSE) { bcPc = bcPc + 1; bc_exec_close(); return; }
    if (t == B_FILES) { bcPc = bcPc + 1; bc_exec_files(); return; }
    if (t == B_KILL || t == B_MKDIR || t == B_RMDIR || t == B_CHDIR) { bcPc = bcPc + 1; bc_exec_simple_path_op(t); return; }
    if (t == B_READ) { bcPc = bcPc + 1; bc_exec_read(); return; }
    if (t == B_RESTORE) { bcPc = bcPc + 1; bc_exec_restore(); return; }
    if (t == B_DATA) { bc_skip_to_next_statement(); return; }
    if (t == B_POKE) { bcPc = bcPc + 1; bc_exec_poke(); return; }
    if (t == B_PINMODE) { bcPc = bcPc + 1; bc_exec_gpio_mode(1); return; }
    if (t == B_GPIOMODE) { bcPc = bcPc + 1; bc_exec_gpio_mode(0); return; }
    if (t == B_GPIOSET || t == B_PINSET) { bcPc = bcPc + 1; bc_exec_gpio_set(0); return; }
    if (t == B_DIGITALWRITE) { bcPc = bcPc + 1; bc_exec_gpio_set(1); return; }
    if (t == B_SELECT) { bcPc = bcPc + 1; bc_exec_select(); return; }
    if (t == B_CASE) { bc_skip_to_end_select(); return; }
    if (t == 0) { bcRunning = 0; return; }
    bc_error(63);
}

void bc_exec_statement(int t)
{
    int id;
    if (t == B_VAR) {
        id = bc_at(bcPc + 1);
        bcPc = bcPc + 2;
        bc_assign_number_to_var_or_array(id);
    } else if (t == B_DO || t == B_LOOP) {
        bc_exec_do_loop(t);
    } else {
        bc_exec_other_statement(t);
    }
}

void bc_run_program()
{
    int atLineStart;
    int oldRunning;
    int token;
#ifdef __NARM__
    int linesSincePoll;
    linesSincePoll = 0;
#endif
    if (sourceDiscarded != 0) {
        if (bcReady == 0) { con_char('N'); con_char('O'); con_char(' '); con_char('P'); con_char('R'); con_char('O'); con_char('G'); con_char('R'); con_char('A'); con_char('M'); con_nl(); return; }
    } else {
        if (lineCount <= 0) { con_char('N'); con_char('O'); con_char(' '); con_char('P'); con_char('R'); con_char('O'); con_char('G'); con_char('R'); con_char('A'); con_char('M'); con_nl(); return; }
    }
    errFlag = 0;
    oldRunning = running;
    running = 1;
    bcRunning = 1;
    /* v75: if source text is present, always rebuild bytecode before RUN.
       Reusing bcReady was unsafe because some editor/load/restore paths can
       leave programArena containing source text while bcReady still says that
       bytecode exists.  That caused ERR 63 when the runtime tried to execute
       raw source bytes or stale tokens.  Bytecode-only/COMPACT mode still uses
       the existing bytecode when no source is present. */
    if (sourceDiscarded == 0) {
        if (bc_build_program() == 0) { running = oldRunning; return; }
    } else {
        if (bcReady == 0) { bc_error(64); running = oldRunning; return; }
    }
    bc_runtime_reset();
    bc_seek_reset();
    bcPc = 0;
    bcNextPc = 0;
    atLineStart = 1;
    while (bcRunning != 0) {
        bcPc = bcNextPc;
        if (bcPc < 0 || bcPc >= bcLen) break;
        token = bc_at(bcPc);
        if (token == 0) break;
        /* Resolve this slot to a source line only if execution reports an error. */
        bcRunLinePc = bcPc;
        bcFlow = 0;
        while (bcRunning != 0) {
            if (atLineStart != 0) {
                /* A raw numbered line can still start with B_INT <line>. */
                if (token == B_INT) {
                    bcPc = bcPc + 2;
                    token = bc_at(bcPc);
                }
                atLineStart = 0;
            }
            if (token == 0) { bcRunning = 0; break; }
            if (token == B_EOL) { bcPc = bcPc + 1; atLineStart = 1; break; }
            if (token != ':') {
                bc_exec_statement(token);
                if (bcRunning == 0 || bcFlow != 0) break;
                token = bc_at(bcPc);
                if (token == B_EOL) { bcPc = bcPc + 1; atLineStart = 1; break; }
                if (token != ':') { bc_error(17); break; }
            }
            bcPc = bcPc + 1;
            token = bc_at(bcPc);
        }
        if (bcFlow != 0) { bcPc = bcNextPc; atLineStart = 1; } else bcNextPc = bcPc;
#ifdef __NARM__
        /* Keep the display queue moving during BASIC execution. Programs
           with PRESENT choose their own frame boundaries. */
        linesSincePoll = linesSincePoll + 1;
        if (linesSincePoll >= 32) {
            mm_service_screen(!bcHasPresent);
            linesSincePoll = 0;
        }
#else
        flushScreen();
#endif
    }
#ifdef __NARM__
    // Queue the last output before control returns to the editor or REPL.
    if (screenDirty) mm_present();
#endif
    bcRunLinePc = -1;
    running = oldRunning;
}

void run_program()
{
    /* v43: stored BASIC RUN executes only bytecode. */
#ifdef __NARM__
    mouse_reset_ui_input();
#endif
    bc_run_program();
}


void exec_direct()
{
    int i;
    i = 0;
    while (i < LINE_MAX) {
        prog[i] = inputLine[i];
        i = i + 1;
    }
    currentEnd = g_len;
    ip = 0;
    currentPc = -1;
    nextPc = 0;
    nextIp = 0;
    running = 1;
    errFlag = 0;
    gosubSp = 0;
    localTop = 0;
    whileSp = 0;

    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) return;
        if (prog[ip] == ':') { ip = ip + 1; continue; }
        if (prog[ip] == 39) return;
        while (skip_label_statement_here() != 0) {
            skip_spaces();
            if (ip >= currentEnd) return;
            if (prog[ip] == ':') ip = ip + 1;
        }
        if (ip >= currentEnd) return;
        if (prog[ip] == 39) return;

        flowChanged = 0;
        exec_current_line_body();
        if (running == 0) return;
        if (flowChanged != 0) return;

        skip_spaces();
        if (ip >= currentEnd) return;
        if (prog[ip] == ':') { ip = ip + 1; continue; }
        if (prog[ip] == 39) return;
        fail(17);
        return;
    }
}

/* ------------------------------------------------------------------------- */
/* REPL command processing                                                    */
/* ------------------------------------------------------------------------- */

int rest_is_end()
{
    skip_spaces();
    if (ip >= currentEnd) return 1;
    return 0;
}

