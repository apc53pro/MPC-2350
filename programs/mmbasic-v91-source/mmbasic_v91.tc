}

int ident_equals_array(int idx)
{
    int i;
    int base;
    char a;
    char b;

    if (idx < 0) return 0;
    if (idx >= arrayCount) return 0;
    if (array_used_get(idx) == 0) return 0;

    base = array_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = identTmp[i];
        b = pool_byte_get(base + i);
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

void copy_ident_to_array(int idx)
{
    int i;
    int base;
    base = array_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        pool_byte_set(base + i, identTmp[i]);
        i = i + 1;
    }
}

void save_ident_for_dim()
{
    int i;
    i = 0;
    while (i < VAR_NAME_MAX) {
        dimIdentTmp[i] = identTmp[i];
        i = i + 1;
    }
    dimIdentIsString = identIsString;
}

void restore_ident_for_dim()
{
    int i;
    i = 0;
    while (i < VAR_NAME_MAX) {
        identTmp[i] = dimIdentTmp[i];
        i = i + 1;
    }
    identIsString = dimIdentIsString;
}

int find_array_from_ident()
{
    int i;
    i = 0;
    while (i < arrayCount) {
        if (ident_equals_array(i) != 0) return i;
        i = i + 1;
    }
    return -1;
}

int compute_array_linear(int arr)
{
    int i;
    int dimBase;
    int idx;
    int size;
    int lin;

    if (arr < 0) { fail(24); return 0; }
    if (arr >= arrayCount) { fail(24); return 0; }
    if (array_used_get(arr) == 0) { fail(24); return 0; }
    if (arrayIdxCount != array_dims_get(arr)) { fail(27); return 0; }

    lin = 0;
    i = 0;
    while (i < arrayIdxCount) {
        idx = arrayIdxTmp[i];
        size = array_dim_size_get(arr, i);
        if (idx < 0) { fail(27); return 0; }
        if (idx >= size) { fail(27); return 0; }
        lin = lin * size + idx;
        i = i + 1;
    }
    return lin;
}

int op_prec(int op)
{
    if (op == '*') return 2;
    if (op == '/') return 2;
    if (op == '%') return 2;
    if (op == '+') return 1;
    if (op == '-') return 1;
    return 0;
}

int is_arith_op(char c)
{
    if (c == '+') return 1;
    if (c == '-') return 1;
    if (c == '*') return 1;
    if (c == '/') return 1;
    if (c == '%') return 1;
    return 0;
}

void push_val(int v)
{
    if (valTop >= EXPR_MAX) { fail(6); return; }
    valStack[valTop] = v;
    valFStack[valTop] = (float)v;
    valIsFloatStack[valTop] = 0;
    valTop = valTop + 1;
}

void push_float_val(float f)
{
    if (valTop >= EXPR_MAX) { fail(6); return; }
    valStack[valTop] = (int)f;
    valFStack[valTop] = f;
    valIsFloatStack[valTop] = 1;
    valTop = valTop + 1;
}

void push_op(int op)
{
    if (opTop >= EXPR_MAX) { fail(6); return; }
    opStack[opTop] = op;
    opTop = opTop + 1;
}

void apply_top_op()
{
    int op;
    int a;
    int b;
    int r;
    float af;
    float bf;
    float rf;
    int floatMath;

    if (opTop <= 0) { fail(7); return; }
    if (valTop < 2) { fail(7); return; }

    opTop = opTop - 1;
    op = opStack[opTop];

    valTop = valTop - 1;
    b = valStack[valTop];
    bf = valFStack[valTop];
    floatMath = valIsFloatStack[valTop];

    valTop = valTop - 1;
    a = valStack[valTop];
    af = valFStack[valTop];
    if (valIsFloatStack[valTop] != 0) floatMath = 1;

    /* v78: keep classic integer semantics for int/int division.  Only promote
       "/" to floating-point when at least one operand is already float. */
    if (floatMath != 0) {
        if (op == '+') rf = af + bf;
        else if (op == '-') rf = af - bf;
        else if (op == '*') rf = af * bf;
        else if (op == '/') {
            if (bf == 0.0f) { fail(8); return; }
            rf = af / bf;
        }
        else if (op == '%') {
            if (b == 0) { fail(8); return; }
            r = a % b;
            push_val(r);
            return;
        }
        else { fail(5); return; }
        push_float_val(rf);
        return;
    }

    r = 0;
    if (op == '+') r = a + b;
    else if (op == '-') r = a - b;
    else if (op == '*') r = a * b;
    else if (op == '/') {
        if (b == 0) { fail(8); return; }
        r = a / b;
    }
    else if (op == '%') {
        if (b == 0) { fail(8); return; }
        r = a % b;
    }
    else { fail(5); return; }

    push_val(r);
}

void expr_stack_save()
{
    int d;
    int base;
    int i;

    if (exprSaveDepth >= EXPR_SAVE_MAX) { fail(6); return; }
    d = exprSaveDepth;
    base = d * EXPR_MAX;
    exprValTopSave[d] = valTop;
    exprOpTopSave[d] = opTop;
    i = 0;
    while (i < EXPR_MAX) {
        exprValSave[base + i] = valStack[i];
        exprFValSave[base + i] = valFStack[i];
        exprValIsFloatSave[base + i] = valIsFloatStack[i];
        exprOpSave[base + i] = opStack[i];
        i = i + 1;
    }
    exprSaveDepth = exprSaveDepth + 1;
}

void expr_stack_restore()
{
    int d;
    int base;
    int i;

    if (exprSaveDepth <= 0) return;
    exprSaveDepth = exprSaveDepth - 1;
    d = exprSaveDepth;
    base = d * EXPR_MAX;
    valTop = exprValTopSave[d];
    opTop = exprOpTopSave[d];
    i = 0;
    while (i < EXPR_MAX) {
        valStack[i] = exprValSave[base + i];
        valFStack[i] = exprFValSave[base + i];
        valIsFloatStack[i] = exprValIsFloatSave[base + i];
        opStack[i] = exprOpSave[base + i];
        i = i + 1;
    }
}

int literal_has_decimal(int startPos, int endPos)
{
    int p;
    p = startPos;
    while (p < endPos) {
        if (prog[p] == '.') return 1;
        p = p + 1;
    }
    return 0;
}

float parse_number_float()
{
    float v;
    float frac;
    int any;
    v = 0.0f;
    any = 0;
    skip_spaces();
    while (ip < currentEnd) {
        if (is_digit(prog[ip]) == 0) break;
        v = v * 10.0f + (float)((int)(prog[ip] - '0'));
        ip = ip + 1;
        any = 1;
    }
    if (ip < currentEnd) {
        if (prog[ip] == '.') {
            ip = ip + 1;
            frac = 0.1f;
            while (ip < currentEnd) {
                if (is_digit(prog[ip]) == 0) break;
                v = v + frac * (float)((int)(prog[ip] - '0'));
                frac = frac * 0.1f;
                ip = ip + 1;
                any = 1;
            }
        }
    }
    if (any == 0) fail(11);
    return v;
}

int rawPeekWord(int addr)
{
    uint *p;
    p = (uint*)addr;
    return (int)(*p);
}

void rawPokeWord(int addr, int value)
{
    uint *p;
    p = (uint*)addr;
    *p = (uint)value;
}

int is_expr_stop()
{
    char c;

    if (ip >= currentEnd) return 1;
    c = prog[ip];
    if (c == ';') return 1;
    if (c == ',') return 1;
    if (c == ':') return 1;
    if (c == 39) return 1;
    if (c == '<') return 1;
    if (c == '>') return 1;
    if (c == '=') return 1;
    if (match_kw2('T','O') != 0) return 1;
    if (match_kw4('T','H','E','N') != 0) return 1;
    if (match_kw4('S','T','E','P') != 0) return 1;
    return 0;
}

#ifdef __NARM__
int mouse_selector_is(char *selector, int len, char *name)
{
    int i;
    i = 0;
    while (i < len && name[i] != 0) {
        if (to_upper(selector[i]) != name[i]) return 0;
        i = i + 1;
    }
    return i == len && name[i] == 0;
}

int basic_mouse_value(char *selector, int len)
{
    struct NarmMouseState state;
    int field;
    int status;

    if (mouse_selector_is(selector, len, "POLL")) {
        status = narm_mouse_poll_event(&basicMouseEvent);
        mouseEventValid = status > 0;
        if (mouseEventValid == 0) return 0;
        return (int)basicMouseEvent.type;
    }
    if (mouse_selector_is(selector, len, "MOTION")) {
        mouseMotionValid = narm_mouse_read_motion(&basicMouseMotion) == 0;
        return mouseMotionValid;
    }
    if (mouse_selector_is(selector, len, "DX")) return mouseMotionValid ? basicMouseMotion.dx : 0;
    if (mouse_selector_is(selector, len, "DY")) return mouseMotionValid ? basicMouseMotion.dy : 0;
    if (mouse_selector_is(selector, len, "WHEEL")) return mouseMotionValid ? basicMouseMotion.wheel : 0;
    if (mouse_selector_is(selector, len, "EVENTX")) return mouseEventValid ? basicMouseEvent.x / mousePixelScale : -1;
    if (mouse_selector_is(selector, len, "EVENTY")) return mouseEventValid ? basicMouseEvent.y / mousePixelScale : -1;
    if (mouse_selector_is(selector, len, "EVENTDX")) return mouseEventValid ? basicMouseEvent.dx : 0;
    if (mouse_selector_is(selector, len, "EVENTDY")) return mouseEventValid ? basicMouseEvent.dy : 0;
    if (mouse_selector_is(selector, len, "EVENTWHEEL")) return mouseEventValid ? basicMouseEvent.wheel : 0;
    if (mouse_selector_is(selector, len, "EVENTBUTTONS")) return mouseEventValid ? (int)basicMouseEvent.buttons : 0;
    if (mouse_selector_is(selector, len, "CHANGED")) return mouseEventValid ? (int)basicMouseEvent.changed_buttons : 0;

    field = 0;
    if (mouse_selector_is(selector, len, "X")) field = 1;
    else if (mouse_selector_is(selector, len, "Y")) field = 2;
    else if (mouse_selector_is(selector, len, "BUTTONS")) field = 3;
    else if (mouse_selector_is(selector, len, "LEFT")) field = 4;
    else if (mouse_selector_is(selector, len, "RIGHT")) field = 5;
    else if (mouse_selector_is(selector, len, "MIDDLE")) field = 6;
    else if (mouse_selector_is(selector, len, "CONNECTED")) field = 7;
    else { fail(5); return 0; }

    status = narm_mouse_get_state(&state);
    if (field == 7) return status == 0 && (state.flags & NARM_MOUSE_CONNECTED) != 0;
    if (status != 0 || (state.flags & (NARM_MOUSE_CONNECTED | NARM_MOUSE_FOCUSED)) !=
                      (NARM_MOUSE_CONNECTED | NARM_MOUSE_FOCUSED)) {
        if (field == 1 || field == 2) return -1;
        return 0;
    }
    if (field == 1) return state.x / mousePixelScale;
    if (field == 2) return state.y / mousePixelScale;
    if (field == 3) return (int)state.buttons;
    return (state.buttons & (1u << (field - 4))) != 0;
}

int direct_mouse_call_start()
{
    int p;
    if (match_kw5('M','O','U','S','E') == 0) return 0;
    p = ip + 5;
    while (p < currentEnd && is_space(prog[p]) != 0) p = p + 1;
    if (p >= currentEnd || prog[p] != '(') return 0;
    p = p + 1;
    while (p < currentEnd && is_space(prog[p]) != 0) p = p + 1;
    if (p < currentEnd && prog[p] == '"') return p + 1;
    return 0;
}

int direct_mouse_value()
{
    int start;
    int len;
    start = direct_mouse_call_start();
    ip = start;
    while (ip < currentEnd && prog[ip] != '"') ip = ip + 1;
    if (ip >= currentEnd) { fail(12); return 0; }
    len = ip - start;
    ip = ip + 1;
    skip_spaces();
    if (ip >= currentEnd || prog[ip] != ')') { fail(12); return 0; }
    ip = ip + 1;
    return basic_mouse_value(prog + start, len);
}
#endif

#ifdef __NARM__
int direct_rgb_call_start()
{
    int p;
    if (match_kw3('R','G','B') == 0) return 0;
    p = ip + 3;
    while (p < currentEnd && is_space(prog[p]) != 0) p = p + 1;
    return p < currentEnd && prog[p] == '(';
}

int direct_rgb_value()
{
    int red;
    int green;
    int blue;
    ip = ip + 3;
    skip_spaces();
    ip = ip + 1;
    expr_stack_save(); red = parse_expr(); expr_stack_restore();
    if (running == 0 || expect_comma() == 0) return 0;
    expr_stack_save(); green = parse_expr(); expr_stack_restore();
    if (running == 0 || expect_comma() == 0) return 0;
    expr_stack_save(); blue = parse_expr(); expr_stack_restore();
    if (running == 0) return 0;
    skip_spaces();
    if (ip >= currentEnd || prog[ip] != ')') { fail(12); return 0; }
    ip = ip + 1;
    return graphics_rgb(red, green, blue);
}
#endif

int parse_expr()
{
    int needValue;
    int op;
    char c;
    int v;
    float fv;
    float bf;
    int p;
    int varIndex;
    int arg;
    int haveArg;
    int arrIndex;
    int lin;
    int dimCount;
    int litStart;
    int subIndex;
    int savePc;
    int saveIp2;
    int saveEnd;
    int execLineIdx;
    int execDone;
    int argn;
    int idx2;
    int returnVar;
    int stmtStart;

    valTop = 0;
    opTop = 0;
    needValue = 1;
    lastExprFloat = 0.0f;
    lastExprIsFloat = 0;

    while (running != 0) {
        skip_spaces();
        if (is_expr_stop() != 0) break;
        c = prog[ip];

        if (is_digit(c) != 0 || c == '.') {
            litStart = ip;
            fv = parse_number_float();
            if (running == 0) return 0;
            if (literal_has_decimal(litStart, ip) != 0) push_float_val(fv);
            else push_val((int)fv);
            needValue = 0;
        } else if (is_alpha(c) != 0) {
#ifdef __NARM__
            if (match_kw7('M','M','.','H','R','E','S') != 0) { ip = ip + 7; push_val(SCREEN_W); needValue = 0; continue; }
            if (match_kw7('M','M','.','V','R','E','S') != 0) { ip = ip + 7; push_val(SCREEN_H); needValue = 0; continue; }
            if (match_kw7('M','M','.','M','O','D','E') != 0) { ip = ip + 7; push_val(graphicsMode); needValue = 0; continue; }
            if (match_kw6('M','M','.','B','P','P') != 0) { ip = ip + 6; push_val(graphicsBpp); needValue = 0; continue; }
            if (direct_rgb_call_start() != 0) {
                v = direct_rgb_value();
                if (running == 0) return 0;
                push_val(v); needValue = 0; continue;
            }
            if (direct_mouse_call_start() != 0) {
                v = direct_mouse_value();
                if (running == 0) return 0;
                push_val(v);
                needValue = 0;
                continue;
            }
#endif
            if (match_kw6('G','E','T','K','E','Y') != 0) {
                ip = ip + 6;
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        ip = ip + 1;
                        skip_spaces();
                        if (ip >= currentEnd) { fail(12); return 0; }
                        if (prog[ip] != ')') { fail(5); return 0; }
                        ip = ip + 1;
                    }
                }
                push_val(readAnyKeyCode());
                needValue = 0;
            } else if (match_kw8('F','O','N','T','A','D','D','R') != 0) {
                ip = ip + 8;
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        ip = ip + 1;
                        skip_spaces();
                        if (ip >= currentEnd) { fail(12); return 0; }
                        if (prog[ip] != ')') { fail(5); return 0; }
                        ip = ip + 1;
                    }
                }
                push_val(fontAddr());
                needValue = 0;
            } else if (match_kw7('K','E','Y','D','O','W','N') != 0) {
                ip = ip + 7;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                expr_stack_save();
                arg = parse_expr();
                expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(12); return 0; }
                ip = ip + 1;
                push_val(rawKeyDownNow(arg));
                needValue = 0;
            } else if (match_kw3('E','O','F') != 0) {
                ip = ip + 3;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                skip_spaces();
                if (ip < currentEnd) { if (prog[ip] == '#') ip = ip + 1; }
                expr_stack_save(); arg = parse_expr(); expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(12); return 0; }
                ip = ip + 1;
                idx2 = arg - 1;
                if (idx2 < 0) { fail(50); return 0; }
                if (idx2 >= MAX_FILES) { fail(50); return 0; }
                if (fileOpen[idx2] == 0) { fail(51); return 0; }
                if (filePos[idx2] >= fileSizeUsed[idx2]) push_val(1);
                else push_val(0);
                needValue = 0;
            } else if (match_kw3('L','O','F') != 0) {
                ip = ip + 3;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                skip_spaces();
                if (ip < currentEnd) { if (prog[ip] == '#') ip = ip + 1; }
                expr_stack_save(); arg = parse_expr(); expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(12); return 0; }
                ip = ip + 1;
                idx2 = arg - 1;
                if (idx2 < 0) { fail(50); return 0; }
                if (idx2 >= MAX_FILES) { fail(50); return 0; }
                if (fileOpen[idx2] == 0) { fail(51); return 0; }
                push_val(fileSizeUsed[idx2]);
                needValue = 0;
            } else if (match_kw3('L','O','C') != 0) {
                ip = ip + 3;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                skip_spaces();
                if (ip < currentEnd) { if (prog[ip] == '#') ip = ip + 1; }
                expr_stack_save(); arg = parse_expr(); expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(12); return 0; }
                ip = ip + 1;
                idx2 = arg - 1;
                if (idx2 < 0) { fail(50); return 0; }
                if (idx2 >= MAX_FILES) { fail(50); return 0; }
                if (fileOpen[idx2] == 0) { fail(51); return 0; }
                push_val(filePos[idx2]);
                needValue = 0;
            } else if (match_kw4('P','E','E','K') != 0) {
                ip = ip + 4;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                expr_stack_save();
                if (running == 0) return 0;
                arg = parse_expr();
                expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(12); return 0; }
                ip = ip + 1;
                push_val(rawPeekWord(arg));
                needValue = 0;
            } else if (match_kw3('L','E','N') != 0) {
                ip = ip + 3;
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
                v = 0;
                if (ip < currentEnd) {
                    if (prog[ip] == 34) {
                        ip = ip + 1;
                        while (ip < currentEnd) { if (prog[ip] == 34) break; v = v + 1; ip = ip + 1; }
                        if (ip >= currentEnd) { fail(12); return 0; }
                        ip = ip + 1;
                    } else {
                        if (parse_ident_to_tmp() == 0) { fail(23); return 0; }
                        varIndex = find_or_create_var_from_ident();
                        if (running == 0) return 0;
                        if (var_is_string_get(varIndex) == 0) { fail(22); return 0; }
                        v = var_str_len_get(varIndex);
                    }
                }
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
                push_val(v); needValue = 0;
            } else if (match_kw3('A','S','C') != 0) {
                ip = ip + 3;
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
                v = 0;
                if (ip < currentEnd) {
                    if (prog[ip] == 34) {
                        ip = ip + 1;
                        if (ip < currentEnd) { if (prog[ip] != 34) v = (int)prog[ip]; }
                        while (ip < currentEnd) { if (prog[ip] == 34) break; ip = ip + 1; }
                        if (ip >= currentEnd) { fail(12); return 0; }
                        ip = ip + 1;
                    } else {
                        if (parse_ident_to_tmp() == 0) { fail(23); return 0; }
