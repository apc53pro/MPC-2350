                        if (ip < currentEnd) { if (prog[ip] == '-') { v = -1; ip = ip + 1; } }
                        while (ip < currentEnd) { if (is_digit(prog[ip]) == 0) break; fv = fv * 10.0f + (float)((int)(prog[ip] - '0')); ip = ip + 1; }
                        if (ip < currentEnd) { if (prog[ip] == '.') { ip = ip + 1; bf = 0.1f; while (ip < currentEnd) { if (is_digit(prog[ip]) == 0) break; fv = fv + bf * (float)((int)(prog[ip] - '0')); bf = bf * 0.1f; ip = ip + 1; } } }
                        while (ip < currentEnd) { if (prog[ip] == 34) break; ip = ip + 1; }
                        if (ip >= currentEnd) { fail(12); return 0; }
                        ip = ip + 1;
                    } else {
                        if (parse_ident_to_tmp() == 0) { fail(23); return 0; }
                        varIndex = find_or_create_var_from_ident();
                        if (running == 0) return 0;
                        if (var_is_string_get(varIndex) == 0) { fail(22); return 0; }
                        p = str_base(varIndex);
                        lin = p + var_str_len_get(varIndex);
                        if (p < lin) { if (pool_byte_get(p) == '-') { v = -1; p = p + 1; } }
                        while (p < lin) { if (is_digit(pool_byte_get(p)) == 0) break; fv = fv * 10.0f + (float)((int)(pool_byte_get(p) - '0')); p = p + 1; }
                        if (p < lin) { if (pool_byte_get(p) == '.') { p = p + 1; bf = 0.1f; while (p < lin) { if (is_digit(pool_byte_get(p)) == 0) break; fv = fv + bf * (float)((int)(pool_byte_get(p) - '0')); bf = bf * 0.1f; p = p + 1; } } }
                    }
                }
                if (v < 0) fv = 0.0f - fv;
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
                push_float_val(fv); needValue = 0;
            } else if (match_kw3('S','I','N') != 0) {
                ip = ip + 3;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                expr_stack_save(); arg = parse_expr(); fv = lastExprFloat; expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
                push_float_val(sin(fv));
                needValue = 0;
            } else if (match_kw3('C','O','S') != 0) {
                ip = ip + 3;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != '(') { fail(12); return 0; }
                ip = ip + 1;
                expr_stack_save(); arg = parse_expr(); fv = lastExprFloat; expr_stack_restore();
                if (running == 0) return 0;
                skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
                push_float_val(cos(fv));
                needValue = 0;
            } else if (match_kw6('M','I','L','L','I','S') != 0) {
                ip = ip + 6;
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        ip = ip + 1;
                        skip_spaces();
                        if (ip >= currentEnd) { fail(12); return 0; }
                        if (prog[ip] != ')') { fail(5); return 0; }
                        ip = ip + 1;
                    }
                }
                push_val((int)millis());
                needValue = 0;
            } else if (match_kw6('R','A','N','D','3','2') != 0) {
                ip = ip + 6;
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        ip = ip + 1;
                        skip_spaces();
                        if (ip >= currentEnd) { fail(12); return 0; }
                        if (prog[ip] != ')') { fail(5); return 0; }
                        ip = ip + 1;
                    }
                }
                push_val((int)rand32());
                needValue = 0;
            } else if (match_kw3('R','N','D') != 0 || match_kw4('R','A','N','D') != 0 || match_kw6('R','A','N','D','O','M') != 0) {
                if (match_kw3('R','N','D') != 0) ip = ip + 3;
                else if (match_kw4('R','A','N','D') != 0) ip = ip + 4;
                else ip = ip + 6;

                haveArg = 0;
                arg = 0;
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        ip = ip + 1;
                        skip_spaces();
                        if (ip < currentEnd) {
                            if (prog[ip] != ')') {
                                expr_stack_save();
                                if (running == 0) return 0;
                                arg = parse_expr();
                                expr_stack_restore();
                                if (running == 0) return 0;
                                haveArg = 1;
                                skip_spaces();
                            }
                        }
                        if (ip >= currentEnd) { fail(12); return 0; }
                        if (prog[ip] != ')') { fail(12); return 0; }
                        ip = ip + 1;
                    }
                }

                if (haveArg == 0) {
                    v = (int)(random() & (uint)0x7FFFFFFF);
                    push_val(v);
                } else {
                    if (arg < 0) arg = 0 - arg;
                    if (arg <= 0) v = 0;
                    else v = (int)(random() % (uint)arg);
                    push_val(v);
                }
                needValue = 0;
            } else {
                if (parse_ident_to_tmp() == 0) { fail(5); return 0; }
                skip_spaces();
                subIndex = find_sub_from_ident();
                if (subIndex >= 0) {
                    if (subIsFunction[subIndex] != 0) {
                        if (ip < currentEnd) {
                            if (prog[ip] == '(') {
                                ip = ip + 1;
                                argn = 0;
                                skip_spaces();
                                if (ip < currentEnd) {
                                    if (prog[ip] != ')') {
                                        while (running != 0) {
                                            if (argn >= subParamCount[subIndex]) { fail(46); return 0; }
                                            expr_stack_save();
                                            v = parse_expr();
                                            fv = lastExprFloat;
                                            p = lastExprIsFloat;
                                            expr_stack_restore();
                                            if (running == 0) return 0;
                                            copy_sub_param_to_ident(subIndex, argn);
                                            idx2 = find_or_create_var_from_ident();
                                            if (running == 0) return 0;
                                            var_int_set(idx2, v);
                                            var_float_set(idx2, fv);
                                            var_is_float_set(idx2, p);
                                            argn = argn + 1;
                                            skip_spaces();
                                            if (ip >= currentEnd) { fail(12); return 0; }
                                            if (prog[ip] == ',') { ip = ip + 1; continue; }
                                            if (prog[ip] == ')') break;
                                            fail(12); return 0;
                                        }
                                    }
                                }
                                if (ip >= currentEnd) { fail(12); return 0; }
                                if (prog[ip] != ')') { fail(12); return 0; }
                                ip = ip + 1;
                                if (argn != subParamCount[subIndex]) { fail(46); return 0; }

                                savePc = currentPc;
                                saveIp2 = ip;
                                saveEnd = currentEnd;
                                execLineIdx = subLine[subIndex];
                                g_pos = subIp[subIndex];
                                execDone = 0;
                                while (execDone == 0) {
                                    if (execLineIdx < 0) { fail(47); return 0; }
                                    if (execLineIdx >= lineCount) { fail(47); return 0; }
                                    currentPc = execLineIdx;
                                    load_line_to_prog(execLineIdx);
                                    ip = g_pos;
                                    while (running != 0) {
                                        scan_skip_labels_and_colons();
                                        if (ip >= currentEnd) break;
                                        if (prog[ip] == 39) break;
                                        if (match_kw3('R','E','M') != 0) break;
                                        stmtStart = ip;
                                        if (match_end_function_here() != 0) { execDone = 1; break; }
                                        if (match_kw5('L','O','C','A','L') != 0) { scan_skip_to_next_statement(); continue; }
                                        if (parse_ident_to_tmp() != 0) {
                                            skip_spaces();
                                            if (ip < currentEnd) {
                                                if (prog[ip] == '=') {
                                                    idx2 = find_or_create_var_from_ident();
                                                    if (running == 0) return 0;
                                                    ip = ip + 1;
                                                    expr_stack_save();
                                                    v = parse_expr();
                                                    fv = lastExprFloat;
                                                    p = lastExprIsFloat;
                                                    expr_stack_restore();
                                                    if (running == 0) return 0;
                                                    var_int_set(idx2, v);
                                                    var_float_set(idx2, fv);
                                                    var_is_float_set(idx2, p);
                                                    skip_spaces();
                                                    if (ip < currentEnd) {
                                                        if (prog[ip] == ':') { ip = ip + 1; continue; }
                                                        if (prog[ip] == 39) break;
                                                        fail(17); return 0;
                                                    }
                                                    continue;
                                                }
                                            }
                                        }
                                        ip = stmtStart;
                                        scan_skip_to_next_statement();
                                    }
                                    if (execDone != 0) break;
                                    execLineIdx = execLineIdx + 1;
                                    g_pos = 0;
                                }
                                currentPc = savePc;
                                if (savePc >= 0) load_line_to_prog(savePc);
                                currentEnd = saveEnd;
                                ip = saveIp2;
                                g_i = 0;
                                while (g_i < VAR_NAME_MAX) {
                                    identTmp[g_i] = subNames[sub_name_base(subIndex) + g_i];
                                    g_i = g_i + 1;
                                }
                                identIsString = 0;
                                returnVar = find_or_create_var_from_ident();
                                if (running == 0) return 0;
                                if (var_is_float_get(returnVar) != 0) push_float_val(var_float_get(returnVar));
                                else push_val(var_int_get(returnVar));
                                needValue = 0;
                            } else { fail(12); return 0; }
                        } else { fail(12); return 0; }
                    } else { fail(5); return 0; }
                } else if (ip < currentEnd) {
                    if (prog[ip] == '(') {
                        arrIndex = find_array_from_ident();
                        if (arrIndex < 0) { fail(24); return 0; }
                        if (array_is_string_get(arrIndex) != 0) { fail(22); return 0; }
                        ip = ip + 1;
                        arrayIdxCount = 0;
                        dimCount = 0;
                        while (running != 0) {
                            if (dimCount >= ARRAY_DIMS_MAX) { fail(28); return 0; }
                            expr_stack_save();
                            if (running == 0) return 0;
                            arrayIdxTmp[dimCount] = parse_expr();
                            expr_stack_restore();
                            if (running == 0) return 0;
                            dimCount = dimCount + 1;
                            arrayIdxCount = dimCount;
                            skip_spaces();
                            if (ip >= currentEnd) { fail(12); return 0; }
                            if (prog[ip] == ',') {
                                ip = ip + 1;
                                continue;
                            }
                            if (prog[ip] == ')') {
                                ip = ip + 1;
                                break;
                            }
                            fail(12);
                            return 0;
                        }
                        lin = compute_array_linear(arrIndex);
                        if (running == 0) return 0;
                        if (array_num_is_float_get(arrIndex, lin) != 0) push_float_val(array_num_float_get(arrIndex, lin));
                        else push_val(array_num_int_get(arrIndex, lin));
                        needValue = 0;
                    } else {
                        varIndex = find_or_create_var_from_ident();
                        if (running == 0) return 0;
                        if (var_is_string_get(varIndex) != 0) { fail(22); return 0; }
                        if (var_is_float_get(varIndex) != 0) push_float_val(var_float_get(varIndex));
                        else push_val(var_int_get(varIndex));
                        needValue = 0;
                    }
                } else {
                    varIndex = find_or_create_var_from_ident();
                    if (running == 0) return 0;
                    if (var_is_string_get(varIndex) != 0) { fail(22); return 0; }
                    if (var_is_float_get(varIndex) != 0) push_float_val(var_float_get(varIndex));
                    else push_val(var_int_get(varIndex));
                    needValue = 0;
                }
            }
        } else if (c == '(') {
            push_op((int)'(');
            ip = ip + 1;
            needValue = 1;
        } else if (c == ')') {
            while (opTop > 0) {
                if (opStack[opTop - 1] == '(') break;
                apply_top_op();
                if (running == 0) return 0;
            }
            if (opTop <= 0) break;
            opTop = opTop - 1;
            ip = ip + 1;
            needValue = 0;
        } else if (is_arith_op(c) != 0) {
            if (needValue != 0) {
                if (c == '+') {
                    ip = ip + 1;
                    continue;
                }
                if (c == '-') push_val(0);
                else { fail(11); return 0; }
            }

            op = (int)c;
            while (opTop > 0) {
                if (opStack[opTop - 1] == '(') break;
                if (op_prec(opStack[opTop - 1]) < op_prec(op)) break;
                apply_top_op();
                if (running == 0) return 0;
            }
            push_op(op);
            ip = ip + 1;
            needValue = 1;
        } else {
            fail(5);
            return 0;
        }
    }

    if (needValue != 0) {
        if (valTop == 0) { fail(11); return 0; }
    }

    while (opTop > 0) {
        if (opStack[opTop - 1] == '(') { fail(12); return 0; }
        apply_top_op();
        if (running == 0) return 0;
    }

    if (valTop <= 0) { fail(11); return 0; }
    lastExprFloat = valFStack[valTop - 1];
    lastExprIsFloat = valIsFloatStack[valTop - 1];
    return valStack[valTop - 1];
}

int parse_condition()
{
    int left;
    int right;
    float leftF;
    float rightF;
    int useFloat;
    int op;
    char c;

    left = parse_expr();
    leftF = lastExprFloat;
    useFloat = lastExprIsFloat;
    if (running == 0) return 0;
    skip_spaces();
    if (ip >= currentEnd) {
        if (useFloat != 0) { if (leftF != 0.0f) return 1; return 0; }
        if (left != 0) return 1;
        return 0;
    }

    c = prog[ip];
    op = 0;

    if (c == '=') { op = 1; ip = ip + 1; }
    else if (c == '<') {
        ip = ip + 1;
        if (ip < currentEnd) {
            if (prog[ip] == '=') { op = 2; ip = ip + 1; }
            else if (prog[ip] == '>') { op = 3; ip = ip + 1; }
            else op = 4;
        } else op = 4;
    } else if (c == '>') {
        ip = ip + 1;
        if (ip < currentEnd) {
            if (prog[ip] == '=') { op = 5; ip = ip + 1; }
            else op = 6;
        } else op = 6;
    } else {
        if (useFloat != 0) { if (leftF != 0.0f) return 1; return 0; }
        if (left != 0) return 1;
        return 0;
    }

    right = parse_expr();
    rightF = lastExprFloat;
    if (lastExprIsFloat != 0) useFloat = 1;
    if (running == 0) return 0;

    if (useFloat != 0) {
        if (op == 1) { if (leftF == rightF) return 1; return 0; }
        if (op == 2) { if (leftF <= rightF) return 1; return 0; }
        if (op == 3) { if (leftF != rightF) return 1; return 0; }
        if (op == 4) { if (leftF < rightF) return 1; return 0; }
        if (op == 5) { if (leftF >= rightF) return 1; return 0; }
        if (op == 6) { if (leftF > rightF) return 1; return 0; }
        return 0;
    }

    if (op == 1) { if (left == right) return 1; return 0; }
    if (op == 2) { if (left <= right) return 1; return 0; }
    if (op == 3) { if (left != right) return 1; return 0; }
    if (op == 4) { if (left < right) return 1; return 0; }
    if (op == 5) { if (left >= right) return 1; return 0; }
    if (op == 6) { if (left > right) return 1; return 0; }
    return 0;
}

int while_top_is_current(int lineIdx, int pos)
{
    if (whileSp <= 0) return 0;
    if (whileLineStack[whileSp - 1] != lineIdx) return 0;
    if (whileIpStack[whileSp - 1] != pos) return 0;
    return 1;
}

int match_end_select_here()
{
    int saveIp;
    saveIp = ip;
    if (match_kw3('E','N','D') == 0) return 0;
    ip = ip + 3;
    skip_spaces();
    if (match_kw6('S','E','L','E','C','T') == 0) { ip = saveIp; return 0; }
    ip = saveIp;
    return 1;
}

int scan_select_case_at(int stmtIp)
{
    int saveIp;
    int ok;
    saveIp = ip;
    ip = stmtIp;
    ok = 0;
    if (match_kw6('S','E','L','E','C','T') != 0) {
        ip = ip + 6;
        skip_spaces();
        if (match_kw4('C','A','S','E') != 0) ok = 1;
    }
    ip = saveIp;
    return ok;
}

int parse_case_item_match(int sel)
{
    int matched;
    int a;
    int b;

    matched = 0;
    skip_spaces();
    if (match_kw4('E','L','S','E') != 0) {
        ip = ip + 4;
        return 1;
    }

    while (running != 0) {
        a = parse_expr();
        if (running == 0) return 0;
        b = a;
        skip_spaces();
        if (match_kw2('T','O') != 0) {
            ip = ip + 2;
            b = parse_expr();
            if (running == 0) return 0;
            if (a <= b) {
                if (sel >= a) {
                    if (sel <= b) matched = 1;
                }
            } else {
                if (sel >= b) {
                    if (sel <= a) matched = 1;
                }
            }
        } else {
            if (sel == a) matched = 1;
        }
        skip_spaces();
        if (ip >= currentEnd) return matched;
        if (prog[ip] == ':') return matched;
        if (prog[ip] == 39) return matched;
        if (prog[ip] != ',') return matched;
        ip = ip + 1;
    }
    return matched;
}

int find_wend_after(int startLine, int startIp)
{
    int line;
    int stmtIp;
    int depth;

    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;

        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            stmtIp = ip;
            if (match_kw5('W','H','I','L','E') != 0) {
                depth = depth + 1;
            } else if (match_kw4('W','E','N','D') != 0) {
                if (depth == 0) {
                    set_jump_to_position(line, ip + 4);
                    return 1;
                }
                depth = depth - 1;
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

int find_endselect_after(int startLine, int startIp)
{
    int line;
    int stmtIp;
    int depth;

    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;

        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            stmtIp = ip;
            if (scan_select_case_at(stmtIp) != 0) {
                depth = depth + 1;
            } else if (match_end_select_here() != 0) {
                if (depth == 0) {
                    ip = ip + 3;
                    skip_spaces();
                    ip = ip + 6;
                    set_jump_to_position(line, ip);
                    return 1;
                }
                depth = depth - 1;
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

int find_matching_case_after(int startLine, int startIp, int sel)
{
    int line;
    int stmtIp;
    int depth;
    int matched;

    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;

        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            stmtIp = ip;
            if (scan_select_case_at(stmtIp) != 0) {
                depth = depth + 1;
            } else if (match_end_select_here() != 0) {
                if (depth == 0) {
                    ip = ip + 3;
                    skip_spaces();
                    ip = ip + 6;
                    set_jump_to_position(line, ip);
                    return 1;
                }
                depth = depth - 1;
            } else if (match_kw4('C','A','S','E') != 0) {
                if (depth == 0) {
                    ip = ip + 4;
                    matched = parse_case_item_match(sel);
                    if (running == 0) return 0;
                    if (matched != 0) {
                        skip_to_next_statement_colon();
                        set_jump_to_position(line, ip);
                        return 1;
                    }
                }
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

int parse_array_indices_to_tmp()
{
    int dimCount;
    skip_spaces();
    if (ip >= currentEnd) { fail(12); return 0; }
    if (prog[ip] != '(') { fail(12); return 0; }
    ip = ip + 1;
    dimCount = 0;
    arrayIdxCount = 0;

    while (running != 0) {
        if (dimCount >= ARRAY_DIMS_MAX) { fail(28); return 0; }
        expr_stack_save();
        if (running == 0) return 0;
        arrayIdxTmp[dimCount] = parse_expr();
        expr_stack_restore();
        if (running == 0) return 0;
        dimCount = dimCount + 1;
        arrayIdxCount = dimCount;
        skip_spaces();
        if (ip >= currentEnd) { fail(12); return 0; }
        if (prog[ip] == ',') {
            ip = ip + 1;
            continue;
        }
        if (prog[ip] == ')') {
            ip = ip + 1;
            return 1;
        }
        fail(12);
        return 0;
    }
    return 0;
}

int str_base(int idx)
{
    return var_record_base(idx) + 48;
}

void clear_str_tmp()
{
    int i;
    strTmpLen = 0;
    i = 0;
    while (i < STR_MAX) {
        strTmp[i] = 0;
        i = i + 1;
    }
}

void append_str_tmp_char(char c)
{
    if (strTmpLen < STR_MAX - 1) {
        strTmp[strTmpLen] = c;
        strTmpLen = strTmpLen + 1;
        strTmp[strTmpLen] = 0;
    } else {
        fail(21);
    }
}

void append_int_to_str_tmp(int v)
{
    int n;
    uint u;
    uint q;
    uint r;

    if (v < 0) {
        append_str_tmp_char('-');
        u = (uint)(0 - v);
    } else {
        u = (uint)v;
    }
    if (running == 0) return;

    if (u == (uint)0) {
        append_str_tmp_char('0');
        return;
    }

    n = 0;
    while (u != (uint)0) {
        q = u / (uint)10;
        r = u - q * (uint)10;
        numTmp[n] = (char)('0' + (int)r);
        n = n + 1;
        u = q;
    }
    while (n > 0) {
        n = n - 1;
        append_str_tmp_char(numTmp[n]);
        if (running == 0) return;
    }
}

void append_float_to_str_tmp(float f)
{
    int whole;
    int frac;
    int i;
    float rem;

    if (f < 0.0f) {
        append_str_tmp_char('-');
        f = 0.0f - f;
    }
    if (running == 0) return;

    whole = (int)f;
    append_int_to_str_tmp(whole);
    if (running == 0) return;
    rem = f - (float)whole;
    if (rem < 0.000001f) return;
    append_str_tmp_char('.');
    i = 0;
    while (i < 6) {
        rem = rem * 10.0f;
        frac = (int)rem;
        append_str_tmp_char((char)('0' + frac));
        rem = rem - (float)frac;
        i = i + 1;
    }
}

float parse_str_tmp_number()
{
    int p;
    int sign;
    float v;
    float frac;
    p = 0;
    sign = 1;
    v = 0.0f;
    while (p < strTmpLen) {
        if (strTmp[p] != ' ') break;
        p = p + 1;
    }
    if (p < strTmpLen) {
        if (strTmp[p] == '-') { sign = -1; p = p + 1; }
        else if (strTmp[p] == '+') p = p + 1;
    }
    while (p < strTmpLen) {
        if (is_digit(strTmp[p]) == 0) break;
        v = v * 10.0f + (float)((int)(strTmp[p] - '0'));
        p = p + 1;
    }
    if (p < strTmpLen) {
        if (strTmp[p] == '.') {
            p = p + 1;
            frac = 0.1f;
            while (p < strTmpLen) {
                if (is_digit(strTmp[p]) == 0) break;
                v = v + frac * (float)((int)(strTmp[p] - '0'));
                frac = frac * 0.1f;
                p = p + 1;
            }
        }
    }
    if (sign < 0) v = 0.0f - v;
    return v;
}

void append_var_string_to_tmp(int idx)
{
    int i;
    int base;
    base = str_base(idx);
    i = 0;
    while (i < var_str_len_get(idx)) {
        append_str_tmp_char(pool_byte_get(base + i));
        if (running == 0) return;
        i = i + 1;
    }
}

void append_array_string_to_tmp(int arr, int lin)
{
    int i;
    int base;
    base = array_str_base(arr, lin);
    i = 0;
    while (i < array_str_len_get(arr, lin)) {
        append_str_tmp_char(pool_byte_get(base + i));
        if (running == 0) return;
        i = i + 1;
    }
}

void copy_tmp_to_string_array(int arr, int lin)
{
    int i;
    int base;
    base = array_str_base(arr, lin);
    i = 0;
    while (i < STR_MAX) {
        pool_byte_set(base + i, 0);
        i = i + 1;
    }
    i = 0;
    while (i < strTmpLen) {
        pool_byte_set(base + i, strTmp[i]);
        i = i + 1;
    }
    array_str_len_set(arr, lin, strTmpLen);
}

void copy_tmp_to_string_var(int idx)
{
    int i;
    int base;
    base = str_base(idx);
    i = 0;
    while (i < STR_MAX) {
        pool_byte_set(base + i, 0);
        i = i + 1;
    }
    i = 0;
    while (i < strTmpLen) {
        pool_byte_set(base + i, strTmp[i]);
        i = i + 1;
    }
    var_str_len_set(idx, strTmpLen);
}

void con_str_tmp()
{
    int i;
    i = 0;
    while (i < strTmpLen) {
        con_char(strTmp[i]);
        i = i + 1;
    }
}

int peek_string_expr_start()
{
    int p;
    char c;
    p = ip;
    while (p < currentEnd) {
        c = prog[p];
        if (is_space(c) == 0) break;
        p = p + 1;
    }
    if (p >= currentEnd) return 0;
    if (prog[p] == 34) return 1;
    if (scan_match_kw4_at(p, 'L','E','F','T') != 0) return 1;
    if (scan_match_kw5_at(p, 'R','I','G','H','T') != 0) return 1;
    if (scan_match_kw3_at(p, 'M','I','D') != 0) return 1;
    if (scan_match_kw3_at(p, 'C','H','R') != 0) return 1;
    if (scan_match_kw3_at(p, 'S','T','R') != 0) return 1;
    if (scan_match_kw3_at(p, 'C','W','D') != 0) return 1;
    if (scan_match_kw5_at(p, 'I','N','K','E','Y') != 0) return 1;
    if (is_ident_start(prog[p]) != 0) {
        while (p < currentEnd) {
            c = prog[p];
            if (c == '$') return 1;
            if (is_ident_char(c) == 0) return 0;
            p = p + 1;
        }
    }
    return 0;
}

int parse_string_arg_to_func()
{
    char c;
    int idx;
    int i;
    int base;
    strFuncLen = 0;
    i = 0;
    while (i < STR_MAX) { strFunc[i] = 0; i = i + 1; }
    skip_spaces();
    if (ip >= currentEnd) { fail(23); return 0; }
    if (prog[ip] == 34) {
        ip = ip + 1;
        while (ip < currentEnd) {
            c = prog[ip];
            if (c == 34) break;
            if (strFuncLen < STR_MAX - 1) {
                strFunc[strFuncLen] = c;
                strFuncLen = strFuncLen + 1;
                strFunc[strFuncLen] = 0;
            } else { fail(21); return 0; }
            ip = ip + 1;
        }
        if (ip >= currentEnd) { fail(12); return 0; }
        if (prog[ip] != 34) { fail(12); return 0; }
        ip = ip + 1;
        return 1;
    }
    if (parse_ident_to_tmp() == 0) { fail(23); return 0; }
    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] == '(') {
            idx = find_array_from_ident();
            if (idx < 0) { fail(24); return 0; }
            if (array_is_string_get(idx) == 0) { fail(22); return 0; }
            if (parse_array_indices_to_tmp() == 0) return 0;
            g_i = compute_array_linear(idx);
            if (running == 0) return 0;
            base = array_str_base(idx, g_i);
            i = 0;
            while (i < array_str_len_get(idx, g_i)) {
                strFunc[i] = pool_byte_get(base + i);
                i = i + 1;
            }
            strFuncLen = array_str_len_get(idx, g_i);
            strFunc[strFuncLen] = 0;
            return 1;
        }
    }
    idx = find_or_create_var_from_ident();
    if (running == 0) return 0;
    if (var_is_string_get(idx) == 0) { fail(22); return 0; }
    base = str_base(idx);
    i = 0;
    while (i < var_str_len_get(idx)) {
        strFunc[i] = pool_byte_get(base + i);
        i = i + 1;
    }
    strFuncLen = var_str_len_get(idx);
    strFunc[strFuncLen] = 0;
    return 1;
}

void save_str_tmp_to_save()
{
    int i;
    strSaveLen = strTmpLen;
    i = 0;
    while (i < STR_MAX) { strSave[i] = strTmp[i]; i = i + 1; }
}

void save_str_tmp_to_func()
{
    int i;
    strFuncLen = strTmpLen;
    i = 0;
    while (i < STR_MAX) { strFunc[i] = strTmp[i]; i = i + 1; }
}

void restore_str_tmp_from_save()
{
    int i;
    strTmpLen = strSaveLen;
    i = 0;
    while (i < STR_MAX) { strTmp[i] = strSave[i]; i = i + 1; }
}

void append_func_to_tmp_range(int start, int count)
{
    int i;
    i = 0;
    while (i < count) {
        append_str_tmp_char(strFunc[start + i]);
        if (running == 0) return;
        i = i + 1;
    }
}

int parse_string_atom_append()
{
    char c;
    int idx;
    int i;
    int n;
    int start;
    int count;
    int oldLen;
    int v;
    float fv;

    skip_spaces();
    if (ip >= currentEnd) { fail(23); return 0; }

    if (match_kw5('I','N','K','E','Y') != 0) {
        ip = ip + 5;
        if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces();
        if (ip < currentEnd) {
            if (prog[ip] == '(') {
                ip = ip + 1;
                skip_spaces();
                if (ip >= currentEnd) { fail(12); return 0; }
                if (prog[ip] != ')') { fail(5); return 0; }
                ip = ip + 1;
            }
        }
        v = readAnyKeyCode();
        if (v != 0) append_str_tmp_char((char)(v & 255));
        return 1;
    }

    if (prog[ip] == 34) {
        ip = ip + 1;
        while (ip < currentEnd) {
            c = prog[ip];
            if (c == 34) break;
            append_str_tmp_char(c);
            if (running == 0) return 0;
            ip = ip + 1;
        }
        if (ip >= currentEnd) { fail(12); return 0; }
        if (prog[ip] != 34) { fail(12); return 0; }
        ip = ip + 1;
        return 1;
    }

    if (match_kw4('L','E','F','T') != 0) {
        ip = ip + 4; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
        save_str_tmp_to_save(); if (parse_string_arg_to_func() == 0) return 0; restore_str_tmp_from_save();
        oldLen = strFuncLen;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ',') { fail(16); return 0; } ip = ip + 1;
        expr_stack_save(); n = parse_expr(); expr_stack_restore(); if (running == 0) return 0;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
        if (n < 0) n = 0; if (n > oldLen) n = oldLen;
        append_func_to_tmp_range(0, n);
        return 1;
    }

    if (match_kw5('R','I','G','H','T') != 0) {
        ip = ip + 5; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
        save_str_tmp_to_save(); if (parse_string_arg_to_func() == 0) return 0; restore_str_tmp_from_save();
        oldLen = strFuncLen;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ',') { fail(16); return 0; } ip = ip + 1;
        expr_stack_save(); n = parse_expr(); expr_stack_restore(); if (running == 0) return 0;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
        if (n < 0) n = 0; if (n > oldLen) n = oldLen;
        start = oldLen - n;
        append_func_to_tmp_range(start, n);
        return 1;
    }

    if (match_kw3('M','I','D') != 0) {
        ip = ip + 3; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
        save_str_tmp_to_save(); if (parse_string_arg_to_func() == 0) return 0; restore_str_tmp_from_save();
        oldLen = strFuncLen;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ',') { fail(16); return 0; } ip = ip + 1;
        expr_stack_save(); start = parse_expr(); expr_stack_restore(); if (running == 0) return 0;
        count = oldLen;
        skip_spaces(); if (ip < currentEnd) { if (prog[ip] == ',') { ip = ip + 1; expr_stack_save(); count = parse_expr(); expr_stack_restore(); if (running == 0) return 0; } }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
        start = start - 1; if (start < 0) start = 0; if (start > oldLen) start = oldLen; if (count < 0) count = 0; if (start + count > oldLen) count = oldLen - start;
        append_func_to_tmp_range(start, count);
        return 1;
    }

    if (match_kw3('C','H','R') != 0) {
        ip = ip + 3; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
        expr_stack_save(); v = parse_expr(); expr_stack_restore(); if (running == 0) return 0;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
        append_str_tmp_char((char)(v & 255));
        return 1;
    }

    if (match_kw3('C','W','D') != 0) {
        ip = ip + 3; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        append_func_to_tmp_range(0, 0);
        i = 0;
        if (currentDirLen <= 0) { append_str_tmp_char('/'); return 1; }
        while (i < currentDirLen) { append_str_tmp_char(currentDir[i]); if (running == 0) return 0; i = i + 1; }
        return 1;
    }

    if (match_kw3('S','T','R') != 0) {
        ip = ip + 3; if (ip < currentEnd) { if (prog[ip] == '$') ip = ip + 1; }
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != '(') { fail(12); return 0; } ip = ip + 1;
        expr_stack_save(); v = parse_expr(); fv = lastExprFloat; n = lastExprIsFloat; expr_stack_restore(); if (running == 0) return 0;
        skip_spaces(); if (ip >= currentEnd) { fail(12); return 0; } if (prog[ip] != ')') { fail(12); return 0; } ip = ip + 1;
        if (n != 0) append_float_to_str_tmp(fv); else append_int_to_str_tmp(v);
        return 1;
    }

    if (parse_ident_to_tmp() == 0) { fail(23); return 0; }
    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] == '(') {
            idx = find_array_from_ident();
            if (idx < 0) { fail(24); return 0; }
            if (array_is_string_get(idx) == 0) { fail(22); return 0; }
            if (parse_array_indices_to_tmp() == 0) return 0;
            g_i = compute_array_linear(idx);
            if (running == 0) return 0;
            append_array_string_to_tmp(idx, g_i);
            if (running == 0) return 0;
            return 1;
        }
    }

    idx = find_or_create_var_from_ident();
    if (running == 0) return 0;
    if (var_is_string_get(idx) == 0) { fail(22); return 0; }
    append_var_string_to_tmp(idx);
    if (running == 0) return 0;
    return 1;
}

int parse_string_expr()
{
    clear_str_tmp();
    if (parse_string_atom_append() == 0) return 0;
    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) return 1;
        if (prog[ip] != '+') return 1;
        ip = ip + 1;
        if (parse_string_atom_append() == 0) return 0;
    }
    return 0;
}

/* ------------------------------------------------------------------------- */
/* MMBasic-style SD file I/O layer                                            */
/* ------------------------------------------------------------------------- */

void file_clear_handle_path(int h)
{
    int i;
    int base;
    base = h * PATH_MAX;
    i = 0;
    while (i < PATH_MAX) { fileHandlePath[base + i] = 0; i = i + 1; }
}

void file_copy_filePath_to_handle(int h)
{
    int i;
    int base;
    base = h * PATH_MAX;
    i = 0;
    while (i < PATH_MAX) { fileHandlePath[base + i] = filePath[i]; i = i + 1; }
}

void file_copy_handle_to_filePath(int h)
{
    int i;
    int base;
    base = h * PATH_MAX;
    clear_chars(filePath, PATH_MAX);
    i = 0;
    while (i < PATH_MAX) { filePath[i] = fileHandlePath[base + i]; i = i + 1; }
}

void file_clear_path2()
{
    int i;
    i = 0;
    while (i < PATH_MAX) { filePath2[i] = 0; i = i + 1; }
    filePath2Len = 0;
}

void file_resolve_tmp_to_filePath()
{
    int i;
    int n;
    int absolute;
    clear_chars(filePath, PATH_MAX);
    filePathLen = 0;
    absolute = 0;
    if (strTmpLen > 0) {
        if (strTmp[0] == '/') absolute = 1;
        if (strTmp[0] == '\\') absolute = 1;
    }
    if (strTmpLen > 1) {
        if (strTmp[1] == ':') absolute = 1;
    }
    n = 0;
    if (absolute == 0) {
        if (currentDirLen > 0) {
            i = 0;
            while (i < currentDirLen) {
                if (n < PATH_MAX - 1) { filePath[n] = currentDir[i]; n = n + 1; }
                i = i + 1;
            }
            if (n > 0) {
                if (filePath[n - 1] != '/') {
                    if (n < PATH_MAX - 1) { filePath[n] = '/'; n = n + 1; }
                }
            }
        }
    }
    i = 0;
    while (i < strTmpLen) {
        if (n < PATH_MAX - 1) { filePath[n] = strTmp[i]; n = n + 1; }
        i = i + 1;
    }
    filePathLen = n;
}

int parse_file_path_arg()
{
    char c;
    clear_str_tmp();
    skip_spaces();
    if (ip >= currentEnd) { fail(52); return 0; }
    if (peek_string_expr_start() != 0) {
        if (parse_string_expr() == 0) return 0;
        file_resolve_tmp_to_filePath();
        return 1;
    }
    while (ip < currentEnd) {
        c = prog[ip];
        if (is_space(c) != 0) break;
        if (c == ',') break;
        if (c == ':') break;
        append_str_tmp_char(c);
        if (running == 0) return 0;
        ip = ip + 1;
    }
    if (strTmpLen <= 0) { fail(52); return 0; }
    file_resolve_tmp_to_filePath();
    return 1;
}

int parse_file_number()
{
    int n;
    skip_spaces();
    if (ip < currentEnd) { if (prog[ip] == '#') ip = ip + 1; }
    expr_stack_save();
    n = parse_expr();
    expr_stack_restore();
    if (running == 0) return 0;
    if (n < 1) { fail(50); return 0; }
    if (n > MAX_FILES) { fail(50); return 0; }
    return n - 1;
}

void file_require_statement_end()
{
    skip_spaces();
    if (ip >= currentEnd) return;
    if (prog[ip] == ':') return;
    if (prog[ip] == 39) { ip = currentEnd; return; }
    fail(17);
}

void file_input_skip_value_seps()
{
    while (g_pos < g_len) {
        if (inputLine[g_pos] == ' ') { g_pos = g_pos + 1; continue; }
        if (inputLine[g_pos] == 9) { g_pos = g_pos + 1; continue; }
        if (inputLine[g_pos] == ',') { g_pos = g_pos + 1; continue; }
        return;
    }
}

int file_input_parse_int_value()
{
    int sign;
    int value;
    int any;
    char c;
    file_input_skip_value_seps();
    inputOk = 0;
    sign = 1;
    value = 0;
    any = 0;
    if (g_pos < g_len) {
        c = inputLine[g_pos];
        if (c == '-') { sign = -1; g_pos = g_pos + 1; }
        else if (c == '+') { g_pos = g_pos + 1; }
    }
    while (g_pos < g_len) {
        c = inputLine[g_pos];
        if (c < '0') break;
        if (c > '9') break;
        any = 1;
        value = value * 10 + (int)(c - '0');
        g_pos = g_pos + 1;
    }
    if (any == 0) return 0;
    inputOk = 1;
    return value * sign;
}

void file_input_parse_string_value()
{
    char c;
    int startQuote;
    int endPos;
    file_input_skip_value_seps();
    clear_str_tmp();
    startQuote = 0;
    if (g_pos < g_len) {
        if (inputLine[g_pos] == 34) { startQuote = 1; g_pos = g_pos + 1; }
    }
    while (g_pos < g_len) {
        c = inputLine[g_pos];
        if (startQuote != 0) { if (c == 34) break; }
        else { if (c == ',') break; }
        append_str_tmp_char(c);
        if (running == 0) return;
        g_pos = g_pos + 1;
    }
    if (startQuote != 0) {
        if (g_pos < g_len) { if (inputLine[g_pos] == 34) g_pos = g_pos + 1; }
    } else {
        endPos = strTmpLen - 1;
        while (endPos >= 0) {
            c = strTmp[endPos];
            if (c != ' ') break;
            strTmp[endPos] = 0;
            strTmpLen = strTmpLen - 1;
            endPos = endPos - 1;
        }
    }
    inputOk = 1;
}

void file_clear_buffer(int h)
{
    int i;
    i = 0;
    while (i < FILE_BUF_MAX) {
        if (h == 0) fileBuf0[i] = 0;
        else if (h == 1) fileBuf1[i] = 0;
        else if (h == 2) fileBuf2[i] = 0;
        else fileBuf3[i] = 0;
        i = i + 1;
    }
    fileBufLen[h] = 0;
}

char file_get_buf_char(int h, int pos)
{
    if (pos < 0) return 0;
    if (pos >= FILE_BUF_MAX) return 0;
    if (h == 0) return fileBuf0[pos];
    if (h == 1) return fileBuf1[pos];
    if (h == 2) return fileBuf2[pos];
    return fileBuf3[pos];
}

void file_set_buf_char(int h, int pos, char c)
{
    if (pos < 0) return;
    if (pos >= FILE_BUF_MAX) return;
    if (h == 0) fileBuf0[pos] = c;
    else if (h == 1) fileBuf1[pos] = c;
    else if (h == 2) fileBuf2[pos] = c;
    else fileBuf3[pos] = c;
}

void file_copy_to_scratch_from_handle(int h, int srcPos, int count)
{
    int i;
    char c;
    i = 0;
    while (i < count) {
        c = file_get_buf_char(h, srcPos + i);
        if (count == 128) fileScratch128[i] = c;
        else if (count == 64) fileScratch64[i] = c;
        else if (count == 32) fileScratch32[i] = c;
        else if (count == 16) fileScratch16[i] = c;
        else if (count == 8) fileScratch8[i] = c;
        else if (count == 4) fileScratch4[i] = c;
        else if (count == 2) fileScratch2[i] = c;
        else fileScratch1[i] = c;
        i = i + 1;
    }
}

void file_write_scratch_size(int size, uint offset)
{
    if (size == 128) sdFileWriteBytes(filePath, fileScratch128, offset, (uint)128);
    else if (size == 64) sdFileWriteBytes(filePath, fileScratch64, offset, (uint)64);
    else if (size == 32) sdFileWriteBytes(filePath, fileScratch32, offset, (uint)32);
    else if (size == 16) sdFileWriteBytes(filePath, fileScratch16, offset, (uint)16);
    else if (size == 8) sdFileWriteBytes(filePath, fileScratch8, offset, (uint)8);
    else if (size == 4) sdFileWriteBytes(filePath, fileScratch4, offset, (uint)4);
    else if (size == 2) sdFileWriteBytes(filePath, fileScratch2, offset, (uint)2);
    else if (size == 1) sdFileWriteBytes(filePath, fileScratch1, offset, (uint)1);
}

void file_write_partial_from_handle(int h, int len, uint offset)
{
    if (len <= 0) return;
    if (len > FILE_BUF_MAX) len = FILE_BUF_MAX;
    if (h == 0) sdFileWriteBytes(filePath, fileBuf0, offset, (uint)len);
    else if (h == 1) sdFileWriteBytes(filePath, fileBuf1, offset, (uint)len);
    else if (h == 2) sdFileWriteBytes(filePath, fileBuf2, offset, (uint)len);
    else sdFileWriteBytes(filePath, fileBuf3, offset, (uint)len);
}

void file_write_full_handle_chunk(int h, uint offset)
{
    if (h == 0) sdFileWriteBytes(filePath, fileBuf0, offset, (uint)FILE_BUF_MAX);
    else if (h == 1) sdFileWriteBytes(filePath, fileBuf1, offset, (uint)FILE_BUF_MAX);
    else if (h == 2) sdFileWriteBytes(filePath, fileBuf2, offset, (uint)FILE_BUF_MAX);
    else sdFileWriteBytes(filePath, fileBuf3, offset, (uint)FILE_BUF_MAX);
}

void file_flush_write_chunk(int h)
{
    int len;
    if (fileDirty[h] == 0) return;
    len = fileBufLen[h];
    if (len <= 0) { fileDirty[h] = 0; return; }
    file_copy_handle_to_filePath(h);
    if (len >= FILE_BUF_MAX) file_write_full_handle_chunk(h, (uint)fileBufStart[h]);
    else file_write_partial_from_handle(h, len, (uint)fileBufStart[h]);
    fileDirty[h] = 0;
    fileBufLen[h] = 0;
    fileBufStart[h] = filePos[h];
    file_clear_buffer(h);
}

void file_refill_read_chunk(int h)
{
    uint n;
    file_copy_handle_to_filePath(h);
    file_clear_buffer(h);
    fileBufStart[h] = filePos[h];
    if (h == 0) n = sdFileReadBytes(filePath, fileBuf0, (uint)fileBufStart[h], (uint)FILE_BUF_MAX);
    else if (h == 1) n = sdFileReadBytes(filePath, fileBuf1, (uint)fileBufStart[h], (uint)FILE_BUF_MAX);
    else if (h == 2) n = sdFileReadBytes(filePath, fileBuf2, (uint)fileBufStart[h], (uint)FILE_BUF_MAX);
    else n = sdFileReadBytes(filePath, fileBuf3, (uint)fileBufStart[h], (uint)FILE_BUF_MAX);
    fileBufLen[h] = (int)n;
    if (fileBufLen[h] > FILE_BUF_MAX) fileBufLen[h] = FILE_BUF_MAX;
    if (fileBufStart[h] + fileBufLen[h] > fileSizeUsed[h]) fileBufLen[h] = fileSizeUsed[h] - fileBufStart[h];
    if (fileBufLen[h] < 0) fileBufLen[h] = 0;
}

char file_read_char_stream(int h)
{
    int localPos;
    char c;
    if (filePos[h] >= fileSizeUsed[h]) return 0;
    localPos = filePos[h] - fileBufStart[h];
    if (localPos < 0 || localPos >= fileBufLen[h]) {
        file_refill_read_chunk(h);
        localPos = filePos[h] - fileBufStart[h];
    }
    if (localPos < 0) return 0;
    if (localPos >= fileBufLen[h]) return 0;
    c = file_get_buf_char(h, localPos);
    filePos[h] = filePos[h] + 1;
    return c;
}

void close_one_file(int h)
{
    if (h < 0) return;
    if (h >= MAX_FILES) return;
    if (fileOpen[h] == 0) return;
    if (fileDirty[h] != 0) file_flush_write_chunk(h);
    fileOpen[h] = 0;
    fileMode[h] = 0;
    filePos[h] = 0;
    fileSizeUsed[h] = 0;
    fileDirty[h] = 0;
    fileBufStart[h] = 0;
    fileBufLen[h] = 0;
    file_clear_handle_path(h);
}

void init_file_handles()
{
    int h;
    h = 0;
    while (h < MAX_FILES) {
        fileOpen[h] = 0;
        fileMode[h] = 0;
        filePos[h] = 0;
        fileSizeUsed[h] = 0;
        fileDirty[h] = 0;
        fileBufStart[h] = 0;
        fileBufLen[h] = 0;
        file_clear_handle_path(h);
        h = h + 1;
    }
    clear_current_dir();
}

void close_all_files()
{
    int h;
    h = 0;
    while (h < MAX_FILES) { close_one_file(h); h = h + 1; }
}

void file_append_char(int h, char c)
{
    int localPos;
    if (fileOpen[h] == 0) { fail(51); return; }
    if (fileMode[h] == 1) { fail(54); return; }

    if (fileBufLen[h] <= 0) {
        fileBufStart[h] = filePos[h];
        file_clear_buffer(h);
    }

    localPos = filePos[h] - fileBufStart[h];
    if (localPos < 0 || localPos >= FILE_BUF_MAX) {
        file_flush_write_chunk(h);
        fileBufStart[h] = filePos[h];
        file_clear_buffer(h);
        localPos = 0;
    }

    file_set_buf_char(h, localPos, c);
    filePos[h] = filePos[h] + 1;
    if (localPos + 1 > fileBufLen[h]) fileBufLen[h] = localPos + 1;
    if (filePos[h] > fileSizeUsed[h]) fileSizeUsed[h] = filePos[h];
    fileDirty[h] = 1;
    if (fileBufLen[h] >= FILE_BUF_MAX) file_flush_write_chunk(h);
}

void file_append_tmp(int h)
{
    int i;
    i = 0;
    while (i < strTmpLen) { file_append_char(h, strTmp[i]); if (running == 0) return; i = i + 1; }
}

void file_append_int_value(int h, int v)
{
    clear_str_tmp();
    append_int_to_str_tmp(v);
    if (running == 0) return;
    file_append_tmp(h);
}

void file_append_float_value(int h, float f)
{
    clear_str_tmp();
    append_float_to_str_tmp(f);
    if (running == 0) return;
    file_append_tmp(h);
}

void exec_open()
{
    int h;
    int mode;
    ip = ip + 4;
    if (parse_file_path_arg() == 0) return;
    skip_spaces();
    mode = 1;
    if (match_kw3('F','O','R') != 0) {
        ip = ip + 3;
        skip_spaces();
        if (match_kw5('I','N','P','U','T') != 0) { mode = 1; ip = ip + 5; }
        else if (match_kw6('O','U','T','P','U','T') != 0) { mode = 2; ip = ip + 6; }
        else if (match_kw6('A','P','P','E','N','D') != 0) { mode = 3; ip = ip + 6; }
        else { fail(56); return; }
    }
    skip_spaces();
    if (match_kw2('A','S') == 0) { fail(56); return; }
    ip = ip + 2;
    h = parse_file_number();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    if (fileOpen[h] != 0) close_one_file(h);
    file_copy_filePath_to_handle(h);
    fileOpen[h] = 1;
    fileMode[h] = mode;
    fileDirty[h] = 0;
    filePos[h] = 0;
    fileSizeUsed[h] = 0;
    fileBufStart[h] = 0;
    fileBufLen[h] = 0;
    file_clear_buffer(h);
    if (mode == 1) {
        if (sdFileExists(filePath) == (uint)0) { fileOpen[h] = 0; fail(57); return; }
        fileSizeUsed[h] = (int)sdFileSize(filePath);
        filePos[h] = 0;
    } else if (mode == 2) {
        sdFileDelete(filePath);
        if (sdFileMake(filePath) == (uint)0) { fileOpen[h] = 0; fail(53); return; }
        fileSizeUsed[h] = 0;
        filePos[h] = 0;
        fileDirty[h] = 0;
    } else {
        if (sdFileExists(filePath) != (uint)0) fileSizeUsed[h] = (int)sdFileSize(filePath);
        else {
            if (sdFileMake(filePath) == (uint)0) { fileOpen[h] = 0; fail(53); return; }
            fileSizeUsed[h] = 0;
        }
        filePos[h] = fileSizeUsed[h];
        fileDirty[h] = 0;
    }
}

void exec_close()
{
    int h;
    ip = ip + 5;
    skip_spaces();
    if (ip >= currentEnd) { close_all_files(); return; }
    if (prog[ip] == ':') { close_all_files(); return; }
    while (running != 0) {
        h = parse_file_number();
        if (running == 0) return;
        close_one_file(h);
        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }
    file_require_statement_end();
}

void exec_file_print_after_print()
{
    int h;
    int suppressNl;
    int v;
    char c;
    skip_spaces();
    h = parse_file_number();
    if (running == 0) return;
    if (fileOpen[h] == 0) { fail(51); return; }
    if (fileMode[h] == 1) { fail(54); return; }
    skip_spaces();
    if (ip < currentEnd) { if (prog[ip] == ',' || prog[ip] == ';') ip = ip + 1; }
    suppressNl = 0;
    skip_spaces();
    if (ip >= currentEnd) { file_append_char(h, 13); file_append_char(h, 10); return; }
    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (peek_string_expr_start() != 0) { if (parse_string_expr() == 0) return; file_append_tmp(h); }
        else { v = parse_expr(); if (running == 0) return; if (lastExprIsFloat != 0) file_append_float_value(h, lastExprFloat); else file_append_int_value(h, v); }
        suppressNl = 0;
        skip_spaces();
        if (ip >= currentEnd) break;
        c = prog[ip];
        if (c == ';') { suppressNl = 1; ip = ip + 1; }
        else if (c == ',') { file_append_char(h, ' '); ip = ip + 1; suppressNl = 0; }
        else break;
    }
    if (suppressNl == 0) { file_append_char(h, 13); file_append_char(h, 10); }
    file_require_statement_end();
}

int file_read_line_to_input(int h)
{
    char c;
    int len;
    len = 0;
    clear_chars(inputLine, LINE_MAX);
    if (fileOpen[h] == 0) { fail(51); return 0; }
    if (fileMode[h] != 1) { fail(58); return 0; }
    while (filePos[h] < fileSizeUsed[h]) {
        c = file_read_char_stream(h);
        if (c == 0) break;
        if (c == 10) break;
        if (c == 13) {
            if (filePos[h] < fileSizeUsed[h]) {
                c = file_read_char_stream(h);
                if (c != 10) filePos[h] = filePos[h] - 1;
            }
            break;
        }
        if (len < LINE_MAX - 1) { inputLine[len] = c; len = len + 1; }
    }
    g_len = len;
    return 1;
}

void exec_input_file_after_input()
{
    int h;
    int idx;
    int value;
    ip = ip + 5;
    skip_spaces();
    h = parse_file_number();
    if (running == 0) return;
    if (file_read_line_to_input(h) == 0) return;
    skip_spaces();
    if (ip < currentEnd) { if (prog[ip] == ',' || prog[ip] == ';') ip = ip + 1; }
    g_pos = 0;
    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) break;
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        idx = find_or_create_var_from_ident();
        if (running == 0) return;
        if (var_is_string_get(idx) != 0) { file_input_parse_string_value(); if (running == 0) return; if (inputOk == 0) { fail(18); return; } copy_tmp_to_string_var(idx); }
        else { value = file_input_parse_int_value(); if (inputOk == 0) { fail(18); return; } var_int_set(idx, value); var_float_set(idx, (float)value); var_is_float_set(idx, 0); }
        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }
    file_require_statement_end();
}

void exec_line_input()
{
    int h;
    int idx;
    ip = ip + 4;
    skip_spaces();
    if (match_kw5('I','N','P','U','T') == 0) { fail(5); return; }
    ip = ip + 5;
    skip_spaces();
    h = -1;
    if (ip < currentEnd) {
        if (prog[ip] == '#') {
            h = parse_file_number();
            if (running == 0) return;
            skip_spaces();
            if (ip < currentEnd) { if (prog[ip] == ',' || prog[ip] == ';') ip = ip + 1; }
        }
    }
    if (parse_ident_to_tmp() == 0) { fail(5); return; }
    idx = find_or_create_var_from_ident();
    if (running == 0) return;
    if (var_is_string_get(idx) == 0) { fail(22); return; }
    if (h >= 0) {
        if (file_read_line_to_input(h) == 0) return;
        clear_str_tmp();
        g_pos = 0;
        while (g_pos < g_len) { append_str_tmp_char(inputLine[g_pos]); if (running == 0) return; g_pos = g_pos + 1; }
        copy_tmp_to_string_var(idx);
    } else {
        flushScreen();
        read_line_editor();
        clear_str_tmp();
        g_pos = 0;
        while (g_pos < g_len) { append_str_tmp_char(inputLine[g_pos]); if (running == 0) return; g_pos = g_pos + 1; }
        copy_tmp_to_string_var(idx);
    }
    file_require_statement_end();
}

void exec_kill()
{
    ip = ip + 4;
    if (parse_file_path_arg() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    if (sdFileDelete(filePath) == (uint)0) { fail(53); return; }
}

void exec_mkdir()
{
    ip = ip + 5;
    if (parse_file_path_arg() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    if (sdDirMake(filePath) == (uint)0) { fail(53); return; }
}

void exec_rmdir()
{
    ip = ip + 5;
    if (parse_file_path_arg() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    if (sdDirDelete(filePath) == (uint)0) { fail(53); return; }
}

void exec_chdir()
{
    int i;
    ip = ip + 5;
    if (parse_file_path_arg() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    i = 0;
    while (i < PATH_MAX) { currentDir[i] = 0; i = i + 1; }
    i = 0;
    while (i < PATH_MAX - 1) {
        currentDir[i] = filePath[i];
        if (filePath[i] == 0) break;
        i = i + 1;
    }
    currentDirLen = i;
}

void exec_files()
{
    int status;
    int idx;
    int nameLen;
    int entryType;
    ip = ip + 5;
    skip_spaces();
    if (ip >= currentEnd || prog[ip] == ':') {
        clear_chars(filePath, PATH_MAX);
        if (currentDirLen > 0) { idx = 0; while (idx < currentDirLen) { filePath[idx] = currentDir[idx]; idx = idx + 1; } }
    } else {
        if (parse_file_path_arg() == 0) return;
    }
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    idx = 0;
    while (idx < 256) {
        status = (int)sdDirEntry(filePath, idx, dirEntryName, nameLen, entryType);
        if (status == 0) break;
        con_str(dirEntryName, PATH_MAX);
        if (entryType != 0) con_char('/');
        con_nl();
        idx = idx + 1;
    }
}

int file_paths_equal()
{
    int i;
    i = 0;
    while (i < PATH_MAX) {
        if (filePath[i] != filePath2[i]) return 0;
        if (filePath[i] == 0) return 1;
        i = i + 1;
    }
    return 1;
}

void exec_name_file()
{
    int i;
    ip = ip + 4;
    if (parse_file_path_arg() == 0) return;
    i = 0;
    while (i < PATH_MAX) { filePath2[i] = filePath[i]; i = i + 1; }
    skip_spaces();
    if (match_kw2('A','S') == 0) { fail(56); return; }
    ip = ip + 2;
    if (parse_file_path_arg() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (sd_mount_ok() == 0) { fail(53); return; }
    if (file_paths_equal() != 0) return;
    if (sdFileExists(filePath2) == (uint)0) { fail(57); return; }
    sdFileDelete(filePath);
    if (sdFileMake(filePath) == (uint)0) { fail(53); return; }
    g_i = (int)sdFileSize(filePath2);
    i = 0;
    while (i < g_i) {
        g_j = g_i - i;
        if (g_j > FILE_BUF_MAX) g_j = FILE_BUF_MAX;
        savebuf_clear();
        g_k = (int)sdFileReadBytes(filePath2, saveLoadBuf, (uint)i, (uint)g_j);
        if (g_k <= 0) { fail(53); return; }
        if ((int)sdFileWriteBytes(filePath, saveLoadBuf, (uint)i, (uint)g_k) < g_k) { fail(53); return; }
        i = i + g_k;
    }
    if (sdFileDelete(filePath2) == (uint)0) { fail(53); return; }
}

int line_starts_for(int idx)
{
    int saveIp;
    int saveEnd;
    int ok;

    load_line_to_prog(idx);
    saveIp = ip;
    saveEnd = currentEnd;
    skip_spaces();
    while (skip_label_statement_here() != 0) { skip_spaces(); }
    ok = match_kw3('F','O','R');
    ip = saveIp;
    currentEnd = saveEnd;
    return ok;
}

int line_starts_next(int idx)
{
    int saveIp;
    int saveEnd;
    int ok;

    load_line_to_prog(idx);
    saveIp = ip;
    saveEnd = currentEnd;
    skip_spaces();
    while (skip_label_statement_here() != 0) { skip_spaces(); }
    ok = match_kw4('N','E','X','T');
    ip = saveIp;
    currentEnd = saveEnd;
    return ok;
}

int skip_after_matching_next(int startIdx)
{
    int i;
    int depth;

    i = startIdx;
    depth = 0;
    while (i < lineCount) {
        if (line_starts_for(i) != 0) depth = depth + 1;
        else if (line_starts_next(i) != 0) {
            if (depth == 0) return i + 1;
            depth = depth - 1;
        }
        i = i + 1;
    }
    return lineCount;
}

void require_statement_end()
{
    skip_spaces();
    if (ip >= currentEnd) return;
    if (prog[ip] == ':') return;
    if (prog[ip] == 39) { ip = currentEnd; return; }
    fail(17);
}

void exec_print()
{
    int suppressNl;
    int v;
    char c;

    ip = ip + 5;
    suppressNl = 0;
    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] == '#') { exec_file_print_after_print(); return; }
    }

    if (ip >= currentEnd) {
        con_nl();
        return;
    }

    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) break;

        if (peek_string_expr_start() != 0) {
            if (parse_string_expr() == 0) return;
            con_str_tmp();
        } else {
            v = parse_expr();
            if (running == 0) return;
            if (lastExprIsFloat != 0) con_float(lastExprFloat);
            else con_int(v);
        }

        suppressNl = 0;
        skip_spaces();
        if (ip >= currentEnd) break;

        c = prog[ip];
        if (c == ';') {
            suppressNl = 1;
            ip = ip + 1;
        } else if (c == ',') {
            con_char(' ');
            ip = ip + 1;
            suppressNl = 0;
        } else break;
    }

    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] != ':') {
            if (prog[ip] == 39) ip = currentEnd;
            else { fail(17); return; }
        }
    }
    if (suppressNl == 0) con_nl();
}

void exec_assignment(int hasLet)
{
    int idx;
    int value;

    if (hasLet != 0) ip = ip + 3;
    if (parse_ident_to_tmp() == 0) { fail(5); return; }
    skip_spaces();

    if (ip < currentEnd) {
        if (prog[ip] == '(') {
            idx = find_array_from_ident();
            if (idx < 0) { fail(24); return; }
            if (parse_array_indices_to_tmp() == 0) return;
            g_i = compute_array_linear(idx);
            if (running == 0) return;
            skip_spaces();
            if (ip >= currentEnd) { fail(5); return; }
            if (prog[ip] != '=') { fail(5); return; }
            ip = ip + 1;
            if (array_is_string_get(idx) != 0) {
                if (parse_string_expr() == 0) return;
                file_require_statement_end();
                if (running == 0) return;
                copy_tmp_to_string_array(idx, g_i);
                return;
            }
            value = parse_expr();
            if (running == 0) return;
            file_require_statement_end();
            if (running == 0) return;
            array_num_int_set(idx, g_i, value);
            array_num_float_set(idx, g_i, lastExprFloat);
            array_num_is_float_set(idx, g_i, lastExprIsFloat);
            return;
        }
    }

    idx = find_or_create_var_from_ident();
    if (running == 0) return;

    skip_spaces();
    if (ip >= currentEnd) { fail(5); return; }
    if (prog[ip] != '=') { fail(5); return; }
    ip = ip + 1;

    if (var_is_string_get(idx) != 0) {
        if (parse_string_expr() == 0) return;
        file_require_statement_end();
        if (running == 0) return;
        copy_tmp_to_string_var(idx);
        return;
    }

    value = parse_expr();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    var_int_set(idx, value);
    var_float_set(idx, lastExprFloat);
    var_is_float_set(idx, lastExprIsFloat);
}

void exec_dim()
{
    int arr;
    int dimCount;
    int total;
    int limit;
    int dimBase;
    int i;

    ip = ip + 3;

    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) { fail(5); return; }
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        if (find_array_from_ident() >= 0) { fail(25); return; }
        save_ident_for_dim();

        skip_spaces();
        if (ip >= currentEnd) { fail(12); return; }
        if (prog[ip] != '(') { fail(12); return; }
        ip = ip + 1;

        dimCount = 0;
        total = 1;
        while (running != 0) {
            if (dimCount >= ARRAY_DIMS_MAX) { fail(28); return; }
            limit = parse_expr();
            if (running == 0) return;
            if (limit < 0) { fail(27); return; }
            arrayIdxTmp[dimCount] = limit + 1;
            total = total * (limit + 1);
            dimCount = dimCount + 1;
            skip_spaces();
            if (ip >= currentEnd) { fail(12); return; }
            if (prog[ip] == ',') {
                ip = ip + 1;
                continue;
            }
            if (prog[ip] == ')') {
                ip = ip + 1;
                break;
            }
            fail(12);
            return;
        }

        if (total <= 0) { fail(27); return; }
        restore_ident_for_dim();
        if (pool_alloc_array_record(identIsString, total) == 0) { fail(29); return; }
        arr = arrayCount;
        array_used_set(arr, 1);
        array_is_string_set(arr, identIsString);
        array_dims_set(arr, dimCount);
        array_total_set(arr, total);
        copy_ident_to_array(arr);
        i = 0;
        while (i < ARRAY_DIMS_MAX) {
            if (i < dimCount) array_dim_size_set(arr, i, arrayIdxTmp[i]);
            else array_dim_size_set(arr, i, 0);
            i = i + 1;
        }

        if (identIsString != 0) {
            i = 0;
            while (i < total) {
                array_str_len_set(arr, i, 0);
                i = i + 1;
            }
            arrayStrNext = arrayStrNext + total;
        } else {
            i = 0;
            while (i < total) {
                array_num_int_set(arr, i, 0);
                array_num_float_set(arr, i, 0.0f);
                array_num_is_float_set(arr, i, 0);
                i = i + 1;
            }
            arrayNumNext = arrayNumNext + total;
        }

        arrayCount = arrayCount + 1;
        skip_spaces();
        if (ip >= currentEnd) return;
        if (prog[ip] == ':') return;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }
}

void save_local_var_if_needed(int idx)
{
    int i;
    int base;
    int saveBase;
    int mark;
    if (bcRunning != 0) {
        if (bcGosubSp <= 0) mark = 0;
        else mark = localMarkStack[bcGosubSp - 1];
    } else {
        if (gosubSp <= 0) mark = 0;
        else mark = localMarkStack[gosubSp - 1];
    }
    i = mark;
    while (i < localTop) {
        if (localVar[i] == idx) return;
        i = i + 1;
    }
    if (localTop >= MAX_LOCAL) { fail(49); return; }
    localVar[localTop] = idx;
    localWasUsed[localTop] = var_used_get(idx);
    localWasString[localTop] = var_is_string_get(idx);
    localWasFloat[localTop] = var_is_float_get(idx);
    localIntSave[localTop] = var_int_get(idx);
    localFloatSave[localTop] = var_float_get(idx);
    localStrLenSave[localTop] = var_str_len_get(idx);
    base = str_base(idx);
    saveBase = localTop * STR_MAX;
    i = 0;
    while (i < STR_MAX) { localStrSave[saveBase + i] = pool_byte_get(base + i); i = i + 1; }
    localTop = localTop + 1;
}

void restore_locals_to(int mark)
{
    int idx;
    int base;
    int saveBase;
    int i;
    while (localTop > mark) {
        localTop = localTop - 1;
        idx = localVar[localTop];
        var_used_set(idx, localWasUsed[localTop]);
        var_is_string_set(idx, localWasString[localTop]);
        var_is_float_set(idx, localWasFloat[localTop]);
        var_int_set(idx, localIntSave[localTop]);
        var_float_set(idx, localFloatSave[localTop]);
        var_str_len_set(idx, localStrLenSave[localTop]);
        base = str_base(idx);
        saveBase = localTop * STR_MAX;
        i = 0;
        while (i < STR_MAX) { pool_byte_set(base + i, localStrSave[saveBase + i]); i = i + 1; }
    }
}

int parse_jump_target()
{
    int target;
    int found;

    skip_spaces();
    jumpTargetLine = -1;
    jumpTargetIp = 0;

    if (ip >= currentEnd) { fail(4); return 0; }

    if (is_digit(prog[ip]) != 0) {
        target = parse_uint_lit();
        found = find_line(target);
        if (found < 0) { fail(4); return 0; }
        jumpTargetLine = found;
        jumpTargetIp = 0;
        return 1;
    }

    if (parse_ident_to_tmp() == 0) { fail(4); return 0; }
    found = find_label_from_ident();
    if (found < 0) { fail(4); return 0; }
    jumpTargetLine = labelLine[found];
    jumpTargetIp = labelIp[found];
    return 1;
}

void exec_goto()
{
    ip = ip + 4;
    if (parse_jump_target() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_gosub()
{
    ip = ip + 5;
    if (parse_jump_target() == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (gosubSp >= MAX_GOSUB) { fail(30); return; }
    localMarkStack[gosubSp] = localTop;
    gosubStack[gosubSp] = currentPc;
    gosubIpStack[gosubSp] = ip;
    gosubSp = gosubSp + 1;
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_return()
{
    ip = ip + 6;
    file_require_statement_end();
    if (running == 0) return;
    if (gosubSp <= 0) { fail(31); return; }
    gosubSp = gosubSp - 1;
    restore_locals_to(localMarkStack[gosubSp]);
    nextPc = gosubStack[gosubSp];
    nextIp = gosubIpStack[gosubSp];
    flowChanged = 1;
}

void exec_if()
{
    int cond;
    int blockIf;

    ip = ip + 2;
    cond = parse_condition();
    if (running == 0) return;
    skip_spaces();
    if (match_kw4('T','H','E','N') == 0) { fail(15); return; }
    ip = ip + 4;
    skip_spaces();

    blockIf = 0;
    if (ip >= currentEnd) blockIf = 1;
    else if (prog[ip] == ':') blockIf = 1;
    else if (prog[ip] == 39) blockIf = 1;

    if (blockIf != 0) {
        file_require_statement_end();
        if (running == 0) return;
        if (cond == 0) {
            if (find_else_or_endif_after(currentPc, ip, 1) == 0) { fail(36); return; }
            nextPc = jumpTargetLine;
            nextIp = jumpTargetIp;
            flowChanged = 1;
        }
        return;
    }

    if (cond != 0) {
        if (parse_jump_target() == 0) return;
        file_require_statement_end();
        if (running == 0) return;
        nextPc = jumpTargetLine;
        nextIp = jumpTargetIp;
        flowChanged = 1;
    } else {
        skip_to_next_statement_colon();
    }
}

void exec_else()
{
    ip = ip + 4;
    file_require_statement_end();
    if (running == 0) return;
    if (find_else_or_endif_after(currentPc, ip, 0) == 0) { fail(36); return; }
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_endif()
{
    ip = ip + 5;
    file_require_statement_end();
}

void exec_do()
{
    int doStartIp;
    int cond;
    int mode;

    doStartIp = ip;
    ip = ip + 2;
    skip_spaces();
    mode = 0;
    cond = 1;

    if (match_kw5('W','H','I','L','E') != 0) {
        mode = 1;
        ip = ip + 5;
        cond = parse_condition();
        if (running == 0) return;
    } else if (match_kw5('U','N','T','I','L') != 0) {
        mode = 2;
        ip = ip + 5;
        cond = parse_condition();
        if (running == 0) return;
    }

    file_require_statement_end();
    if (running == 0) return;

    if (mode == 1) {
        if (cond == 0) {
            if (do_top_is_current(currentPc, doStartIp) != 0) doSp = doSp - 1;
            if (find_loop_after(currentPc, ip) == 0) { fail(37); return; }
            nextPc = jumpTargetLine;
            nextIp = jumpTargetIp;
            flowChanged = 1;
            return;
        }
    }
    if (mode == 2) {
        if (cond != 0) {
            if (do_top_is_current(currentPc, doStartIp) != 0) doSp = doSp - 1;
            if (find_loop_after(currentPc, ip) == 0) { fail(37); return; }
            nextPc = jumpTargetLine;
            nextIp = jumpTargetIp;
            flowChanged = 1;
            return;
        }
    }

    if (do_top_is_current(currentPc, doStartIp) == 0) {
        if (doSp >= MAX_DO) { fail(35); return; }
        doLineStack[doSp] = currentPc;
        doIpStack[doSp] = doStartIp;
        doSp = doSp + 1;
    }
}

void exec_loop()
{
    int jumpBack;
    int cond;

    ip = ip + 4;
    skip_spaces();
    jumpBack = 1;

    if (match_kw5('W','H','I','L','E') != 0) {
        ip = ip + 5;
        cond = parse_condition();
        if (running == 0) return;
        if (cond == 0) jumpBack = 0;
    } else if (match_kw5('U','N','T','I','L') != 0) {
        ip = ip + 5;
        cond = parse_condition();
        if (running == 0) return;
        if (cond != 0) jumpBack = 0;
    }

    file_require_statement_end();
    if (running == 0) return;
    if (doSp <= 0) { fail(34); return; }

    if (jumpBack != 0) {
        nextPc = doLineStack[doSp - 1];
        nextIp = doIpStack[doSp - 1];
        flowChanged = 1;
        return;
    }

    doSp = doSp - 1;
}

void exec_while()
{
    int startIp;
    int cond;

    startIp = ip;
    ip = ip + 5;
    cond = parse_condition();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    if (cond == 0) {
        if (while_top_is_current(currentPc, startIp) != 0) whileSp = whileSp - 1;
        if (find_wend_after(currentPc, ip) == 0) { fail(38); return; }
        nextPc = jumpTargetLine;
        nextIp = jumpTargetIp;
        flowChanged = 1;
        return;
    }

    if (while_top_is_current(currentPc, startIp) == 0) {
        if (whileSp >= MAX_WHILE) { fail(39); return; }
        whileLineStack[whileSp] = currentPc;
        whileIpStack[whileSp] = startIp;
        whileSp = whileSp + 1;
    }
}

void exec_wend()
{
    ip = ip + 4;
    file_require_statement_end();
    if (running == 0) return;
    if (whileSp <= 0) { fail(40); return; }
    nextPc = whileLineStack[whileSp - 1];
    nextIp = whileIpStack[whileSp - 1];
    flowChanged = 1;
}

void exec_select()
{
    int sel;

    ip = ip + 6;
    skip_spaces();
    if (match_kw4('C','A','S','E') == 0) { fail(41); return; }
    ip = ip + 4;
    sel = parse_expr();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    if (find_matching_case_after(currentPc, ip, sel) == 0) { fail(42); return; }
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_case()
{
    ip = ip + 4;
    if (find_endselect_after(currentPc, ip) == 0) { fail(42); return; }
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_endselect()
{
    ip = ip + 3;
    skip_spaces();
    if (match_kw6('S','E','L','E','C','T') == 0) { fail(41); return; }
    ip = ip + 6;
    file_require_statement_end();
}

void exec_for()
{
    int idx;
    int startVal;
    int endVal;
    int stepVal;
    int skipTo;

    ip = ip + 3;
    if (parse_ident_to_tmp() == 0) { fail(5); return; }
    idx = find_or_create_var_from_ident();
    if (running == 0) return;

    skip_spaces();
    if (ip >= currentEnd) { fail(5); return; }
    if (prog[ip] != '=') { fail(5); return; }
    ip = ip + 1;

    startVal = parse_expr();
    if (running == 0) return;
    skip_spaces();
    if (match_kw2('T','O') == 0) { fail(13); return; }
    ip = ip + 2;
    endVal = parse_expr();
    if (running == 0) return;
    stepVal = 1;
    skip_spaces();
    if (match_kw4('S','T','E','P') != 0) {
        ip = ip + 4;
        stepVal = parse_expr();
        if (running == 0) return;
    }
    if (stepVal == 0) { fail(14); return; }

    var_int_set(idx, startVal);
    var_float_set(idx, (float)startVal);
    var_is_float_set(idx, 0);

    if (stepVal > 0) {
        if (startVal > endVal) {
            skipTo = skip_after_matching_next(currentPc + 1);
            nextPc = skipTo;
            nextIp = 0;
            flowChanged = 1;
            return;
        }
    } else {
        if (startVal < endVal) {
            skipTo = skip_after_matching_next(currentPc + 1);
            nextPc = skipTo;
            nextIp = 0;
            flowChanged = 1;
            return;
        }
    }

    if (forSp >= MAX_FOR) { fail(9); return; }
    file_require_statement_end();
    if (running == 0) return;
    forVar[forSp] = idx;
    forEnd[forSp] = endVal;
    forStep[forSp] = stepVal;
    forResumeLine[forSp] = currentPc;
    forResumeIp[forSp] = ip;
    forSp = forSp + 1;
}

void exec_next()
{
    int idx;
    int top;
    int v;
    int stepVal;
    int endVal;
    int saveIp;

    ip = ip + 4;
    if (forSp <= 0) { fail(10); return; }

    top = forSp - 1;
    idx = forVar[top];

    skip_spaces();
    if (ip < currentEnd) {
        saveIp = ip;
        if (parse_ident_to_tmp() != 0) {
            if (find_or_create_var_from_ident() != idx) { fail(10); return; }
        } else {
            ip = saveIp;
        }
    }

    file_require_statement_end();
    if (running == 0) return;

    stepVal = forStep[top];
    endVal = forEnd[top];
    v = var_int_get(idx) + stepVal;
    var_int_set(idx, v);
    var_float_set(idx, (float)v);
    var_is_float_set(idx, 0);

    if (stepVal > 0) {
        if (v <= endVal) {
            nextPc = forResumeLine[top];
            nextIp = forResumeIp[top];
            flowChanged = 1;
            return;
        }
    } else {
        if (v >= endVal) {
            nextPc = forResumeLine[top];
            nextIp = forResumeIp[top];
            flowChanged = 1;
            return;
        }
    }

    forSp = forSp - 1;
}

int expect_comma()
{
    skip_spaces();
    if (ip >= currentEnd) { fail(16); return 0; }
    if (prog[ip] != ',') { fail(16); return 0; }
    ip = ip + 1;
    return 1;
}

int next_gfx_arg()
{
    int v;
    if (expect_comma() == 0) return 0;
    v = parse_expr();
    return v;
}

#ifdef __NARM__
void exec_mode()
{
    int mode;
    ip = ip + 4;
    mode = parse_expr();
    if (running == 0) return;
    if (lastExprIsFloat != 0 && lastExprFloat != (float)mode) { fail(5); return; }
    file_require_statement_end();
    if (running == 0) return;
    graphics_set_mode(mode);
}
#endif

void exec_gcls()
{
    int color;
    ip = ip + 4;
    color = 0;
    skip_spaces();
    if (ip < currentEnd) color = parse_expr();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    mm_clear((uint)color);
    screenDirty = 1;
}

void exec_pixel_stmt(int kwLen)
{
    int x;
    int y;
    int color;
    ip = ip + kwLen;
    x = parse_expr();
    if (running == 0) return;
    y = next_gfx_arg();
    if (running == 0) return;
    color = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (x >= 0) {
        if (x < SCREEN_W) {
            if (y >= 0) {
                if (y < SCREEN_H) mm_pixel((uint)(y * SCREEN_W + x), (uint)color);
            }
        }
    }
    screenDirty = 1;
}

void exec_gtext()
{
    int x;
    int y;
    int color;
    int i;

    ip = ip + 5;
    x = parse_expr();
    if (running == 0) return;
    y = next_gfx_arg();
    if (running == 0) return;
    if (expect_comma() == 0) return;
    if (parse_string_expr() == 0) return;
    color = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    i = 0;
    while (i < strTmpLen) {
        drawGlyph(x + i * FONT_W, y, (int)strTmp[i], (uint)color);
        i = i + 1;
    }
    screenDirty = 1;
}

void exec_gbutton()
{
    int x;
