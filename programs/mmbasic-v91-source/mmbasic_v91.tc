    if (running == 0) return;
    editor_save_config();
    con_char('E'); con_char('D'); con_char('I'); con_char('T'); con_char('O'); con_char('R'); con_char(' '); con_char('C'); con_char('F'); con_char('G'); con_char(' '); con_char('S'); con_char('A'); con_char('V'); con_char('E'); con_char('D'); con_nl();
}

void exec_edload_stmt()
{
    ip = ip + 6;
    file_require_statement_end();
    if (running == 0) return;
    editor_load_config();
    if (uiMode != 0) fsNeedRedraw = 1;
    con_char('E'); con_char('D'); con_char('I'); con_char('T'); con_char('O'); con_char('R'); con_char(' '); con_char('C'); con_char('F'); con_char('G'); con_char(' '); con_char('L'); con_char('O'); con_char('A'); con_char('D'); con_char('E'); con_char('D'); con_nl();
}

void exec_edreset_stmt()
{
    ip = ip + 7;
    file_require_statement_end();
    if (running == 0) return;
    editor_set_default_colors();
