};
uint8 mmMode3Palette[16] = {255,0,2,16,224,128,97,236,252,28,9,159,7,227,73,146};

uint mm_rgb(uint color)
{
    color &= 255u;
    return gpu_rgb332(graphicsMode == 3 ? mmMode3Palette[mmMode3Map[color]] : color);
}

int mm_scale() { return graphicsMode == 3 ? 1 : 2; }

void mm_clear(uint color) { gpu_draw_clear(mm_rgb(color)); }

void mm_fill_rect(int x0, int y0, int x1, int y1, uint color)
{
    int s = mm_scale();
    gpu_draw_rect(gd_min(x0, x1) * s, gd_min(y0, y1) * s,
                  gd_max(x0, x1) * s + s - 1, gd_max(y0, y1) * s + s - 1, mm_rgb(color));
}

void mm_pixel(uint index, uint color)
{
    if (index >= (uint)(SCREEN_W * SCREEN_H)) return;
    int x = (int)(index % (uint)SCREEN_W), y = (int)(index / (uint)SCREEN_W);
    mm_fill_rect(x, y, x, y, color);
}

void mm_line(int x0, int y0, int x1, int y1, uint color)
{
    int s = mm_scale();
    if (x0 == x1 || y0 == y1) { mm_fill_rect(x0, y0, x1, y1, color); return; }
    gpu_draw_line(x0 * s, y0 * s, x1 * s, y1 * s, mm_rgb(color));
}

void mm_glyph(int x, int y, int w, int h, const uint *glyph, uint color)
{
    int s = mm_scale();
    gpu_draw_mask(x * s, y * s, w, h, glyph, s, mm_rgb(color));
}

struct NarmMouseState mmPointer;
int mmDrawnPointerX = -1, mmDrawnPointerY = -1;
int mmSwapPending;
uint mmSwapArgs[2];
uint mmSwapStarted;
uint mmServiceMs = 0xffffffffu;
int bcHasPresent;
void mm_invalidate_source_rows();

int mm_pointer_visible()
{
    return (mmPointer.flags & (NARM_MOUSE_CONNECTED | NARM_MOUSE_FOCUSED | NARM_MOUSE_CURSOR_VISIBLE)) ==
           (NARM_MOUSE_CONNECTED | NARM_MOUSE_FOCUSED | NARM_MOUSE_CURSOR_VISIBLE);
}

void mm_finish_present(int wait)
{
    if (!mmSwapPending) return;
    if (!wait && !gdFault) {
        int ready = narm_gpu_submit(NARM_GPU_FRAME_READY, mmSwapArgs, 0);
        if (ready == 0 && millis() - mmSwapStarted <= 10000u) return;
        if (ready <= 0) gdFault = 1;
    }
    mmSwapPending = 0;
    if (gdFault) return;

    // The render pass is already queued. A blocking swap uses the working
    // board reply path. In the wait case the GPU orders it after the pass.
    gdBack = (int)mmSwapArgs[0];
    if (mmDrawnPointerX >= 0) gd_draw_pointer(mmDrawnPointerX, mmDrawnPointerY);
    gdArgs[0] = mmSwapArgs[0];
    gdArgs[1] = mmSwapArgs[1];
    if (gd_call(NARM_GPU_PRESENT, 2)) gd_frame_done();
    gdBack = -1;
}

void mm_wait_present()
{
    if (mmSwapPending && !narm_has_focus()) gdFault = 1;
    mm_finish_present(1);
}

void mm_present()
{
    if (!narm_has_focus()) return;
    mm_wait_present();
    if (gdFault) return;
    narm_mouse_get_state(&mmPointer);
    int visible = mm_pointer_visible();
    int x = visible ? mmPointer.x : -1;
    int y = visible ? mmPointer.y : -1;
    int cursorChanged = x != mmDrawnPointerX || y != mmDrawnPointerY;
    if (!gdCount && !gdClear && gdBack < 0 && !cursorChanged) {
        screenDirty = 0;
        return;
    }
    if (!gd_begin()) return;
    gd_flush_final();
    if (gdFault) return;

    mmDrawnPointerX = x;
    mmDrawnPointerY = y;
    mmSwapArgs[0] = (uint)gdBack;
    mmSwapArgs[1] = ++gdToken;
    mmSwapStarted = millis();
    mmSwapPending = 1;
    gdBack = -1;
    screenDirty = 0;
}

void mm_fill_triangle(int x0, int y0, int x1, int y1, int x2, int y2, uint color)
{
    int s = mm_scale();
    gpu_draw_triangle(x0 * s, y0 * s, 0, mm_rgb(color), x1 * s, y1 * s, 0, 0,
                      x2 * s, y2 * s, 0, 0, 0);
}

int graphics_rgb(int red, int green, int blue)
{
    if (red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255) {
        fail(5);
        return 0;
    }
    return ((red >> 5) << 5) | ((green >> 5) << 2) | (blue >> 6);
}

void graphics_set_mode(int mode)
{
    int i;
    if (mode != 3 && mode != 5) { fail(5); return; }
    graphicsMode = mode;
    if (mode == 3) {
        SCREEN_W = 640; SCREEN_H = 480;
        graphicsBpp = 4; mousePixelScale = 1;
        CON_COLS = 106; CON_ROWS = 60;
    } else {
        SCREEN_W = 320; SCREEN_H = 240;
        graphicsBpp = 8; mousePixelScale = 2;
        CON_COLS = 53; CON_ROWS = 30;
    }
    CON_CELLS = CON_COLS * CON_ROWS;
    FS_VISIBLE_ROWS = CON_ROWS - FS_SOURCE_ROW - 1;
    i = 0;
    while (i < CON_MAX_CELLS) {
        conBuf[i] = 32;
        fsColorValid[i] = 0;
        i = i + 1;
    }
    conX = 0; conY = 0;
    fsNeedRedraw = 1;
    fsMouseViewport = 0;
    mouse_reset_ui_input();
    mm_clear(COL_BG);
    screenDirty = 1;
}
#else
#define mm_clear clearBuffer
#define mm_pixel putPixel
#define mm_fill_rect fillRect2D
#define mm_line drawLine
#define mm_fill_triangle fillTri
#define mm_glyph putFont
void mm_present() { present(); screenDirty = 0; }
#endif

void fillRectClip(int x0, int y0, int x1, int y1, uint color)
{
    if (x1 < x0 || y1 < y0) return;
    if (x1 < 0 || y1 < 0 || x0 >= SCREEN_W || y0 >= SCREEN_H) return;
    if (x0 < 0) x0 = 0;
    if (y0 < 0) y0 = 0;
    if (x1 >= SCREEN_W) x1 = SCREEN_W - 1;
    if (y1 >= SCREEN_H) y1 = SCREEN_H - 1;
    if (x1 < x0) return;
    if (y1 < y0) return;

    mm_fill_rect(x0, y0, x1, y1, color);
}

void drawRectClip(int x0, int y0, int x1, int y1, uint color)
{
    int t;
    if (x1 < x0) { t = x0; x0 = x1; x1 = t; }
    if (y1 < y0) { t = y0; y0 = y1; y1 = t; }
    fillRectClip(x0, y0, x1, y0, color);
    fillRectClip(x1, y0, x1, y1, color);
    fillRectClip(x0, y1, x1, y1, color);
    fillRectClip(x0, y0, x0, y1, color);
}

int glyphRow(int ch, int row)
{
    if (ch >= 97) {
        if (ch <= 122) ch = ch - 32;
    }

    if (ch == 32) return 0;

    if (ch == 48) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 19; if (row==3) return 21; if (row==4) return 25; if (row==5) return 17; return 14; }
    if (ch == 49) { if (row==0) return 4; if (row==1) return 12; if (row==2) return 4; if (row==3) return 4; if (row==4) return 4; if (row==5) return 4; return 14; }
    if (ch == 50) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 1; if (row==3) return 2; if (row==4) return 4; if (row==5) return 8; return 31; }
    if (ch == 51) { if (row==0) return 30; if (row==1) return 1; if (row==2) return 1; if (row==3) return 14; if (row==4) return 1; if (row==5) return 1; return 30; }
    if (ch == 52) { if (row==0) return 2; if (row==1) return 6; if (row==2) return 10; if (row==3) return 18; if (row==4) return 31; if (row==5) return 2; return 2; }
    if (ch == 53) { if (row==0) return 31; if (row==1) return 16; if (row==2) return 16; if (row==3) return 30; if (row==4) return 1; if (row==5) return 1; return 30; }
    if (ch == 54) { if (row==0) return 6; if (row==1) return 8; if (row==2) return 16; if (row==3) return 30; if (row==4) return 17; if (row==5) return 17; return 14; }
    if (ch == 55) { if (row==0) return 31; if (row==1) return 1; if (row==2) return 2; if (row==3) return 4; if (row==4) return 8; if (row==5) return 8; return 8; }
    if (ch == 56) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 17; if (row==3) return 14; if (row==4) return 17; if (row==5) return 17; return 14; }
    if (ch == 57) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 17; if (row==3) return 15; if (row==4) return 1; if (row==5) return 2; return 12; }

    if (ch == 65) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 17; if (row==3) return 31; if (row==4) return 17; if (row==5) return 17; return 17; }
    if (ch == 66) { if (row==0) return 30; if (row==1) return 17; if (row==2) return 17; if (row==3) return 30; if (row==4) return 17; if (row==5) return 17; return 30; }
    if (ch == 67) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 16; if (row==3) return 16; if (row==4) return 16; if (row==5) return 17; return 14; }
    if (ch == 68) { if (row==0) return 30; if (row==1) return 17; if (row==2) return 17; if (row==3) return 17; if (row==4) return 17; if (row==5) return 17; return 30; }
    if (ch == 69) { if (row==0) return 31; if (row==1) return 16; if (row==2) return 16; if (row==3) return 30; if (row==4) return 16; if (row==5) return 16; return 31; }
    if (ch == 70) { if (row==0) return 31; if (row==1) return 16; if (row==2) return 16; if (row==3) return 30; if (row==4) return 16; if (row==5) return 16; return 16; }
    if (ch == 71) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 16; if (row==3) return 23; if (row==4) return 17; if (row==5) return 17; return 15; }
    if (ch == 72) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 17; if (row==3) return 31; if (row==4) return 17; if (row==5) return 17; return 17; }
    if (ch == 73) { if (row==0) return 14; if (row==1) return 4; if (row==2) return 4; if (row==3) return 4; if (row==4) return 4; if (row==5) return 4; return 14; }
    if (ch == 74) { if (row==0) return 7; if (row==1) return 2; if (row==2) return 2; if (row==3) return 2; if (row==4) return 18; if (row==5) return 18; return 12; }
    if (ch == 75) { if (row==0) return 17; if (row==1) return 18; if (row==2) return 20; if (row==3) return 24; if (row==4) return 20; if (row==5) return 18; return 17; }
    if (ch == 76) { if (row==0) return 16; if (row==1) return 16; if (row==2) return 16; if (row==3) return 16; if (row==4) return 16; if (row==5) return 16; return 31; }
    if (ch == 77) { if (row==0) return 17; if (row==1) return 27; if (row==2) return 21; if (row==3) return 21; if (row==4) return 17; if (row==5) return 17; return 17; }
    if (ch == 78) { if (row==0) return 17; if (row==1) return 25; if (row==2) return 21; if (row==3) return 19; if (row==4) return 17; if (row==5) return 17; return 17; }
    if (ch == 79) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 17; if (row==3) return 17; if (row==4) return 17; if (row==5) return 17; return 14; }
    if (ch == 80) { if (row==0) return 30; if (row==1) return 17; if (row==2) return 17; if (row==3) return 30; if (row==4) return 16; if (row==5) return 16; return 16; }
    if (ch == 81) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 17; if (row==3) return 17; if (row==4) return 21; if (row==5) return 18; return 13; }
    if (ch == 82) { if (row==0) return 30; if (row==1) return 17; if (row==2) return 17; if (row==3) return 30; if (row==4) return 20; if (row==5) return 18; return 17; }
    if (ch == 83) { if (row==0) return 15; if (row==1) return 16; if (row==2) return 16; if (row==3) return 14; if (row==4) return 1; if (row==5) return 1; return 30; }
    if (ch == 84) { if (row==0) return 31; if (row==1) return 4; if (row==2) return 4; if (row==3) return 4; if (row==4) return 4; if (row==5) return 4; return 4; }
    if (ch == 85) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 17; if (row==3) return 17; if (row==4) return 17; if (row==5) return 17; return 14; }
    if (ch == 86) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 17; if (row==3) return 17; if (row==4) return 17; if (row==5) return 10; return 4; }
    if (ch == 87) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 17; if (row==3) return 21; if (row==4) return 21; if (row==5) return 21; return 10; }
    if (ch == 88) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 10; if (row==3) return 4; if (row==4) return 10; if (row==5) return 17; return 17; }
    if (ch == 89) { if (row==0) return 17; if (row==1) return 17; if (row==2) return 10; if (row==3) return 4; if (row==4) return 4; if (row==5) return 4; return 4; }
    if (ch == 90) { if (row==0) return 31; if (row==1) return 1; if (row==2) return 2; if (row==3) return 4; if (row==4) return 8; if (row==5) return 16; return 31; }

    if (ch == 33) { if (row<5) return 4; if (row==5) return 0; return 4; }          /* ! */
    if (ch == 34) { if (row==0) return 10; if (row==1) return 10; return 0; }        /* " */
    if (ch == 35) { if (row==1) return 10; if (row==2) return 31; if (row==3) return 10; if (row==4) return 31; if (row==5) return 10; return 0; }
    if (ch == 36) { if (row==0) return 4; if (row==1) return 15; if (row==2) return 20; if (row==3) return 14; if (row==4) return 5; if (row==5) return 30; return 4; }
    if (ch == 37) { if (row==0) return 17; if (row==1) return 2; if (row==2) return 4; if (row==3) return 4; if (row==4) return 8; if (row==5) return 17; return 0; }
    if (ch == 38) { if (row==0) return 12; if (row==1) return 18; if (row==2) return 20; if (row==3) return 8; if (row==4) return 21; if (row==5) return 18; return 13; }
    if (ch == 39) { if (row==0) return 4; if (row==1) return 4; return 0; }          /* ' */
    if (ch == 40) { if (row==0) return 2; if (row==1) return 4; if (row==2) return 8; if (row==3) return 8; if (row==4) return 8; if (row==5) return 4; return 2; }
    if (ch == 41) { if (row==0) return 8; if (row==1) return 4; if (row==2) return 2; if (row==3) return 2; if (row==4) return 2; if (row==5) return 4; return 8; }
    if (ch == 42) { if (row==1) return 21; if (row==2) return 14; if (row==3) return 31; if (row==4) return 14; if (row==5) return 21; return 0; }
    if (ch == 43) { if (row==1) return 4; if (row==2) return 4; if (row==3) return 31; if (row==4) return 4; if (row==5) return 4; return 0; }
    if (ch == 44) { if (row==5) return 4; if (row==6) return 8; return 0; }
    if (ch == 45) { if (row==3) return 31; return 0; }
    if (ch == 46) { if (row==6) return 4; return 0; }
    if (ch == 47) { if (row==0) return 1; if (row==1) return 1; if (row==2) return 2; if (row==3) return 4; if (row==4) return 8; if (row==5) return 16; return 16; }
    if (ch == 58) { if (row==2) return 4; if (row==5) return 4; return 0; }
    if (ch == 59) { if (row==2) return 4; if (row==5) return 4; if (row==6) return 8; return 0; }
    if (ch == 60) { if (row==0) return 1; if (row==1) return 2; if (row==2) return 4; if (row==3) return 8; if (row==4) return 4; if (row==5) return 2; return 1; }
    if (ch == 61) { if (row==2) return 31; if (row==4) return 31; return 0; }
    if (ch == 62) { if (row==0) return 16; if (row==1) return 8; if (row==2) return 4; if (row==3) return 2; if (row==4) return 4; if (row==5) return 8; return 16; }
    if (ch == 63) { if (row==0) return 14; if (row==1) return 17; if (row==2) return 1; if (row==3) return 2; if (row==4) return 4; if (row==5) return 0; return 4; }
    if (ch == 91) { if (row==0) return 14; if (row==1) return 8; if (row==2) return 8; if (row==3) return 8; if (row==4) return 8; if (row==5) return 8; return 14; }
    if (ch == 93) { if (row==0) return 14; if (row==1) return 2; if (row==2) return 2; if (row==3) return 2; if (row==4) return 2; if (row==5) return 2; return 14; }
    if (ch == 94) { if (row==0) return 4; if (row==1) return 10; if (row==2) return 17; return 0; }
    if (ch == 95) { if (row==6) return 31; return 0; }
    if (ch == 123) { if (row==0) return 2; if (row==1) return 4; if (row==2) return 4; if (row==3) return 8; if (row==4) return 4; if (row==5) return 4; return 2; }
    if (ch == 125) { if (row==0) return 8; if (row==1) return 4; if (row==2) return 4; if (row==3) return 2; if (row==4) return 4; if (row==5) return 4; return 8; }
    if (ch == 126) { if (row==2) return 8; if (row==3) return 21; if (row==4) return 2; return 0; }

    if (row==0) return 14;
    if (row==1) return 17;
    if (row==2) return 1;
    if (row==3) return 2;
    if (row==4) return 4;
    if (row==5) return 0;
    return 4;
}

void buildFontGlyph(int ch)
{
    int row;
    int col;
    int bitIndex;
    int pat;
    int base;

    ch = ch & 255;
    base = ch * 2;
    fontTable[base] = (uint)0;
    fontTable[base + 1] = (uint)0;

    row = 0;
    while (row < 7) {
        pat = glyphRow(ch, row);
        col = 0;
        while (col < 5) {
            if ((pat & (16 >> col)) != 0) {
                bitIndex = row * 5 + col;
                if (bitIndex < 32) fontTable[base] = fontTable[base] | ((uint)1 << (31 - bitIndex));
                else fontTable[base + 1] = fontTable[base + 1] | ((uint)1 << (63 - bitIndex));
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

void initFontTable()
{
    int ch;
    ch = 0;
    while (ch < 256) {
        buildFontGlyph(ch);
        ch = ch + 1;
    }
}

int fontAddr()
{
    return (int)&fontTable[0];
}

void drawGlyph(int x, int y, int ch, uint color)
{
    int base;
    ch = ch & 255;
    base = ch * 2;
    mm_glyph(x, y, 5, 7, &fontTable[base], color);
}

void drawButtonGfx(int x, int y, int w, int h, uint fillColor, uint borderColor, uint textColor)
{
    int i;
    int tx;
    int ty;
    if (w <= 0 || h <= 0) return;
    fillRectClip(x, y, x + w - 1, y + h - 1, fillColor);
    drawRectClip(x, y, x + w - 1, y + h - 1, borderColor);
    tx = x + (w - strTmpLen * FONT_W) / 2;
    ty = y + (h - 7) / 2;
    i = 0;
    while (i < strTmpLen) {
        drawGlyph(tx + i * FONT_W, ty, (int)strTmp[i], textColor);
        i = i + 1;
    }
    screenDirty = 1;
}


void drawCell(int cx, int cy)
{
    int idx;
    int ch;
    int x;
    int y;

    if (cx < 0) return;
    if (cy < 0) return;
    if (cx >= CON_COLS) return;
    if (cy >= CON_ROWS) return;

    idx = cy * CON_COLS + cx;
    ch = conBuf[idx];
    /* Classic REPL/console text is offset 1 px down/right so it never
       touches the physical screen edge. */
    x = cx * FONT_W + 1;
    y = cy * FONT_H + 1;
    fillRectClip(x, y, x + FONT_W - 1, y + FONT_H - 1, COL_BG);
    if (ch != 32) drawGlyph(x, y, ch, COL_TEXT);
    screenDirty = 1;
}

void drawCellCursor(int cx, int cy)
{
    int idx;
    int ch;
    int x;
    int y;

    if (cx < 0) return;
    if (cy < 0) return;
    if (cx >= CON_COLS) return;
    if (cy >= CON_ROWS) return;

    idx = cy * CON_COLS + cx;
    ch = conBuf[idx];
    /* Classic REPL/console cursor follows the same 1 px text offset. */
    x = cx * FONT_W + 1;
    y = cy * FONT_H + 1;

    fillRectClip(x, y, x + FONT_W - 1, y + FONT_H - 1, COL_TEXT);
    if (ch != 32) drawGlyph(x, y, ch, COL_BG);
    screenDirty = 1;
}

void redrawConsole()
{
    int y;
    int x;
    int idx;
    int ch;

    mm_clear(COL_BG);
    y = 0;
    while (y < CON_ROWS) {
        x = 0;
        while (x < CON_COLS) {
            idx = y * CON_COLS + x;
            ch = conBuf[idx];
            if (ch != 32) drawGlyph(x * FONT_W, y * FONT_H, ch, COL_TEXT);
            x = x + 1;
        }
        y = y + 1;
    }
    screenDirty = 1;
}

#ifdef __NARM__
void pollNarmSystemEvents()
{
    int systemEvent;
    systemEvent = narm_poll_system_event();
    while (systemEvent != NARM_EVENT_NONE) {
        if (systemEvent == NARM_EVENT_CLOSE_REQUESTED) narm_exit(0);
        if (systemEvent == NARM_EVENT_FOCUS_LOST || systemEvent == NARM_EVENT_FOCUS_GAINED) {
            mouseDrag = 0;
            mouseEventValid = 0;
            mouseMotionValid = 0;
        }
        if (systemEvent == NARM_EVENT_FOCUS_GAINED) {
            mmSwapPending = 0;
            mmDrawnPointerX = -1;
            mmDrawnPointerY = -1;
            gpu_draw_invalidate_assets();
            mm_invalidate_source_rows();
            if (fsEditorActive != 0) fsNeedRedraw = 1;
            else redrawConsole();
        }
        systemEvent = narm_poll_system_event();
    }
}
#endif

#ifdef __NARM__
void mm_service_screen(int allowDraw)
{
    uint now = millis();
    if (now == mmServiceMs) return;
    mmServiceMs = now;
    pollNarmSystemEvents();
    if (!narm_has_focus()) return;
    mm_finish_present(0);
    if (!allowDraw || mmSwapPending || gdFault) return;
    narm_mouse_get_state(&mmPointer);
    int visible = mm_pointer_visible();
    if (screenDirty || mmDrawnPointerX != (visible ? mmPointer.x : -1) ||
        mmDrawnPointerY != (visible ? mmPointer.y : -1)) mm_present();
}
#endif

void flushScreen()
{
#ifdef __NARM__
    mm_service_screen(1);
#else
    if (screenDirty) mm_present();
#endif
}

void scrollConsole()
{
    int i;

    /*
       Fast console overflow mode.

       The old implementation shifted conBuf up by one row and then called
       redrawConsole(), which redrew up to 1590 text cells. After the screen
       filled, every PRINT that reached a new line paid that full redraw cost.

       The VM currently has fast rectangle/font drawing, but no framebuffer
       block-copy/scroll opcode. A true visual scroll therefore still requires
       redrawing the whole terminal. For program output and benchmarks, the
       practical behavior is page-clear: clear the text buffer and framebuffer,
       then continue printing from the top.
    */

    i = 0;
    while (i < CON_CELLS) {
        conBuf[i] = 32;
        i = i + 1;
    }

    conX = 0;
    conY = 0;
    mm_clear(COL_BG);
    screenDirty = 1;
}

void consoleClear()
{
    int i;
    i = 0;
    while (i < CON_CELLS) {
        conBuf[i] = 32;
        i = i + 1;
    }
    conX = 0;
    conY = 0;
    mm_clear(COL_BG);
    screenDirty = 1;
}

void con_nl()
{
    conX = 0;
    conY = conY + 1;
    if (conY >= CON_ROWS) scrollConsole();
}

void con_char(char c)
{
    int idx;

    if (c == 13) return;
    if (c == 10) {
        con_nl();
        return;
    }

    if (conX >= CON_COLS) con_nl();
    idx = conY * CON_COLS + conX;
    conBuf[idx] = c;
    drawCell(conX, conY);
    conX = conX + 1;
    if (conX >= CON_COLS) con_nl();
}


void con_char_fg(char c, uint fg)
{
    uint old;
    old = COL_TEXT;
    COL_TEXT = fg;
    con_char(c);
    COL_TEXT = old;
}

void con_backspace_visual()
{
    int idx;
    if (conX <= 0) return;
    conX = conX - 1;
    idx = conY * CON_COLS + conX;
    conBuf[idx] = 32;
    drawCell(conX, conY);
}

void con_str(char s[], int len)
{
    int i;
    i = 0;
    while (i < len) {
        if (s[i] == 0) return;
        con_char(s[i]);
        i = i + 1;
    }
}

void con_lit_title()
{
    con_char('T'); con_char('I'); con_char('N'); con_char('Y'); con_char('-');
    con_char('C'); con_char(' '); con_char('M'); con_char('M'); con_char('B');
    con_char('A'); con_char('S'); con_char('I'); con_char('C'); con_char(' ');
    con_char('R'); con_char('E'); con_char('P'); con_char('L'); con_nl();
}

void con_lit_ready()
{
    con_char('R'); con_char('E'); con_char('A'); con_char('D'); con_char('Y'); con_char('.'); con_nl();
}

void con_uint(uint v)
{
    int n;
    uint q;
    uint r;

    if (v == (uint)0) {
        con_char('0');
        return;
    }

    n = 0;
    while (v != (uint)0) {
        q = v / (uint)10;
        r = v - q * (uint)10;
        numTmp[n] = (char)('0' + (int)r);
        n = n + 1;
        v = q;
    }

    while (n > 0) {
        n = n - 1;
        con_char(numTmp[n]);
    }
}

void con_int(int v)
{
    if (v < 0) {
        con_char('-');
        con_uint((uint)(0 - v));
    } else {
        con_uint((uint)v);
    }
}

void con_float(float f)
{
    int whole;
    int frac;
    int i;
    float rem;

    if (f < 0.0f) {
        con_char('-');
        f = 0.0f - f;
    }

    whole = (int)f;
    con_int(whole);
    rem = f - (float)whole;
    if (rem < 0.000001f) return;

    con_char('.');
    i = 0;
    while (i < 6) {
        rem = rem * 10.0f;
        frac = (int)rem;
        con_char((char)('0' + frac));
        rem = rem - (float)frac;
        i = i + 1;
    }
}

void con_error_prefix()
{
    con_char('E'); con_char('R'); con_char('R'); con_char(' ');
}

/* ------------------------------------------------------------------------- */
/* Character/string utilities                                                */
/* ------------------------------------------------------------------------- */

int is_space(char c)
{
    if (c == 32) return 1;
    if (c == 9) return 1;
    return 0;
}

int is_digit(char c)
{
    if (c >= '0') {
        if (c <= '9') return 1;
    }
    return 0;
}

int is_alpha(char c)
{
    if (c >= 'A') {
        if (c <= 'Z') return 1;
    }
    if (c >= 'a') {
        if (c <= 'z') return 1;
    }
    return 0;
}

char to_upper(char c)
{
    if (c >= 'a') {
        if (c <= 'z') return c - 32;
    }
    return c;
}

void clear_chars(char b[], int maxLen)
{
    int i;
    i = 0;
    while (i < maxLen) {
        b[i] = 0;
        i = i + 1;
    }
}

void set_default_path()
{
    clear_chars(filePath, PATH_MAX);
    filePath[0] = 'B';
    filePath[1] = 'A';
    filePath[2] = 'S';
    filePath[3] = 'I';
    filePath[4] = 'C';
    filePath[5] = '.';
    filePath[6] = 'T';
    filePath[7] = 'X';
    filePath[8] = 'T';
    filePathLen = 9;
}

void con_path()
{
    con_str(filePath, PATH_MAX);
}

void con_current_dir()
{
    if (currentDirLen <= 0) { con_char('/'); return; }
    con_str(currentDir, PATH_MAX);
}

void clear_current_dir()
{
    int i;
    i = 0;
    while (i < PATH_MAX) { currentDir[i] = 0; i = i + 1; }
    currentDirLen = 0;
}


char pool_byte_get(int addr)
{
    int shift;
    uint value;
    if (addr < 0) return 0;
    if (addr >= BASIC_POOL_BYTES) return 0;
    shift = (3 - (addr % 4)) * 8;
    value = basicPool[addr / 4];
    return (char)((value >> shift) & (uint)255);
}

void pool_byte_set(int addr, char value)
{
    int shift;
    uint mask;
    uint word;
    if (addr < 0) return;
    if (addr >= BASIC_POOL_BYTES) return;
    shift = (3 - (addr % 4)) * 8;
    mask = ((uint)255) << shift;
    word = basicPool[addr / 4];
    word = (word & ~mask) | (((uint)value & (uint)255) << shift);
    basicPool[addr / 4] = word;
}

int pool_int_get(int addr)
{
    if (addr < 0) return 0;
    if (addr + 3 >= BASIC_POOL_BYTES) return 0;
    return (int)basicPool[addr / 4];
}

void pool_int_set(int addr, int value)
{
    if (addr < 0) return;
    if (addr + 3 >= BASIC_POOL_BYTES) return;
    basicPool[addr / 4] = (uint)value;
}

float pool_float_get(int addr)
{
    union FloatBits bits;
    bits.i = pool_int_get(addr);
    return bits.f;
}

void pool_float_set(int addr, float value)
{
    union FloatBits bits;
    bits.f = value;
    pool_int_set(addr, bits.i);
}

int pool_source_bytes()
{
    return lineCount * LINE_MAX;
}

int pool_free_bytes()
{
    return poolVarTop - pool_source_bytes();
}

int pool_can_add_line()
{
    if (lineCount >= LINE_META_MAX) return 0;
    if ((lineCount + 1) * LINE_MAX > poolVarTop) return 0;
    return 1;
}

int pool_alloc_scalar_record(int isString)
{
    int bytes;
    int nextTop;
    bytes = VAR_RECORD_HEADER_BYTES;
    if (isString != 0) bytes = VAR_STRING_RECORD_BYTES;
    if (varCount >= VAR_META_MAX) return 0;
    nextTop = poolVarTop - bytes;
    if (nextTop < pool_source_bytes()) return 0;
    poolVarTop = nextTop;
    poolScalarTop = nextTop;
    varRecordAddr[varCount] = nextTop;
    return 1;
}

int line_base(int idx)
{
    if (idx < 0) return 0;
    if (idx >= LINE_META_MAX) return 0;
    return lineSlot[idx] * LINE_MAX;
}


char src_get(int addr)
{
    if (addr < 0) return 0;
    if (addr >= BASIC_POOL_BYTES) return 0;
    return pool_byte_get(addr);
}

void src_set(int addr, char value)
{
    if (addr < 0) return;
    if (addr >= BASIC_POOL_BYTES) return;
    pool_byte_set(addr, value);
}

char bc_source_char(int addr)
{
    if (bcSourceFromProg != 0) return prog[addr];
    return src_get(addr);
}

void stage_source_slots_to_prog()
{
    /* v86: no full-program staging buffer exists anymore.  Source lives in
       low shared-pool slots and bytecode lives in programArena[]. */
}

void restore_source_slots_from_prog()
{
    /* v85: no-op compatibility stub.  Normal RUN never destroys source. */
}

/* ------------------------------------------------------------------------- */
/* Program storage                                                           */
/* ------------------------------------------------------------------------- */

void mark_source_dirty()
{
    sourceDirty = 1;
    bcReady = 0;
    bcProgramOnly = 0;
}

void mark_compiled_ready()
{
    sourceDirty = 0;
    bcReady = 1;
    bcSourceLines = lineCount;
}

void clear_source_only_fast()
{
    int i;
    i = 0;
    while (i < pool_source_bytes()) {
        pool_byte_set(i, 0);
        i = i + 1;
    }
}

void discard_source_after_compile()
{
    if (bcReady == 0) return;
    /* v86: source and bytecode no longer share storage.  The editable source is
       already packed in shared-pool slots, so there is no int32-per-character waste
       to reclaim here, and normal COMPILE/RUN should keep source available for
       LIST, SAVE, and the fullscreen editor. */
    sourceDiscarded = 0;
    bcProgramOnly = 0;
}

void clear_program()
{
    int i;

    /* v54: do not wipe the large backing stores here.
       On a fresh program load the VM variable memory is already zeroed by the
       loader/runtime.  During NEW/LOAD we only need to invalidate the active
       metadata counters; old bytes in the source/bytecode/DATA/name pools are
       ignored because their counts are reset.  The old v51/v53 path cleared
       tens of thousands of entries before the first framebuffer present, and
       the int-arena src_set() version was especially slow on real hardware. */

    lineCount = 0;
    labelCount = 0;
    subCount = 0;
    dataCount = 0;
    dataPtr = 0;

    bcReady = 0;
    sourceDirty = 0;
    sourceDiscarded = 0;
    bcSourceLines = 0;
    bcSourceTextBytes = 0;
    bcProgramOnly = 0;
    bcSourceFromProg = 0;
    bcLen = 0;
    bcByteLen = 0;
    bc_seek_reset();
    bcStrLen = 0;
    bcFloatLen = 0;

    fsCurLine = 0;
    fsCurCol = 0;
    fsTopLine = 0;
    fsLeftCol = 0;

    /* Clear only small per-line metadata so LIST/EDIT state is deterministic.
       Do not clear basicPool, programArena, labelNames, subNames, subParamNames,
       or dataItems; their active counts above make stale bytes unreachable. */
    i = 0;
    while (i < LINE_META_MAX) {
        lineNum[i] = 0;
        lineLen[i] = 0;
        lineHasNumber[i] = 0;
        lineSlot[i] = i;
        fsLineStateLen[i] = -1;
        fsLineEndInString[i] = 0;
        fsLineEndComment[i] = 0;
        i = i + 1;
    }
}

void clear_vars()
{
    int i;
    int oldVarCount;
    int oldArrayCount;
    int oldLocalTop;

    oldVarCount = varCount;
    oldArrayCount = arrayCount;
    oldLocalTop = localTop;

    /* v56: do not trust persistent global counters on first boot.
       Sparse global initialization relies on the VM loader clearing varmem, but
       some real-hardware paths may leave stale values from a previous program.
       If varCount/arrayCount/localTop start as garbage, the old lazy-clear path
       can loop almost forever before the first framebuffer draw.  Clamp them
       before using them as loop bounds. */
    if (oldVarCount < 0) oldVarCount = 0;
    if (oldVarCount > VAR_META_MAX) oldVarCount = 0;
    if (oldArrayCount < 0) oldArrayCount = 0;
    if (oldArrayCount > ARRAY_META_MAX) oldArrayCount = 0;
    if (oldLocalTop < 0) oldLocalTop = 0;
    if (oldLocalTop > MAX_LOCAL) oldLocalTop = 0;

    /* Fast runtime reset.  The old version wiped every backing store:
       pooled scalar/array payloads, localStrSave, etc.
       That made pressing F5/RUN slow even for PRINT "HELLO".
       Lookups are controlled by varCount/arrayCount/localTop, and new symbols
       overwrite their own name slots, so only active metadata must be reset. */
    varCount = 0;
    poolVarTop = BASIC_POOL_BYTES;
    poolScalarTop = BASIC_POOL_BYTES;
    identIsString = 0;
    strTmpLen = 0;

    i = 0;
    while (i < STR_MAX) {
        strTmp[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < VAR_NAME_MAX) {
        dimIdentTmp[i] = 0;
        i = i + 1;
    }
    dimIdentIsString = 0;

    arrayCount = 0;
    arrayNumNext = 0;
    arrayStrNext = 0;
    arrayIdxCount = 0;
    localTop = 0;

    i = 0;
    while (i < oldLocalTop) {
        localVar[i] = 0;
        localWasUsed[i] = 0;
        localWasString[i] = 0;
        localWasFloat[i] = 0;
        localIntSave[i] = 0;
        localFloatSave[i] = 0.0f;
        localStrLenSave[i] = 0;
        i = i + 1;
    }

}

void copy_slot(int dst, int src)
{
    /* v63: logical line movement is pointer/slot movement only.
       The actual source text stays in its physical slot.  This makes
       Enter/Backspace line insert/delete O(number of metadata entries) instead
       of copying LINE_MAX text bytes for every shifted line. */
    lineSlot[dst] = lineSlot[src];
    lineNum[dst] = lineNum[src];
    lineLen[dst] = lineLen[src];
    lineHasNumber[dst] = lineHasNumber[src];
    fsLineStateLen[dst] = fsLineStateLen[src];
    fsLineEndInString[dst] = fsLineEndInString[src];
    fsLineEndComment[dst] = fsLineEndComment[src];
}

int find_line(int target)
{
    int i;
    i = 0;
    while (i < lineCount) {
        if (lineHasNumber[i] != 0) {
            if (lineNum[i] == target) return i;
        }
        i = i + 1;
    }
    return -1;
}

int find_insert_pos(int target)
{
    int i;
    i = 0;
    while (i < lineCount) {
        if (lineHasNumber[i] != 0) {
            if (lineNum[i] >= target) return i;
        }
        i = i + 1;
    }
    return lineCount;
}

void delete_line_index(int idx)
{
    int i;
    int freedSlot;
    if (idx < 0) return;
    if (idx >= lineCount) return;

    freedSlot = lineSlot[idx];
    i = idx;
    while (i < lineCount - 1) {
        copy_slot(i, i + 1);
        i = i + 1;
    }
    lineCount = lineCount - 1;
    lineSlot[lineCount] = freedSlot;
    lineNum[lineCount] = 0;
    lineLen[lineCount] = 0;
    lineHasNumber[lineCount] = 0;
    fs_set_empty_line_state(lineCount);
    mark_source_dirty();
}

void store_program_line(int num, int start, int end)
{
    int dst;
    int found;
    int len;
    int pos;
    int base;
    int i;
    int freeSlot;

    while (start < end) {
        if (is_space(inputLine[start]) == 0) break;
        start = start + 1;
    }
    while (end > start) {
        if (is_space(inputLine[end - 1]) == 0) break;
        end = end - 1;
    }

    found = find_line(num);

    if (start >= end) {
        if (found >= 0) {
            delete_line_index(found);
            con_char('D'); con_char('E'); con_char('L'); con_char('E'); con_char('T'); con_char('E'); con_char('D'); con_nl();
        }
        return;
    }

    if (found >= 0) {
        dst = found;
    } else {
        if (pool_can_add_line() == 0) {
            con_error_prefix(); con_char('O'); con_char('U'); con_char('T'); con_char(' '); con_char('O'); con_char('F'); con_char(' '); con_char('M'); con_char('E'); con_char('M'); con_char('O'); con_char('R'); con_char('Y'); con_nl();
            return;
        }
        pos = find_insert_pos(num);
        freeSlot = lineSlot[lineCount];
        i = lineCount;
        while (i > pos) {
            copy_slot(i, i - 1);
            i = i - 1;
        }
        lineCount = lineCount + 1;
        lineSlot[pos] = freeSlot;
        dst = pos;
    }

    len = end - start;
    if (len >= LINE_MAX) len = LINE_MAX - 1;
    lineNum[dst] = num;
    lineHasNumber[dst] = 1;
    lineLen[dst] = len;
    base = line_base(dst);
    i = 0;
    while (i < len) {
        src_set(base + i, inputLine[start + i]);
        i = i + 1;
    }
    fs_invalidate_line_state(dst);
    sourceDiscarded = 0;
    mark_source_dirty();
}


void append_program_line(int start, int end)
{
    int dst;
    int len;
    int base;
    int i;

    while (end > start) {
        if (is_space(inputLine[end - 1]) == 0) break;
        end = end - 1;
    }
    if (start >= end) return;

    if (pool_can_add_line() == 0) {
        con_error_prefix(); con_char('O'); con_char('U'); con_char('T'); con_char(' '); con_char('O'); con_char('F'); con_char(' '); con_char('M'); con_char('E'); con_char('M'); con_char('O'); con_char('R'); con_char('Y'); con_nl();
        return;
    }

    dst = lineCount;
    lineCount = lineCount + 1;
    len = end - start;
    if (len >= LINE_MAX) len = LINE_MAX - 1;
    lineNum[dst] = 0;
    lineHasNumber[dst] = 0;
    lineLen[dst] = len;
    base = line_base(dst);
    i = 0;
    while (i < len) {
        src_set(base + i, inputLine[start + i]);
        i = i + 1;
    }
    fs_invalidate_line_state(dst);
    sourceDiscarded = 0;
    mark_source_dirty();
}

void load_line_to_prog(int idx)
{
    int base;
    int i;
    base = line_base(idx);

    i = 0;
    while (i < PROG_MAX) {
        prog[i] = 0;
        i = i + 1;
    }

    i = 0;
    while (i < lineLen[idx]) {
        prog[i] = src_get(base + i);
        i = i + 1;
    }
    currentEnd = lineLen[idx];
    ip = 0;
}


int src_upper_char(int base, int pos)
{
    return (int)to_upper(src_get(base + pos));
}

int src_kw_match2(int base, int pos, char a, char b)
{
    if (src_upper_char(base,pos) != a) return 0;
    if (src_upper_char(base,pos+1) != b) return 0;
    return 1;
}

int src_kw_match3(int base, int pos, char a, char b, char c)
{
    if (src_upper_char(base,pos) != a) return 0;
    if (src_upper_char(base,pos+1) != b) return 0;
    if (src_upper_char(base,pos+2) != c) return 0;
    return 1;
}

int src_kw_match4(int base, int pos, char a, char b, char c, char d)
{
    if (src_upper_char(base,pos) != a) return 0;
    if (src_upper_char(base,pos+1) != b) return 0;
    if (src_upper_char(base,pos+2) != c) return 0;
    if (src_upper_char(base,pos+3) != d) return 0;
    return 1;
}

int src_kw_match5(int base, int pos, char a, char b, char c, char d, char e)
{
    if (src_upper_char(base,pos) != a) return 0;
    if (src_upper_char(base,pos+1) != b) return 0;
    if (src_upper_char(base,pos+2) != c) return 0;
    if (src_upper_char(base,pos+3) != d) return 0;
    if (src_upper_char(base,pos+4) != e) return 0;
    return 1;
}

int src_kw_match6(int base, int pos, char a, char b, char c, char d, char e, char f)
{
    if (src_upper_char(base,pos) != a) return 0;
    if (src_upper_char(base,pos+1) != b) return 0;
    if (src_upper_char(base,pos+2) != c) return 0;
    if (src_upper_char(base,pos+3) != d) return 0;
    if (src_upper_char(base,pos+4) != e) return 0;
    if (src_upper_char(base,pos+5) != f) return 0;
    return 1;
}

int source_word_is_keyword(int base, int pos, int len)
{
    if (len == 2) {
        if (src_kw_match2(base,pos,'I','F') != 0) return 1;
        if (src_kw_match2(base,pos,'D','O') != 0) return 1;
        if (src_kw_match2(base,pos,'T','O') != 0) return 1;
    }
    if (len == 3) {
        if (src_kw_match3(base,pos,'R','G','B') != 0) return 1;
        if (src_kw_match3(base,pos,'F','O','R') != 0) return 1;
        if (src_kw_match3(base,pos,'N','E','W') != 0) return 1;
        if (src_kw_match3(base,pos,'D','I','M') != 0) return 1;
        if (src_kw_match3(base,pos,'R','U','N') != 0) return 1;
        if (src_kw_match3(base,pos,'R','E','M') != 0) return 1;
        if (src_kw_match3(base,pos,'E','N','D') != 0) return 1;
    }
    if (len == 4) {
        if (src_kw_match4(base,pos,'M','O','D','E') != 0) return 1;
        if (src_kw_match4(base,pos,'T','H','E','N') != 0) return 1;
        if (src_kw_match4(base,pos,'E','L','S','E') != 0) return 1;
        if (src_kw_match4(base,pos,'G','O','T','O') != 0) return 1;
        if (src_kw_match4(base,pos,'N','E','X','T') != 0) return 1;
        if (src_kw_match4(base,pos,'D','A','T','A') != 0) return 1;
        if (src_kw_match4(base,pos,'R','E','A','D') != 0) return 1;
        if (src_kw_match4(base,pos,'L','O','O','P') != 0) return 1;
        if (src_kw_match4(base,pos,'W','E','N','D') != 0) return 1;
        if (src_kw_match4(base,pos,'C','A','S','E') != 0) return 1;
        if (src_kw_match4(base,pos,'O','P','E','N') != 0) return 1;
        if (src_kw_match4(base,pos,'L','I','N','E') != 0) return 1;
    }
    if (len == 5) {
        if (src_kw_match5(base,pos,'E','N','D','I','F') != 0) return 1;
        if (src_kw_match5(base,pos,'G','O','S','U','B') != 0) return 1;
        if (src_kw_match5(base,pos,'P','R','I','N','T') != 0) return 1;
        if (src_kw_match5(base,pos,'I','N','P','U','T') != 0) return 1;
        if (src_kw_match5(base,pos,'W','H','I','L','E') != 0) return 1;
        if (src_kw_match5(base,pos,'C','L','O','S','E') != 0) return 1;
        if (src_kw_match5(base,pos,'L','O','C','A','L') != 0) return 1;
        if (src_kw_match5(base,pos,'P','A','U','S','E') != 0) return 1;
        if (src_kw_match5(base,pos,'D','E','L','A','Y') != 0) return 1;
        if (src_kw_match5(base,pos,'C','O','L','O','R') != 0) return 1;
    }
    if (len == 6) {
        if (src_kw_match6(base,pos,'R','E','T','U','R','N') != 0) return 1;
        if (src_kw_match6(base,pos,'S','E','L','E','C','T') != 0) return 1;
    }
    return 0;
}

int source_is_ident_start_char(char c)
{
    if (is_alpha(c) != 0) return 1;
    if (c == '_') return 1;
    return 0;
}

int source_is_ident_char(char c)
{
    if (source_is_ident_start_char(c) != 0) return 1;
    if (is_digit(c) != 0) return 1;
    if (c == '.') return 1;
    if (c == '$') return 1;
    return 0;
}

void con_int_fg(int v, uint fg)
{
    uint old;
    old = COL_TEXT;
    COL_TEXT = fg;
    con_int(v);
    COL_TEXT = old;
}

void con_source_chars_fg(int base, int start, int endp, uint fg)
{
    int p;
    p = start;
    while (p < endp) {
        con_char_fg(src_get(base + p), fg);
        p = p + 1;
    }
}

void con_source_line_colored(int base, int len)
{
    int j;
    int wstart;
    int wlen;
    int inString;
    char c;
    uint color;

    j = 0;
    inString = 0;
    while (j < len) {
        c = src_get(base + j);

        if (c == 34) {
            con_char_fg(c, ED_LIT);
            inString = 1 - inString;
            j = j + 1;
        } else if (inString != 0) {
            con_char_fg(c, ED_LIT);
            j = j + 1;
        } else if (c == 39) {
            while (j < len) {
                con_char_fg(src_get(base + j), ED_COMMENT);
                j = j + 1;
            }
        } else if (is_digit(c) != 0) {
            while (j < len) {
                c = src_get(base + j);
                if (is_digit(c) == 0) {
                    if (c != '.') break;
                }
                con_char_fg(c, ED_NUM);
                j = j + 1;
            }
        } else if (source_is_ident_start_char(c) != 0) {
            wstart = j;
            while (j < len) {
                c = src_get(base + j);
                if (source_is_ident_char(c) == 0) break;
                j = j + 1;
            }
            wlen = j - wstart;
            color = ED_VAR;
            if (source_word_is_keyword(base, wstart, wlen) != 0) color = ED_KEY;
            con_source_chars_fg(base, wstart, j, color);
        } else {
            con_char_fg(c, ED_TEXT);
            j = j + 1;
        }
    }
}

void list_program()
{
    int i;
    int base;

    if (sourceDiscarded != 0) {
        con_char('C'); con_char('O'); con_char('M'); con_char('P'); con_char('I'); con_char('L'); con_char('E'); con_char('D'); con_char(' ');
        con_char('O'); con_char('N'); con_char('L'); con_char('Y'); con_nl();
        print_bc_info();
        return;
    }
    if (lineCount == 0) {
        con_char('E'); con_char('M'); con_char('P'); con_char('T'); con_char('Y'); con_nl();
        return;
    }

    i = 0;
    while (i < lineCount) {
        if (lineHasNumber[i] != 0) {
            con_int_fg(lineNum[i], ED_NUM);
            con_char_fg(' ', ED_TEXT);
        }
        base = line_base(i);
        con_source_line_colored(base, lineLen[i]);
        con_nl();
        i = i + 1;
    }
}


int sd_mount_ok()
{
    if (sdMount() != (uint)0) return 1;
    return 0;
}

void con_sd_mount_error()
{
    con_error_prefix();
    con_char('S'); con_char('D'); con_char(' '); con_char('M'); con_char('O'); con_char('U'); con_char('N'); con_char('T');
    con_nl();
}

void savebuf_clear()
{
    int i;
    i = 0;
    while (i < FILE_BUF_MAX) {
        saveLoadBuf[i] = 0;
        i = i + 1;
    }
}

void savebuf_flush()
{
    int wrote;
    if (saveBufPos <= 0) return;

    wrote = (int)sdFileWriteBytes(filePath, saveLoadBuf, (uint)saveFileOffset, (uint)saveBufPos);
    if (wrote < saveBufPos) {
        con_error_prefix(); con_char('S'); con_char('A'); con_char('V'); con_nl();
    }
    saveFileOffset = saveFileOffset + saveBufPos;
    saveBufPos = 0;
    savebuf_clear();
}

void append_prog_char(char c)
{
    saveLoadBuf[saveBufPos] = c;
    saveBufPos = saveBufPos + 1;
    saveActualBytes = saveActualBytes + 1;
    if (saveBufPos >= FILE_BUF_MAX) savebuf_flush();
}

void append_prog_uint(uint v)
{
    int n;
    uint q;
    uint r;

    if (v == (uint)0) {
        append_prog_char('0');
        return;
    }

    n = 0;
    while (v != (uint)0) {
        q = v / (uint)10;
        r = v - q * (uint)10;
        numTmp[n] = (char)('0' + (int)r);
        n = n + 1;
        v = q;
    }
    while (n > 0) {
        n = n - 1;
        append_prog_char(numTmp[n]);
    }
}

void save_program_sd()
{
    int i;
    int j;
    int base;

    if (sourceDiscarded != 0) {
        con_error_prefix(); con_char('N'); con_char('O'); con_char(' '); con_char('S'); con_char('O'); con_char('U'); con_char('R'); con_char('C'); con_nl();
        return;
    }

    if (sd_mount_ok() == 0) { con_sd_mount_error(); return; }

    sdFileDelete(filePath);
    if (sdFileMake(filePath) == (uint)0) {
        con_error_prefix(); con_char('S'); con_char('A'); con_char('V'); con_char('E'); con_nl();
        return;
    }

    savebuf_clear();
    saveBufPos = 0;
    saveFileOffset = 0;
    saveActualBytes = 0;

    i = 0;
    while (i < lineCount) {
        if (lineHasNumber[i] != 0) {
            append_prog_uint((uint)lineNum[i]);
            append_prog_char(' ');
        }
        base = line_base(i);
        j = 0;
        while (j < lineLen[i]) {
            append_prog_char(src_get(base + j));
            j = j + 1;
        }
        append_prog_char(13);
        append_prog_char(10);
        i = i + 1;
    }
    savebuf_flush();
    progLen = saveActualBytes;

    con_char('S'); con_char('A'); con_char('V'); con_char('E'); con_char('D'); con_char(' ');
    con_path();
    con_nl();
}

void parse_loaded_line_from_input(int rawLen)
{
    int p;
    int num;
    int hasDigit;
    int isNumberedLine;
    int lineStart;

    if (rawLen <= 0) return;

    p = 0;
    while (p < rawLen) {
        if (inputLine[p] != 10) {
            if (inputLine[p] != 13) break;
        }
        p = p + 1;
    }
    if (p >= rawLen) return;
    if (inputLine[p] == 0) return;

    lineStart = p;
    num = 0;
    hasDigit = 0;
    while (p < rawLen) {
        if (is_digit(inputLine[p]) == 0) break;
        hasDigit = 1;
        num = num * 10 + (int)(inputLine[p] - '0');
        p = p + 1;
    }

    isNumberedLine = 0;
    if (hasDigit != 0) {
        if (p >= rawLen) isNumberedLine = 1;
        else if (is_space(inputLine[p]) != 0) isNumberedLine = 1;
    }
    if (isNumberedLine == 0) {
        p = lineStart;
        num = 0;
        hasDigit = 0;
    }

    if (hasDigit != 0) {
        while (p < rawLen) {
            if (is_space(inputLine[p]) == 0) break;
            p = p + 1;
        }
        store_program_line(num, p, rawLen);
    } else {
        append_program_line(0, rawLen);
    }
}

void load_program_sd()
{
    int fileSize;
    int offset;
    int n;
    int i;
    char c;
    int done;

    if (sd_mount_ok() == 0) { con_sd_mount_error(); return; }

    if (sdFileExists(filePath) == (uint)0) {
        con_error_prefix(); con_char('N'); con_char('O'); con_char(' '); con_char('F'); con_char('I'); con_char('L'); con_char('E'); con_char(' ');
        con_path();
        con_nl();
        return;
    }

    fileSize = (int)sdFileSize(filePath);
    if (fileSize <= 0) {
        con_error_prefix(); con_char('E'); con_char('M'); con_char('P'); con_char('T'); con_char('Y'); con_nl();
        return;
    }

    clear_program();
    clear_chars(inputLine, LINE_MAX);
    loadLineLen = 0;
    loadPrevCR = 0;
    offset = 0;
    done = 0;

    while (offset < fileSize) {
        savebuf_clear();
        n = (int)sdFileReadBytes(filePath, saveLoadBuf, (uint)offset, (uint)FILE_BUF_MAX);
        if (n <= 0) break;

        i = 0;
        while (i < n) {
            c = saveLoadBuf[i];
            if (c == 0) { done = 1; break; }

            if (c == 10) {
                if (loadPrevCR == 0) parse_loaded_line_from_input(loadLineLen);
                loadLineLen = 0;
                clear_chars(inputLine, LINE_MAX);
                loadPrevCR = 0;
            } else if (c == 13) {
                parse_loaded_line_from_input(loadLineLen);
                loadLineLen = 0;
                clear_chars(inputLine, LINE_MAX);
                loadPrevCR = 1;
            } else {
                if (loadLineLen < LINE_MAX - 1) {
                    inputLine[loadLineLen] = c;
                    loadLineLen = loadLineLen + 1;
                }
                loadPrevCR = 0;
            }
            i = i + 1;
        }

        if (done != 0) break;
        offset = offset + FILE_BUF_MAX;
    }

    if (loadLineLen > 0) parse_loaded_line_from_input(loadLineLen);

    sourceDiscarded = 0;
    mark_source_dirty();
    con_char('L'); con_char('O'); con_char('A'); con_char('D'); con_char('E'); con_char('D'); con_char(' ');
    con_path();
    con_char(' ');
    con_int(lineCount);
    con_char(' '); con_char('L'); con_char('I'); con_char('N'); con_char('E'); con_char('S'); con_nl();
}

/* ------------------------------------------------------------------------- */
/* Keyboard input and line editor                                             */
/* ------------------------------------------------------------------------- */

int keyPulse(int idx)
{
    if (keyPressed != (uint)0) {
        if (keyWas[idx] == 0) {
            if (inputNow < keyCoolUntil[idx]) return 0;
            keyWas[idx] = 1;
            keyNextPulse[idx] = inputNow + (uint)750;
            return 1;
        }

        if (inputNow >= keyNextPulse[idx]) {
            keyNextPulse[idx] = inputNow + (uint)35;
            return 1;
        }

        return 0;
    }

    if (keyWas[idx] != 0) keyCoolUntil[idx] = inputNow + (uint)20;
    keyWas[idx] = 0;
    keyNextPulse[idx] = (uint)0;
    return 0;
}

int keyPulseAny3(int idx, int scA, int scB, int scC)
{
    uint any;

    any = (uint)0;

    key(scA, keyData, keyPressed);
    if (keyPressed != (uint)0) any = (uint)1;

    key(scB, keyData, keyPressed);
    if (keyPressed != (uint)0) any = (uint)1;

    key(scC, keyData, keyPressed);
    if (keyPressed != (uint)0) any = (uint)1;

    keyPressed = any;
    if (keyPulse(idx) != 0) return 1;
    return 0;
}

void keepShiftSelectionAliveIfNeeded()
{
    if (shiftDown != 0) {
        shiftSelectUntil = inputNow + (uint)250;
    }
}

void restoreShiftForNavigationIfLatched()
{
    if (shiftDown != 0) return;
    if (shiftSelectUntil == (uint)0) return;
    if (inputNow < shiftSelectUntil) shiftDown = 1;
}

void updateShift()
{
    shiftDown = 0;
    key(0x12, keyData, keyPressed);
    if (keyPressed != (uint)0) shiftDown = 1;
    key(0x59, keyData, keyPressed);
    if (keyPressed != (uint)0) shiftDown = 1;
    keepShiftSelectionAliveIfNeeded();
}

int shiftedDigit(int d)
{
    if (d == 1) return 33;  /* ! */
    if (d == 2) return 64;  /* @ */
    if (d == 3) return 35;  /* # */
    if (d == 4) return 36;  /* $ */
    if (d == 5) return 37;  /* % */
    if (d == 6) return 94;  /* ^ */
    if (d == 7) return 38;  /* & */
    if (d == 8) return 42;  /* * */
    if (d == 9) return 40;  /* ( */
    if (d == 0) return 41;  /* ) */
    return 48 + d;
}

int readTypedChar()
{
    updateShift();

    key(0x1C, keyData, keyPressed); if (keyPulse(28) != 0) return 65; /* A */
    key(0x32, keyData, keyPressed); if (keyPulse(50) != 0) return 66; /* B */
    key(0x21, keyData, keyPressed); if (keyPulse(33) != 0) return 67; /* C */
    key(0x23, keyData, keyPressed); if (keyPulse(35) != 0) return 68; /* D */
    key(0x24, keyData, keyPressed); if (keyPulse(36) != 0) return 69; /* E */
    key(0x2B, keyData, keyPressed); if (keyPulse(43) != 0) return 70; /* F */
    key(0x34, keyData, keyPressed); if (keyPulse(52) != 0) return 71; /* G */
    key(0x33, keyData, keyPressed); if (keyPulse(51) != 0) return 72; /* H */
    key(0x43, keyData, keyPressed); if (keyPulse(67) != 0) return 73; /* I */
    key(0x3B, keyData, keyPressed); if (keyPulse(59) != 0) return 74; /* J */
    key(0x42, keyData, keyPressed); if (keyPulse(66) != 0) return 75; /* K */
    key(0x4B, keyData, keyPressed); if (keyPulse(75) != 0) return 76; /* L */
    key(0x3A, keyData, keyPressed); if (keyPulse(58) != 0) return 77; /* M */
    key(0x31, keyData, keyPressed); if (keyPulse(49) != 0) return 78; /* N */
    key(0x44, keyData, keyPressed); if (keyPulse(68) != 0) return 79; /* O */
    key(0x4D, keyData, keyPressed); if (keyPulse(77) != 0) return 80; /* P */
    key(0x15, keyData, keyPressed); if (keyPulse(21) != 0) return 81; /* Q */
    key(0x2D, keyData, keyPressed); if (keyPulse(45) != 0) return 82; /* R */
    key(0x1B, keyData, keyPressed); if (keyPulse(27) != 0) return 83; /* S */
    key(0x2C, keyData, keyPressed); if (keyPulse(44) != 0) return 84; /* T */
    key(0x3C, keyData, keyPressed); if (keyPulse(60) != 0) return 85; /* U */
    key(0x2A, keyData, keyPressed); if (keyPulse(42) != 0) return 86; /* V */
    key(0x1D, keyData, keyPressed); if (keyPulse(29) != 0) return 87; /* W */
    key(0x22, keyData, keyPressed); if (keyPulse(34) != 0) return 88; /* X */
    key(0x35, keyData, keyPressed); if (keyPulse(53) != 0) return 89; /* Y */
    key(0x1A, keyData, keyPressed); if (keyPulse(26) != 0) return 90; /* Z */

    key(0x45, keyData, keyPressed); if (keyPulse(69) != 0) { if (shiftDown != 0) return shiftedDigit(0); return 48; }
    key(0x16, keyData, keyPressed); if (keyPulse(22) != 0) { if (shiftDown != 0) return shiftedDigit(1); return 49; }
    key(0x1E, keyData, keyPressed); if (keyPulse(30) != 0) { if (shiftDown != 0) return shiftedDigit(2); return 50; }
    key(0x26, keyData, keyPressed); if (keyPulse(38) != 0) { if (shiftDown != 0) return shiftedDigit(3); return 51; }
    key(0x25, keyData, keyPressed); if (keyPulse(37) != 0) { if (shiftDown != 0) return shiftedDigit(4); return 52; }
    key(0x2E, keyData, keyPressed); if (keyPulse(46) != 0) { if (shiftDown != 0) return shiftedDigit(5); return 53; }
    key(0x36, keyData, keyPressed); if (keyPulse(54) != 0) { if (shiftDown != 0) return shiftedDigit(6); return 54; }
    key(0x3D, keyData, keyPressed); if (keyPulse(61) != 0) { if (shiftDown != 0) return shiftedDigit(7); return 55; }
    key(0x3E, keyData, keyPressed); if (keyPulse(62) != 0) { if (shiftDown != 0) return shiftedDigit(8); return 56; }
    key(0x46, keyData, keyPressed); if (keyPulse(70) != 0) { if (shiftDown != 0) return shiftedDigit(9); return 57; }

    key(0x29, keyData, keyPressed); if (keyPulse(41) != 0) return 32; /* Space */
    key(0x4E, keyData, keyPressed); if (keyPulse(78) != 0) { if (shiftDown != 0) return 95; return 45; } /* - _ */
    key(0x55, keyData, keyPressed); if (keyPulse(85) != 0) { if (shiftDown != 0) return 43; return 61; } /* = + */
    key(0x54, keyData, keyPressed); if (keyPulse(84) != 0) { if (shiftDown != 0) return 123; return 91; } /* [ { */
    key(0x5B, keyData, keyPressed); if (keyPulse(91) != 0) { if (shiftDown != 0) return 125; return 93; } /* ] } */
    key(0x4C, keyData, keyPressed); if (keyPulse(76) != 0) { if (shiftDown != 0) return 58; return 59; } /* ; : */
    key(0x52, keyData, keyPressed); if (keyPulse(82) != 0) { if (shiftDown != 0) return 34; return 39; } /* ' " */
    key(0x41, keyData, keyPressed); if (keyPulse(65) != 0) { if (shiftDown != 0) return 60; return 44; } /* , < */
    key(0x49, keyData, keyPressed); if (keyPulse(73) != 0) { if (shiftDown != 0) return 62; return 46; } /* . > */
    key(0x4A, keyData, keyPressed); if (keyPulse(74) != 0) { if (shiftDown != 0) return 63; return 47; } /* / ? */
    key(0x0E, keyData, keyPressed); if (keyPulse(14) != 0) { if (shiftDown != 0) return 126; return 96; } /* ` ~ */

    return 0;
}

int readAnyKeyCode()
{
    int c;

    inputNow = millis();
    c = readTypedChar();
    if (c != 0) return c;

    key(0x5A, keyData, keyPressed);
    if (keyPulse(90) != 0) return 13;      /* Enter */

    key(0x66, keyData, keyPressed);
    if (keyPulse(102) != 0) return 8;      /* Backspace */

    key(0x0D, keyData, keyPressed);
    if (keyPulse(13) != 0) return 9;       /* Tab */

    if (keyPulseAny3(107, 0x6B, 0xE06B, 0x016B) != 0) { restoreShiftForNavigationIfLatched(); return 130; }    /* Left */

    if (keyPulseAny3(116, 0x74, 0xE074, 0x0174) != 0) { restoreShiftForNavigationIfLatched(); return 131; }    /* Right */

    if (keyPulseAny3(117, 0x75, 0xE075, 0x0175) != 0) { restoreShiftForNavigationIfLatched(); return 132; }    /* Up */

    if (keyPulseAny3(114, 0x72, 0xE072, 0x0172) != 0) { restoreShiftForNavigationIfLatched(); return 133; }    /* Down */

    if (keyPulseAny3(113, 0x71, 0xE071, 0x0171) != 0) return 127;    /* Delete */

    if (keyPulseAny3(108, 0x6C, 0xE06C, 0x016C) != 0) { restoreShiftForNavigationIfLatched(); return 134; }    /* Home */

    if (keyPulseAny3(105, 0x69, 0xE069, 0x0169) != 0) { restoreShiftForNavigationIfLatched(); return 135; }    /* End */

    if (keyPulseAny3(125, 0x7D, 0xE07D, 0x017D) != 0) { restoreShiftForNavigationIfLatched(); return 136; }    /* Page Up */

    if (keyPulseAny3(122, 0x7A, 0xE07A, 0x017A) != 0) { restoreShiftForNavigationIfLatched(); return 137; }    /* Page Down */

    return 0;
}

int rawKeyDownNow(int scancode)
{
    if (scancode < 0) return 0;
    if (scancode > 255) return 0;

    key(scancode, keyData, keyPressed);
    if (keyPressed != (uint)0) return 1;
    return 0;
}


void pollLineKeys()
{
    typedChar = readTypedChar();
    hitEnter = 0;
    hitBack = 0;
    hitLeft = 0;
    hitRight = 0;
    hitTab = 0;
    hitUp = 0;
    hitDown = 0;
    hitDelete = 0;
    hitHome = 0;
    hitEnd = 0;
    hitPgUp = 0;
    hitPgDown = 0;
    hitF1 = 0;
    hitF2 = 0;
    hitF3 = 0;
    hitF4 = 0;
    hitF5 = 0;
    hitF6 = 0;
    hitF10 = 0;
    hitF9 = 0;

    key(0x5A, keyData, keyPressed);
    if (keyPulse(90) != 0) hitEnter = 1;

    key(0x66, keyData, keyPressed);
    if (keyPulse(102) != 0) hitBack = 1;

    if (keyPulseAny3(107, 0x6B, 0xE06B, 0x016B) != 0) hitLeft = 1;

    if (keyPulseAny3(116, 0x74, 0xE074, 0x0174) != 0) hitRight = 1;

    key(0x0D, keyData, keyPressed);
    if (keyPulse(13) != 0) hitTab = 1;

    if (keyPulseAny3(117, 0x75, 0xE075, 0x0175) != 0) hitUp = 1;

    if (keyPulseAny3(114, 0x72, 0xE072, 0x0172) != 0) hitDown = 1;

    if (keyPulseAny3(113, 0x71, 0xE071, 0x0171) != 0) hitDelete = 1;

    if (keyPulseAny3(108, 0x6C, 0xE06C, 0x016C) != 0) hitHome = 1;

    if (keyPulseAny3(105, 0x69, 0xE069, 0x0169) != 0) hitEnd = 1;

    if (keyPulseAny3(125, 0x7D, 0xE07D, 0x017D) != 0) hitPgUp = 1;

    if (keyPulseAny3(122, 0x7A, 0xE07A, 0x017A) != 0) hitPgDown = 1;

    if (hitLeft != 0 || hitRight != 0 || hitUp != 0 || hitDown != 0 || hitHome != 0 || hitEnd != 0 || hitPgUp != 0 || hitPgDown != 0) {
        restoreShiftForNavigationIfLatched();
    }

    /* F1/F2 are reserved by the OS, so the editor does not bind them. */

    key(0x04, keyData, keyPressed);
    if (keyPulse(4) != 0) hitF3 = 1;

    key(0x0C, keyData, keyPressed);
    if (keyPulse(12) != 0) hitF4 = 1;

    key(0x03, keyData, keyPressed);
    if (keyPulse(3) != 0) hitF5 = 1;

    key(0x0B, keyData, keyPressed);
    if (keyPulse(11) != 0) hitF6 = 1;

    key(0x09, keyData, keyPressed);
    if (keyPulse(9) != 0) hitF10 = 1;

    key(0x01, keyData, keyPressed);
    if (keyPulse(1) != 0) hitF9 = 1;
}

void editorSetupViewport()
{
    editViewStart = 0;
    editViewCols = CON_COLS - editStartX;
    if (editViewCols < 1) editViewCols = 1;
    if (editViewCols > LINE_MAX) editViewCols = LINE_MAX;
}

void editorClampView(int cursor)
{
    if (cursor < 0) cursor = 0;
    if (cursor >= LINE_MAX) cursor = LINE_MAX - 1;

    if (cursor < editViewStart) editViewStart = cursor;
    if (cursor >= editViewStart + editViewCols) {
        editViewStart = cursor - editViewCols + 1;
    }
    if (editViewStart < 0) editViewStart = 0;
}

void editorMoveToPos(int pos)
{
    int sx;
    if (pos < 0) pos = 0;
    if (pos >= LINE_MAX) pos = LINE_MAX - 1;
    editorClampView(pos);
    sx = editStartX + pos - editViewStart;
    if (sx < 0) sx = 0;
    if (sx >= CON_COLS) sx = CON_COLS - 1;
    conY = editStartY;
    conX = sx;
}


void editorSelectionCancel()
{
    editSelActive = 0;
    editSelAnchor = 0;
    editSelStart = 0;
    editSelEnd = 0;
}

void editorSelectionBeginIfNeeded(int cursor)
{
    if (editSelActive == 0) {
        editSelAnchor = cursor;
        editSelStart = cursor;
        editSelEnd = cursor;
        editSelActive = 1;
    }
}

void editorSelectionUpdate(int cursor)
{
    if (editSelActive == 0) return;

    if (cursor < editSelAnchor) {
        editSelStart = cursor;
        editSelEnd = editSelAnchor;
    } else {
        editSelStart = editSelAnchor;
        editSelEnd = cursor;
    }

    if (editSelStart < 0) editSelStart = 0;
    if (editSelEnd < 0) editSelEnd = 0;
    if (editSelStart >= LINE_MAX) editSelStart = LINE_MAX - 1;
    if (editSelEnd >= LINE_MAX) editSelEnd = LINE_MAX - 1;

    if (editSelStart == editSelEnd) editSelActive = 0;
}

int editorHasSelection()
{
    if (editSelActive == 0) return 0;
    if (editSelStart == editSelEnd) return 0;
    return 1;
}

int editorPosSelected(int logicalPos)
{
    if (editorHasSelection() == 0) return 0;
    if (logicalPos < editSelStart) return 0;
    if (logicalPos >= editSelEnd) return 0;
    return 1;
}

int editorDeleteSelectionFromInput(int len)
{
    int i;
    int removeCount;

    if (editorHasSelection() == 0) return len;

    removeCount = editSelEnd - editSelStart;
    i = editSelStart;
    while (i + removeCount < len) {
        inputLine[i] = inputLine[i + removeCount];
        i = i + 1;
    }
    while (i < len) {
        inputLine[i] = 0;
        i = i + 1;
    }
    len = len - removeCount;
    if (len < 0) len = 0;
    inputLine[len] = 0;
    return len;
}

void editorDrawLogical(int logicalPos, int len, int cursor)
{
    int sx;
    int absPos;
    char c;

    sx = logicalPos - editViewStart;
    if (sx < 0) return;
    if (sx >= editViewCols) return;

    sx = editStartX + sx;
    if (sx < 0) return;
    if (sx >= CON_COLS) return;
    if (editStartY < 0) return;
    if (editStartY >= CON_ROWS) return;

    if (logicalPos < len) c = inputLine[logicalPos];
    else c = 32;

    absPos = editStartY * CON_COLS + sx;
    conBuf[absPos] = c;

    if (logicalPos == cursor) drawCellCursor(sx, editStartY);
    else if (editorPosSelected(logicalPos) != 0) drawCellCursor(sx, editStartY);
    else drawCell(sx, editStartY);
}

void editorRedrawViewport(int len, int cursor)
{
    int i;
    int logicalPos;

    if (cursor >= 0) editorClampView(cursor);

    i = 0;
    while (i < editViewCols) {
        logicalPos = editViewStart + i;
        editorDrawLogical(logicalPos, len, cursor);
        i = i + 1;
    }
}

void editorRedrawFrom(int startPos, int len, int cursor)
{
    int logicalPos;

    if (startPos < editViewStart) startPos = editViewStart;
    logicalPos = startPos;
    while (logicalPos < editViewStart + editViewCols) {
        editorDrawLogical(logicalPos, len, cursor);
        logicalPos = logicalPos + 1;
    }
}

void editorRedrawCursorMove(int len, int oldCursor, int newCursor)
{
    int oldView;

    oldView = editViewStart;
    editorClampView(newCursor);

    if (oldView != editViewStart) {
        editorRedrawViewport(len, newCursor);
        return;
    }

    editorDrawLogical(oldCursor, len, -1);
    editorDrawLogical(newCursor, len, newCursor);
}

void editorRedrawEdit(int startPos, int len, int cursor)
{
    int oldView;

    oldView = editViewStart;
    editorClampView(cursor);

    if (oldView != editViewStart) {
        editorRedrawViewport(len, cursor);
        return;
    }

    editorRedrawFrom(startPos, len, cursor);
}

void editorInsertChar(int len, int cursor, char c)
{
    int i;
    i = len;
    while (i > cursor) {
        inputLine[i] = inputLine[i - 1];
        i = i - 1;
    }
    inputLine[cursor] = c;
}

void editorDeleteLeft(int len, int cursor)
{
    int i;
    i = cursor - 1;
    while (i < len - 1) {
        inputLine[i] = inputLine[i + 1];
        i = i + 1;
    }
    inputLine[len - 1] = 0;
}

void reserveEditorRows()
{
    if (conY < CON_ROWS) return;
    scrollConsole();
}

#ifdef __NARM__
int editor_mouse_cursor(int len, int cursor)
{
    struct NarmMouseEvent event;
    int x;
    int y;
    int next;
    int changed;
    int remaining;

    changed = 0;
    remaining = 32;
    while (remaining > 0 && narm_mouse_poll_event(&event) > 0) {
        remaining = remaining - 1;
        if (mouse_cancel_gesture(&event) != 0) { mouseDrag = 0; continue; }
        x = event.x / mousePixelScale;
        y = (event.y / mousePixelScale - 1) / FONT_H;
        if (mouse_press_left(&event) != 0) {
            mouseDrag = 0;
            if (editMouseSubmitRow >= 0 && y == editMouseSubmitRow && x < 8 * FONT_W) {
                hitEnter = 1;
                break;
            }
            if (y != editStartY || x < editStartX * FONT_W) continue;
            if (shiftDown != 0) editorSelectionBeginIfNeeded(cursor);
            else editorSelectionCancel();
            mouseDrag = 1;
            changed = 1;
        }
        if (mouseDrag == 0) continue;
        if (mouse_press_left(&event) == 0) editorSelectionBeginIfNeeded(cursor);
        next = editViewStart + (x - 1 + FONT_W / 2) / FONT_W - editStartX;
        if (next < 0) next = 0;
        if (next > len) next = len;
        if (next != cursor) changed = 1;
        cursor = next;
        if (editSelActive != 0) editorSelectionUpdate(cursor);
        if ((event.buttons & NARM_MOUSE_BUTTON_LEFT) == 0) mouseDrag = 0;
    }
    if (changed != 0) editorRedrawViewport(len, cursor);
    return cursor;
}
#endif

void read_line_editor()
{
    int done;
    int len;
    int cursor;
    int i;
    int hadSelection;
    int oldCursor;
    int deleteStart;

    clear_chars(inputLine, LINE_MAX);
    editorSelectionCancel();
    len = 0;
    cursor = 0;
    done = 0;
    editStartX = conX;
    editStartY = conY;
    editorSetupViewport();
    editorRedrawViewport(len, cursor);
#ifdef __NARM__
    mouse_reset_ui_input();
#endif

    while (done == 0) {
        inputNow = millis();
        pollLineKeys();
#ifdef __NARM__
        pollNarmSystemEvents();
        if (hitEnter || hitLeft || hitRight || hitHome || hitEnd ||
            hitBack || hitDelete || hitTab || typedChar) mouseDrag = 0;
        else cursor = editor_mouse_cursor(len, cursor);
#endif

        if (hitLeft != 0) {
            if (cursor > 0) {
                oldCursor = cursor;
                if (shiftDown != 0) editorSelectionBeginIfNeeded(cursor);
                cursor = cursor - 1;
                if (shiftDown != 0) {
                    editorSelectionUpdate(cursor);
                    editorRedrawViewport(len, cursor);
                } else {
                    hadSelection = editorHasSelection();
                    editorSelectionCancel();
                    if (hadSelection != 0) editorRedrawViewport(len, cursor);
                    else editorRedrawCursorMove(len, oldCursor, cursor);
                }
            } else {
                if (shiftDown == 0) {
                    if (editorHasSelection() != 0) {
                        editorSelectionCancel();
                        editorRedrawViewport(len, cursor);
                    }
                }
            }
        }

        if (hitRight != 0) {
            if (cursor < len) {
                oldCursor = cursor;
                if (shiftDown != 0) editorSelectionBeginIfNeeded(cursor);
                cursor = cursor + 1;
                if (shiftDown != 0) {
                    editorSelectionUpdate(cursor);
                    editorRedrawViewport(len, cursor);
                } else {
                    hadSelection = editorHasSelection();
                    editorSelectionCancel();
                    if (hadSelection != 0) editorRedrawViewport(len, cursor);
                    else editorRedrawCursorMove(len, oldCursor, cursor);
                }
            } else {
                if (shiftDown == 0) {
                    if (editorHasSelection() != 0) {
                        editorSelectionCancel();
                        editorRedrawViewport(len, cursor);
                    }
                }
            }
        }

        if (hitHome != 0) {
            if (cursor != 0) {
                oldCursor = cursor;
                if (shiftDown != 0) editorSelectionBeginIfNeeded(cursor);
                cursor = 0;
                if (shiftDown != 0) {
                    editorSelectionUpdate(cursor);
                    editorRedrawViewport(len, cursor);
                } else {
                    hadSelection = editorHasSelection();
                    editorSelectionCancel();
                    if (hadSelection != 0) editorRedrawViewport(len, cursor);
                    else editorRedrawCursorMove(len, oldCursor, cursor);
                }
            }
        }

        if (hitEnd != 0) {
            if (cursor != len) {
                oldCursor = cursor;
                if (shiftDown != 0) editorSelectionBeginIfNeeded(cursor);
                cursor = len;
                if (shiftDown != 0) {
                    editorSelectionUpdate(cursor);
                    editorRedrawViewport(len, cursor);
                } else {
                    hadSelection = editorHasSelection();
                    editorSelectionCancel();
                    if (hadSelection != 0) editorRedrawViewport(len, cursor);
                    else editorRedrawCursorMove(len, oldCursor, cursor);
                }
            }
        }

        if (hitTab != 0) {
            if (editorHasSelection() != 0) {
                deleteStart = editSelStart;
                len = editorDeleteSelectionFromInput(len);
                cursor = deleteStart;
                editorSelectionCancel();
                editorRedrawViewport(len, cursor);
            }
            g_i = 4 - (cursor % 4);
            while (g_i > 0) {
                if (len < LINE_MAX - 1) {
                    editorInsertChar(len, cursor, (char)32);
                    len = len + 1;
                    cursor = cursor + 1;
                    inputLine[len] = 0;
                    editorRedrawEdit(cursor - 1, len, cursor);
                }
                g_i = g_i - 1;
            }
        }

        if (typedChar >= 32) {
            if (typedChar < 127) {
                if (editorHasSelection() != 0) {
                    deleteStart = editSelStart;
                    len = editorDeleteSelectionFromInput(len);
                    cursor = deleteStart;
                    editorSelectionCancel();
                    editorRedrawViewport(len, cursor);
                }
                if (len < LINE_MAX - 1) {
                    editorInsertChar(len, cursor, (char)typedChar);
                    len = len + 1;
                    cursor = cursor + 1;
                    inputLine[len] = 0;
                    editorRedrawEdit(cursor - 1, len, cursor);
                }
            }
        }

        if (hitBack != 0) {
            if (editorHasSelection() != 0) {
                deleteStart = editSelStart;
                len = editorDeleteSelectionFromInput(len);
                cursor = deleteStart;
                editorSelectionCancel();
                editorRedrawViewport(len, cursor);
            } else if (cursor > 0) {
                editorDeleteLeft(len, cursor);
                len = len - 1;
                cursor = cursor - 1;
                inputLine[len] = 0;
                editorRedrawEdit(cursor, len, cursor);
            }
        }

        if (hitDelete != 0) {
            if (editorHasSelection() != 0) {
                deleteStart = editSelStart;
                len = editorDeleteSelectionFromInput(len);
                cursor = deleteStart;
                editorSelectionCancel();
                editorRedrawViewport(len, cursor);
            } else if (cursor < len) {
                i = cursor;
                while (i < len - 1) {
                    inputLine[i] = inputLine[i + 1];
                    i = i + 1;
                }
                len = len - 1;
                inputLine[len] = 0;
                editorRedrawEdit(cursor, len, cursor);
            }
        }

        if (hitEnter != 0) {
            done = 1;
            editorSelectionCancel();
            editorRedrawViewport(len, -1);
            editorMoveToPos(len);
            con_nl();
        }

        flushScreen();
    }

    editorSelectionCancel();
#ifdef __NARM__
    mouse_reset_ui_input();
#endif
    g_len = len;
}

/* ------------------------------------------------------------------------- */
/* BASIC parser/executor                                                     */
/* ------------------------------------------------------------------------- */

int bc_line_index_for_pc(int pc)
{
    int i;
    i = 0;
    while (i < lineCount) {
        if (pc >= bcLineStart[i]) {
            if (pc < bcLineEnd[i]) return i;
        }
        i = i + 1;
    }
    return -1;
}

void fail(int code)
{
    int ln;
    int idx;

    if (errFlag != 0) return;
    errFlag = code;
    running = 0;

    con_error_prefix();
    con_int(code);
    con_char(' ');
    con_char('L'); con_char('I'); con_char('N'); con_char('E'); con_char(' ');

    ln = 0;

    /* v76: bytecode RUN does not execute through exec_line(), so currentPc can
       be stale unless we map the active bytecode pc back to a source line. */
    if (bcReady != 0) {
        idx = bc_line_index_for_pc(bcPc);
        if (idx < 0 && bcRunLinePc >= 0) idx = bc_line_index_for_pc(bcRunLinePc);
        if (idx >= 0) {
            if (idx < lineCount) {
                if (lineHasNumber[idx] != 0) ln = lineNum[idx];
                else ln = idx + 1;
            }
        }
    }

    if (ln == 0) {
        if (currentPc >= 0) {
            if (currentPc < lineCount) {
                if (lineHasNumber[currentPc] != 0) ln = lineNum[currentPc];
                else ln = currentPc + 1;
            }
        }
    }
    con_int(ln);
    con_nl();
}

void skip_spaces()
{
    while (ip < currentEnd) {
        if (is_space(prog[ip]) == 0) return;
        ip = ip + 1;
    }
}

int word_break_at(int p)
{
    char c;
    if (p >= currentEnd) return 1;
    c = prog[p];
    if (is_alpha(c) != 0) return 0;
    if (is_digit(c) != 0) return 0;
    if (c == '_') return 0;
    if (c == '.') return 0;
    if (c == '$') return 1;
    return 1;
}

int match_kw2(char a, char b)
{
    if (ip + 2 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    return word_break_at(ip + 2);
}

int match_kw3(char a, char b, char c)
{
    if (ip + 3 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    return word_break_at(ip + 3);
}

int match_kw4(char a, char b, char c, char d)
{
    if (ip + 4 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    return word_break_at(ip + 4);
}

int match_kw5(char a, char b, char c, char d, char e)
{
    if (ip + 5 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    if (to_upper(prog[ip + 4]) != e) return 0;
    return word_break_at(ip + 5);
}

int match_kw6(char a, char b, char c, char d, char e, char f)
{
    if (ip + 6 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    if (to_upper(prog[ip + 4]) != e) return 0;
    if (to_upper(prog[ip + 5]) != f) return 0;
    return word_break_at(ip + 6);
}

int match_kw7(char a, char b, char c, char d, char e, char f, char g)
{
    if (ip + 7 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    if (to_upper(prog[ip + 4]) != e) return 0;
    if (to_upper(prog[ip + 5]) != f) return 0;
    if (to_upper(prog[ip + 6]) != g) return 0;
    return word_break_at(ip + 7);
}

int match_kw8(char a, char b, char c, char d, char e, char f, char g, char h)
{
    if (ip + 8 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    if (to_upper(prog[ip + 4]) != e) return 0;
    if (to_upper(prog[ip + 5]) != f) return 0;
    if (to_upper(prog[ip + 6]) != g) return 0;
    if (to_upper(prog[ip + 7]) != h) return 0;
    return word_break_at(ip + 8);
}

int match_kw12(char a, char b, char c, char d, char e, char f, char g, char h, char i, char j, char k, char l)
{
    if (ip + 12 > currentEnd) return 0;
    if (to_upper(prog[ip]) != a) return 0;
    if (to_upper(prog[ip + 1]) != b) return 0;
    if (to_upper(prog[ip + 2]) != c) return 0;
    if (to_upper(prog[ip + 3]) != d) return 0;
    if (to_upper(prog[ip + 4]) != e) return 0;
    if (to_upper(prog[ip + 5]) != f) return 0;
    if (to_upper(prog[ip + 6]) != g) return 0;
    if (to_upper(prog[ip + 7]) != h) return 0;
    if (to_upper(prog[ip + 8]) != i) return 0;
    if (to_upper(prog[ip + 9]) != j) return 0;
    if (to_upper(prog[ip + 10]) != k) return 0;
    if (to_upper(prog[ip + 11]) != l) return 0;
    return word_break_at(ip + 12);
}

int parse_path_arg_or_default()
{
    int n;
    int quoted;
    char c;

    clear_chars(filePath, PATH_MAX);
    filePathLen = 0;
    skip_spaces();

    if (ip >= currentEnd) {
        set_default_path();
        return 1;
    }

    quoted = 0;
    if (prog[ip] == 34) {
        quoted = 1;
        ip = ip + 1;
    }

    n = 0;
    while (ip < currentEnd) {
        c = prog[ip];
        if (quoted != 0) {
            if (c == 34) break;
        } else {
            if (is_space(c) != 0) break;
        }

        if (n < PATH_MAX - 1) {
            filePath[n] = c;
            n = n + 1;
        }
        ip = ip + 1;
    }

    if (quoted != 0) {
        if (ip >= currentEnd) {
            con_error_prefix(); con_char('Q'); con_char('U'); con_char('O'); con_char('T'); con_char('E'); con_nl();
            return 0;
        }
        if (prog[ip] != 34) {
            con_error_prefix(); con_char('Q'); con_char('U'); con_char('O'); con_char('T'); con_char('E'); con_nl();
            return 0;
        }
        ip = ip + 1;
    }

    filePathLen = n;
    if (filePathLen <= 0) set_default_path();

    skip_spaces();
    if (ip < currentEnd) {
        con_error_prefix(); con_char('P'); con_char('A'); con_char('T'); con_char('H'); con_nl();
        return 0;
    }

    return 1;
}


int parse_uint_lit()
{
    int v;
    v = 0;
    skip_spaces();
    while (ip < currentEnd) {
        if (is_digit(prog[ip]) == 0) return v;
        v = v * 10 + (int)(prog[ip] - '0');
        ip = ip + 1;
    }
    return v;
}

int var_record_base(int idx)
{
    if (idx < 0) return 0;
    if (idx >= VAR_META_MAX) return 0;
    return varRecordAddr[idx];
}

int var_name_base(int idx)
{
    return var_record_base(idx);
}

char var_name_get(int idx, int pos)
{
    return pool_byte_get(var_name_base(idx) + pos);
}

void var_name_set(int idx, int pos, char value)
{
    pool_byte_set(var_name_base(idx) + pos, value);
}

int var_int_get(int idx)
{
    return pool_int_get(var_record_base(idx) + 36);
}

void var_int_set(int idx, int value)
{
    pool_int_set(var_record_base(idx) + 36, value);
}

float var_float_get(int idx)
{
    return pool_float_get(var_record_base(idx) + 40);
}

void var_float_set(int idx, float value)
{
    pool_float_set(var_record_base(idx) + 40, value);
}

int var_used_get(int idx)
{
    return (int)pool_byte_get(var_record_base(idx) + 44);
}

void var_used_set(int idx, int value)
{
    pool_byte_set(var_record_base(idx) + 44, (char)value);
}

int var_is_string_get(int idx)
{
    return (int)pool_byte_get(var_record_base(idx) + 45);
}

void var_is_string_set(int idx, int value)
{
    pool_byte_set(var_record_base(idx) + 45, (char)value);
}

int var_is_float_get(int idx)
{
    return (int)pool_byte_get(var_record_base(idx) + 46);
}

void var_is_float_set(int idx, int value)
{
    pool_byte_set(var_record_base(idx) + 46, (char)value);
}

int var_str_len_get(int idx)
{
    return (int)pool_byte_get(var_record_base(idx) + 47);
}

void var_str_len_set(int idx, int value)
{
    pool_byte_set(var_record_base(idx) + 47, (char)value);
}

void clear_ident_tmp()
{
    int i;
    i = 0;
    while (i < VAR_NAME_MAX) {
        identTmp[i] = 0;
        i = i + 1;
    }
}

int is_ident_start(char c)
{
    if (is_alpha(c) != 0) return 1;
    if (c == '_') return 1;
    return 0;
}

int is_ident_char(char c)
{
    if (is_alpha(c) != 0) return 1;
    if (is_digit(c) != 0) return 1;
    if (c == '_') return 1;
    if (c == '.') return 1;
    return 0;
}

int parse_ident_to_tmp()
{
    int n;
    int tooLong;
    char c;

    clear_ident_tmp();
    identIsString = 0;
    skip_spaces();
    if (ip >= currentEnd) return 0;
    c = prog[ip];
    if (is_ident_start(c) == 0) return 0;

    n = 0;
    tooLong = 0;
    while (ip < currentEnd) {
        c = prog[ip];
        if (c == '$') {
            identIsString = 1;
            if (n < 32) {
                identTmp[n] = '$';
                n = n + 1;
            } else {
                tooLong = 1;
            }
            ip = ip + 1;
            break;
        }
        if (is_ident_char(c) == 0) break;
        if (n < 32) {
            identTmp[n] = to_upper(c);
            n = n + 1;
        } else {
            tooLong = 1;
        }
        ip = ip + 1;
    }

    if (tooLong != 0) { fail(20); return 0; }
    if (n <= 0) return 0;
    return 1;
}

int ident_equals_var(int idx)
{
    int i;
    int base;
    char a;
    char b;

    if (idx < 0) return 0;
    if (idx >= varCount) return 0;
    if (var_used_get(idx) == 0) return 0;

    base = var_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = identTmp[i];
        b = pool_byte_get(base + i);
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

void copy_ident_to_var(int idx)
{
    int i;
    int base;
    base = var_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        pool_byte_set(base + i, identTmp[i]);
        i = i + 1;
    }
}

int find_var_from_ident()
{
    int i;
    i = 0;
    while (i < varCount) {
        if (ident_equals_var(i) != 0) return i;
        i = i + 1;
    }
    return -1;
}

int find_or_create_var_from_ident()
{
    int idx;
    idx = find_var_from_ident();
    if (idx >= 0) return idx;
    if (pool_alloc_scalar_record(identIsString) == 0) { fail(19); return 0; }
    idx = varCount;
    var_used_set(idx, 1);
    var_int_set(idx, 0);
    var_float_set(idx, 0.0f);
    var_is_string_set(idx, identIsString);
    var_is_float_set(idx, 0);
    var_str_len_set(idx, 0);
    copy_ident_to_var(idx);
    varCount = varCount + 1;
    return idx;
}

int label_name_base(int idx)
{
    return idx * VAR_NAME_MAX;
}

void clear_labels()
{
    /* Fast clear: labelCount is the only thing lookup uses.
       Do not wipe labelNames[] every RUN; new labels overwrite their own slots. */
    labelCount = 0;
}

int ident_equals_label(int idx)
{
    int i;
    int base;
    char a;
    char b;

    if (idx < 0) return 0;
    if (idx >= MAX_LABELS) return 0;
    base = label_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = identTmp[i];
        b = labelNames[base + i];
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

int find_label_from_ident()
{
    int i;
    i = 0;
    while (i < labelCount) {
        if (ident_equals_label(i) != 0) return i;
        i = i + 1;
    }
    return -1;
}

void copy_ident_to_label(int idx)
{
    int i;
    int base;
    base = label_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        labelNames[base + i] = identTmp[i];
        i = i + 1;
    }
}

void add_label_from_ident(int lineIdx, int targetIp)
{
    int idx;
    idx = find_label_from_ident();
    if (idx >= 0) { fail(32); return; }
    if (labelCount >= MAX_LABELS) { fail(33); return; }
    idx = labelCount;
    copy_ident_to_label(idx);
    labelLine[idx] = lineIdx;
    labelIp[idx] = targetIp;
    labelCount = labelCount + 1;
}

void skip_to_next_statement_colon()
{
    char c;
    while (ip < currentEnd) {
        c = prog[ip];
        if (c == 39) { ip = currentEnd; return; }
        if (c == 34) {
            ip = ip + 1;
            while (ip < currentEnd) {
                c = prog[ip];
                if (c == 34) { ip = ip + 1; break; }
                ip = ip + 1;
            }
            continue;
        }
        if (c == ':') return;
        ip = ip + 1;
    }
}

void build_labels()
{
    int i;
    int saveIp;

    clear_labels();
    i = 0;
    while (i < lineCount) {
        load_line_to_prog(i);
        ip = 0;
        while (running != 0) {
            skip_spaces();
            if (ip >= currentEnd) break;
            if (prog[ip] == ':') { ip = ip + 1; continue; }
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            saveIp = ip;
            if (parse_ident_to_tmp() != 0) {
                skip_spaces();
                if (ip < currentEnd) {
                    if (prog[ip] == ':') {
                        ip = ip + 1;
                        add_label_from_ident(i, ip);
                        if (running == 0) return;
                        continue;
                    }
                }
            }
            ip = saveIp;
            skip_to_next_statement_colon();
            if (ip < currentEnd) {
                if (prog[ip] == ':') ip = ip + 1;
            }
        }
        i = i + 1;
    }
}


int skip_label_statement_here()
{
    int saveIp;
    saveIp = ip;
    if (parse_ident_to_tmp() != 0) {
        if (identTmp[0] == 'D') {
            if (identTmp[1] == 'O') {
                if (identTmp[2] == 0) { ip = saveIp; return 0; }
            }
        }
        if (identTmp[0] == 'I') {
            if (identTmp[1] == 'F') {
                if (identTmp[2] == 0) { ip = saveIp; return 0; }
            }
        }
        if (identTmp[0] == 'E') {
            if (identTmp[1] == 'L') {
                if (identTmp[2] == 'S') {
                    if (identTmp[3] == 'E') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
            if (identTmp[1] == 'N') {
                if (identTmp[2] == 'D') {
                    if (identTmp[3] == 'I') {
                        if (identTmp[4] == 'F') {
                            if (identTmp[5] == 0) { ip = saveIp; return 0; }
                        }
                    }
                }
            }
        }
        if (identTmp[0] == 'L') {
            if (identTmp[1] == 'O') {
                if (identTmp[2] == 'O') {
                    if (identTmp[3] == 'P') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
        }
        if (identTmp[0] == 'F') {
            if (identTmp[1] == 'O') {
                if (identTmp[2] == 'R') {
                    if (identTmp[3] == 0) { ip = saveIp; return 0; }
                }
            }
        }
        if (identTmp[0] == 'N') {
            if (identTmp[1] == 'E') {
                if (identTmp[2] == 'X') {
                    if (identTmp[3] == 'T') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
        }
        if (identTmp[0] == 'W') {
            if (identTmp[1] == 'H') {
                if (identTmp[2] == 'I') {
                    if (identTmp[3] == 'L') {
                        if (identTmp[4] == 'E') {
                            if (identTmp[5] == 0) { ip = saveIp; return 0; }
                        }
                    }
                }
            }
            if (identTmp[1] == 'E') {
                if (identTmp[2] == 'N') {
                    if (identTmp[3] == 'D') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
        }
        if (identTmp[0] == 'S') {
            if (identTmp[1] == 'E') {
                if (identTmp[2] == 'L') {
                    if (identTmp[3] == 'E') {
                        if (identTmp[4] == 'C') {
                            if (identTmp[5] == 'T') {
                                if (identTmp[6] == 0) { ip = saveIp; return 0; }
                            }
                        }
                    }
                }
            }
        }
        if (identTmp[0] == 'C') {
            if (identTmp[1] == 'A') {
                if (identTmp[2] == 'S') {
                    if (identTmp[3] == 'E') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
            if (identTmp[1] == 'A') {
                if (identTmp[2] == 'L') {
                    if (identTmp[3] == 'L') {
                        if (identTmp[4] == 0) { ip = saveIp; return 0; }
                    }
                }
            }
        }
        if (identTmp[0] == 'S') {
            if (identTmp[1] == 'U') {
                if (identTmp[2] == 'B') {
                    if (identTmp[3] == 0) { ip = saveIp; return 0; }
                }
            }
        }
        if (identTmp[0] == 'F') {
            if (identTmp[1] == 'U') {
                if (identTmp[2] == 'N') {
                    if (identTmp[3] == 'C') {
                        if (identTmp[4] == 'T') {
                            if (identTmp[5] == 'I') {
                                if (identTmp[6] == 'O') {
                                    if (identTmp[7] == 'N') {
                                        if (identTmp[8] == 0) { ip = saveIp; return 0; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (identTmp[0] == 'L') {
            if (identTmp[1] == 'O') {
                if (identTmp[2] == 'C') {
                    if (identTmp[3] == 'A') {
                        if (identTmp[4] == 'L') {
                            if (identTmp[5] == 0) { ip = saveIp; return 0; }
                        }
                    }
                }
            }
        }

        skip_spaces();
        if (ip < currentEnd) {
            if (prog[ip] == ':') {
                ip = ip + 1;
                return 1;
            }
        }
    }
    ip = saveIp;
    return 0;
}

int scan_match_kw2_at(int p, char a, char b)
{
    int saveIp;
    int ok;
    saveIp = ip;
    ip = p;
    ok = match_kw2(a, b);
    ip = saveIp;
    return ok;
}

int scan_match_kw3_at(int p, char a, char b, char c)
{
    int saveIp;
    int ok;
    saveIp = ip;
    ip = p;
    ok = match_kw3(a, b, c);
    ip = saveIp;
    return ok;
}

int scan_match_kw4_at(int p, char a, char b, char c, char d)
{
    int saveIp;
    int ok;
    saveIp = ip;
    ip = p;
    ok = match_kw4(a, b, c, d);
    ip = saveIp;
    return ok;
}

int scan_match_kw5_at(int p, char a, char b, char c, char d, char e)
{
    int saveIp;
    int ok;
    saveIp = ip;
    ip = p;
    ok = match_kw5(a, b, c, d, e);
    ip = saveIp;
    return ok;
}

int scan_then_block_at(int stmtIp)
{
    int p;
    int q;
    char c;

    if (scan_match_kw2_at(stmtIp, 'I', 'F') == 0) return 0;
    p = stmtIp + 2;
    while (p < currentEnd) {
        c = prog[p];
        if (c == 39) return 0;
        if (c == 34) {
            p = p + 1;
            while (p < currentEnd) {
                c = prog[p];
                if (c == 34) { p = p + 1; break; }
                p = p + 1;
            }
            continue;
        }
        if (c == ':') return 0;
        if (scan_match_kw4_at(p, 'T', 'H', 'E', 'N') != 0) {
            q = p + 4;
            while (q < currentEnd) {
                if (is_space(prog[q]) == 0) break;
                q = q + 1;
            }
            if (q >= currentEnd) return 1;
            if (prog[q] == ':') return 1;
            if (prog[q] == 39) return 1;
            return 0;
        }
        p = p + 1;
    }
    return 0;
}

void scan_skip_to_next_statement()
{
    skip_to_next_statement_colon();
    if (ip < currentEnd) {
        if (prog[ip] == ':') ip = ip + 1;
    }
}

void scan_skip_labels_and_colons()
{
    int again;
    again = 1;
    while (again != 0) {
        again = 0;
        skip_spaces();
        while (ip < currentEnd) {
            if (prog[ip] != ':') break;
            ip = ip + 1;
            skip_spaces();
            again = 1;
        }
        while (skip_label_statement_here() != 0) {
            skip_spaces();
            again = 1;
            if (ip < currentEnd) {
                if (prog[ip] == ':') {
                    ip = ip + 1;
                    skip_spaces();
                }
            }
        }
    }
}

void set_jump_to_position(int lineIdx, int pos)
{
    if (lineIdx >= lineCount) {
        jumpTargetLine = lineCount;
        jumpTargetIp = 0;
        return;
    }
    if (pos >= lineLen[lineIdx]) {
        jumpTargetLine = lineIdx + 1;
        jumpTargetIp = 0;
        return;
    }
    jumpTargetLine = lineIdx;
    jumpTargetIp = pos;
}

int find_else_or_endif_after(int startLine, int startIp, int wantElse)
{
    int line;
    int stmtIp;
    int depth;

    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;

        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            stmtIp = ip;
            if (scan_then_block_at(stmtIp) != 0) {
                depth = depth + 1;
            } else if (match_kw5('E','N','D','I','F') != 0) {
                if (depth == 0) {
                    set_jump_to_position(line, ip + 5);
                    return 1;
                }
                depth = depth - 1;
            } else if (match_kw4('E','L','S','E') != 0) {
                if (depth == 0) {
                    if (wantElse != 0) {
                        set_jump_to_position(line, ip + 4);
                        return 1;
                    }
                }
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

int find_loop_after(int startLine, int startIp)
{
    int line;
    int stmtIp;
    int depth;

    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;

        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;

            stmtIp = ip;
            if (match_kw2('D','O') != 0) {
                depth = depth + 1;
            } else if (match_kw4('L','O','O','P') != 0) {
                if (depth == 0) {
                    set_jump_to_position(line, ip + 4);
                    return 1;
                }
                depth = depth - 1;
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

int do_top_is_current(int lineIdx, int pos)
{
    if (doSp <= 0) return 0;
    if (doLineStack[doSp - 1] != lineIdx) return 0;
    if (doIpStack[doSp - 1] != pos) return 0;
    return 1;
}

int sub_name_base(int idx)
{
    return idx * VAR_NAME_MAX;
}

int sub_param_name_base(int subIdx, int paramIdx)
{
    return (subIdx * MAX_PARAMS + paramIdx) * VAR_NAME_MAX;
}

void clear_subs()
{
    int i;
    int oldSubCount;
    oldSubCount = subCount;
    subCount = 0;
    i = 0;
    while (i < oldSubCount) {
        subLine[i] = 0;
        subIp[i] = 0;
        subIsFunction[i] = 0;
        subParamCount[i] = 0;
        i = i + 1;
    }
}

int ident_equals_sub(int idx)
{
    int i;
    int base;
    char a;
    char b;
    if (idx < 0) return 0;
    if (idx >= MAX_SUBS) return 0;
    base = sub_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        a = identTmp[i];
        b = subNames[base + i];
        if (a != b) return 0;
        if (a == 0) return 1;
        i = i + 1;
    }
    return 1;
}

int find_sub_from_ident()
{
    int i;
    i = 0;
    while (i < subCount) {
        if (ident_equals_sub(i) != 0) return i;
        i = i + 1;
    }
    return -1;
}

void copy_ident_to_sub(int idx)
{
    int i;
    int base;
    base = sub_name_base(idx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        subNames[base + i] = identTmp[i];
        i = i + 1;
    }
}

void copy_ident_to_sub_param(int subIdx, int paramIdx)
{
    int i;
    int base;
    base = sub_param_name_base(subIdx, paramIdx);
    i = 0;
    while (i < VAR_NAME_MAX) {
        subParamNames[base + i] = identTmp[i];
        i = i + 1;
    }
}

void copy_sub_param_to_ident(int subIdx, int paramIdx)
{
    int i;
    int base;
    char c;
    base = sub_param_name_base(subIdx, paramIdx);
    identIsString = 0;
    i = 0;
    while (i < VAR_NAME_MAX) {
        c = subParamNames[base + i];
        identTmp[i] = c;
        if (c == '$') identIsString = 1;
        if (c == 0) return;
        i = i + 1;
    }
}

int add_sub_from_ident(int isFunc, int lineIdx, int targetIp)
{
    int idx;
    idx = find_sub_from_ident();
    if (idx >= 0) { fail(44); return -1; }
    if (subCount >= MAX_SUBS) { fail(45); return -1; }
    idx = subCount;
    copy_ident_to_sub(idx);
    subLine[idx] = lineIdx;
    subIp[idx] = targetIp;
    subIsFunction[idx] = isFunc;
    subParamCount[idx] = 0;
    subCount = subCount + 1;
    return idx;
}

void parse_sub_params(int subIdx)
{
    int n;
    skip_spaces();
    if (ip >= currentEnd) return;
    if (prog[ip] != '(') return;
    ip = ip + 1;
    n = 0;
    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] == ')') { ip = ip + 1; return; }
    }
    while (running != 0) {
        if (n >= MAX_PARAMS) { fail(46); return; }
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        if (identIsString != 0) { fail(22); return; }
        copy_ident_to_sub_param(subIdx, n);
        n = n + 1;
        subParamCount[subIdx] = n;
        skip_spaces();
        if (ip >= currentEnd) { fail(12); return; }
        if (prog[ip] == ',') { ip = ip + 1; continue; }
        if (prog[ip] == ')') { ip = ip + 1; return; }
        fail(12);
        return;
    }
}

int match_end_sub_here()
{
    int saveIp;
    saveIp = ip;
    if (match_kw3('E','N','D') == 0) return 0;
    ip = ip + 3;
    skip_spaces();
    if (match_kw3('S','U','B') == 0) { ip = saveIp; return 0; }
    ip = saveIp;
    return 1;
}

int match_end_function_here()
{
    int saveIp;
    saveIp = ip;
    if (match_kw3('E','N','D') == 0) return 0;
    ip = ip + 3;
    skip_spaces();
    if (match_kw8('F','U','N','C','T','I','O','N') == 0) { ip = saveIp; return 0; }
    ip = saveIp;
    return 1;
}

int find_end_sub_or_function_after(int startLine, int startIp, int wantFunc)
{
    int line;
    int stmtIp;
    int depth;
    line = startLine;
    depth = 0;
    while (line < lineCount) {
        load_line_to_prog(line);
        if (line == startLine) ip = startIp;
        else ip = 0;
        while (ip < currentEnd) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;
            stmtIp = ip;
            if (wantFunc == 0) {
                if (match_kw3('S','U','B') != 0) depth = depth + 1;
                else if (match_end_sub_here() != 0) {
                    if (depth == 0) { ip = ip + 3; skip_spaces(); ip = ip + 3; set_jump_to_position(line, ip); return 1; }
                    depth = depth - 1;
                }
            } else {
                if (match_kw8('F','U','N','C','T','I','O','N') != 0) depth = depth + 1;
                else if (match_end_function_here() != 0) {
                    if (depth == 0) { ip = ip + 3; skip_spaces(); ip = ip + 8; set_jump_to_position(line, ip); return 1; }
                    depth = depth - 1;
                }
            }
            ip = stmtIp;
            scan_skip_to_next_statement();
        }
        line = line + 1;
    }
    jumpTargetLine = lineCount;
    jumpTargetIp = 0;
    return 0;
}

void build_subs()
{
    int i;
    int saveIp;
    int idx;
    int isFunc;
    int startLine;
    int startIp;
    clear_subs();
    i = 0;
    while (i < lineCount) {
        load_line_to_prog(i);
        ip = 0;
        while (running != 0) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;
            saveIp = ip;
            isFunc = -1;
            if (match_kw3('S','U','B') != 0) { ip = ip + 3; isFunc = 0; }
            else if (match_kw8('F','U','N','C','T','I','O','N') != 0) { ip = ip + 8; isFunc = 1; }
            if (isFunc >= 0) {
                skip_spaces();
                if (parse_ident_to_tmp() == 0) { fail(5); return; }
                idx = add_sub_from_ident(isFunc, i + 1, 0);
                if (running == 0) return;
                parse_sub_params(idx);
                if (running == 0) return;
                skip_to_next_statement_colon();
                if (ip < currentEnd) {
                    if (prog[ip] == ':') { ip = ip + 1; startLine = i; startIp = ip; }
                    else { startLine = i + 1; startIp = 0; }
                } else { startLine = i + 1; startIp = 0; }
                subLine[idx] = startLine;
                subIp[idx] = startIp;
                if (find_end_sub_or_function_after(startLine, startIp, isFunc) == 0) { fail(47); return; }
                i = jumpTargetLine;
                if (i < lineCount) { load_line_to_prog(i); ip = jumpTargetIp; }
                continue;
            }
            ip = saveIp;
            scan_skip_to_next_statement();
        }
        i = i + 1;
    }
}

int data_item_base(int idx)
{
    return idx * DATA_ITEM_MAX;
}

void clear_data_table()
{
    int i;
    int oldDataCount;
    oldDataCount = dataCount;
    dataCount = 0;
    dataPtr = 0;
    i = 0;
    while (i < oldDataCount) { dataLen[i] = 0; dataLine[i] = 0; i = i + 1; }
}

void add_data_item_from_range(int lineIdx, int startPos, int endPos)
{
    int n;
    int base;
    char c;
    while (startPos < endPos) { if (is_space(prog[startPos]) == 0) break; startPos = startPos + 1; }
    while (endPos > startPos) { if (is_space(prog[endPos - 1]) == 0) break; endPos = endPos - 1; }
    if (dataCount >= MAX_DATA) { fail(48); return; }
    base = data_item_base(dataCount);
    n = 0;
    while (startPos < endPos) {
        c = prog[startPos];
        if (n < DATA_ITEM_MAX - 1) { dataItems[base + n] = c; n = n + 1; }
        startPos = startPos + 1;
    }
    dataItems[base + n] = 0;
    dataLen[dataCount] = n;
    dataLine[dataCount] = lineIdx;
    dataCount = dataCount + 1;
}

void scan_data_statement(int lineIdx)
{
    int start;
    int quoted;
    char c;
    ip = ip + 4;
    start = ip;
    quoted = 0;
    while (ip <= currentEnd) {
        if (ip >= currentEnd) {
            add_data_item_from_range(lineIdx, start, ip);
            return;
        }
        c = prog[ip];
        if (c == 34) quoted = 1 - quoted;
        if (quoted == 0) {
            if (c == ',') {
                add_data_item_from_range(lineIdx, start, ip);
                if (running == 0) return;
                ip = ip + 1;
                start = ip;
                continue;
            }
            if (c == ':') {
                add_data_item_from_range(lineIdx, start, ip);
                return;
            }
            if (c == 39) {
                add_data_item_from_range(lineIdx, start, ip);
                return;
            }
        }
        ip = ip + 1;
    }
}

void build_data_table()
{
    int i;
    clear_data_table();
    i = 0;
    while (i < lineCount) {
        load_line_to_prog(i);
        ip = 0;
        while (running != 0) {
            scan_skip_labels_and_colons();
            if (ip >= currentEnd) break;
            if (prog[ip] == 39) break;
            if (match_kw3('R','E','M') != 0) break;
            if (match_kw4('D','A','T','A') != 0) scan_data_statement(i);
            else scan_skip_to_next_statement();
        }
        i = i + 1;
    }
    dataPtr = 0;
}

int pool_alloc_array_record(int isString, int total)
{
    int bytes;
    int nextTop;
    if (arrayCount >= ARRAY_META_MAX) return 0;
    bytes = ARRAY_RECORD_HEADER_BYTES + total * ARRAY_NUM_RECORD_BYTES;
    if (isString != 0) bytes = ARRAY_RECORD_HEADER_BYTES + total * ARRAY_STR_RECORD_BYTES;
    nextTop = poolVarTop - bytes;
    if (nextTop < pool_source_bytes()) return 0;
    poolVarTop = nextTop;
    arrayRecordAddr[arrayCount] = nextTop;
    return 1;
}

int array_record_base(int idx)
{
    if (idx < 0) return 0;
    if (idx >= ARRAY_META_MAX) return 0;
    return arrayRecordAddr[idx];
}

int array_name_base(int idx)
{
    return array_record_base(idx);
}

int array_used_get(int idx)
{
    return (int)pool_byte_get(array_record_base(idx) + 33);
}

void array_used_set(int idx, int value)
{
    pool_byte_set(array_record_base(idx) + 33, (char)value);
}

int array_is_string_get(int idx)
{
    return (int)pool_byte_get(array_record_base(idx) + 34);
}

void array_is_string_set(int idx, int value)
{
    pool_byte_set(array_record_base(idx) + 34, (char)value);
}

int array_dims_get(int idx)
{
    return (int)pool_byte_get(array_record_base(idx) + 35);
}

void array_dims_set(int idx, int value)
{
    pool_byte_set(array_record_base(idx) + 35, (char)value);
}

int array_total_get(int idx)
{
    return pool_int_get(array_record_base(idx) + 36);
}

void array_total_set(int idx, int value)
{
    pool_int_set(array_record_base(idx) + 36, value);
}

int array_dim_size_get(int idx, int dim)
{
    return pool_int_get(array_record_base(idx) + 40 + dim * 4);
}

void array_dim_size_set(int idx, int dim, int value)
{
    pool_int_set(array_record_base(idx) + 40 + dim * 4, value);
}

int array_data_base(int idx)
{
    return array_record_base(idx) + ARRAY_RECORD_HEADER_BYTES;
}

int array_num_int_get(int arr, int lin)
{
    return pool_int_get(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES);
}

void array_num_int_set(int arr, int lin, int value)
{
    pool_int_set(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES, value);
}

float array_num_float_get(int arr, int lin)
{
    return pool_float_get(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES + 4);
}

void array_num_float_set(int arr, int lin, float value)
{
    pool_float_set(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES + 4, value);
}

int array_num_is_float_get(int arr, int lin)
{
    return (int)pool_byte_get(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES + 8);
}

void array_num_is_float_set(int arr, int lin, int value)
{
    pool_byte_set(array_data_base(arr) + lin * ARRAY_NUM_RECORD_BYTES + 8, (char)value);
}

int array_str_base(int arr, int lin)
{
    return array_data_base(arr) + lin * ARRAY_STR_RECORD_BYTES + 4;
}

int array_str_len_get(int arr, int lin)
{
    return (int)pool_byte_get(array_data_base(arr) + lin * ARRAY_STR_RECORD_BYTES);
}

void array_str_len_set(int arr, int lin, int value)
