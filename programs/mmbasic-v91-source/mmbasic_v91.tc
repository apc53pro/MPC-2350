#ifdef __NARM__
void fs_mouse_scroll(int rows)
{
    int limit;
    limit = lineCount - FS_VISIBLE_ROWS;
    if (limit < 0) limit = 0;
    fsTopLine = fsTopLine + rows;
    if (fsTopLine < 0) fsTopLine = 0;
    if (fsTopLine > limit) fsTopLine = limit;
    fsMouseViewport = 1;
}

int fs_mouse_toolbar(int col)
{
    /* The columns match the labels in fs_draw_bottom_line(). */
    if (col < 8) hitF10 = 1;
    else if (col >= 9 && col < 18) hitF3 = 1;
    else if (col >= 19 && col < 26) hitF4 = 1;
    else if (col >= 27 && col < 33) hitF5 = 1;
    else if (col >= 34 && col < 40) hitF6 = 1;
    else if (col >= 41 && col < 48) hitF9 = 1;
    else return 0;
    return 1;
}

void fs_mouse_place(int x, int y)
{
    int row;
    int col;
    row = (y + 4) / FONT_H - FS_SOURCE_ROW;
    if (row < 0) row = 0;
    if (row >= FS_VISIBLE_ROWS) row = FS_VISIBLE_ROWS - 1;
    col = (x - 1 + FONT_W / 2) / FONT_W;
    if (col >= CON_COLS) col = CON_COLS - 1;
    fsCurLine = fsTopLine + row;
    fsCurCol = fsLeftCol + col;
    if (fsCurLine >= lineCount) {
        fsCurLine = lineCount - 1;
        fsCurCol = lineLen[fsCurLine];
    }
    fsMouseViewport = 1;
    fs_clamp_cursor();
    if (fsCurCol < fsLeftCol) fsLeftCol = fsCurCol;
    if (fsCurCol >= fsLeftCol + CON_COLS) fsLeftCol = fsCurCol - CON_COLS + 1;
}

int fs_mouse_poll()
{
    struct NarmMouseEvent event;
    struct NarmMouseState state;
    int remaining;
    int x;
    int y;
    int sourceTop;
    int sourceBottom;
    int oldLine;
    int oldCol;
    int clearedSelection;
    int pressing;
    static uint lastScroll;

    sourceTop = FS_SOURCE_ROW * FONT_H - 4;
    sourceBottom = sourceTop + FS_VISIBLE_ROWS * FONT_H;
    oldLine = fsCurLine;
    oldCol = fsCurCol;
    clearedSelection = 0;
    remaining = 32;
    while (remaining > 0 && narm_mouse_poll_event(&event) > 0) {
        remaining = remaining - 1;
        if (mouse_cancel_gesture(&event) != 0) { mouseDrag = 0; continue; }
        x = event.x / mousePixelScale;
        y = event.y / mousePixelScale;
        pressing = mouse_press_left(&event);
        if (pressing != 0) {
            mouseDrag = 0;
            if (y >= (CON_ROWS - 1) * FONT_H && fs_mouse_toolbar(x / FONT_W) != 0) break;
            if (y < sourceTop || y >= sourceBottom) continue;
            if (shiftDown != 0) fs_selection_begin_if_needed();
            else {
                if (fs_selection_has_range() != 0) clearedSelection = 1;
                fs_selection_cancel();
            }
            fs_mouse_place(x, y);
            fs_selection_begin_if_needed();
            mouseDrag = 1;
            lastScroll = inputNow;
        }
        if (event.wheel != 0) fs_mouse_scroll(-3 * event.wheel);
        if (mouseDrag == 0) continue;
        if (pressing == 0 || event.wheel != 0) fs_mouse_place(x, y);
        if ((event.buttons & NARM_MOUSE_BUTTON_LEFT) == 0) mouseDrag = 0;
    }

    /* Keep extending a drag at the edge even if the mouse stops reporting motion. */
    if (mouseDrag != 0 && (uint)(inputNow - lastScroll) >= 60u) {
        if (narm_mouse_get_state(&state) != 0 ||
            (state.flags & NARM_MOUSE_FOCUSED) == 0 ||
            (state.buttons & NARM_MOUSE_BUTTON_LEFT) == 0) mouseDrag = 0;
        else {
            x = state.x / mousePixelScale;
            y = state.y / mousePixelScale;
            if (y < sourceTop && fsTopLine > 0) fs_mouse_scroll(-1);
            if (y >= sourceBottom && fsTopLine + FS_VISIBLE_ROWS < lineCount) fs_mouse_scroll(1);
            if (x <= 1 && fsLeftCol > 0) fsLeftCol = fsLeftCol - 1;
            if (x >= CON_COLS * FONT_W - 1 && fsCurCol < lineLen[fsCurLine]) fsLeftCol = fsLeftCol + 1;
            fs_mouse_place(x, y);
        }
        lastScroll = inputNow;
    }
    if (clearedSelection != 0) return 3;
    if (oldLine != fsCurLine || oldCol != fsCurCol) return 11;
    return 0;
}

void fs_redraw_mouse_selection(int oldLine)
{
    int line;
    int end;
    line = oldLine;
    end = fsCurLine;
    if (oldLine > fsCurLine) { line = fsCurLine; end = oldLine; }
    if (line < fsTopLine) line = fsTopLine;
    if (end >= fsTopLine + FS_VISIBLE_ROWS) end = fsTopLine + FS_VISIBLE_ROWS - 1;
    while (line <= end) {
        fs_redraw_one_source_line(line);
        line = line + 1;
    }
    fs_paint_status_line(1);
    fs_draw_bottom_line();
}
#endif

void fs_editor_loop()
{
    int oldLine;
    int oldCol;
    int oldTop;
    int oldLeft;
    int oldCount;
    int oldStatus;
    int redrawMode;
    int fastAppend;
    int fastTabAppend;
    int oldLen;
    int oldWasEndBack;
    int oldWasEndDelete;
    int enterAppendOnly;
    int joinEofOnly;
    int selMoveMode;

    if (sourceDiscarded != 0) {
        load_program_sd();
    }
    fsNeedRedraw = 1;
    fsStatus = 0;
#ifdef __NARM__
    fsEditorActive = 1;
    fsMouseViewport = 0;
    mouse_reset_ui_input();
#endif
    fs_clamp_cursor();
    while (uiMode != 0) {
        inputNow = millis();
        pollLineKeys();

        oldLine = fsCurLine;
        oldCol = fsCurCol;
        oldTop = fsTopLine;
        oldLeft = fsLeftCol;
        oldCount = lineCount;
        oldStatus = fsStatus;
        redrawMode = 0;
        fastAppend = 0;
        fastTabAppend = 0;
        oldLen = lineLen[fsCurLine];
        oldWasEndBack = 0;
        oldWasEndDelete = 0;
        enterAppendOnly = 0;
        joinEofOnly = 0;
        selMoveMode = 0;

#ifdef __NARM__
        pollNarmSystemEvents();
        if (hitUp || hitDown || hitLeft || hitRight || hitHome || hitEnd ||
            hitPgUp || hitPgDown || hitBack || hitDelete || hitEnter || hitTab || typedChar) {
            mouseDrag = 0;
            fsMouseViewport = 0;
        } else if (!(hitF3 || hitF4 || hitF5 || hitF6 || hitF9 || hitF10)) {
            redrawMode = fs_mouse_poll();
        }
        if (hitF3 || hitF4 || hitF5 || hitF6 || hitF9 || hitF10) {
            mouseDrag = 0;
            fsEditorActive = 0;
            if (hitF4 || hitF6 || hitF9) fsMouseViewport = 0;
        }
#endif

        if (hitF10 != 0) { fs_selection_cancel(); fs_editor_help_screen(); redrawMode = 3; }
        else if (hitF3 != 0) { fs_selection_cancel(); fs_editor_save_as(); redrawMode = 3; }
        else if (hitF4 != 0) { fs_selection_cancel(); load_program_sd(); fsCurLine = 0; fsCurCol = 0; fsTopLine = 0; fsLeftCol = 0; fsStatus = 2; redrawMode = 3; }
        else if (hitF5 != 0) { fs_selection_cancel(); fs_run_program_from_editor(); redrawMode = 3; }
        else if (hitF6 != 0) { fs_selection_cancel(); clear_program(); fsCurLine = 0; fsCurCol = 0; fsTopLine = 0; fsLeftCol = 0; fsStatus = 3; redrawMode = 3; }
        else if (hitF9 != 0) {
            fs_selection_cancel();
            uiMode = 0;
            /* v57: make REPL switch immediate and force classic black/white.
               Do not print the full help page here; HELP remains available. */
            COL_BG = (uint)0;
            COL_TEXT = (uint)255;
            consoleClear();
            con_lit_title();
            con_lit_ready();
            flushScreen();
            return;
        }
        else if (hitUp != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); fsCurLine = fsCurLine - 1; fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitDown != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); fsCurLine = fsCurLine + 1; fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitLeft != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); if (fsCurCol > 0) fsCurCol = fsCurCol - 1; else if (fsCurLine > 0) { fsCurLine = fsCurLine - 1; fsCurCol = lineLen[fsCurLine]; } fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitRight != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); if (fsCurCol < lineLen[fsCurLine]) fsCurCol = fsCurCol + 1; else if (fsCurLine + 1 < lineCount) { fsCurLine = fsCurLine + 1; fsCurCol = 0; } fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitHome != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); fsCurCol = 0; fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitEnd != 0) { selMoveMode = fs_prepare_cursor_move_for_selection(); fsCurCol = lineLen[fsCurLine]; fs_finish_cursor_move_for_selection(); if (shiftDown != 0) redrawMode = 3; else if (selMoveMode == 2) redrawMode = 3; else redrawMode = 4; }
        else if (hitPgUp != 0) { fs_prepare_cursor_move_for_selection(); fsCurLine = fsCurLine - FS_VISIBLE_ROWS; fs_finish_cursor_move_for_selection(); redrawMode = 3; }
        else if (hitPgDown != 0) { fs_prepare_cursor_move_for_selection(); fsCurLine = fsCurLine + FS_VISIBLE_ROWS; fs_finish_cursor_move_for_selection(); redrawMode = 3; }
        else if (hitBack != 0) {
            if (fs_selection_has_range() != 0) {
                fs_delete_selection(); fsStatus = 0; redrawMode = 3;
            } else {
                if (fsCurCol == oldLen) if (oldLen > 0) oldWasEndBack = 1;
                if (fsCurCol == 0) if (fsCurLine > 0) if (fsCurLine == oldCount - 1) joinEofOnly = 1;
                fs_backspace(); fsStatus = 0;
                /* v71: if Backspace at line 0/col 0, no line join happened. */
                if (joinEofOnly != 0) redrawMode = 10;
                else if (oldWasEndBack != 0) redrawMode = 7;
                else redrawMode = 8;
            }
        }
        else if (hitDelete != 0) {
            if (fs_selection_has_range() != 0) {
                fs_delete_selection(); fsStatus = 0; redrawMode = 3;
            } else {
                if (fsCurCol >= oldLen) oldWasEndDelete = 1;
                fs_delete_char_at_cursor(); fsStatus = 0;
                if (oldWasEndDelete != 0) redrawMode = 6;
                else redrawMode = 8;
            }
        }
        else if (hitEnter != 0) {
            if (fs_selection_has_range() != 0) {
                fs_delete_selection(); fs_enter_split(); fsStatus = 0; redrawMode = 3;
            } else {
                if (fsCurLine == oldCount - 1) if (fsCurCol == oldLen) enterAppendOnly = 1;
                fs_enter_split(); fsStatus = 0;
                if (enterAppendOnly != 0) redrawMode = 9;
                else redrawMode = 6;
            }
        }
        else if (hitTab != 0) {
            if (fs_selection_has_range() != 0) {
                fs_delete_selection();
                g_i = 4 - (fsCurCol % 4);
                while (g_i > 0) { fs_insert_char(' '); g_i = g_i - 1; }
                fsStatus = 0; redrawMode = 3;
            } else {
                if (fsCurCol == oldLen) fastTabAppend = 1;
                g_i = 4 - (fsCurCol % 4);
                while (g_i > 0) { fs_insert_char(' '); g_i = g_i - 1; }
                fsStatus = 0;
                if (fastTabAppend != 0) redrawMode = 5;
                else redrawMode = 2;
            }
        }
        else if (typedChar >= 32) {
            if (typedChar < 127) {
                if (fs_selection_has_range() != 0) {
                    fs_delete_selection();
                    fs_insert_char((char)typedChar);
                    fsStatus = 0; redrawMode = 3;
                } else {
                    if (fsCurCol == oldLen) fastAppend = 1;
                    fs_insert_char((char)typedChar);
                    fsStatus = 0;
                    if (fastAppend != 0) redrawMode = 5;
                    else redrawMode = 2;
                }
            }
        }

#ifdef __NARM__
        fsEditorActive = 1;
#endif
        fs_clamp_cursor();

        if (fsNeedRedraw != 0) redrawMode = 3;
        if (oldTop != fsTopLine) redrawMode = 3;
        if (oldLeft != fsLeftCol) redrawMode = 3;
        if (oldCount != lineCount) {
            /* v62: keep the fast append-new-line path.  v59/v60 accidentally
               overwrote redrawMode 9 with redrawMode 6 whenever lineCount changed,
               so Enter at end-of-file redrew the whole visible editor area. */
            if (redrawMode != 3) {
                if (redrawMode != 9) { if (redrawMode != 10) redrawMode = 6; }
            }
        }

        if (redrawMode == 3) {
            fs_redraw_all();
            fsNeedRedraw = 0;
#ifdef __NARM__
        } else if (redrawMode == 11) {
            fs_redraw_mouse_selection(oldLine);
#endif
        } else if (redrawMode == 10) {
            fs_redraw_join_eof(oldLine, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode == 7) {
            fs_redraw_backspace_end(oldLine, oldCol, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode == 8) {
            fs_redraw_delete_tail(oldLine, oldCol, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode == 9) {
            fs_draw_source_pos(oldLine, oldCol, 0);
            fs_draw_source_pos(fsCurLine, fsCurCol, 1);
            if (oldStatus != fsStatus) fs_draw_bottom_line();
            fsNeedRedraw = 0;
        } else if (redrawMode == 4) {
            fs_redraw_cursor_move(oldLine, oldCol, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode == 5) {
            if (fastTabAppend != 0) fs_redraw_fast_tab_append(oldLine, oldCol, oldStatus);
            else fs_redraw_fast_append(oldLine, oldCol, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode == 6) {
            if (oldLine < fsCurLine) fs_redraw_visible_from_line(oldLine, oldStatus);
            else fs_redraw_visible_from_line(fsCurLine, oldStatus);
            fsNeedRedraw = 0;
        } else if (redrawMode != 0) {
            fs_redraw_dirty_lines(oldLine, oldStatus);
            fsNeedRedraw = 0;
        } else if (oldStatus != fsStatus) {
            fs_draw_bottom_line();
            fsNeedRedraw = 0;
        }

#ifdef __NARM__
        // Finish queued swaps and follow the pointer during idle editor loops.
        flushScreen();
#else
        if (redrawMode != 0 || screenDirty != 0) flushScreen();
#endif
    }
}

void repl_loop()
{
    while (uiMode == 0) {
        reserveEditorRows();
        con_char('>');
        flushScreen();
        read_line_editor();
        process_repl_line();
        flushScreen();
    }
}

void env_loop()
{
    fs_editor_loop();
}

void init_keys()
{
    int i;
    i = 0;
    while (i < 128) {
        keyWas[i] = 0;
        keyNextPulse[i] = (uint)0;
        keyCoolUntil[i] = (uint)0;
        i = i + 1;
    }
}

int main()
{
    clear_program();
    clear_vars();
    initFontTable();
    set_default_path();
    init_file_handles();
    init_keys();
    editor_load_config();
    uiMode = 1;
    COL_BG = (uint)0;
    COL_TEXT = (uint)255;
    consoleClear();

    while (1) {
        if (uiMode == 0) repl_loop();
        else env_loop();
    }

    return 0;
}
