void mouse_reset_ui_input()
{
    struct NarmMouseEvent event;
    struct NarmMouseMotion motion;
    int remaining;
    mouseDrag = 0;
    mouseEventValid = 0;
    mouseMotionValid = 0;
    /* The firmware queue holds 32 reports. Bound the drain under live input. */
    remaining = 32;
    while (remaining > 0 && narm_mouse_poll_event(&event) > 0) {
        remaining = remaining - 1;
    }
    narm_mouse_read_motion(&motion);
}

int mouse_press_left(struct NarmMouseEvent *event)
{
    return (event->changed_buttons & event->buttons & NARM_MOUSE_BUTTON_LEFT) != 0;
}

int mouse_cancel_gesture(struct NarmMouseEvent *event)
{
    return (event->type & (NARM_MOUSE_EVENT_RESYNC | NARM_MOUSE_EVENT_DISCONNECT)) != 0;
}
