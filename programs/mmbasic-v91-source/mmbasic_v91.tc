    int w;
    int h;
    int fillColor;
    int borderColor;
    int textColor;

    ip = ip + 7;
    x = parse_expr();
    if (running == 0) return;
    y = next_gfx_arg();
    if (running == 0) return;
    w = next_gfx_arg();
    if (running == 0) return;
    h = next_gfx_arg();
    if (running == 0) return;
    if (expect_comma() == 0) return;
    if (parse_string_expr() == 0) return;
    fillColor = next_gfx_arg();
    if (running == 0) return;
    borderColor = next_gfx_arg();
    if (running == 0) return;
    textColor = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    drawButtonGfx(x, y, w, h, (uint)fillColor, (uint)borderColor, (uint)textColor);
}

