/* v50 bytecode runtime limits.  RUN executes only this token stream.
   v83 separates packed editable source text from bytecode.
   v84 stores the unified bytecode stream as packed uint8[] varint bytes.
   BC_MAX is now byte capacity, not word/token capacity. */
#define BC_MAX_BYTES 262144
#define BC_SEEK_STRIDE 32
#define BC_TOKEN_CACHE_SIZE 128
int BC_MAX = BC_MAX_BYTES;
