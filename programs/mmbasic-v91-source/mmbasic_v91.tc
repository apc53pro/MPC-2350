void print_bc_info()
{
    con_char('B'); con_char('Y'); con_char('T'); con_char('E'); con_char('C'); con_char('O'); con_char('D'); con_char('E'); con_nl();
    con_char('B'); con_char('C'); con_char(' '); con_int(bcLen); con_char('T'); con_char(' '); con_int(bcByteLen); con_char('/'); con_int(BC_MAX); con_char('B'); con_nl();
    con_char('S'); con_char('T'); con_char('R'); con_char(' '); con_int(bcStrLen); con_char('/'); con_int(BC_STR_MAX); con_nl();
    con_char('F'); con_char('L'); con_char('T'); con_char(' '); con_int(bcFloatLen); con_char('/'); con_int(BC_FLOAT_MAX); con_nl();
    con_char('S'); con_char('R'); con_char('C'); con_char(' '); con_int(bcSourceTextBytes); con_char(' ');
    if (sourceDiscarded != 0) { con_char('D'); con_char('I'); con_char('S'); con_char('C'); con_char('A'); con_char('R'); con_char('D'); con_char('E'); con_char('D'); }
    else { con_char('P'); con_char('R'); con_char('E'); con_char('S'); con_char('E'); con_char('N'); con_char('T'); }
    con_nl();
    con_char('R'); con_char('E'); con_char('A'); con_char('D'); con_char('Y'); con_char('='); con_int(bcReady); con_char(' ');
    con_char('D'); con_char('I'); con_char('R'); con_char('T'); con_char('Y'); con_char('='); con_int(sourceDirty); con_nl();
}

void compile_program_only()
{
    if (sourceDiscarded != 0) { print_bc_info(); return; }
    if (lineCount <= 0) { con_char('N'); con_char('O'); con_char(' '); con_char('P'); con_char('R'); con_char('O'); con_char('G'); con_char('R'); con_char('A'); con_char('M'); con_nl(); return; }
    errFlag = 0;
    running = 1;
    if (bc_build_program() == 0) return;
    con_char('C'); con_char('O'); con_char('M'); con_char('P'); con_char('I'); con_char('L'); con_char('E'); con_char('D'); con_char(' ');
    con_int(bcLen); con_char('T'); con_char(' '); con_int(bcByteLen); con_char('/'); con_int(BC_MAX); con_char('B'); con_char(' ');
    con_char('S'); con_char('R'); con_char('C'); con_char(' '); con_char('K'); con_char('E'); con_char('P'); con_char('T'); con_char(' '); con_char('P'); con_char('A'); con_char('C'); con_char('K'); con_char('E'); con_char('D'); con_nl();
}

void compact_program_to_bytecode()
{
    if (sourceDiscarded != 0) { print_bc_info(); return; }
    compile_program_only();
    if (running == 0) return;
    if (bcReady == 0) return;
    discard_source_after_compile();
    con_char('S'); con_char('O'); con_char('U'); con_char('R'); con_char('C'); con_char('E'); con_char(' ');
    con_char('K'); con_char('E'); con_char('P'); con_char('T'); con_char(' '); con_char('P'); con_char('A'); con_char('C'); con_char('K'); con_char('E'); con_char('D'); con_nl();
}

void process_repl_line()
{
    int p;
    int num;
    int hasDigit;
    int i;

    currentEnd = g_len;
    ip = 0;
    i = 0;
    while (i < LINE_MAX) {
        prog[i] = inputLine[i];
        i = i + 1;
    }

    skip_spaces();
    if (ip >= currentEnd) return;

    if (is_digit(prog[ip]) != 0) {
        num = 0;
        hasDigit = 0;
        while (ip < currentEnd) {
            if (is_digit(prog[ip]) == 0) break;
            hasDigit = 1;
            num = num * 10 + (int)(prog[ip] - '0');
            ip = ip + 1;
        }
        p = ip;
        if (hasDigit != 0) store_program_line(num, p, currentEnd);
        return;
    }

    if (match_kw3('R','U','N') != 0) {
        ip = ip + 3;
        if (rest_is_end() != 0) { run_program(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw7('C','O','M','P','I','L','E') != 0) {
        ip = ip + 7;
        if (rest_is_end() != 0) { compile_program_only(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw7('C','O','M','P','A','C','T') != 0) {
        ip = ip + 7;
        if (rest_is_end() != 0) { compact_program_to_bytecode(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw6('B','C','I','N','F','O') != 0) {
        ip = ip + 6;
        if (rest_is_end() != 0) { print_bc_info(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw4('L','I','S','T') != 0) {
        ip = ip + 4;
        if (rest_is_end() != 0) { list_program(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw3('N','E','W') != 0) {
        ip = ip + 3;
        if (rest_is_end() != 0) {
            clear_program();
            clear_vars();
            con_char('N'); con_char('E'); con_char('W'); con_nl();
            return;
        }
    }
    ip = 0; skip_spaces();
    if (match_kw4('L','O','A','D') != 0) {
        ip = ip + 4;
        if (parse_path_arg_or_default() != 0) { load_program_sd(); return; }
        return;
    }
    ip = 0; skip_spaces();
    if (match_kw4('S','A','V','E') != 0) {
        ip = ip + 4;
        if (parse_path_arg_or_default() != 0) { save_program_sd(); return; }
        return;
    }
    ip = 0; skip_spaces();
    if (match_kw3('M','E','M') != 0) {
        ip = ip + 3;
        if (rest_is_end() != 0) { print_memory(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw6('M','E','M','O','R','Y') != 0) {
        ip = ip + 6;
        if (rest_is_end() != 0) { print_memory(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw3('C','L','S') != 0) {
        ip = ip + 3;
        if (rest_is_end() != 0) { consoleClear(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw6('E','D','I','T','O','R') != 0) {
        ip = ip + 6;
        if (rest_is_end() != 0) { uiMode = 1; fsNeedRedraw = 1; return; }
    }
    ip = 0; skip_spaces();
    if (match_kw4('R','E','P','L') != 0) {
        ip = ip + 4;
        if (rest_is_end() != 0) { uiMode = 0; con_lit_ready(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw4('H','E','L','P') != 0) {
        ip = ip + 4;
        if (rest_is_end() != 0) { print_help(); return; }
    }
    ip = 0; skip_spaces();
    if (match_kw3('B','Y','E') != 0) {
        ip = ip + 3;
        if (rest_is_end() != 0) { halt(); return; }
    }

    exec_direct();
}


void process_env_line()
{
    int p;
    int num;
    int hasDigit;
    int i;

    currentEnd = g_len;
    ip = 0;
    i = 0;
    while (i < LINE_MAX) {
        prog[i] = inputLine[i];
        i = i + 1;
    }

    skip_spaces();
    if (ip >= currentEnd) return;

    if (match_kw4('H','E','L','P') != 0) { ip = ip + 4; if (rest_is_end() != 0) { env_help(); return; } }
    ip = 0; skip_spaces();
    if (match_kw4('M','E','N','U') != 0) { ip = ip + 4; if (rest_is_end() != 0) { env_header(); env_help(); return; } }
    ip = 0; skip_spaces();
    if (match_kw4('E','D','I','T') != 0) { ip = ip + 4; if (rest_is_end() != 0) { env_header(); list_program(); return; } }
    ip = 0; skip_spaces();
    if (match_kw4('L','I','S','T') != 0) { ip = ip + 4; if (rest_is_end() != 0) { list_program(); return; } }
    ip = 0; skip_spaces();
    if (match_kw3('R','U','N') != 0) { ip = ip + 3; if (rest_is_end() != 0) { run_program(); return; } }
    ip = 0; skip_spaces();
    if (match_kw7('C','O','M','P','I','L','E') != 0) { ip = ip + 7; if (rest_is_end() != 0) { compile_program_only(); return; } }
    ip = 0; skip_spaces();
    if (match_kw7('C','O','M','P','A','C','T') != 0) { ip = ip + 7; if (rest_is_end() != 0) { compact_program_to_bytecode(); return; } }
    ip = 0; skip_spaces();
    if (match_kw6('B','C','I','N','F','O') != 0) { ip = ip + 6; if (rest_is_end() != 0) { print_bc_info(); return; } }
    ip = 0; skip_spaces();
    if (match_kw3('N','E','W') != 0) { ip = ip + 3; if (rest_is_end() != 0) { clear_program(); clear_vars(); con_char('N'); con_char('E'); con_char('W'); con_nl(); return; } }
    ip = 0; skip_spaces();
    if (match_kw4('L','O','A','D') != 0) { ip = ip + 4; if (parse_path_arg_or_default() != 0) { load_program_sd(); return; } return; }
    ip = 0; skip_spaces();
    if (match_kw4('S','A','V','E') != 0) { ip = ip + 4; if (parse_path_arg_or_default() != 0) { save_program_sd(); return; } return; }
    ip = 0; skip_spaces();
    if (match_kw3('M','E','M') != 0) { ip = ip + 3; if (rest_is_end() != 0) { print_memory(); return; } }
    ip = 0; skip_spaces();
    if (match_kw3('C','L','S') != 0) { ip = ip + 3; if (rest_is_end() != 0) { consoleClear(); return; } }
    ip = 0; skip_spaces();
    if (match_kw4('R','E','P','L') != 0) {
        ip = ip + 4;
        if (rest_is_end() != 0) {
            uiMode = 0;
            consoleClear();
            con_lit_title();
            con_lit_ready();
            print_help();
            return;
        }
    }
    ip = 0; skip_spaces();
    if (match_kw5('F','I','L','E','S') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw5('C','H','D','I','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw5('M','K','D','I','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw5('R','M','D','I','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw4('K','I','L','L') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw5('C','O','L','O','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw6('C','O','L','O','U','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw3('I','N','K') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw5('P','A','P','E','R') != 0) { exec_direct(); return; }
    ip = 0; skip_spaces();
    if (match_kw3('B','Y','E') != 0) { exec_direct(); return; }

    ip = 0;
    skip_spaces();
    if (is_digit(prog[ip]) != 0) {
        num = 0;
        hasDigit = 0;
        while (ip < currentEnd) {
            if (is_digit(prog[ip]) == 0) break;
            hasDigit = 1;
            num = num * 10 + (int)(prog[ip] - '0');
            ip = ip + 1;
        }
        p = ip;
        if (hasDigit != 0) store_program_line(num, p, currentEnd);
        return;
    }

    append_program_line(0, currentEnd);
}


/* ------------------------------------------------------------------------- */
/* Fullscreen source editor                                                   */
/* ------------------------------------------------------------------------- */

/* Editor layout in character rows. Source text starts at row 2 so the upper
   divider has its own pixel line and does not overlap the first source row. */
void fs_paint_cell(int x, int y, char ch, uint fg, uint bg, int paintBackground)
{
    int px;
    int py;
    int gx;
    int gy;
    if (x < 0) return;
    if (x >= CON_COLS) return;
    if (y < 0) return;
    if (y >= CON_ROWS) return;
    px = x * FONT_W;
    py = y * FONT_H;

    /* Editor source/input area: shift 1 px right so text does not touch
       the left edge, and 4 px up to sit better between the divider lines. */
    if (y > 0) {
        if (y < CON_ROWS - 1) {
            px = px + 1;
            py = py - 4;
        }
    }

    gx = px;
    gy = py;
    if (y == 0) { gx = px + 1; gy = py + 1; }
    if (y == CON_ROWS - 1) { gx = px + 1; gy = py; }
    if (paintBackground) fillRectClip(px, py, px + FONT_W - 1, py + FONT_H - 1, bg);
    if (ch != 32) drawGlyph(gx, gy, ch, fg);
    screenDirty = 1;
}

void fs_draw_cell(int x, int y, char ch, uint fg, uint bg, int cursor)
{
    fs_paint_cell(x, y, ch, cursor ? bg : fg, cursor ? fg : bg, 1);
}

int fs_cache_index(int x, int row)
{
    int rr;
    if (x < 0) return -1;
    if (x >= CON_COLS) return -1;
    rr = row - FS_SOURCE_ROW;
    if (rr < 0) return -1;
    if (rr >= FS_VISIBLE_ROWS) return -1;
    return rr * CON_COLS + x;
}

void fs_cache_set(int x, int row, uint color)
{
    int idx;
    idx = fs_cache_index(x, row);
    if (idx < 0) return;
    fsColorCache[idx] = (char)(color & (uint)255);
    fsColorValid[idx] = 1;
}

uint fs_cache_get(int x, int row, int *valid)
{
    int idx;
    idx = fs_cache_index(x, row);
    if (idx < 0) { *valid = 0; return ED_TEXT; }
    if (fsColorValid[idx] == 0) { *valid = 0; return ED_TEXT; }
    *valid = 1;
    return (uint)((int)fsColorCache[idx] & 255);
}

void fs_cache_clear_row(int row)
{
    int x;
    int idx;
    x = 0;
    while (x < CON_COLS) {
        idx = fs_cache_index(x, row);
        if (idx >= 0) { fsColorCache[idx] = (char)(ED_TEXT & (uint)255); fsColorValid[idx] = 1; }
        x = x + 1;
    }
}

#ifdef __NARM__
// Editor source strips occupy 0x400000 through 0x7bffff. The slot can hold
// a 640x14 RGB565 strip. Only the used pixels are uploaded.
#define MM_SOURCE_ROWS 120u
#define MM_SOURCE_CELLS 106u
#define MM_SOURCE_BASE 0x400000u
#define MM_SOURCE_STRIDE 32768u
struct MmSourceCell {
    uint bits0;
    uint bits1;
    uint color;
};
struct MmSourceRow {
    uint age;
    uint hash;
    uint count;
    uint scale;
    uint bg;
    struct MmSourceCell cells[MM_SOURCE_CELLS];
};
struct MmSourceCell mmRowCells[MM_SOURCE_CELLS];
struct MmSourceRow mmRowCache[MM_SOURCE_ROWS];
uint16 mmRowPixels[640];
uint mmRowAge;
uint mmRowCount;

void mm_invalidate_source_rows()
{
    for (uint i = 0; i < MM_SOURCE_ROWS; ++i) mmRowCache[i].count = 0;
    mmRowAge = 0;
}

int mm_upload_source_row(uint addr, uint count, uint scale, uint bg)
{
    uint width = count * 6u * scale;
    uint bytes = (width * 2u + 3u) & ~3u;
    for (uint y = 0; y < 7u; ++y) {
        uint p = 0;
        for (uint i = 0; i < count; ++i) {
            struct MmSourceCell *cell = &mmRowCells[i];
            for (uint x = 0; x < 5u; ++x) {
                uint bit = y * 5u + x;
                uint bits = bit < 32u ? cell->bits0 : cell->bits1;
                uint pixel = bits & (0x80000000u >> (bit & 31u)) ? cell->color : bg;
                mmRowPixels[p++] = (uint16)pixel;
                if (scale == 2u) mmRowPixels[p++] = (uint16)pixel;
            }
            mmRowPixels[p++] = (uint16)bg;
            if (scale == 2u) mmRowPixels[p++] = (uint16)bg;
        }
        if (width & 1u) mmRowPixels[p] = (uint16)bg;
        for (uint sy = 0; sy < scale; ++sy) {
            if (!gd_upload(addr, mmRowPixels, bytes)) return 0;
            addr += bytes;
        }
    }
    return 1;
}

void mm_draw_source_row(int row)
{
    if (!mmRowCount || gdFault) return;
    // Submit the background once, before the first opaque strip copy.
    gd_flush_final();
    if (gdFault) return;
    uint scale = (uint)mm_scale();
    uint bg = gpu_rgb565(mm_rgb(ED_BG));
    uint count = mmRowCount;
    uint hash = (scale ^ bg) * 16777619u;
    for (uint i = 0; i < count; ++i) {
        hash = (hash ^ mmRowCells[i].bits0) * 16777619u;
        hash = (hash ^ mmRowCells[i].bits1) * 16777619u;
        hash = (hash ^ mmRowCells[i].color) * 16777619u;
    }
    uint slot = hash % MM_SOURCE_ROWS;
    uint oldest = slot;
    uint maxAge = 0;
    uint age = ++mmRowAge;
    int hit = 0;
    for (uint n = 0; n < MM_SOURCE_ROWS; ++n) {
        struct MmSourceRow *cached = &mmRowCache[slot];
        if (!cached->count) break;
        if (cached->hash == hash && cached->count == count &&
            cached->scale == scale && cached->bg == bg) {
            uint i = 0;
            while (i < count && cached->cells[i].bits0 == mmRowCells[i].bits0 &&
                   cached->cells[i].bits1 == mmRowCells[i].bits1 &&
                   cached->cells[i].color == mmRowCells[i].color) ++i;
            if (i == count) { hit = 1; break; }
        }
        if (age - cached->age > maxAge) { maxAge = age - cached->age; oldest = slot; }
        slot = (slot + 1u) % MM_SOURCE_ROWS;
    }
    uint width = count * 6u * scale;
    uint height = 7u * scale;
    uint pitch = (width * 2u + 3u) & ~3u;
    // COPY_RECT and uploads are ordered on the GPU. All earlier reads of an
    // evicted slot complete before the replacement reaches VRAM.
    if (!hit && mmRowCache[slot].count) slot = oldest;
    uint addr = MM_SOURCE_BASE + slot * MM_SOURCE_STRIDE;
    struct MmSourceRow *cached = &mmRowCache[slot];
    if (!hit) {
        if (!mm_upload_source_row(addr, count, scale, bg)) {
            mm_invalidate_source_rows();
            return;
        }
        cached->hash = hash;
        cached->count = count;
        cached->scale = scale;
        cached->bg = bg;
        for (uint i = 0; i < count; ++i) {
            cached->cells[i].bits0 = mmRowCells[i].bits0;
            cached->cells[i].bits1 = mmRowCells[i].bits1;
            cached->cells[i].color = mmRowCells[i].color;
        }
    }
    cached->age = age;
    gd_copy(1, 0, addr, width, height, pitch, (int)scale, (row * 8 - 4) * (int)scale,
            width, height);
}
#endif

void fs_draw_source_cell_cached(int x, int row, char ch, uint fg, int rowSprite)
{
    fs_cache_set(x, row, fg);
#ifdef __NARM__
    if (rowSprite) {
        uint glyph = ((uint)ch & 255u) * 2u;
        struct MmSourceCell *cell = &mmRowCells[x];
        cell->bits0 = fontTable[glyph];
        cell->bits1 = fontTable[glyph + 1];
        cell->color = 0;
        if (ch != 32 && (cell->bits0 || cell->bits1)) {
            cell->color = gpu_rgb565(mm_rgb(fg));
            mmRowCount = (uint)x + 1u;
        } else {
            cell->bits0 = 0;
            cell->bits1 = 0;
        }
        return;
    }
#endif
    fs_paint_cell(x, row, ch, fg, ED_BG, 0);
}

void fs_draw_text_at(int x, int y, char s[], int len, uint fg)
{
    int i;
    i = 0;
    while (i < len) {
        if (s[i] == 0) return;
        fs_paint_cell(x + i, y, s[i], fg, ED_BG, 0);
        i = i + 1;
    }
}

void fs_draw_lit_char(int x, int y, char c, uint fg, uint bg)
{
    fs_draw_cell(x, y, c, fg, bg, 0);
}

void fs_clear_row(int y, uint bg)
{
    int py;
    py = y * FONT_H;
    if (y > 0) {
        if (y < CON_ROWS - 1) py = py - 4;
    }
    fillRectClip(0, py, SCREEN_W - 1, py + FONT_H - 1, bg);
    fs_cache_clear_row(y);
    screenDirty = 1;
}

void fs_clear_source_area()
{
    int y0;
    int y1;
    int row;

    /* v69: hard-clear the whole editor text viewport before redraws that move
       lines vertically.  Per-row clears normally work, but after splitting a
       long line at column 0/middle, stale glyph pixels could survive from the
       old row on hardware.  Clearing the complete source rectangle makes line
       split/join redraws deterministic. */
    y0 = FS_SOURCE_ROW * FONT_H - 4;
    if (y0 < 0) y0 = 0;
    y1 = (FS_SOURCE_ROW + FS_VISIBLE_ROWS) * FONT_H - 5;
    if (y1 >= SCREEN_H) y1 = SCREEN_H - 1;
    fillRectClip(0, y0, SCREEN_W - 1, y1, ED_BG);

    row = FS_SOURCE_ROW;
    while (row < FS_SOURCE_ROW + FS_VISIBLE_ROWS) {
        fs_cache_clear_row(row);
        row = row + 1;
    }
    screenDirty = 1;
}

void fs_draw_status_text_char(int x, char c)
{
    fs_paint_cell(x, 0, c, ED_STATUS_TEXT, ED_BG, 0);
}

void fs_paint_status_line(int eraseRow)
{
    int x;
    if (eraseRow) fs_clear_row(0, ED_BG);
    fs_draw_status_text_char(0,'M'); fs_draw_status_text_char(1,'M'); fs_draw_status_text_char(2,'B'); fs_draw_status_text_char(3,'A'); fs_draw_status_text_char(4,'S'); fs_draw_status_text_char(5,'I'); fs_draw_status_text_char(6,'C');
    fs_draw_status_text_char(8,'E'); fs_draw_status_text_char(9,'D'); fs_draw_status_text_char(10,'I'); fs_draw_status_text_char(11,'T'); fs_draw_status_text_char(12,'O'); fs_draw_status_text_char(13,'R');
    fs_draw_status_text_char(15,'L'); fs_draw_status_text_char(16,'N'); fs_draw_status_text_char(17,' ');
    fs_draw_status_text_char(48,'V'); fs_draw_status_text_char(49,MMBASIC_VERSION_C0); fs_draw_status_text_char(50,MMBASIC_VERSION_C1); fs_draw_status_text_char(51,MMBASIC_VERSION_C2);
    x = 18;
    conX = 0; conY = 0;
    /* Draw numeric line/column directly using numTmp to avoid the console. */
    g_i = fsCurLine + 1;
    g_j = 0;
    if (g_i == 0) { numTmp[0] = '0'; g_j = 1; }
    while (g_i > 0) { numTmp[g_j] = (char)('0' + (g_i % 10)); g_i = g_i / 10; g_j = g_j + 1; }
    while (g_j > 0) { g_j = g_j - 1; fs_draw_status_text_char(x, numTmp[g_j]); x = x + 1; }
    fs_draw_status_text_char(x,' '); x = x + 1;
    fs_draw_status_text_char(x,'C'); x = x + 1; fs_draw_status_text_char(x,'O'); x = x + 1; fs_draw_status_text_char(x,'L'); x = x + 1; fs_draw_status_text_char(x,' '); x = x + 1;
    g_i = fsCurCol + 1;
    g_j = 0;
    if (g_i == 0) { numTmp[0] = '0'; g_j = 1; }
    while (g_i > 0) { numTmp[g_j] = (char)('0' + (g_i % 10)); g_i = g_i / 10; g_j = g_j + 1; }
    while (g_j > 0) { g_j = g_j - 1; fs_draw_status_text_char(x, numTmp[g_j]); x = x + 1; }
}

void fs_paint_bottom_line(int eraseRow)
{
    if (eraseRow) fs_clear_row(CON_ROWS - 1, ED_BG);
    fs_draw_text_at(0, CON_ROWS - 1, "F10 HELP F3 SAVEAS F4 LOAD F5 RUN F6 NEW F9 REPL",
                    48, ED_STATUS_TEXT);
    /* Keep the toolbar available while an action status is displayed. */
    if (eraseRow) fillRectClip(36 * FONT_W, 0, 46 * FONT_W - 1, FONT_H - 1, ED_BG);
    if (fsStatus == 1) fs_draw_text_at(36, 0, "SAVED", 5, ED_STATUS_TEXT);
    if (fsStatus == 2) fs_draw_text_at(36, 0, "LOADED", 6, ED_STATUS_TEXT);
    if (fsStatus == 3) fs_draw_text_at(36, 0, "NEW", 3, ED_STATUS_TEXT);
    if (fsStatus == 4) fs_draw_text_at(36, 0, "OUT OF MEM", 10, ED_STATUS_TEXT);
}

void fs_draw_bottom_line() { fs_paint_bottom_line(1); }

void fs_draw_dividers()
{
    fillRectClip(0, FONT_H + 1, SCREEN_W - 1, FONT_H + 1, ED_DIV);
    fillRectClip(0, (CON_ROWS - 1) * FONT_H - 2, SCREEN_W - 1, (CON_ROWS - 1) * FONT_H - 2, ED_DIV);
    screenDirty = 1;
}

int fs_line_base(int line)
{
    return line_base(line);
}

uint fs_token_color(int base, int start, int len)
{
    if (source_word_is_keyword(base, start, len) != 0) return ED_KEY;
    return ED_VAR;
}

uint fs_fast_local_color(int line, int pos)
{
    int base;
    int len;
    int start;
    int endp;
    char c;

    if (line < 0) return ED_TEXT;
    if (line >= lineCount) return ED_TEXT;
    if (pos < 0) return ED_TEXT;
    len = lineLen[line];
    if (pos >= len) return ED_TEXT;
    base = fs_line_base(line);
    c = src_get(base + pos);
    if (c == 39) return ED_COMMENT;
    if (c == 34) return ED_LIT;
    if (is_digit(c) != 0) return ED_NUM;
    if (c == '.') return ED_NUM;
    if (source_is_ident_char(c) != 0) {
        start = pos;
        while (start > 0) {
            if (source_is_ident_char(src_get(base + start - 1)) == 0) break;
            start = start - 1;
        }
        endp = pos;
        while (endp < len) {
            if (source_is_ident_char(src_get(base + endp)) == 0) break;
            endp = endp + 1;
        }
        return fs_token_color(base, start, endp - start);
    }
    return ED_TEXT;
}

void fs_invalidate_line_state(int line)
{
    if (line < 0) return;
    if (line >= LINE_META_MAX) return;
    fsLineStateLen[line] = -1;
    fsLineEndInString[line] = 0;
    fsLineEndComment[line] = 0;
}

void fs_set_empty_line_state(int line)
{
    if (line < 0) return;
    if (line >= LINE_META_MAX) return;
    fsLineStateLen[line] = 0;
    fsLineEndInString[line] = 0;
    fsLineEndComment[line] = 0;
}

void fs_recompute_line_state_to(int line, int upto)
{
    int base;
    int len;
    int j;
    int inString;
    int inComment;
    char c;

    if (line < 0) return;
    if (line >= lineCount) return;
    len = lineLen[line];
    if (upto < 0) upto = 0;
    if (upto > len) upto = len;
    base = fs_line_base(line);
    j = 0;
    inString = 0;
    inComment = 0;

    while (j < upto) {
        c = src_get(base + j);
        if (inComment != 0) {
            j = j + 1;
        } else if (inString != 0) {
            if (c == 34) inString = 0;
            j = j + 1;
        } else {
            if (c == 39) inComment = 1;
            else if (c == 34) inString = 1;
            j = j + 1;
        }
    }

    fsLineStateLen[line] = upto;
    fsLineEndInString[line] = inString;
    fsLineEndComment[line] = inComment;
}


uint fs_append_char_color_and_advance(int line, int pos)
{
    int base;
    int len;
    int start;
    int tokLen;
    char c;
    uint color;

    if (line < 0) return ED_TEXT;
    if (line >= lineCount) return ED_TEXT;
    if (pos < 0) return ED_TEXT;
    len = lineLen[line];
    if (pos >= len) return ED_TEXT;

    base = fs_line_base(line);
    c = src_get(base + pos);

    /* Reliable append-only highlighter.  This is the only function used by the
       normal typing hot path.  It uses the syntax state *before* the appended
       char, chooses the color, then advances the state to after that char.
       This avoids the v59-v63 bug where the fast range redraw and the later
       "exact" recolor disagreed, leaving numbers/strings white until a full
       redraw. */
    if (fsLineStateLen[line] != pos) fs_recompute_line_state_to(line, pos);

    if (fsLineStateLen[line] != pos) {
        /* Very defensive fallback: if the state could not be made current,
           compute local color.  This should not happen on append-at-EOL, but it
           is safer than drawing everything as white. */
        return fs_fast_local_color(line, pos);
    }

    if (fsLineEndComment[line] != 0) {
        fsLineStateLen[line] = pos + 1;
        return ED_COMMENT;
    }

    if (fsLineEndInString[line] != 0) {
        color = ED_LIT;
        if (c == 34) fsLineEndInString[line] = 0;
        fsLineStateLen[line] = pos + 1;
        return color;
    }

    if (c == 39) {
        fsLineEndComment[line] = 1;
        fsLineStateLen[line] = pos + 1;
        return ED_COMMENT;
    }

    if (c == 34) {
        fsLineEndInString[line] = 1;
        fsLineStateLen[line] = pos + 1;
        return ED_LIT;
    }

    if (is_digit(c) != 0) {
        fsLineStateLen[line] = pos + 1;
        return ED_NUM;
    }

    if (c == '.') {
        fsLineStateLen[line] = pos + 1;
        return ED_NUM;
    }

    if (source_is_ident_char(c) != 0) {
        start = pos;
        while (start > 0) {
            if (pos - start > 12) break;
            if (source_is_ident_char(src_get(base + start - 1)) == 0) break;
            start = start - 1;
        }
        tokLen = pos - start + 1;
        if (tokLen <= 12) color = fs_token_color(base, start, tokLen);
        else color = ED_VAR;
        fsLineStateLen[line] = pos + 1;
        return color;
    }

    fsLineStateLen[line] = pos + 1;
    return ED_TEXT;
}

void fs_draw_appended_char_exact(int line, int pos)
{
    int row;
    int base;
    char c;
    uint color;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (line < 0) return;
    if (line >= lineCount) return;
    if (pos < 0) return;
    if (pos >= lineLen[line]) return;
    if (pos < fsLeftCol) return;
    if (pos >= fsLeftCol + CON_COLS) return;

    base = fs_line_base(line);
    row = line - fsTopLine + FS_SOURCE_ROW;
    c = src_get(base + pos);
    /* v65: use the exact same color classifier as full redraw.
       The previous incremental append-state highlighter diverged from
       fs_draw_source_line(), which is why numbers/strings stayed white until F5
       forced a full redraw.  This scans only to this one character and draws one
       cell, so it is much cheaper than redrawing the line while staying correct. */
    color = fs_live_color_full_scan(line, pos);
    fs_cache_set(pos - fsLeftCol, row, color);
    fs_draw_cell(pos - fsLeftCol, row, c, color, ED_BG, 0);
}

uint fs_fast_append_color(int line, int pos)
{
    int base;
    int len;
    int start;
    int tokLen;
    char c;
    uint color;

    if (line < 0) return ED_TEXT;
    if (line >= lineCount) return ED_TEXT;
    if (pos < 0) return ED_TEXT;
    len = lineLen[line];
    if (pos >= len) return ED_TEXT;
    base = fs_line_base(line);
    c = src_get(base + pos);

    /* Fast path for append-at-end.  Keep a line syntax state at the current
       append position.  If it is missing/stale, rebuild it once.  After that
       appending stays O(1), which fixes string/number colors without causing
       long-line lag on every key. */
    if (fsLineStateLen[line] != pos) fs_recompute_line_state_to(line, pos);
    if (fsLineStateLen[line] == pos) {
        if (fsLineEndComment[line] != 0) {
            fsLineStateLen[line] = pos + 1;
            return ED_COMMENT;
        }
        if (fsLineEndInString[line] != 0) {
            color = ED_LIT;
            if (c == 34) fsLineEndInString[line] = 0;
            fsLineStateLen[line] = pos + 1;
            return color;
        }
        if (c == 39) {
            fsLineEndComment[line] = 1;
            fsLineStateLen[line] = pos + 1;
            return ED_COMMENT;
        }
        if (c == 34) {
            fsLineEndInString[line] = 1;
            fsLineStateLen[line] = pos + 1;
            return ED_LIT;
        }
        if (is_digit(c) != 0) {
            fsLineStateLen[line] = pos + 1;
            return ED_NUM;
        }
        if (c == '.') {
            fsLineStateLen[line] = pos + 1;
            return ED_NUM;
        }
        if (source_is_ident_char(c) != 0) {
            start = pos;
            /* Only scan a short token tail.  This avoids the old long-variable
               and long-line slowdown.  Very long names are just colored as vars
               while typing; a later full redraw restores exact keyword color. */
            while (start > 0) {
                if (pos - start > 12) break;
                if (source_is_ident_char(src_get(base + start - 1)) == 0) break;
                start = start - 1;
            }
            tokLen = pos - start + 1;
            if (tokLen <= 12) color = fs_token_color(base, start, tokLen);
            else color = ED_VAR;
            fsLineStateLen[line] = pos + 1;
            return color;
        }
        fsLineStateLen[line] = pos + 1;
        return ED_TEXT;
    }

    return fs_fast_local_color(line, pos);
}

void fs_draw_source_line(int line, int row, int eraseRow)
{
    int base;
    int len;
    int j;
    int wstart;
    int wlen;
    int inString;
    int inComment;
    char c;
    uint color;

    if (eraseRow) fs_clear_row(row, ED_BG);
    else fs_cache_clear_row(row);
    if (line < 0) return;
    if (line >= lineCount) return;

    base = fs_line_base(line);
    len = lineLen[line];
    j = 0;
    inString = 0;
    inComment = 0;
#ifdef __NARM__
    mmRowCount = 0;
#endif

    while (j < len) {
        c = src_get(base + j);
        if (c == 34) {
            if (j >= fsLeftCol) if (j < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(j - fsLeftCol, row, c, ED_LIT, !eraseRow);
            inString = 1 - inString;
            j = j + 1;
        } else if (inString != 0) {
            if (j >= fsLeftCol) if (j < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(j - fsLeftCol, row, c, ED_LIT, !eraseRow);
            j = j + 1;
        } else if (c == 39) {
            inComment = 1;
            while (j < len) {
                if (j >= fsLeftCol) if (j < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(j - fsLeftCol, row, src_get(base + j), ED_COMMENT, !eraseRow);
                j = j + 1;
            }
        } else if (is_digit(c) != 0) {
            while (j < len) {
                c = src_get(base + j);
                if (is_digit(c) == 0) {
                    if (c != '.') break;
                }
                if (j >= fsLeftCol) if (j < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(j - fsLeftCol, row, c, ED_NUM, !eraseRow);
                j = j + 1;
            }
        } else if (source_is_ident_start_char(c) != 0) {
            wstart = j;
            while (j < len) {
                c = src_get(base + j);
                if (source_is_ident_char(c) == 0) break;
                j = j + 1;
            }
            wlen = j - wstart;
            color = fs_token_color(base, wstart, wlen);
            g_i = wstart;
            while (g_i < j) {
                if (g_i >= fsLeftCol) if (g_i < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(g_i - fsLeftCol, row, src_get(base + g_i), color, !eraseRow);
                g_i = g_i + 1;
            }
        } else {
            if (j >= fsLeftCol) if (j < fsLeftCol + CON_COLS) fs_draw_source_cell_cached(j - fsLeftCol, row, c, ED_TEXT, !eraseRow);
            j = j + 1;
        }
    }

#ifdef __NARM__
    if (!eraseRow) mm_draw_source_row(row);
#endif
    fsLineStateLen[line] = len;
    fsLineEndInString[line] = inString;
    fsLineEndComment[line] = inComment;
}

void fs_clamp_cursor()
{
    int len;
    if (lineCount <= 0) {
        lineCount = 1;
        lineLen[0] = 0;
        lineNum[0] = 0;
        lineHasNumber[0] = 0;
    }
    if (fsCurLine < 0) fsCurLine = 0;
    if (fsCurLine >= lineCount) fsCurLine = lineCount - 1;
    len = lineLen[fsCurLine];
    if (fsCurCol < 0) fsCurCol = 0;
    if (fsCurCol > len) fsCurCol = len;
#ifdef __NARM__
    if (fsMouseViewport != 0) return;
#endif
    if (fsTopLine > fsCurLine) fsTopLine = fsCurLine;
    if (fsCurLine >= fsTopLine + FS_VISIBLE_ROWS) fsTopLine = fsCurLine - FS_VISIBLE_ROWS + 1;
    if (fsTopLine < 0) fsTopLine = 0;
    /* v59: horizontally scroll in chunks instead of one column per typed
       character.  The old behavior made long-line typing trigger a full redraw
       after every character once the cursor reached the right edge. */
    if (fsCurCol < fsLeftCol + 4) fsLeftCol = fsCurCol - 12;
    if (fsCurCol >= fsLeftCol + CON_COLS - 4) fsLeftCol = fsCurCol - CON_COLS + 12;
    if (fsLeftCol < 0) fsLeftCol = 0;
}

void fs_paint_source_area()
{
    for (int row = 0; row < FS_VISIBLE_ROWS; ++row)
        fs_draw_source_line(fsTopLine + row, row + FS_SOURCE_ROW, 0);
    // Selection draws follow all strip copies so they stay above the text.
    for (int row = 0; row < FS_VISIBLE_ROWS; ++row)
        fs_overlay_selection_line(fsTopLine + row);
}

void fs_redraw_all()
{
    int base;
    int ch;
    fs_clamp_cursor();
    mm_clear(ED_BG);
    fs_paint_status_line(0);
    fs_paint_bottom_line(0);
    fs_draw_dividers();
    fs_paint_source_area();
    base = fs_line_base(fsCurLine);
    ch = 32;
    if (fsCurCol < lineLen[fsCurLine]) ch = src_get(base + fsCurCol);
    if (fsCurLine >= fsTopLine) if (fsCurLine < fsTopLine + FS_VISIBLE_ROWS) {
        if (fsCurCol >= fsLeftCol) if (fsCurCol < fsLeftCol + CON_COLS) {
            fs_draw_cell(fsCurCol - fsLeftCol, fsCurLine - fsTopLine + FS_SOURCE_ROW, (char)ch, ED_CURSOR, ED_BG, 1);
        }
    }
    screenDirty = 1;
}

uint fs_live_color_full_scan(int line, int pos)
{
    int base;
    int len;
    int j;
    int wstart;
    int wlen;
    int inString;
    char c;

    if (line < 0) return ED_TEXT;
    if (line >= lineCount) return ED_TEXT;
    if (pos < 0) return ED_TEXT;

    base = fs_line_base(line);
    len = lineLen[line];
    if (pos >= len) return ED_TEXT;

    j = 0;
    inString = 0;
    while (j < len) {
        c = src_get(base + j);

        if (c == 34) {
            if (pos == j) return ED_LIT;
            if (inString == 0) inString = 1;
            else inString = 0;
            j = j + 1;
            continue;
        }

        if (inString != 0) {
            if (pos == j) return ED_LIT;
            j = j + 1;
            continue;
        }

        if (c == 39) {
            if (pos >= j) return ED_COMMENT;
            return ED_TEXT;
        }

        if (is_digit(c) != 0) {
            wstart = j;
            while (j < len) {
                c = src_get(base + j);
                if (is_digit(c) == 0) {
                    if (c != '.') break;
                }
                j = j + 1;
            }
            if (pos >= wstart) if (pos < j) return ED_NUM;
            continue;
        }

        if (c == '.') {
            if (j + 1 < len) {
                if (is_digit(src_get(base + j + 1)) != 0) {
                    wstart = j;
                    j = j + 1;
                    while (j < len) {
                        c = src_get(base + j);
                        if (is_digit(c) == 0) break;
                        j = j + 1;
                    }
                    if (pos >= wstart) if (pos < j) return ED_NUM;
                    continue;
                }
            }
            if (pos == j) return ED_TEXT;
            j = j + 1;
            continue;
        }

        if (source_is_ident_start_char(c) != 0) {
            wstart = j;
            while (j < len) {
                c = src_get(base + j);
                if (source_is_ident_char(c) == 0) break;
                j = j + 1;
            }
            wlen = j - wstart;
            if (pos >= wstart) if (pos < j) return fs_token_color(base, wstart, wlen);
            continue;
        }

        if (pos == j) return ED_TEXT;
        j = j + 1;
    }

    return ED_TEXT;
}

uint fs_source_color_at(int line, int pos)
{
    return fs_live_color_full_scan(line, pos);
}


int fs_linepos_before(int aLine, int aCol, int bLine, int bCol)
{
    if (aLine < bLine) return 1;
    if (aLine > bLine) return 0;
    if (aCol < bCol) return 1;
    return 0;
}

void fs_selection_cancel()
{
    fsSelActive = 0;
}

void fs_selection_recompute_bounds()
{
    if (fs_linepos_before(fsSelAnchorLine, fsSelAnchorCol, fsCurLine, fsCurCol) != 0) {
        fsSelStartLine = fsSelAnchorLine;
        fsSelStartCol = fsSelAnchorCol;
        fsSelEndLine = fsCurLine;
        fsSelEndCol = fsCurCol;
    } else {
        fsSelStartLine = fsCurLine;
        fsSelStartCol = fsCurCol;
        fsSelEndLine = fsSelAnchorLine;
        fsSelEndCol = fsSelAnchorCol;
    }

    if (fsSelStartLine < 0) fsSelStartLine = 0;
    if (fsSelEndLine < 0) fsSelEndLine = 0;
    if (fsSelStartLine >= lineCount) fsSelStartLine = lineCount - 1;
    if (fsSelEndLine >= lineCount) fsSelEndLine = lineCount - 1;
    if (fsSelStartLine < 0) fsSelStartLine = 0;
    if (fsSelEndLine < 0) fsSelEndLine = 0;

    if (fsSelStartCol < 0) fsSelStartCol = 0;
    if (fsSelEndCol < 0) fsSelEndCol = 0;
    if (fsSelStartCol > lineLen[fsSelStartLine]) fsSelStartCol = lineLen[fsSelStartLine];
    if (fsSelEndCol > lineLen[fsSelEndLine]) fsSelEndCol = lineLen[fsSelEndLine];
}

int fs_selection_has_range()
{
    if (fsSelActive == 0) return 0;
    fs_selection_recompute_bounds();
    if (fsSelStartLine == fsSelEndLine) {
        if (fsSelStartCol == fsSelEndCol) return 0;
    }
    return 1;
}

int fs_pos_in_selection_bounds(int line, int pos)
{
    if (line < fsSelStartLine) return 0;
    if (line > fsSelEndLine) return 0;

    if (fsSelStartLine == fsSelEndLine) {
        if (line != fsSelStartLine) return 0;
        if (pos < fsSelStartCol) return 0;
        if (pos >= fsSelEndCol) return 0;
        return 1;
    }

    if (line == fsSelStartLine) {
        if (pos < fsSelStartCol) return 0;
        if (pos <= lineLen[line]) return 1;
        return 0;
    }

    if (line == fsSelEndLine) {
        if (pos < fsSelEndCol) return 1;
        return 0;
    }

    if (pos <= lineLen[line]) return 1;
    return 0;
}

int fs_pos_selected(int line, int pos)
{
    if (fs_selection_has_range() == 0) return 0;
    return fs_pos_in_selection_bounds(line, pos);
}

void fs_selection_begin_if_needed()
{
    if (fsSelActive == 0) {
        fsSelAnchorLine = fsCurLine;
        fsSelAnchorCol = fsCurCol;
        fsSelActive = 1;
    }
}

int fs_prepare_cursor_move_for_selection()
{
    int had;
    if (shiftDown != 0) {
        fs_selection_begin_if_needed();
        return 1;
    }
    had = fs_selection_has_range();
    fs_selection_cancel();
    if (had != 0) return 2;
    return 0;
}

void fs_finish_cursor_move_for_selection()
{
    if (shiftDown == 0) return;
    if (fsSelActive == 0) return;
    if (fsSelAnchorLine == fsCurLine) {
        if (fsSelAnchorCol == fsCurCol) fsSelActive = 0;
    }
}

void fs_overlay_selection_line(int line)
{
    int p;
    if (fs_selection_has_range() == 0) return;
    p = fsLeftCol;
    while (p < fsLeftCol + CON_COLS) {
        if (fs_pos_in_selection_bounds(line, p) != 0) fs_draw_source_pos(line, p, 0);
        p = p + 1;
    }
}

void fs_delete_selection()
{
    int startLine;
    int startCol;
    int endLine;
    int endCol;
    int baseStart;
    int baseEnd;
    int tailLen;
    int i;
    int removeCount;

    if (fs_selection_has_range() == 0) return;

    startLine = fsSelStartLine;
    startCol = fsSelStartCol;
    endLine = fsSelEndLine;
    endCol = fsSelEndCol;

    if (startLine < 0) startLine = 0;
    if (endLine >= lineCount) endLine = lineCount - 1;
    if (startCol < 0) startCol = 0;
    if (endCol < 0) endCol = 0;
    if (startCol > lineLen[startLine]) startCol = lineLen[startLine];
    if (endCol > lineLen[endLine]) endCol = lineLen[endLine];

    if (startLine == endLine) {
        baseStart = fs_line_base(startLine);
        i = startCol;
        while (i + (endCol - startCol) < lineLen[startLine]) {
            src_set(baseStart + i, src_get(baseStart + i + (endCol - startCol)));
            i = i + 1;
        }
        while (i < lineLen[startLine]) { src_set(baseStart + i, 0); i = i + 1; }
        lineLen[startLine] = lineLen[startLine] - (endCol - startCol);
        fs_invalidate_line_state(startLine);
        fsCurLine = startLine;
        fsCurCol = startCol;
        fs_selection_cancel();
        sourceDiscarded = 0;
        mark_source_dirty();
        return;
    }

    baseStart = fs_line_base(startLine);
    baseEnd = fs_line_base(endLine);
    tailLen = lineLen[endLine] - endCol;
    if (tailLen < 0) tailLen = 0;
    if (startCol + tailLen >= LINE_MAX) { fsStatus = 4; return; }

    i = 0;
    while (i < tailLen) {
        src_set(baseStart + startCol + i, src_get(baseEnd + endCol + i));
        i = i + 1;
    }
    i = startCol + tailLen;
    while (i < lineLen[startLine]) { src_set(baseStart + i, 0); i = i + 1; }
    lineLen[startLine] = startCol + tailLen;
    fs_invalidate_line_state(startLine);

    removeCount = endLine - startLine;
    while (removeCount > 0) {
        delete_line_index(startLine + 1);
        removeCount = removeCount - 1;
    }

    fsCurLine = startLine;
    fsCurCol = startCol;
    fs_selection_cancel();
    sourceDiscarded = 0;
    mark_source_dirty();
}

void fs_draw_source_pos(int line, int pos, int cursor)
{
    int base;
    int row;
    int ch;
    int valid;
    uint color;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (pos < fsLeftCol) return;
    if (pos >= fsLeftCol + CON_COLS) return;

    row = line - fsTopLine + FS_SOURCE_ROW;
    ch = 32;
    if (line >= 0) {
        if (line < lineCount) {
            base = fs_line_base(line);
            if (pos >= 0) {
                if (pos < lineLen[line]) ch = src_get(base + pos);
            }
        }
    }

    if (cursor != 0) {
        fs_draw_cell(pos - fsLeftCol, row, (char)ch, ED_CURSOR, ED_BG, 1);
        return;
    }

    if (fs_pos_selected(line, pos) != 0) {
        fs_draw_cell(pos - fsLeftCol, row, (char)ch, ED_BG, ED_CURSOR, 0);
        return;
    }

    color = fs_cache_get(pos - fsLeftCol, row, &valid);
    if (valid == 0) color = fs_source_color_at(line, pos);
    fs_draw_cell(pos - fsLeftCol, row, (char)ch, color, ED_BG, 0);
}

int fs_fast_edit_start(int line, int pos)
{
    int base;
    int start;
    char c;

    if (line < 0) return pos;
    if (line >= lineCount) return pos;
    if (pos < 0) return 0;

    base = fs_line_base(line);
    start = pos;

    /* v58: do not scan from column 0 on every append/cursor edit.
       Long lines became progressively slower because the old code checked every
       previous character for quotes/comments.  For fast append redraw we only
       back up to the start of the current token.  A full line redraw will still
       restore perfect syntax coloring after larger edits/scrolls. */
    while (start > 0) {
        c = src_get(base + start - 1);
        if (source_is_ident_char(c) != 0) start = start - 1;
        else if (is_digit(c) != 0) start = start - 1;
        else if (c == '.') start = start - 1;
        else break;
    }

    return start;
}

void fs_redraw_source_range(int line, int startPos, int endPos, int drawCursor)
{
    int p;
    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (startPos < fsLeftCol) startPos = fsLeftCol;
    if (endPos > fsLeftCol + CON_COLS) endPos = fsLeftCol + CON_COLS;
    if (startPos < 0) startPos = 0;
    if (endPos < startPos) endPos = startPos;

    p = startPos;
    while (p <= endPos) {
        fs_draw_source_pos(line, p, 0);
        p = p + 1;
    }
    if (drawCursor != 0) fs_draw_source_pos(fsCurLine, fsCurCol, 1);
}

void fs_redraw_source_range_fast(int line, int startPos, int endPos, int drawCursor)
{
    int p;
    int row;
    int base;
    int ch;
    uint color;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (startPos < fsLeftCol) startPos = fsLeftCol;
    if (endPos > fsLeftCol + CON_COLS) endPos = fsLeftCol + CON_COLS;
    if (startPos < 0) startPos = 0;
    if (endPos < startPos) endPos = startPos;

    row = line - fsTopLine + FS_SOURCE_ROW;
    base = fs_line_base(line);
    p = startPos;
    while (p <= endPos) {
        ch = 32;
        if (p < lineLen[line]) ch = src_get(base + p);
        color = fs_fast_append_color(line, p);
        fs_cache_set(p - fsLeftCol, row, color);
        fs_draw_cell(p - fsLeftCol, row, (char)ch, color, ED_BG, 0);
        p = p + 1;
    }
    if (drawCursor != 0) fs_draw_source_pos(fsCurLine, fsCurCol, 1);
}


int fs_ident_token_start_at(int line, int pos)
{
    int base;
    int start;
    if (line < 0) return pos;
    if (line >= lineCount) return pos;
    if (pos < 0) return 0;
    if (pos >= lineLen[line]) pos = lineLen[line] - 1;
    if (pos < 0) return 0;
    base = fs_line_base(line);
    if (source_is_ident_char(src_get(base + pos)) == 0) return pos;
    start = pos;
    while (start > 0) {
        if (source_is_ident_char(src_get(base + start - 1)) == 0) break;
        start = start - 1;
    }
    return start;
}

int fs_ident_token_end_at(int line, int pos)
{
    int base;
    int endp;
    if (line < 0) return pos;
    if (line >= lineCount) return pos;
    if (pos < 0) return 0;
    if (pos >= lineLen[line]) pos = lineLen[line] - 1;
    if (pos < 0) return 0;
    base = fs_line_base(line);
    if (source_is_ident_char(src_get(base + pos)) == 0) return pos;
    endp = pos;
    while (endp < lineLen[line]) {
        if (source_is_ident_char(src_get(base + endp)) == 0) break;
        endp = endp + 1;
    }
    return endp;
}

void fs_redraw_ident_token_exact(int line, int pos)
{
    int base;
    int start;
    int endp;
    int p;
    int row;
    uint color;
    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (line < 0) return;
    if (line >= lineCount) return;
    if (pos < 0) return;
    if (pos >= lineLen[line]) pos = lineLen[line] - 1;
    if (pos < 0) return;
    base = fs_line_base(line);
    if (source_is_ident_char(src_get(base + pos)) == 0) return;
    start = fs_ident_token_start_at(line, pos);
    endp = fs_ident_token_end_at(line, pos);
    color = fs_token_color(base, start, endp - start);
    row = line - fsTopLine + FS_SOURCE_ROW;
    p = start;
    while (p < endp) {
        if (p >= fsLeftCol) if (p < fsLeftCol + CON_COLS) {
            fs_cache_set(p - fsLeftCol, row, color);
            fs_draw_cell(p - fsLeftCol, row, src_get(base + p), color, ED_BG, 0);
        }
        p = p + 1;
    }
}

void fs_redraw_line_visible_from(int line, int startPos, int drawCursor)
{
    int base;
    int len;
    int j;
    int wstart;
    int wlen;
    int inString;
    char c;
    uint color;
    int row;
    int endPos;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (line < 0) return;
    if (line >= lineCount) return;
    if (startPos < fsLeftCol) startPos = fsLeftCol;
    if (startPos < 0) startPos = 0;
    endPos = fsLeftCol + CON_COLS;
    len = lineLen[line];
    if (endPos > len + 1) endPos = len + 1;
    row = line - fsTopLine + FS_SOURCE_ROW;
    base = fs_line_base(line);

    /* Scan once from the beginning to get string/comment state, then redraw only
       the visible tail.  This avoids the previous redraw-dirty-line path that
       re-highlighted the whole line on every Backspace/Delete. */
    j = 0;
    inString = 0;
    while (j < startPos) {
        c = src_get(base + j);
        if (c == 34) inString = 1 - inString;
        else if (inString == 0) {
            if (c == 39) {
                /* From here to EOL is comment, so state at startPos is comment. */
                j = startPos;
                inString = 2;
                break;
            }
        }
        j = j + 1;
    }

    j = startPos;
    while (j < endPos) {
        c = 32;
        if (j < len) c = src_get(base + j);
        if (inString == 2) {
            color = ED_COMMENT;
            fs_cache_set(j - fsLeftCol, row, color);
            fs_draw_cell(j - fsLeftCol, row, c, color, ED_BG, 0);
            j = j + 1;
        } else if (j >= len) {
            fs_cache_set(j - fsLeftCol, row, ED_TEXT);
            fs_draw_cell(j - fsLeftCol, row, (char)32, ED_TEXT, ED_BG, 0);
            j = j + 1;
        } else if (c == 34) {
            color = ED_LIT;
            fs_cache_set(j - fsLeftCol, row, color);
            fs_draw_cell(j - fsLeftCol, row, c, color, ED_BG, 0);
            inString = 1 - inString;
            j = j + 1;
        } else if (inString != 0) {
            color = ED_LIT;
            fs_cache_set(j - fsLeftCol, row, color);
            fs_draw_cell(j - fsLeftCol, row, c, color, ED_BG, 0);
            j = j + 1;
        } else if (c == 39) {
            inString = 2;
        } else if (is_digit(c) != 0) {
            while (j < endPos) {
                c = src_get(base + j);
                if (is_digit(c) == 0) { if (c != '.') break; }
                color = ED_NUM;
                fs_cache_set(j - fsLeftCol, row, color);
                fs_draw_cell(j - fsLeftCol, row, c, color, ED_BG, 0);
                j = j + 1;
                if (j >= len) break;
            }
        } else if (source_is_ident_start_char(c) != 0) {
            wstart = j;
            while (j < len) {
                c = src_get(base + j);
                if (source_is_ident_char(c) == 0) break;
                j = j + 1;
            }
            wlen = j - wstart;
            color = fs_token_color(base, wstart, wlen);
            g_i = wstart;
            while (g_i < j) {
                if (g_i >= fsLeftCol) if (g_i < fsLeftCol + CON_COLS) {
                    fs_cache_set(g_i - fsLeftCol, row, color);
                    fs_draw_cell(g_i - fsLeftCol, row, src_get(base + g_i), color, ED_BG, 0);
                }
                g_i = g_i + 1;
            }
        } else {
            color = ED_TEXT;
            fs_cache_set(j - fsLeftCol, row, color);
            fs_draw_cell(j - fsLeftCol, row, c, color, ED_BG, 0);
            j = j + 1;
        }
    }
    if (drawCursor != 0) fs_draw_source_pos(fsCurLine, fsCurCol, 1);
}

void fs_redraw_short_ident_token(int line, int pos)
{
    int base;
    int start;
    int endp;
    int p;
    int row;
    int tooLong;
    uint color;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (line < 0) return;
    if (line >= lineCount) return;
    if (pos < 0) return;
    if (pos >= lineLen[line]) return;

    base = fs_line_base(line);
    if (source_is_ident_char(src_get(base + pos)) == 0) return;

    start = pos;
    tooLong = 0;
    while (start > 0) {
        if (source_is_ident_char(src_get(base + start - 1)) == 0) break;
        if (pos - start >= 12) { tooLong = 1; break; }
        start = start - 1;
    }
    if (tooLong != 0) return;

    endp = pos + 1;
    while (endp < lineLen[line]) {
        if (source_is_ident_char(src_get(base + endp)) == 0) break;
        if (endp - start >= 12) { tooLong = 1; break; }
        endp = endp + 1;
    }
    if (tooLong != 0) return;

    color = fs_token_color(base, start, endp - start);
    row = line - fsTopLine + FS_SOURCE_ROW;
    p = start;
    while (p < endp) {
        if (p >= fsLeftCol) if (p < fsLeftCol + CON_COLS) {
            fs_cache_set(p - fsLeftCol, row, color);
            fs_draw_cell(p - fsLeftCol, row, src_get(base + p), color, ED_BG, 0);
        }
        p = p + 1;
    }
}

void fs_clear_visible_cell(int line, int pos)
{
    int row;
    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (pos < fsLeftCol) return;
    if (pos >= fsLeftCol + CON_COLS) return;
    row = line - fsTopLine + FS_SOURCE_ROW;
    fs_cache_set(pos - fsLeftCol, row, ED_TEXT);
    fs_draw_cell(pos - fsLeftCol, row, (char)32, ED_TEXT, ED_BG, 0);
}

void fs_redraw_backspace_end(int oldLine, int oldCol, int oldStatus)
{
    int pos;
    if (oldLine < fsTopLine) return;
    if (oldLine >= fsTopLine + FS_VISIBLE_ROWS) return;

    /* v62: Backspace-at-EOL must not rescan/repaint a long token.  It also must
       clear the old cursor cell, otherwise repeated Backspace leaves white cursor
       blocks behind.  Only repaint a short identifier token so keywords like
       PRINT -> PRIN recover their color cheaply. */
    fs_clear_visible_cell(oldLine, oldCol);
    fs_clear_visible_cell(oldLine, oldCol - 1);

    pos = fsCurCol - 1;
    if (pos >= 0) fs_redraw_short_ident_token(fsCurLine, pos);

    fs_draw_source_pos(fsCurLine, fsCurCol, 1);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_redraw_join_eof(int oldLine, int oldStatus)
{
    int row;

    /* v65: Backspace from an empty final line should not redraw the whole
       previous line.  That was the remaining lag when joining back to the
       previous line after pressing Enter.  If text was actually appended from
       the removed line, redraw only the visible tail from the join point. */
    if (lineLen[fsCurLine] == fsCurCol) {
        fs_draw_source_pos(fsCurLine, fsCurCol, 1);
    } else {
        fs_redraw_line_visible_from(fsCurLine, fsCurCol, 1);
    }

    /* v71: Only clear the removed physical row if a line was actually removed.
       When Backspace is pressed at column 0 on the first line, fs_backspace()
       correctly does nothing, but the old redraw path still treated it as an
       EOF join and cleared the current row after redrawing it.  That made the
       whole first line disappear except for the cursor character. */
    if (oldLine != fsCurLine) {
        if (oldLine >= fsTopLine) {
            if (oldLine < fsTopLine + FS_VISIBLE_ROWS) {
                row = oldLine - fsTopLine + FS_SOURCE_ROW;
                fs_clear_row(row, ED_BG);
            }
        }
    }
    fs_draw_cursor_for_line(fsCurLine);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_redraw_delete_tail(int oldLine, int oldCol, int oldStatus)
{
    int start;
    start = fsCurCol;
    if (start > 0) {
        if (oldLine == fsCurLine) {
            if (source_is_ident_char(src_get(fs_line_base(fsCurLine) + start - 1)) != 0) {
                start = fs_ident_token_start_at(fsCurLine, start - 1);
            }
        }
    }
    fs_redraw_line_visible_from(fsCurLine, start, 1);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_recolor_appended_cell_exact(int line, int pos)
{
    int row;
    int base;
    char c;
    uint color;

    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (line < 0) return;
    if (line >= lineCount) return;
    if (pos < 0) return;
    if (pos >= lineLen[line]) return;
    if (pos < fsLeftCol) return;
    if (pos >= fsLeftCol + CON_COLS) return;

    base = fs_line_base(line);
    row = line - fsTopLine + FS_SOURCE_ROW;
    c = src_get(base + pos);

    color = ED_TEXT;
    if (fsLineEndComment[line] != 0) color = ED_COMMENT;
    else if (c == 39) color = ED_COMMENT;
    else if (c == 34) color = ED_LIT;
    else if (fsLineEndInString[line] != 0) color = ED_LIT;
    else if (is_digit(c) != 0) color = ED_NUM;
    else if (c == '.') color = ED_NUM;
    else if (source_is_ident_char(c) != 0) color = fs_fast_local_color(line, pos);

    fs_cache_set(pos - fsLeftCol, row, color);
    fs_draw_cell(pos - fsLeftCol, row, c, color, ED_BG, 0);
}

void fs_redraw_fast_append(int oldLine, int oldCol, int oldStatus)
{
    int pos;
    char c;
    uint color;

    pos = oldCol;

    /* v67: stop relying on the broken live-only highlighter for literals.
       The only path proven correct is the normal visible-line highlighter used by
       full redraw/F5.  For string/comment/number characters, redraw from the
       changed cell to the visible end using that same highlighter.  For normal
       identifiers, keep the O(1) append path plus a short-token repaint so
       keywords still recolor without long-line lag. */
    color = fs_source_color_at(fsCurLine, pos);

    if (color == ED_LIT || color == ED_NUM || color == ED_COMMENT) {
        fs_redraw_line_visible_from(fsCurLine, pos, 1);
        if (oldStatus != fsStatus) fs_draw_bottom_line();
        return;
    }

    fs_draw_appended_char_exact(fsCurLine, pos);
    fs_draw_source_pos(fsCurLine, fsCurCol, 1);

    if (pos >= 0) if (pos < lineLen[fsCurLine]) {
        c = src_get(fs_line_base(fsCurLine) + pos);
        if (source_is_ident_char(c) != 0) {
            fs_redraw_short_ident_token(fsCurLine, pos);
            fs_draw_source_pos(fsCurLine, fsCurCol, 1);
        }
    }

    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_redraw_fast_tab_append(int oldLine, int oldCol, int oldStatus)
{
    /* v57: skip header/status redraw during append-tab editing. */
    fs_redraw_source_range_fast(fsCurLine, oldCol, fsCurCol, 1);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_redraw_cursor_move(int oldLine, int oldCol, int oldStatus)
{
    /* v57: cursor movement should touch only the old/new cells.
       The header line is refreshed on full redraws, not every key pulse. */
    if (oldLine == fsCurLine) {
        if (oldCol == fsCurCol) {
            fs_draw_source_pos(fsCurLine, fsCurCol, 1);
        } else {
            fs_draw_source_pos(oldLine, oldCol, 0);
            fs_draw_source_pos(fsCurLine, fsCurCol, 1);
        }
    } else {
        fs_draw_source_pos(oldLine, oldCol, 0);
        fs_draw_source_pos(fsCurLine, fsCurCol, 1);
    }
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_draw_cursor_for_line(int line)
{
    int base;
    int ch;
    int row;

    if (line != fsCurLine) return;
    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    if (fsCurCol < fsLeftCol) return;
    if (fsCurCol >= fsLeftCol + CON_COLS) return;

    base = fs_line_base(fsCurLine);
    ch = 32;
    if (fsCurCol < lineLen[fsCurLine]) ch = src_get(base + fsCurCol);
    row = fsCurLine - fsTopLine + FS_SOURCE_ROW;
    fs_draw_cell(fsCurCol - fsLeftCol, row, (char)ch, ED_CURSOR, ED_BG, 1);
}

void fs_redraw_one_source_line(int line)
{
    int row;
    if (line < fsTopLine) return;
    if (line >= fsTopLine + FS_VISIBLE_ROWS) return;
    row = line - fsTopLine + FS_SOURCE_ROW;
    fs_draw_source_line(line, row, 1);
    fs_overlay_selection_line(line);
    fs_draw_cursor_for_line(line);
}

void fs_redraw_visible_from_line(int startLine, int oldStatus)
{
    fs_clear_source_area();
    fs_paint_source_area();
    fs_draw_cursor_for_line(fsCurLine);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_redraw_dirty_lines(int oldLine, int oldStatus)
{
    /* v57: avoid status/header redraw during normal editing. */
    if (oldLine != fsCurLine) fs_redraw_one_source_line(oldLine);
    fs_redraw_one_source_line(fsCurLine);
    if (oldStatus != fsStatus) fs_draw_bottom_line();
}

void fs_insert_blank_line(int pos)
{
    int i;
    int freeSlot;
    if (pool_can_add_line() == 0) { fsStatus = 4; return; }
    if (pos < 0) pos = 0;
    if (pos > lineCount) pos = lineCount;
    freeSlot = lineSlot[lineCount];
    i = lineCount;
    while (i > pos) {
        copy_slot(i, i - 1);
        i = i - 1;
    }
    lineCount = lineCount + 1;
    lineSlot[pos] = freeSlot;
    lineNum[pos] = 0;
    lineHasNumber[pos] = 0;
    lineLen[pos] = 0;
    fs_set_empty_line_state(pos);
    sourceDiscarded = 0;
    mark_source_dirty();
}

void fs_insert_char(char c)
{
    int base;
    int len;
    int i;
    fs_clamp_cursor();
    len = lineLen[fsCurLine];
    if (len >= LINE_MAX - 1) return;
    base = fs_line_base(fsCurLine);
    i = len;
    while (i > fsCurCol) {
        src_set(base + i, src_get(base + i - 1));
        i = i - 1;
    }
    src_set(base + fsCurCol, c);
    lineLen[fsCurLine] = len + 1;
    if (fsCurCol < len) fs_invalidate_line_state(fsCurLine);
    fsCurCol = fsCurCol + 1;
    sourceDiscarded = 0;
    mark_source_dirty();
}

void fs_delete_char_at_cursor()
{
    int base;
    int len;
    int i;
    fs_clamp_cursor();
    base = fs_line_base(fsCurLine);
    len = lineLen[fsCurLine];
    if (fsCurCol < len) {
        i = fsCurCol;
        while (i < len - 1) { src_set(base + i, src_get(base + i + 1)); i = i + 1; }
        src_set(base + len - 1, 0);
        lineLen[fsCurLine] = len - 1;
        fs_invalidate_line_state(fsCurLine);
        mark_source_dirty();
        return;
    }
    if (fsCurLine + 1 < lineCount) {
        if (len + lineLen[fsCurLine + 1] < LINE_MAX) {
            g_i = 0;
            g_j = fs_line_base(fsCurLine + 1);
            while (g_i < lineLen[fsCurLine + 1]) {
                src_set(base + len + g_i, src_get(g_j + g_i));
                g_i = g_i + 1;
            }
            lineLen[fsCurLine] = len + lineLen[fsCurLine + 1];
            fs_invalidate_line_state(fsCurLine);
            delete_line_index(fsCurLine + 1);
            mark_source_dirty();
        }
    }
}

void fs_backspace()
{
    int oldLine;
    int oldLen;
    int prevLen;
    if (fsCurCol > 0) {
        fsCurCol = fsCurCol - 1;
        fs_delete_char_at_cursor();
        return;
    }
    if (fsCurLine > 0) {
        oldLine = fsCurLine;
        oldLen = lineLen[oldLine];
        prevLen = lineLen[oldLine - 1];
        if (prevLen + oldLen < LINE_MAX) {
            g_i = 0;
            g_j = fs_line_base(oldLine);
            g_k = fs_line_base(oldLine - 1);
            while (g_i < oldLen) { src_set(g_k + prevLen + g_i, src_get(g_j + g_i)); g_i = g_i + 1; }
            lineLen[oldLine - 1] = prevLen + oldLen;
            fs_invalidate_line_state(oldLine - 1);
            delete_line_index(oldLine);
            fsCurLine = oldLine - 1;
            fsCurCol = prevLen;
            mark_source_dirty();
        }
    }
}

void fs_enter_split()
{
    int base;
    int newBase;
    int len;
    int tail;
    int i;
    fs_clamp_cursor();
    if (pool_can_add_line() == 0) { fsStatus = 4; return; }
    base = fs_line_base(fsCurLine);
    len = lineLen[fsCurLine];
    tail = len - fsCurCol;
    fs_insert_blank_line(fsCurLine + 1);
    newBase = fs_line_base(fsCurLine + 1);
    i = 0;
    while (i < tail) {
        src_set(newBase + i, src_get(base + fsCurCol + i));
        src_set(base + fsCurCol + i, 0);
        i = i + 1;
    }
    lineLen[fsCurLine] = fsCurCol;
    lineLen[fsCurLine + 1] = tail;
    fs_invalidate_line_state(fsCurLine);
    fs_invalidate_line_state(fsCurLine + 1);
    if (tail == 0) fs_set_empty_line_state(fsCurLine + 1);
    fsCurLine = fsCurLine + 1;
    fsCurCol = 0;
    sourceDiscarded = 0;
    mark_source_dirty();
}

void fs_wait_enter()
{
    int done;
#ifdef __NARM__
    struct NarmMouseEvent event;
    int remaining;
    mouse_reset_ui_input();
#endif
    done = 0;
    while (done == 0) {
        inputNow = millis();
        pollLineKeys();
        if (hitEnter != 0) done = 1;
#ifdef __NARM__
        remaining = 32;
        while (done == 0 && remaining > 0 && narm_mouse_poll_event(&event) > 0) {
            remaining = remaining - 1;
            if (mouse_cancel_gesture(&event) == 0 && mouse_press_left(&event) != 0 &&
                (event.y / mousePixelScale - 1) / FONT_H == conY && event.x / mousePixelScale < conX * FONT_W) done = 1;
        }
#endif
        flushScreen();
    }
}

void fs_copy_save_name_from_input()
{
    int start;
    int end;
    int n;
    char c;

    start = 0;
    end = g_len;
    while (start < end) {
        if (is_space(inputLine[start]) == 0) break;
        start = start + 1;
    }
    while (end > start) {
        if (is_space(inputLine[end - 1]) == 0) break;
        end = end - 1;
    }
    if (start >= end) return;

    if (inputLine[start] == 34) {
        start = start + 1;
        end = start;
        while (end < g_len) {
            if (inputLine[end] == 34) break;
            end = end + 1;
        }
    }

    clear_chars(filePath, PATH_MAX);
    n = 0;
    while (start < end) {
        c = inputLine[start];
        if (n < PATH_MAX - 1) {
            filePath[n] = c;
            n = n + 1;
        }
        start = start + 1;
    }
    if (n > 0) filePathLen = n;
}

void fs_editor_save_as()
{
    consoleClear();
    con_char('S'); con_char('A'); con_char('V'); con_char('E'); con_char(' '); con_char('A'); con_char('S'); con_nl();
    con_char('C'); con_char('U'); con_char('R'); con_char('R'); con_char('E'); con_char('N'); con_char('T'); con_char(':'); con_char(' ');
    con_path();
    con_nl();
    con_char('E'); con_char('N'); con_char('T'); con_char('E'); con_char('R'); con_char('='); con_char('K'); con_char('E'); con_char('E'); con_char('P'); con_char(' '); con_char(' ');
    con_char('O'); con_char('R'); con_char(' '); con_char('T'); con_char('Y'); con_char('P'); con_char('E'); con_char(' '); con_char('N'); con_char('A'); con_char('M'); con_char('E'); con_nl();
#ifdef __NARM__
    editMouseSubmitRow = conY;
    con_str("[ SAVE ]", 8);
    con_nl();
#endif
    con_char('>');
    flushScreen();
    read_line_editor();
#ifdef __NARM__
    editMouseSubmitRow = -1;
#endif
    if (g_len > 0) fs_copy_save_name_from_input();
    save_program_sd();
    fsStatus = 1;
    fsNeedRedraw = 1;
}

void fs_run_program_from_editor()
{
    consoleClear();

    /* v83: do not save/reload through SD for F5.  Source text is already kept
       in packed shared-pool slots, and bytecode generation writes only to the
       separate packed uint8 programArena[], so running no longer destroys editor text. */
    run_program();

    con_nl();
#ifdef __NARM__
    con_str("[ RETURN TO EDITOR ]  ENTER", 27);
#else
    con_char('P'); con_char('R'); con_char('E'); con_char('S'); con_char('S'); con_char(' '); con_char('E'); con_char('N'); con_char('T'); con_char('E'); con_char('R'); con_char(' '); con_char('T'); con_char('O'); con_char(' '); con_char('E'); con_char('D'); con_char('I'); con_char('T');
#endif
    flushScreen();
    fs_wait_enter();

    if (sourceDiscarded != 0) {
        restore_source_slots_from_prog();
        sourceDiscarded = 0;
        bcProgramOnly = 0;
        /* Compatibility path for older bytecode-only state.  Normal v83 RUN does
           not enter this block because source and bytecode use separate arenas. */
        bcReady = 0;
        bcLen = 0;
        bcByteLen = 0;
        bc_seek_reset();
        bcStrLen = 0;
        bcFloatLen = 0;
        sourceDirty = 0;
    }
    fsStatus = 0;
    fsNeedRedraw = 1;
}

