void input_skip_value_seps()
{
    char c;
    while (g_pos < g_len) {
        c = inputLine[g_pos];
        if (c == ' ') { g_pos = g_pos + 1; continue; }
        if (c == 9) { g_pos = g_pos + 1; continue; }
        if (c == ',') { g_pos = g_pos + 1; continue; }
        return;
    }
}

int input_parse_int_value()
{
    int sign;
    int value;
    int any;
    char c;

    input_skip_value_seps();
    inputOk = 0;
    sign = 1;
    value = 0;
    any = 0;

    if (g_pos < g_len) {
        c = inputLine[g_pos];
        if (c == '-') {
            sign = -1;
            g_pos = g_pos + 1;
        } else if (c == '+') {
            g_pos = g_pos + 1;
        }
    }

    while (g_pos < g_len) {
        c = inputLine[g_pos];
        if (c < '0') break;
        if (c > '9') break;
        any = 1;
        value = value * 10 + (int)(c - '0');
        g_pos = g_pos + 1;
    }

    if (any == 0) return 0;
    inputOk = 1;
    return value * sign;
}

void input_parse_string_value()
{
    char c;
    int startQuote;
    int endPos;

    input_skip_value_seps();
    clear_str_tmp();
    startQuote = 0;

    if (g_pos < g_len) {
        if (inputLine[g_pos] == 34) {
            startQuote = 1;
            g_pos = g_pos + 1;
        }
    }

    while (g_pos < g_len) {
        c = inputLine[g_pos];
        if (startQuote != 0) {
            if (c == 34) break;
        } else {
            if (c == ',') break;
        }
        append_str_tmp_char(c);
        if (running == 0) return;
        g_pos = g_pos + 1;
    }

    if (startQuote != 0) {
        if (g_pos < g_len) {
            if (inputLine[g_pos] == 34) g_pos = g_pos + 1;
        }
    } else {
        endPos = strTmpLen - 1;
        while (endPos >= 0) {
            c = strTmp[endPos];
            if (c != ' ') break;
            strTmp[endPos] = 0;
            strTmpLen = strTmpLen - 1;
            endPos = endPos - 1;
        }
    }

    inputOk = 1;
}

void exec_input()
{
    char c;
    int idx;
    int value;

    ip = ip + 5;
    skip_spaces();
    if (ip < currentEnd) {
        if (prog[ip] == '#') {
            ip = ip - 5;
            exec_input_file_after_input();
            return;
        }
    }

    if (ip < currentEnd) {
        if (prog[ip] == 34) {
            ip = ip + 1;
            while (ip < currentEnd) {
                c = prog[ip];
                if (c == 34) break;
                con_char(c);
                ip = ip + 1;
            }
            if (ip >= currentEnd) { fail(12); return; }
            if (prog[ip] != 34) { fail(12); return; }
            ip = ip + 1;
            skip_spaces();
            if (ip < currentEnd) {
                if (prog[ip] == ';') ip = ip + 1;
                else if (prog[ip] == ',') ip = ip + 1;
                else { fail(16); return; }
            }
        } else {
            con_char('?');
            con_char(' ');
        }
    } else {
        fail(5);
        return;
    }

    skip_spaces();
    if (ip >= currentEnd) { fail(5); return; }

    flushScreen();
    read_line_editor();
    g_pos = 0;

    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) break;

        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        skip_spaces();
        if (ip < currentEnd) {
            if (prog[ip] == '(') {
                idx = find_array_from_ident();
                if (idx < 0) { fail(24); return; }
                if (parse_array_indices_to_tmp() == 0) return;
                g_i = compute_array_linear(idx);
                if (running == 0) return;
                if (array_is_string_get(idx) != 0) {
                    file_input_parse_string_value();
                    if (running == 0) return;
                    if (inputOk == 0) { fail(18); return; }
                    copy_tmp_to_string_array(idx, g_i);
                } else {
                    value = file_input_parse_int_value();
                    if (inputOk == 0) { fail(18); return; }
                    array_num_int_set(idx, g_i, value);
                    array_num_float_set(idx, g_i, (float)value);
                    array_num_is_float_set(idx, g_i, 0);
                }
            } else {
                idx = find_or_create_var_from_ident();
                if (running == 0) return;

                if (var_is_string_get(idx) != 0) {
                    file_input_parse_string_value();
                    if (running == 0) return;
                    if (inputOk == 0) { fail(18); return; }
                    copy_tmp_to_string_var(idx);
                } else {
                    value = file_input_parse_int_value();
                    if (inputOk == 0) { fail(18); return; }
                    var_int_set(idx, value);
                    var_float_set(idx, (float)value);
                    var_is_float_set(idx, 0);
                }
            }
        } else {
            idx = find_or_create_var_from_ident();
            if (running == 0) return;
            if (var_is_string_get(idx) != 0) {
                file_input_parse_string_value();
                if (running == 0) return;
                if (inputOk == 0) { fail(18); return; }
                copy_tmp_to_string_var(idx);
            } else {
                value = file_input_parse_int_value();
                if (inputOk == 0) { fail(18); return; }
                var_int_set(idx, value);
                var_float_set(idx, (float)value);
                var_is_float_set(idx, 0);
            }
        }

        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }

    file_require_statement_end();
}


void data_item_to_str_tmp(int item)
{
    int base;
    int p;
    int end;
    char c;
    clear_str_tmp();
    if (item < 0) return;
    if (item >= dataCount) return;
    base = data_item_base(item);
    p = 0;
    end = dataLen[item];
    while (p < end) { if (is_space(dataItems[base + p]) == 0) break; p = p + 1; }
    if (p < end) {
        if (dataItems[base + p] == 34) {
            p = p + 1;
            while (p < end) {
                c = dataItems[base + p];
                if (c == 34) break;
                append_str_tmp_char(c);
                if (running == 0) return;
                p = p + 1;
            }
            return;
        }
    }
    while (end > p) { if (is_space(dataItems[base + end - 1]) == 0) break; end = end - 1; }
    while (p < end) {
        append_str_tmp_char(dataItems[base + p]);
        if (running == 0) return;
        p = p + 1;
    }
}

float data_item_to_float(int item)
{
    int base;
    int p;
    int end;
    int sign;
    float v;
    float frac;
    char c;
    v = 0.0f;
    sign = 1;
    if (item < 0) return 0.0f;
    if (item >= dataCount) return 0.0f;
    base = data_item_base(item);
    p = 0;
    end = dataLen[item];
    while (p < end) { if (is_space(dataItems[base + p]) == 0) break; p = p + 1; }
    if (p < end) { if (dataItems[base + p] == 34) p = p + 1; }
    if (p < end) { if (dataItems[base + p] == '-') { sign = -1; p = p + 1; } else if (dataItems[base + p] == '+') p = p + 1; }
    while (p < end) {
        c = dataItems[base + p];
        if (is_digit(c) == 0) break;
        v = v * 10.0f + (float)((int)(c - '0'));
        p = p + 1;
    }
    if (p < end) {
        if (dataItems[base + p] == '.') {
            p = p + 1;
            frac = 0.1f;
            while (p < end) {
                c = dataItems[base + p];
                if (is_digit(c) == 0) break;
                v = v + frac * (float)((int)(c - '0'));
                frac = frac * 0.1f;
                p = p + 1;
            }
        }
    }
    if (sign < 0) v = 0.0f - v;
    return v;
}

int data_item_has_decimal(int item)
{
    int base;
    int p;
    int end;
    if (item < 0) return 0;
    if (item >= dataCount) return 0;
    base = data_item_base(item);
    end = dataLen[item];
    p = 0;
    while (p < end) { if (dataItems[base + p] == '.') return 1; p = p + 1; }
    return 0;
}

void exec_data_stmt()
{
    ip = ip + 4;
    skip_to_next_statement_colon();
}

void exec_read()
{
    int idx;
    int arr;
    int lin;
    float fv;
    int isF;
    ip = ip + 4;
    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) { fail(5); return; }
        if (dataPtr >= dataCount) { fail(43); return; }
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        skip_spaces();
        if (ip < currentEnd) {
            if (prog[ip] == '(') {
                arr = find_array_from_ident();
                if (arr < 0) { fail(24); return; }
                if (parse_array_indices_to_tmp() == 0) return;
                lin = compute_array_linear(arr);
                if (running == 0) return;
                if (array_is_string_get(arr) != 0) {
                    data_item_to_str_tmp(dataPtr);
                    if (running == 0) return;
                    copy_tmp_to_string_array(arr, lin);
                } else {
                    fv = data_item_to_float(dataPtr);
                    isF = data_item_has_decimal(dataPtr);
                    array_num_int_set(arr, lin, (int)fv);
                    array_num_float_set(arr, lin, fv);
                    array_num_is_float_set(arr, lin, isF);
                }
            } else {
                idx = find_or_create_var_from_ident();
                if (running == 0) return;
                if (var_is_string_get(idx) != 0) {
                    data_item_to_str_tmp(dataPtr);
                    if (running == 0) return;
                    copy_tmp_to_string_var(idx);
                } else {
                    fv = data_item_to_float(dataPtr);
                    isF = data_item_has_decimal(dataPtr);
                    var_int_set(idx, (int)fv);
                    var_float_set(idx, fv);
                    var_is_float_set(idx, isF);
                }
            }
        } else {
            idx = find_or_create_var_from_ident();
            if (running == 0) return;
            if (var_is_string_get(idx) != 0) {
                data_item_to_str_tmp(dataPtr);
                if (running == 0) return;
                copy_tmp_to_string_var(idx);
            } else {
                fv = data_item_to_float(dataPtr);
                isF = data_item_has_decimal(dataPtr);
                var_int_set(idx, (int)fv);
                var_float_set(idx, fv);
                var_is_float_set(idx, isF);
            }
        }
        dataPtr = dataPtr + 1;
        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }
    file_require_statement_end();
}

void exec_restore()
{
    int targetLine;
    int found;
    int i;
    ip = ip + 7;
    skip_spaces();
    if (ip >= currentEnd) { dataPtr = 0; return; }
    if (prog[ip] == ':') { dataPtr = 0; return; }
    targetLine = 0;
    if (is_digit(prog[ip]) != 0) {
        targetLine = find_line(parse_uint_lit());
        if (targetLine < 0) { fail(4); return; }
    } else {
        if (parse_ident_to_tmp() == 0) { fail(4); return; }
        found = find_label_from_ident();
        if (found < 0) { fail(4); return; }
        targetLine = labelLine[found];
    }
    file_require_statement_end();
    if (running == 0) return;
    i = 0;
    while (i < dataCount) {
        if (dataLine[i] >= targetLine) { dataPtr = i; return; }
        i = i + 1;
    }
    dataPtr = dataCount;
}

void exec_local()
{
    int idx;
    ip = ip + 5;
    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) { fail(5); return; }
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        idx = find_or_create_var_from_ident();
        if (running == 0) return;
        save_local_var_if_needed(idx);
        if (running == 0) return;
        var_int_set(idx, 0);
        var_float_set(idx, 0.0f);
        var_is_float_set(idx, 0);
        var_str_len_set(idx, 0);
        skip_spaces();
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (prog[ip] != ',') { fail(16); return; }
        ip = ip + 1;
    }
    file_require_statement_end();
}

void assign_call_args_to_params(int subIdx)
{
    int argn;
    int idx;
    int v;
    float fv;
    int isF;
    int paren;
    argn = 0;
    paren = 0;
    skip_spaces();
    if (ip < currentEnd) { if (prog[ip] == '(') { paren = 1; ip = ip + 1; } }
    skip_spaces();
    if (paren != 0) { if (ip < currentEnd) { if (prog[ip] == ')') { ip = ip + 1; return; } } }
    while (running != 0) {
        if (argn >= subParamCount[subIdx]) { fail(46); return; }
        expr_stack_save();
        v = parse_expr();
        fv = lastExprFloat;
        isF = lastExprIsFloat;
        expr_stack_restore();
        if (running == 0) return;
        copy_sub_param_to_ident(subIdx, argn);
        idx = find_or_create_var_from_ident();
        if (running == 0) return;
        save_local_var_if_needed(idx);
        if (running == 0) return;
        var_int_set(idx, v);
        var_float_set(idx, fv);
        var_is_float_set(idx, isF);
        argn = argn + 1;
        skip_spaces();
        if (paren != 0) {
            if (ip >= currentEnd) { fail(12); return; }
            if (prog[ip] == ',') { ip = ip + 1; continue; }
            if (prog[ip] == ')') { ip = ip + 1; break; }
            fail(12); return;
        }
        if (ip >= currentEnd) break;
        if (prog[ip] == ':') break;
        if (prog[ip] == ',') { ip = ip + 1; continue; }
        break;
    }
    if (argn != subParamCount[subIdx]) { fail(46); return; }
}

void exec_call()
{
    int idx;
    ip = ip + 4;
    skip_spaces();
    if (parse_ident_to_tmp() == 0) { fail(4); return; }
    idx = find_sub_from_ident();
    if (idx < 0) { fail(4); return; }
    if (gosubSp >= MAX_GOSUB) { fail(30); return; }
    localMarkStack[gosubSp] = localTop;
    assign_call_args_to_params(idx);
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    gosubStack[gosubSp] = currentPc;
    gosubIpStack[gosubSp] = ip;
    gosubSp = gosubSp + 1;
    nextPc = subLine[idx];
    nextIp = subIp[idx];
    flowChanged = 1;
}

void exec_sub_definition(int isFunc)
{
    int kw;
    int startLine;
    int startIp;
    if (isFunc != 0) kw = 8; else kw = 3;
    ip = ip + kw;
    skip_to_next_statement_colon();
    if (ip < currentEnd) {
        if (prog[ip] == ':') { ip = ip + 1; startLine = currentPc; startIp = ip; }
        else { startLine = currentPc + 1; startIp = 0; }
    } else { startLine = currentPc + 1; startIp = 0; }
    if (find_end_sub_or_function_after(startLine, startIp, isFunc) == 0) { fail(47); return; }
    nextPc = jumpTargetLine;
    nextIp = jumpTargetIp;
    flowChanged = 1;
}

void exec_endsub_or_function(int isFunc)
{
    ip = ip + 3;
    skip_spaces();
    if (isFunc != 0) {
        if (match_kw8('F','U','N','C','T','I','O','N') == 0) { fail(5); return; }
        ip = ip + 8;
    } else {
        if (match_kw3('S','U','B') == 0) { fail(5); return; }
        ip = ip + 3;
    }
    file_require_statement_end();
    if (running == 0) return;
    if (gosubSp <= 0) { fail(31); return; }
    gosubSp = gosubSp - 1;
    restore_locals_to(localMarkStack[gosubSp]);
    nextPc = gosubStack[gosubSp];
    nextIp = gosubIpStack[gosubSp];
    flowChanged = 1;
}

void exec_current_line_body()
{
    char c;

    skip_spaces();
    if (ip >= currentEnd) return;
    c = prog[ip];

    if (c == 39) { ip = currentEnd; return; }
    if (match_kw3('R','E','M') != 0) { ip = currentEnd; return; }
    if (match_kw4('O','P','E','N') != 0) { exec_open(); return; }
    if (match_kw5('C','L','O','S','E') != 0) { exec_close(); return; }
    if (match_kw4('K','I','L','L') != 0) { exec_kill(); return; }
    if (match_kw5('M','K','D','I','R') != 0) { exec_mkdir(); return; }
    if (match_kw5('R','M','D','I','R') != 0) { exec_rmdir(); return; }
    if (match_kw5('C','H','D','I','R') != 0) { exec_chdir(); return; }
    if (match_kw5('F','I','L','E','S') != 0) { exec_files(); return; }
    if (match_kw4('D','A','T','A') != 0) { exec_data_stmt(); return; }
    if (match_kw4('R','E','A','D') != 0) { exec_read(); return; }
    if (match_kw7('R','E','S','T','O','R','E') != 0) { exec_restore(); return; }
    if (match_kw4('C','A','L','L') != 0) { exec_call(); return; }
    if (match_kw5('L','O','C','A','L') != 0) { exec_local(); return; }
    if (match_kw3('S','U','B') != 0) { exec_sub_definition(0); return; }
    if (match_kw8('F','U','N','C','T','I','O','N') != 0) { exec_sub_definition(1); return; }
    if (match_end_sub_here() != 0) { exec_endsub_or_function(0); return; }
    if (match_end_function_here() != 0) { exec_endsub_or_function(1); return; }
    if (match_kw5('P','R','I','N','T') != 0) { exec_print(); return; }
    if (match_kw5('I','N','P','U','T') != 0) { skip_spaces(); if (ip + 5 <= currentEnd) { } exec_input(); return; }
    if (match_kw3('D','I','M') != 0) { exec_dim(); return; }
    if (match_kw3('M','E','M') != 0) { ip = ip + 3; file_require_statement_end(); if (running != 0) print_memory(); return; }
    if (match_kw6('M','E','M','O','R','Y') != 0) { ip = ip + 6; file_require_statement_end(); if (running != 0) print_memory(); return; }
    if (match_kw5('C','O','L','O','R') != 0) { exec_color_stmt(5, 0); return; }
    if (match_kw6('C','O','L','O','U','R') != 0) { exec_color_stmt(6, 0); return; }
    if (match_kw3('I','N','K') != 0) { exec_color_stmt(3, 1); return; }
    if (match_kw5('P','A','P','E','R') != 0) { exec_color_stmt(5, 2); return; }
    if (match_kw7('E','D','C','O','L','O','R') != 0) { exec_edcolor_stmt(); return; }
    if (match_kw6('E','D','S','A','V','E') != 0) { exec_edsave_stmt(); return; }
    if (match_kw6('E','D','L','O','A','D') != 0) { exec_edload_stmt(); return; }
    if (match_kw7('E','D','R','E','S','E','T') != 0) { exec_edreset_stmt(); return; }
#ifdef __NARM__
    if (match_kw4('M','O','D','E') != 0) { exec_mode(); return; }
#endif
    if (match_kw4('G','C','L','S') != 0) { exec_gcls(); return; }
    if (match_kw5('G','T','E','X','T') != 0) { exec_gtext(); return; }
    if (match_kw7('G','B','U','T','T','O','N') != 0) { exec_gbutton(); return; }
    if (match_kw5('P','I','X','E','L') != 0) { exec_pixel_stmt(5); return; }
    if (match_kw4('P','S','E','T') != 0) { exec_pixel_stmt(4); return; }
    if (match_kw4('L','I','N','E') != 0) {
        g_pos = ip;
        ip = ip + 4; skip_spaces();
        if (match_kw5('I','N','P','U','T') != 0) { ip = g_pos; exec_line_input(); return; }
        ip = g_pos; exec_line_gfx(); return;
    }
    if (match_kw4('R','E','C','T') != 0) { exec_rect(); return; }
    if (match_kw8('F','I','L','L','R','E','C','T') != 0) { exec_fillrect(); return; }
    if (match_kw7('F','I','L','L','T','R','I') != 0) { exec_tri(1); return; }
    if (match_kw3('T','R','I') != 0) { exec_tri(0); return; }
    if (match_kw7('P','R','E','S','E','N','T') != 0) { exec_present_stmt(); return; }
    if (match_kw5('P','A','U','S','E') != 0) { exec_delay_stmt(5); return; }
    if (match_kw5('D','E','L','A','Y') != 0) { exec_delay_stmt(5); return; }
    if (match_kw4('P','O','K','E') != 0) { exec_poke_stmt(); return; }
    if (match_kw7('P','I','N','M','O','D','E') != 0) { exec_gpio_mode_stmt(7, 1); return; }
    if (match_kw8('G','P','I','O','M','O','D','E') != 0) { exec_gpio_mode_stmt(8, 0); return; }
    if (match_kw7('G','P','I','O','S','E','T') != 0) { exec_gpio_set_stmt(7, 0); return; }
    if (match_kw6('P','I','N','S','E','T') != 0) { exec_gpio_set_stmt(6, 0); return; }
    if (match_kw12('D','I','G','I','T','A','L','W','R','I','T','E') != 0) { exec_gpio_set_stmt(12, 1); return; }
    if (match_kw3('L','E','T') != 0) { exec_assignment(1); return; }
    if (match_kw5('G','O','S','U','B') != 0) { exec_gosub(); return; }
    if (match_kw4('G','O','T','O') != 0) { exec_goto(); return; }
    if (match_kw6('R','E','T','U','R','N') != 0) { exec_return(); return; }
    if (match_kw4('E','L','S','E') != 0) { exec_else(); return; }
    if (match_kw5('E','N','D','I','F') != 0) { exec_endif(); return; }
    if (match_kw2('I','F') != 0) { exec_if(); return; }
    if (match_kw2('D','O') != 0) { exec_do(); return; }
    if (match_kw4('L','O','O','P') != 0) { exec_loop(); return; }
    if (match_kw5('W','H','I','L','E') != 0) { exec_while(); return; }
    if (match_kw4('W','E','N','D') != 0) { exec_wend(); return; }
    if (match_kw6('S','E','L','E','C','T') != 0) { exec_select(); return; }
    if (match_kw4('C','A','S','E') != 0) { exec_case(); return; }
    if (match_end_select_here() != 0) { exec_endselect(); return; }
    if (match_kw3('F','O','R') != 0) { exec_for(); return; }
    if (match_kw4('N','E','X','T') != 0) { exec_next(); return; }
    if (match_kw3('E','N','D') != 0) { running = 0; return; }
    if (match_kw4('S','T','O','P') != 0) { running = 0; return; }

    if (is_ident_start(c) != 0) {
        exec_assignment(0);
        return;
    }

    fail(5);
}

void exec_line(int idx, int startIp)
{
    currentPc = idx;
    nextPc = idx + 1;
    nextIp = 0;
    load_line_to_prog(idx);
    ip = startIp;

    while (running != 0) {
        skip_spaces();
        if (ip >= currentEnd) return;
        if (prog[ip] == ':') { ip = ip + 1; continue; }
        if (prog[ip] == 39) return;
        while (skip_label_statement_here() != 0) {
            skip_spaces();
            if (ip >= currentEnd) return;
            if (prog[ip] == ':') { ip = ip + 1; }
        }
        if (ip >= currentEnd) return;
        if (prog[ip] == 39) return;

        flowChanged = 0;
        exec_current_line_body();
        if (running == 0) return;
        if (flowChanged != 0) return;

        skip_spaces();
        if (ip >= currentEnd) return;
        if (prog[ip] == ':') {
            ip = ip + 1;
            continue;
        }
        if (prog[ip] == 39) return;
        fail(17);
        return;
    }
}



