void exec_tri(int filled)
{
    int x0;
    int y0;
    int x1;
    int y1;
    int x2;
    int y2;
    int color;
    if (filled != 0) ip = ip + 7;
    else ip = ip + 3;
    x0 = parse_expr();
    if (running == 0) return;
    y0 = next_gfx_arg();
    if (running == 0) return;
    x1 = next_gfx_arg();
    if (running == 0) return;
    y1 = next_gfx_arg();
    if (running == 0) return;
    x2 = next_gfx_arg();
    if (running == 0) return;
    y2 = next_gfx_arg();
    if (running == 0) return;
    color = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    if (filled != 0) mm_fill_triangle(x0, y0, x1, y1, x2, y2, (uint)color);
    else {
        mm_line(x0, y0, x1, y1, (uint)color);
        mm_line(x1, y1, x2, y2, (uint)color);
        mm_line(x2, y2, x0, y0, (uint)color);
    }
    screenDirty = 1;
}

void exec_poke_stmt()
{
    int addr;
    int value;
    int paren;

    ip = ip + 4;
    skip_spaces();
    paren = 0;
    if (ip < currentEnd) {
        if (prog[ip] == '(') {
            paren = 1;
            ip = ip + 1;
        }
    }

    addr = parse_expr();
    if (running == 0) return;

    if (expect_comma() == 0) return;
    value = parse_expr();
    if (running == 0) return;

    if (paren != 0) {
        skip_spaces();
        if (ip >= currentEnd) { fail(12); return; }
        if (prog[ip] != ')') { fail(12); return; }
        ip = ip + 1;
    }

    file_require_statement_end();
    if (running == 0) return;
    rawPokeWord(addr, value);
}

void exec_gpio_mode_stmt(int kwLen, int usePinMode)
{
    int pin;
    int mode;
    ip = ip + kwLen;
    pin = parse_expr();
    if (running == 0) return;
    mode = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    if (usePinMode != 0) pinMode(pin, mode);
    else gpioMode(pin, mode);
}

void exec_gpio_set_stmt(int kwLen, int useDigitalWrite)
{
    int pin;
    int value;
    ip = ip + kwLen;
    pin = parse_expr();
    if (running == 0) return;
    value = next_gfx_arg();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    if (useDigitalWrite != 0) digitalWrite(pin, value);
    else gpioSet(pin, value);
}

void exec_present_stmt()
{
    ip = ip + 7;
    file_require_statement_end();
    if (running == 0) return;
    mm_present();
}

void exec_delay_stmt(int kwLen)
{
    int ms;
    uint start;
    uint target;

    ip = ip + kwLen;
    ms = parse_expr();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;

    if (ms <= 0) return;

    flushScreen();
    target = (uint)ms;
    start = millis();
    while ((uint)(millis() - start) < target) {
#ifdef __NARM__
        mm_service_screen(1);
#endif
    }
}


void exec_color_stmt(int kwLen, int mode)
{
    int fg;
    int bg;
    int bgGiven;

    ip = ip + kwLen;
    bgGiven = 0;

    if (mode == 2) {
        bg = parse_expr();
        if (running == 0) return;
        file_require_statement_end();
        if (running == 0) return;
        COL_BG = (uint)(bg & 255);
        consoleClear();
        return;
    }

    fg = parse_expr();
    if (running == 0) return;

    if (mode == 0) {
        skip_spaces();
        if (ip < currentEnd) {
            if (prog[ip] == ',') {
                ip = ip + 1;
                bg = parse_expr();
                if (running == 0) return;
                bgGiven = 1;
            }
        }
    }

    file_require_statement_end();
    if (running == 0) return;

    COL_TEXT = (uint)(fg & 255);
    if (bgGiven != 0) {
        COL_BG = (uint)(bg & 255);
        consoleClear();
    } else {
        redrawConsole();
    }
}

void editor_set_default_colors()
{
    ED_BG = (uint)0;
    ED_TEXT = (uint)255;
    ED_KEY = (uint)51;
    ED_VAR = (uint)255;
    ED_LIT = (uint)227;
    ED_NUM = (uint)28;
    ED_COMMENT = (uint)252;
    ED_DIV = (uint)65;
    ED_STATUS_TEXT = (uint)255;
    ED_CURSOR = (uint)255;
}

void editor_pack_config()
{
    editorCfg[0] = (char)(ED_BG & (uint)255);
    editorCfg[1] = (char)(ED_TEXT & (uint)255);
    editorCfg[2] = (char)(ED_KEY & (uint)255);
    editorCfg[3] = (char)(ED_VAR & (uint)255);
    editorCfg[4] = (char)(ED_LIT & (uint)255);
    editorCfg[5] = (char)(ED_NUM & (uint)255);
    editorCfg[6] = (char)(ED_COMMENT & (uint)255);
    editorCfg[7] = (char)(ED_DIV & (uint)255);
    editorCfg[8] = (char)(ED_STATUS_TEXT & (uint)255);
    editorCfg[9] = (char)(ED_CURSOR & (uint)255);
    editorCfg[10] = 0;
    editorCfg[11] = 0;
    editorCfg[12] = 0;
    editorCfg[13] = 0;
    editorCfg[14] = 0;
    editorCfg[15] = 0;
}

void editor_apply_config()
{
    ED_BG = (uint)((int)editorCfg[0] & 255);
    ED_TEXT = (uint)((int)editorCfg[1] & 255);
    ED_KEY = (uint)((int)editorCfg[2] & 255);
    ED_VAR = (uint)((int)editorCfg[3] & 255);
    ED_LIT = (uint)((int)editorCfg[4] & 255);
    ED_NUM = (uint)((int)editorCfg[5] & 255);
    ED_COMMENT = (uint)((int)editorCfg[6] & 255);
    ED_DIV = (uint)((int)editorCfg[7] & 255);
    ED_STATUS_TEXT = (uint)((int)editorCfg[8] & 255);
    ED_CURSOR = (uint)((int)editorCfg[9] & 255);
}

void editor_load_config()
{
    int n;
    editor_set_default_colors();
    if (sd_mount_ok() == 0) return;
    if (sdFileExists(editorCfgPath) == (uint)0) return;
    clear_chars(editorCfg, 16);
    n = (int)sdFileReadBytes(editorCfgPath, editorCfg, (uint)0, (uint)16);
    if (n >= 10) editor_apply_config();
}

void editor_save_config()
{
    editor_pack_config();
    if (sd_mount_ok() == 0) return;
    sdFileDelete(editorCfgPath);
    sdFileMake(editorCfgPath);
    sdFileWriteBytes(editorCfgPath, editorCfg, (uint)0, (uint)16);
}

int editor_color_slot_from_ident()
{
    if (identTmp[0] == 'B') {
        if (identTmp[1] == 'G') if (identTmp[2] == 0) return 0;
        if (identTmp[1] == 'A') if (identTmp[2] == 'C') if (identTmp[3] == 'K') return 0;
    }
    if (identTmp[0] == 'P') {
        if (identTmp[1] == 'A') if (identTmp[2] == 'P') if (identTmp[3] == 'E') if (identTmp[4] == 'R') return 0;
    }
    if (identTmp[0] == 'T') if (identTmp[1] == 'E') if (identTmp[2] == 'X') if (identTmp[3] == 'T') if (identTmp[4] == 0) return 1;
    if (identTmp[0] == 'F') if (identTmp[1] == 'G') if (identTmp[2] == 0) return 1;
    if (identTmp[0] == 'K') {
        if (identTmp[1] == 'E') if (identTmp[2] == 'Y') {
            if (identTmp[3] == 0) return 2;
            if (identTmp[3] == 'W') return 2;
        }
    }
    if (identTmp[0] == 'V') {
        if (identTmp[1] == 'A') if (identTmp[2] == 'R') return 3;
    }
    if (identTmp[0] == 'S') {
        if (identTmp[1] == 'T') if (identTmp[2] == 'R') return 4;
        if (identTmp[1] == 'T') if (identTmp[2] == 'A') if (identTmp[3] == 'T') return 8;
    }
    if (identTmp[0] == 'L') if (identTmp[1] == 'I') if (identTmp[2] == 'T') return 4;
    if (identTmp[0] == 'N') {
        if (identTmp[1] == 'U') if (identTmp[2] == 'M') return 5;
    }
    if (identTmp[0] == 'C') {
        if (identTmp[1] == 'O') if (identTmp[2] == 'M') return 6;
        if (identTmp[1] == 'U') if (identTmp[2] == 'R') return 9;
    }
    if (identTmp[0] == 'D') {
        if (identTmp[1] == 'I') if (identTmp[2] == 'V') return 7;
    }
    if (identTmp[0] == 'L') if (identTmp[1] == 'I') if (identTmp[2] == 'N') if (identTmp[3] == 'E') return 7;
    return -1;
}

void editor_set_color_slot(int slot, int value)
{
    uint c;
    c = (uint)(value & 255);
    if (slot == 0) ED_BG = c;
    else if (slot == 1) ED_TEXT = c;
    else if (slot == 2) ED_KEY = c;
    else if (slot == 3) ED_VAR = c;
    else if (slot == 4) ED_LIT = c;
    else if (slot == 5) ED_NUM = c;
    else if (slot == 6) ED_COMMENT = c;
    else if (slot == 7) ED_DIV = c;
    else if (slot == 8) ED_STATUS_TEXT = c;
    else if (slot == 9) ED_CURSOR = c;
}

void print_editor_colors()
{
    con_char('E'); con_char('D'); con_char('I'); con_char('T'); con_char('O'); con_char('R'); con_char(' '); con_char('C'); con_char('O'); con_char('L'); con_char('O'); con_char('R'); con_char('S'); con_nl();
    con_char('0'); con_char(' '); con_char('B'); con_char('G'); con_char('='); con_int((int)ED_BG); con_nl();
    con_char('1'); con_char(' '); con_char('T'); con_char('E'); con_char('X'); con_char('T'); con_char('='); con_int((int)ED_TEXT); con_nl();
    con_char('2'); con_char(' '); con_char('K'); con_char('E'); con_char('Y'); con_char('='); con_int((int)ED_KEY); con_nl();
    con_char('3'); con_char(' '); con_char('V'); con_char('A'); con_char('R'); con_char('='); con_int((int)ED_VAR); con_nl();
    con_char('4'); con_char(' '); con_char('S'); con_char('T'); con_char('R'); con_char('='); con_int((int)ED_LIT); con_nl();
    con_char('5'); con_char(' '); con_char('N'); con_char('U'); con_char('M'); con_char('='); con_int((int)ED_NUM); con_nl();
    con_char('6'); con_char(' '); con_char('C'); con_char('O'); con_char('M'); con_char('M'); con_char('='); con_int((int)ED_COMMENT); con_nl();
    con_char('7'); con_char(' '); con_char('D'); con_char('I'); con_char('V'); con_char('='); con_int((int)ED_DIV); con_nl();
}

void exec_edcolor_stmt()
{
    int slot;
    int value;
    ip = ip + 7;
    skip_spaces();
    if (ip >= currentEnd) { print_editor_colors(); return; }
    slot = -1;
    if (is_digit(prog[ip]) != 0) {
        slot = parse_expr();
        if (running == 0) return;
    } else {
        if (parse_ident_to_tmp() == 0) { fail(5); return; }
        slot = editor_color_slot_from_ident();
    }
    if (slot < 0) { fail(5); return; }
    if (slot > 9) { fail(5); return; }
    if (expect_comma() == 0) return;
    value = parse_expr();
    if (running == 0) return;
    file_require_statement_end();
    if (running == 0) return;
    editor_set_color_slot(slot, value);
    if (uiMode != 0) fsNeedRedraw = 1;
}

