/* v86: the shared packed BASIC pool replaces separate source, scalar, and
   DIM-array stores. Source slots occupy low addresses; scalar records and DIM
   payloads occupy high addresses. Pool byte helpers preserve packed char
   storage while allowing aligned int/float values in runtime records. */
uint basicPool[163840];
int poolVarTop;
int poolScalarTop;
int varRecordAddr[13654];
int arrayRecordAddr[9638];

/* Unified bytecode stream.  Stored as uint8[] so vmcc packs four bytes per
   32-bit VM word.  Each logical token/operand is unsigned LEB128 encoded. */
