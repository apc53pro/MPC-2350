#define main mmbasic_main
#include "../mmbasic_v91_narm.tc"
#undef main

int direct(char *expression)
{
    int i;
    i = 0;
    while (expression[i] != 0) { prog[i] = expression[i]; i = i + 1; }
    currentEnd = i; ip = 0; errFlag = 0; running = 1;
    return parse_expr();
}

void add_line(char *text)
{
    int i;
    i = 0;
    while (text[i] != 0) { inputLine[i] = text[i]; i = i + 1; }
    append_program_line(0, i);
}

void repl(char *text)
{
    int i;
    i = 0;
    while (text[i] != 0) { inputLine[i] = text[i]; i = i + 1; }
    g_len = i; process_repl_line();
}

int test_direct()
{
    int i;
    if (direct("MM.MODE * 100 + MM.BPP") != 508) return 11;
    if (direct("mm.hres + mm.vres") != 560) return 12;
    if (direct("RGB(255, 0, 0)") != 224) return 13;
    if (direct("3 + RGB(10 + 245, 2 * 100 + 55, RGB(0,0,255)*85)") != 258) return 14;
    repl("MODE 3");
    if (errFlag != 0 || SCREEN_W != 640 || SCREEN_H != 480 || mousePixelScale != 1) return 15;
    if (CON_COLS != 106 || CON_ROWS != 60 || CON_CELLS != 6360 || FS_VISIBLE_ROWS != 57) return 16;
    if (direct("MM.MODE * 100 + MM.BPP") != 304 || direct("MM.HRES + MM.VRES") != 1120) return 17;
    if (direct("MOUSE(\"X\")") != 639 || direct("MOUSE(\"Y\")") != 479) return 18;
    repl("GCLS RGB(0,0,0): PIXEL 639,479,RGB(255,255,255): PIXEL 640,480,255");
    if (errFlag != 0) return 19;
    repl("LINE 0,479,639,0,RGB(255,0,0)");
    repl("RECT 500,350,638,478,RGB(0,255,0)");
    repl("FILLRECT 610,450,650,490,RGB(0,0,255)");
    repl("FILLRECT -40,-30,-10,-10,255: FILLRECT 700,500,800,600,255");
    repl("GTEXT 570,420,\"HIRES\",255: GBUTTON 480,380,120,24,\"OK\",224,255,28");
    if (errFlag != 0) return 20;
    conBuf[6359] = 'Z'; drawCell(105,59);
    fs_draw_cell(105,58,'Z',255,0,0);
    fs_cache_set(105,58,252);
    if (fsColorValid[6041] != 1 || (fsColorCache[6041] & 255) != 252) return 21;
    mm_present();
    repl("MODE 5 : PIXEL 319,239,255 : PRESENT");
    if (errFlag != 0 || graphicsMode != 5 || CON_CELLS != 1590 || FS_VISIBLE_ROWS != 27) return 22;
    if (direct("MOUSE(\"X\")") != 319 || direct("MOUSE(\"Y\")") != 239) return 23;
    i = 1590;
    while (i < 6360) { if (conBuf[i] != 32 || fsColorValid[i] != 0) return 24; i = i + 1; }
    return 0;
}

int test_stored()
{
    add_line("10 MODE 3 : A=MM.HRES : B=MM.VRES : C=MM.BPP : D=MM.MODE");
    add_line("20 RGB=7 : E=RGB + RGB(255,255,255) : CALL DRAW");
    add_line("30 MODE 5 : F=MM.HRES : G=MM.VRES : H=MM.BPP : I=MM.MODE");
    add_line("40 CALL DRAW : END");
    add_line("100 SUB DRAW");
    add_line("110 GCLS 0");
    add_line("120 PIXEL MM.HRES-1,MM.VRES-1,RGB(255,255,255)");
    add_line("130 FILLRECT MM.HRES-20,MM.VRES-20,MM.HRES+10,MM.VRES+10,224");
    add_line("140 RECT 10,10,100,100,28 : LINE 0,MM.VRES-1,MM.HRES-1,0,227");
    add_line("150 GTEXT 12,20,\"BOTH MODES\",252 : GBUTTON 20,30,80,20,\"TEST\",224,255,28");
    add_line("160 TRI 20,150,40,130,60,150,255 : FILLTRI 70,150,90,130,110,150,28");
    add_line("170 FILLTRI 120,140,130,140,140,140,227 : FILLTRI -100,-80,-20,-40,-10,-50,255");
    add_line("180 PRESENT");
    add_line("190 END SUB");
    repl("RUN");
    if (errFlag != 0) return 30 + errFlag;
    if (direct("A+B+C+D") != 1127 || direct("E") != 262) return 31;
    if (direct("F+G+H+I") != 573) return 32;
    return 0;
}

int test_high_editor()
{
    int i;
    repl("MODE 3");
    i = 0;
    while (i < 90) {
        add_line("0123456789 ABCDEFGHIJ KLMNOPQRST UVWXYZ0123 4567890123 4567890123 4567890123 4567890");
        i = i + 1;
    }
    fs_clamp_cursor();
    narm_random_u32(); fs_mouse_poll();
    if (fsCurLine != 38 || fsCurCol != 70 || mouseDrag != 1) return 41;
    narm_random_u32(); fs_mouse_poll();
    if (fsCurLine != 43 || fsCurCol != 75 || mouseDrag != 0) return 42;
    if (fs_selection_has_range() == 0) return 43;
    if (fsSelStartLine != 38 || fsSelStartCol != 70 || fsSelEndLine != 43 || fsSelEndCol != 75) return 43;
    narm_random_u32(); fs_mouse_poll(); fs_clamp_cursor();
    if (fsTopLine != 6) return 44;
    fs_redraw_all();
    mm_present();
    narm_random_u32(); fs_mouse_poll();
    if (hitF5 == 0) return 45;
    return 0;
}

int test_invalid()
{
    repl("MODE 2");
    if (errFlag != 5 || graphicsMode != 5) return 51;
    repl("MODE 3.5");
    if (errFlag != 5 || graphicsMode != 5) return 52;
    repl("MODE 3,5");
    if (errFlag == 0 || graphicsMode != 5) return 53;
    repl("MODE");
    if (errFlag == 0 || graphicsMode != 5) return 54;
    direct("RGB(256,0,0)"); if (errFlag != 5) return 55;
    direct("RGB(0,-1,0)"); if (errFlag != 5) return 56;
    direct("RGB(0,0,256)"); if (errFlag != 5) return 57;
    direct("RGB(255 0,0)"); if (errFlag == 0) return 58;
    direct("RGB(255,0)"); if (errFlag == 0) return 59;
    return 0;
}

int test_stored_invalid(int scenario)
{
    add_line("10 MODE 3");
    if (scenario == 5) add_line("200 MODE 1 : MODE 5");
    if (scenario == 6) add_line("200 MODE 5.5 : MODE 5");
    if (scenario == 7) add_line("200 MODE 5,3 : MODE 5");
    if (scenario == 8) add_line("200 A=RGB(256,0,0) : MODE 5");
    if (scenario == 9) add_line("200 A=RGB(1,2) : MODE 5");
    repl("RUN");
    if (errFlag == 0 || graphicsMode != 3) return 61;
    if (scenario == 5 && errFlag != 5) return 62;
    if (scenario == 6 && errFlag != 5) return 63;
    return 0;
}

int test_mouse()
{
    repl("MODE 3");
    narm_random_u32();
    if (direct("MOUSE(\"POLL\")") != 1) return 71;
    if (direct("MOUSE(\"EVENTX\")+MOUSE(\"EVENTY\")") != 1118) return 72;
    if (direct("MOUSE(\"EVENTDX\")-MOUSE(\"EVENTDY\")") != 1400) return 73;
    if (direct("MOUSE(\"MOTION\")") != 1 || direct("MOUSE(\"DX\")") != 900) return 74;
    repl("MODE 5");
    narm_random_u32();
    if (direct("MOUSE(\"POLL\")") != 1) return 75;
    if (direct("MOUSE(\"EVENTX\")+MOUSE(\"EVENTY\")") != 558) return 76;
    if (direct("MOUSE(\"EVENTDX\")-MOUSE(\"EVENTDY\")") != 1400) return 77;
    return 0;
}

int main()
{
    int scenario;
    clear_program(); clear_vars(); initFontTable(); init_keys();
    scenario = narm_random_u32();
    if (scenario == 1) return test_direct();
    if (scenario == 2) return test_stored();
    if (scenario == 3) return test_high_editor();
    if (scenario == 4) return test_invalid();
    if (scenario >= 5 && scenario <= 9) return test_stored_invalid(scenario);
    if (scenario == 10) return test_mouse();
    if (scenario == 11) { repl("MODE 3"); uiMode=1; fs_editor_loop(); return uiMode != 0; }
    if (scenario == 12) {
        set_default_path();
        repl("LOAD \"/COLORMODES.BAS\"");
        if (lineCount < 30) return 80;
        repl("RUN");
        if (errFlag != 0) return errFlag;
        if (graphicsMode != 5) return 81;
        return 0;
    }
    return 99;
}
