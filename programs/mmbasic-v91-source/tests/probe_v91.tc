#define main mmbasic_main
#include "../mmbasic_v91_narm.tc"
#undef main

int direct(char *expression)
{
    int i;
    i = 0;
    while (expression[i] != 0) { prog[i] = expression[i]; i = i + 1; }
    currentEnd = i;
    ip = 0;
    errFlag = 0;
    running = 1;
    return parse_expr();
}

void add_line(char *text)
{
    int i;
    i = 0;
    while (text[i] != 0) { inputLine[i] = text[i]; i = i + 1; }
    append_program_line(0, i);
}

void repl(char *text)
{
    int i;
    i = 0;
    while (text[i] != 0) { inputLine[i] = text[i]; i = i + 1; }
    g_len = i;
    process_repl_line();
}

int test_basic()
{
    if (direct("MOUSE( \"x\" ) + 2") != 102) return 11;
    if (direct("mouse(\"Y\")") != 50) return 12;
    if (direct("MOUSE(\"LEFT\") + MOUSE(\"RIGHT\") + MOUSE(\"MIDDLE\")") != 2) return 13;
    if (direct("MOUSE(\"CONNECTED\")") != 1) return 14;
    if (direct("MOUSE(\"BUTTONS\")") != 5) return 15;
    repl("MOUSE = 7 : A = MOUSE(\"X\") + MOUSE");
    if (errFlag != 0 || direct("A") != 107) return 16;
    if (direct("MOUSE(\"POLL\")") != 3) return 17;
    if (direct("MOUSE(\"EVENTX\") + MOUSE(\"EVENTY\")") != 117) return 18;
    if (direct("MOUSE(\"EVENTDX\") + MOUSE(\"EVENTDY\")") != -3) return 19;
    if (direct("MOUSE(\"EVENTBUTTONS\") + MOUSE(\"CHANGED\")") != 2) return 20;
    if (direct("MOUSE(\"POLL\")") != 4) return 21;
    if (direct("MOUSE(\"POLL\")") != 0 || direct("MOUSE(\"EVENTX\")") != -1) return 22;
    if (direct("MOUSE(\"MOTION\")") != 1) return 23;
    if (direct("MOUSE(\"DX\") + MOUSE(\"DY\") + MOUSE(\"WHEEL\")") != -6) return 24;
    if (direct("MOUSE(\"MOTION\")") != 1 || direct("MOUSE(\"WHEEL\")") != 0) return 25;
    if (direct("MOUSE(\"INVALID\")") != 0 || errFlag != 5) return 26;
    if (direct("MOUSE(\"X\"") != 0 || errFlag != 12) return 27;
    return 0;
}

int test_program()
{
    add_line("10 DIM MOUSE(2)");
    add_line("20 MOUSE(1) = 7");
    add_line("30 A = 2 * MOUSE( \"x\" ) + MOUSE(1)");
    add_line("40 B = MOUSE(\"POLL\")");
    add_line("50 C = MOUSE(\"EVENTX\") + MOUSE(\"EVENTY\")");
    add_line("60 D = MOUSE(\"POLL\")");
    add_line("70 E = MOUSE(\"POLL\")");
    add_line("80 F = MOUSE(\"EVENTX\")");
    add_line("90 END");
    repl("RUN");
    if (errFlag != 0) return 30 + errFlag;
    if (direct("A") != 207) return 31;
    if (direct("B") != 3) return 32;
    if (direct("C") != 117) return 33;
    if (direct("D") != 4) return 34;
    if (direct("E") != 0) return 35;
    if (direct("F") != -1) return 36;
    return 0;
}

int test_gestures()
{
    int i;
    i = 0;
    while (i < 40) { add_line("0123456789 abcde"); i = i + 1; }
    fs_clamp_cursor();
    narm_random_u32();
    fs_mouse_poll();
    if (fsCurLine != 2 || fsCurCol != 3 || fs_selection_has_range() != 0) return 41;
    narm_random_u32();
    fs_mouse_poll();
    if (fsCurLine != 4 || fsCurCol != 5 || fs_selection_has_range() == 0 || mouseDrag != 0) return 42;
    if (fsSelStartLine != 2 || fsSelStartCol != 3 || fsSelEndLine != 4 || fsSelEndCol != 5) return 43;
    narm_random_u32();
    fs_mouse_poll();
    fs_clamp_cursor();
    if (fsTopLine != 6 || fsCurLine != 4 || fs_selection_has_range() == 0) return 44;
    narm_random_u32();
    fs_mouse_poll();
    if (fsCurLine != 7 || fsCurCol != 1 || fs_selection_has_range() != 0) return 45;
    narm_random_u32();
    fs_mouse_poll();
    if (mouseDrag != 0 || fsCurLine != 7 || fsCurCol != 1) return 46;
    narm_random_u32();
    fs_mouse_poll();
    if (mouseDrag == 0) return 47;
    fsEditorActive = 1;
    fsNeedRedraw = 0;
    pollNarmSystemEvents();
    if (mouseDrag != 0 || fsNeedRedraw == 0) return 48;
    narm_random_u32();
    fs_mouse_poll();
    if (hitF5 == 0) return 49;
    return 0;
}

int test_modal()
{
    uiMode = 1;
    fs_editor_loop();
    if (uiMode != 0 || fsEditorActive != 0) return 50;
    return 0;
}

int test_rebuild_and_jumps()
{
    int i;
    add_line("X = 0");
    add_line("GOTO 200");
    add_line("100 X = X + 1 : GOTO 200");
    i = 0;
    while (i < 200) { add_line("REM PADDING"); i = i + 1; }
    add_line("200 IF X < 15 THEN 100");
    add_line("PRINT \"DONE\"");
    add_line("END");
    repl("RUN");
    if (errFlag != 0 || direct("X") != 15) return 71;
    if (conBuf[0] != 'D' || conBuf[1] != 'O' || conBuf[2] != 'N' || conBuf[3] != 'E') return 72;
    repl("200 IF X < 9 THEN 100");
    repl("RUN");
    if (errFlag != 0 || direct("X") != 9) return 73;
    return 0;
}

int test_error_line()
{
    int i;
    int line;
    add_line("X = 0");
    i = 0;
    while (i < 200) { add_line("REM PADDING"); i = i + 1; }
    add_line("432 X = X / 0");
    repl("RUN");
    if (errFlag != 8) return 81;
    line = 0;
    while (line < CON_COLS - 3) {
        if (conBuf[line] == '4' && conBuf[line + 1] == '3' && conBuf[line + 2] == '2') return 0;
        line = line + 1;
    }
    return 82;
}

int test_integer_plan_fallback()
{
    add_line("X = 0 : D = 1");
    add_line("DO WHILE X < 3");
    add_line("X = X + D");
    add_line("D = 0.5");
    add_line("LOOP");
    add_line("X = D * 5");
    add_line("Y = 2 : X = Y + 3");
    add_line("Q = X / 2");
    add_line("A = 16777216 : B = A + 1");
    add_line("DO WHILE A <> B");
    add_line("Q = 99 : STOP");
    add_line("LOOP");
    add_line("DO UNTIL Q >= 4");
    add_line("Q = Q + 1");
    add_line("LOOP");
    add_line("X = X + (Y * 3)");
    add_line("END");
    repl("RUN");
    if (errFlag != 0 || direct("Q") != 4 || direct("X") != 11) return 91;
    if (direct("D*2") != 1 || lastExprIsFloat == 0) return 92;
    return 0;
}

int test_poll_and_present()
{
    add_line("X = 0");
    add_line("DO WHILE X < 32");
    add_line("X = X + 1");
    add_line("LOOP");
    add_line("PRINT \"DONE\"");
    add_line("END");
    repl("RUN");
    if (errFlag != 0 || direct("X") != 32) return 101;
    if (conBuf[0] != 'D' || conBuf[3] != 'E') return 102;
    return 0;
}

int main()
{
    int scenario;
    clear_program();
    clear_vars();
    initFontTable();
    init_keys();
    scenario = narm_random_u32();
    if (scenario == 1) return test_basic();
    if (scenario == 2) return test_program();
    if (scenario == 3) return test_gestures();
    if (scenario == 4) return test_modal();
    if (scenario == 7) return test_rebuild_and_jumps();
    if (scenario == 8) return test_error_line();
    if (scenario == 9) return test_integer_plan_fallback();
    if (scenario == 10) return test_poll_and_present();
    if (scenario == 6) {
        int cursor;
        editStartX = 2;
        editStartY = 3;
        editorSetupViewport();
        narm_random_u32();
        cursor = editor_mouse_cursor(14, 0);
        if (cursor != 3 || mouseDrag == 0) return 61;
        narm_random_u32();
        cursor = editor_mouse_cursor(14, cursor);
        if (cursor != 7 || editorHasSelection() == 0 || mouseDrag != 0) return 62;
        if (editSelStart != 3 || editSelEnd != 7) return 63;
        narm_random_u32();
        editMouseSubmitRow = 2;
        cursor = editor_mouse_cursor(14, cursor);
        if (hitEnter == 0 || cursor != 7) return 64;
        return 0;
    }
    if (scenario == 5) {
        if (direct("MOUSE(\"CONNECTED\")") != 0) return 51;
        if (direct("MOUSE(\"X\")") != -1 || direct("MOUSE(\"Y\")") != -1) return 52;
        if (direct("MOUSE(\"BUTTONS\")") != 0 || direct("MOUSE(\"POLL\")") != 0) return 53;
        return 0;
    }
    return 99;
}
