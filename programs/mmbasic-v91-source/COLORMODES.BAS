10 MODE 3
20 CALL DRAW
30 DO
40 PAUSE 10
50 IF KEYDOWN(118) THEN 300
60 IF KEYDOWN(41) THEN 100
70 LOOP
100 IF MM.MODE = 3 THEN 130
110 MODE 3
120 GOTO 140
130 MODE 5
140 CALL DRAW
150 DO WHILE KEYDOWN(41)
160 PAUSE 10
170 LOOP
180 GOTO 30
300 MODE 5
310 END
1000 SUB DRAW
1010 GCLS 0
1020 SW = MM.HRES : SH = MM.VRES
1030 GTEXT 12,8,"MODE " + STR(MM.MODE) + "  " + STR(SW) + "X" + STR(SH) + "  " + STR(MM.BPP) + " BPP",255
1040 GTEXT 12,20,"SPACE SWITCHES MODE / ESC EXITS",252
1050 CW = (SW-32)/16 : CH = (SH-70)/16
1060 FOR C = 0 TO 255
1070 X = 16 + (C%16)*CW : Y = 40 + (C/16)*CH
1080 FILLRECT X,Y,X+CW-1,Y+CH-1,C
1090 NEXT C
1100 RECT 15,39,16+CW*16,40+CH*16,255
1110 LINE 0,SH-1,SW-1,SH-1,255
1120 GTEXT 12,SH-17,"256 RGB332 INPUTS / 16 COLOURS IN MODE 3",255
1130 PRESENT
1140 END SUB
